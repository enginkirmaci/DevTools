<?xml version="1.0" encoding="utf-8" ?>
<suki:SukiWindow
	x:Class="ConceptChat.Views.MainWindow"
	xmlns="https://github.com/avaloniaui"
	xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
	xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
	xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
	xmlns:m="using:ConceptChat.Models"
	xmlns:suki="https://github.com/kikipoulet/SukiUI"
	xmlns:vm="using:ConceptChat.ViewModels"
	Title="opencode concept chat"
	Width="960"
	Height="720"
	MinWidth="760"
	MinHeight="540"
	BackgroundStyle="Flat"
	WindowStartupLocation="CenterScreen"
	x:DataType="vm:MainViewModel"
	mc:Ignorable="d">

	<suki:SukiWindow.Styles>
		<Style Selector="TextBlock.note">
			<Setter Property="Opacity" Value="0.55" />
			<Setter Property="FontStyle" Value="Italic" />
			<Setter Property="FontSize" Value="12" />
			<Setter Property="HorizontalAlignment" Value="Center" />
			<Setter Property="Margin" Value="0,3" />
			<Setter Property="TextWrapping" Value="Wrap" />
		</Style>
		<Style Selector="TextBlock.note.error">
			<Setter Property="Opacity" Value="1" />
			<Setter Property="Foreground" Value="#FFEF6F6F" />
		</Style>
		<Style Selector="Border.pill">
			<Setter Property="CornerRadius" Value="12" />
			<Setter Property="Padding" Value="10,4" />
			<Setter Property="Background" Value="#FF2E333F" />
		</Style>
		<Style Selector="Border.pill.on">
			<Setter Property="Background" Value="#FF1D4433" />
		</Style>
	</suki:SukiWindow.Styles>

	<Grid RowDefinitions="Auto,*,Auto">

		<!--  Header: connection row + folder/model row  -->
		<StackPanel Grid.Row="0" Margin="12,12,12,8" Spacing="8">
			<Grid ColumnDefinitions="Auto,*,Auto,Auto,Auto,Auto" ColumnSpacing="8">
				<Border Classes="pill" Classes.on="{Binding IsServerRunning}">
					<TextBlock Text="{Binding StatusText}" FontSize="12" VerticalAlignment="Center" />
				</Border>
				<TextBlock
					Grid.Column="2"
					Text="port"
					VerticalAlignment="Center"
					Opacity="0.6" />
				<TextBox Grid.Column="3" Width="80" Text="{Binding Port}" />
				<Button
					Grid.Column="4"
					Content="Start"
					Command="{Binding StartCommand}"
					IsEnabled="{Binding !IsServerRunning}" />
				<Button
					Grid.Column="5"
					Content="Stop"
					Command="{Binding StopCommand}"
					IsEnabled="{Binding IsServerRunning}" />
			</Grid>
			<Grid ColumnDefinitions="Auto,*,Auto,Auto,Auto" ColumnSpacing="8">
				<TextBlock Text="Working folder" VerticalAlignment="Center" Opacity="0.6" />
				<TextBox Grid.Column="1" Text="{Binding Folder}" />
				<Button Grid.Column="2" Content="Browse…" Click="OnBrowseClicked" />
				<TextBlock
					Grid.Column="3"
					Text="● working"
					VerticalAlignment="Center"
					Foreground="#FF6EC0FF"
					FontSize="12"
					IsVisible="{Binding IsBusy}" />
				<Button Grid.Column="4" Content="New chat" Command="{Binding NewChatCommand}" />
			</Grid>
		</StackPanel>

		<!--  Chat transcript  -->
		<Border
			Grid.Row="1"
			Margin="12,0,12,8"
			CornerRadius="10"
			Background="#FF171A21"
			Padding="8">
			<ScrollViewer x:Name="ChatScroll" HorizontalScrollBarVisibility="Disabled">
				<ItemsControl ItemsSource="{Binding ChatItems}" Margin="4">
					<ItemsControl.DataTemplates>

						<DataTemplate DataType="{x:Type m:UserMessageItem}">
							<Border
								HorizontalAlignment="Right"
								CornerRadius="10"
								Background="#FF2B4C7E"
								Padding="10,7"
								MaxWidth="560"
								Margin="40,4,0,4">
								<TextBlock Text="{Binding Text}" TextWrapping="Wrap" />
							</Border>
						</DataTemplate>

						<DataTemplate DataType="{x:Type m:AssistantTextItem}">
							<Border
								HorizontalAlignment="Left"
								CornerRadius="10"
								Background="#FF23262E"
								Padding="10,7"
								MaxWidth="640"
								Margin="0,4,40,4">
								<TextBlock Text="{Binding Text}" TextWrapping="Wrap" />
							</Border>
						</DataTemplate>

						<DataTemplate DataType="{x:Type m:ToolItem}">
							<StackPanel Orientation="Horizontal" Margin="4,2,40,2" Spacing="6">
								<Border CornerRadius="6" Padding="6,2" Background="#FF262B36">
									<TextBlock Text="{Binding Tool}" FontSize="11" />
								</Border>
								<TextBlock
									Text="{Binding Title}"
									Opacity="0.8"
									TextTrimming="CharacterEllipsis"
									MaxWidth="480"
									VerticalAlignment="Center" />
								<TextBlock
									Text="{Binding Status}"
									Opacity="0.5"
									FontSize="11"
									VerticalAlignment="Center" />
							</StackPanel>
						</DataTemplate>

						<DataTemplate DataType="{x:Type m:PermissionItem}">
							<Border
								HorizontalAlignment="Left"
								CornerRadius="10"
								Background="#FF33291A"
								BorderBrush="#FFD08B3C"
								BorderThickness="1"
								Padding="10,8"
								MaxWidth="640"
								Margin="0,6,40,6">
								<StackPanel Spacing="6">
									<TextBlock Text="{Binding Title}" FontWeight="SemiBold" />
									<TextBlock
										Text="{Binding Detail}"
										FontFamily="DejaVu Sans Mono, Consolas, monospace"
										FontSize="12"
										TextWrapping="Wrap"
										Foreground="#FFE8D9BC" />
									<StackPanel Orientation="Horizontal" Spacing="8" IsVisible="{Binding IsPending}">
										<Button Content="Allow" Command="{Binding AllowCommand}" />
										<Button Content="Always allow" Command="{Binding AllowAlwaysCommand}" />
										<Button Content="Deny" Command="{Binding DenyCommand}" />
									</StackPanel>
									<TextBlock
										Text="{Binding Answer}"
										IsVisible="{Binding !IsPending}"
										Opacity="0.85"
										FontStyle="Italic" />
								</StackPanel>
							</Border>
						</DataTemplate>

						<DataTemplate DataType="{x:Type m:SystemNoteItem}">
							<TextBlock
								Classes="note"
								Classes.error="{Binding IsError}"
								Text="{Binding Text}" />
						</DataTemplate>

					</ItemsControl.DataTemplates>
				</ItemsControl>
			</ScrollViewer>
		</Border>

		<!--  Input row  -->
		<Border
			Grid.Row="2"
			Margin="12,0,12,12"
			CornerRadius="10"
			Background="#FF1E222B"
			BorderBrush="#FF2E333F"
			BorderThickness="1"
			Padding="8">
			<Grid ColumnDefinitions="Auto,*,Auto" ColumnSpacing="8">
				<ComboBox
					MinWidth="230"
					ItemsSource="{Binding Models}"
					SelectedItem="{Binding SelectedModel}"
					VerticalAlignment="Center"
					ToolTip.Tip="Model for the next message" />
				<TextBox
					Grid.Column="1"
					Text="{Binding Input}"
					PlaceholderText="Ask opencode…"
					IsEnabled="{Binding IsServerRunning}" />
				<Button
					Grid.Column="2"
					Content="Send"
					Command="{Binding SendCommand}"
					IsDefault="True"
					IsEnabled="{Binding IsServerRunning}" />
			</Grid>
		</Border>
	</Grid>
</suki:SukiWindow>
