<?xml version="1.0" encoding="utf-8" ?>
<suki:SukiWindow
	x:Class="OpenCodeAgent.Views.MainWindow"
	xmlns="https://github.com/avaloniaui"
	xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
	xmlns:c="using:OpenCodeAgent.Controls"
	xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
	xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
	xmlns:m="using:OpenCodeAgent.Models"
	xmlns:suki="https://github.com/kikipoulet/SukiUI"
	xmlns:vm="using:OpenCodeAgent.ViewModels"
	Title="opencode agent"
	Width="1080"
	Height="760"
	MinWidth="860"
	MinHeight="580"
	BackgroundStyle="Flat"
	WindowStartupLocation="CenterScreen"
	x:DataType="vm:MainViewModel"
	mc:Ignorable="d">

	<suki:SukiWindow.Styles>
		<Style Selector="TextBlock.note">
			<Setter Property="Opacity" Value="0.55" />
			<Setter Property="FontStyle" Value="Italic" />
			<Setter Property="FontSize" Value="12" />
			<Setter Property="HorizontalAlignment" Value="Center" />
			<Setter Property="Margin" Value="0,3" />
			<Setter Property="TextWrapping" Value="Wrap" />
		</Style>
		<Style Selector="TextBlock.note.error">
			<Setter Property="Opacity" Value="1" />
			<Setter Property="Foreground" Value="#FFEF6F6F" />
		</Style>
		<Style Selector="Border.pill">
			<Setter Property="CornerRadius" Value="12" />
			<Setter Property="Padding" Value="10,4" />
			<Setter Property="Background" Value="#FF2E333F" />
		</Style>
		<Style Selector="Border.pill.on">
			<Setter Property="Background" Value="#FF1D4433" />
		</Style>
		<Style Selector="TextBlock.sidebar-hint">
			<Setter Property="Opacity" Value="0.5" />
			<Setter Property="FontSize" Value="12" />
			<Setter Property="FontStyle" Value="Italic" />
			<Setter Property="TextWrapping" Value="Wrap" />
			<Setter Property="TextAlignment" Value="Center" />
			<Setter Property="Margin" Value="4,8" />
		</Style>
		<Style Selector="TextBlock.msg-time">
			<Setter Property="FontSize" Value="10.5" />
			<Setter Property="Opacity" Value="0.55" />
			<Setter Property="HorizontalAlignment" Value="Right" />
		</Style>
	</suki:SukiWindow.Styles>

	<Grid ColumnDefinitions="250,*">

		<!--  Sidebar: chat sessions  -->
		<Border
			Grid.Column="0"
			Margin="10,10,0,10"
			CornerRadius="10"
			Background="#FF12151C"
			Padding="10">
			<Grid RowDefinitions="Auto,*,Auto">
				<Grid Margin="2,2,2,8" ColumnDefinitions="*,Auto">
					<TextBlock
						Text="Chats"
						FontWeight="SemiBold"
						VerticalAlignment="Center" />
					<Button
						Grid.Column="1"
						Classes="icon"
						Content="+"
						Command="{Binding NewChatCommand}"
						IsEnabled="{Binding IsServerRunning}"
						ToolTip.Tip="New chat" />
				</Grid>
				<ListBox
					Grid.Row="1"
					ItemsSource="{Binding Sessions}"
					SelectedItem="{Binding SelectedSession}"
					Background="Transparent">
					<ListBox.ItemTemplate>
						<DataTemplate>
							<StackPanel Margin="2,3" Background="Transparent">
								<StackPanel.ContextMenu>
									<ContextMenu>
										<MenuItem Header="Pin" Click="OnPinClick" IsVisible="{Binding !IsPinned}" />
										<MenuItem Header="Unpin" Click="OnUnpinClick" IsVisible="{Binding IsPinned}" />
										<MenuItem Header="Rename" Click="OnRenameClick" />
										<MenuItem Header="Delete" Click="OnDeleteClick" />
									</ContextMenu>
								</StackPanel.ContextMenu>
								<TextBlock
									Text="{Binding Title}"
									TextTrimming="CharacterEllipsis"
									IsVisible="{Binding !IsEditing}" />
								<TextBox
									Text="{Binding DraftTitle}"
									IsVisible="{Binding IsEditing}"
									KeyDown="OnRenameKeyDown"
									LostFocus="OnRenameLostFocus" />
								<TextBlock
									Text="{Binding UpdatedLabel}"
									FontSize="11"
									Opacity="0.5"
									Margin="0,1,0,0" />
							</StackPanel>
						</DataTemplate>
					</ListBox.ItemTemplate>
				</ListBox>
				<StackPanel Grid.Row="2">
					<TextBlock
						Classes="sidebar-hint"
						IsVisible="{Binding !IsServerRunning}"
						Text="Start the server to load your chats." />
					<TextBlock
						Classes="sidebar-hint"
						IsVisible="{Binding HasSessionsHint}"
						Text="No chats yet for this folder." />
				</StackPanel>
			</Grid>
		</Border>

		<Grid Grid.Column="1" RowDefinitions="Auto,*,Auto" Margin="10,10,10,10">

			<!--  Header: connection row + folder/model row  -->
			<StackPanel Grid.Row="0" Spacing="8">
				<Grid ColumnDefinitions="Auto,*,Auto,Auto,Auto,Auto" ColumnSpacing="8">
					<Border Classes="pill" Classes.on="{Binding IsServerRunning}">
						<TextBlock Text="{Binding StatusText}" FontSize="12" VerticalAlignment="Center" />
					</Border>
					<TextBlock
						Grid.Column="2"
						Text="port"
						VerticalAlignment="Center"
						Opacity="0.6" />
					<TextBox Grid.Column="3" Width="80" Text="{Binding Port}" />
					<Button
						Grid.Column="4"
						Content="Start"
						Command="{Binding StartCommand}"
						IsEnabled="{Binding !IsServerRunning}" />
					<Button
						Grid.Column="5"
						Content="Stop"
						Command="{Binding StopCommand}"
						IsEnabled="{Binding IsServerRunning}" />
				</Grid>
				<Grid ColumnDefinitions="Auto,*,Auto,Auto,Auto,Auto,Auto" ColumnSpacing="8">
					<TextBlock Text="Working folder" VerticalAlignment="Center" Opacity="0.6" />
					<TextBox Grid.Column="1" Text="{Binding Folder}" />
					<Button Grid.Column="2" Content="Browse…" Click="OnBrowseClicked" />
					<CheckBox
						Grid.Column="3"
						Content="Auto-allow"
						IsChecked="{Binding AutoAllow}"
						VerticalAlignment="Center"
						ToolTip.Tip="Answer permission asks automatically with allow (once) instead of waiting for a click" />
					<TextBlock
						Grid.Column="4"
						Text="● working"
						VerticalAlignment="Center"
						Foreground="#FF6EC0FF"
						FontSize="12"
						IsVisible="{Binding IsBusy}" />
					<Button Grid.Column="5" Content="New chat" Command="{Binding NewChatCommand}" />
				</Grid>
			</StackPanel>

			<!--  Chat transcript  -->
			<Border
				Grid.Row="1"
				Margin="0,8,0,8"
				CornerRadius="10"
				Background="#FF171A21"
				Padding="8">
				<Grid>
					<ScrollViewer x:Name="ChatScroll" HorizontalScrollBarVisibility="Disabled">
						<StackPanel Margin="4">
							<ItemsControl ItemsSource="{Binding ChatItems}">
								<ItemsControl.DataTemplates>

									<DataTemplate DataType="{x:Type m:UserMessageItem}">
										<Border
											HorizontalAlignment="Right"
											CornerRadius="10"
											Background="#FF2B4C7E"
											Padding="10,7"
											MaxWidth="560"
											Margin="40,4,0,4">
											<Border.ContextMenu>
												<ContextMenu>
													<MenuItem Header="Copy" Click="OnCopyMessage" />
												</ContextMenu>
											</Border.ContextMenu>
											<StackPanel Spacing="2">
												<TextBlock Text="{Binding Text}" TextWrapping="Wrap" />
												<TextBlock Classes="msg-time" Text="{Binding TimeLabel}" />
											</StackPanel>
										</Border>
									</DataTemplate>

									<DataTemplate DataType="{x:Type m:AssistantTextItem}">
										<Border
											HorizontalAlignment="Left"
											CornerRadius="10"
											Background="#FF23262E"
											Padding="10,7"
											MaxWidth="640"
											Margin="0,4,40,4">
											<Border.ContextMenu>
												<ContextMenu>
													<MenuItem Header="Copy" Click="OnCopyMessage" />
												</ContextMenu>
											</Border.ContextMenu>
											<StackPanel Spacing="2">
												<c:MarkdownTextBlock Text="{Binding Text}" />
												<TextBlock Classes="msg-time" Text="{Binding TimeLabel}" />
											</StackPanel>
										</Border>
									</DataTemplate>

									<DataTemplate DataType="{x:Type m:ToolItem}">
										<StackPanel
											Orientation="Horizontal"
											Margin="4,2,40,2"
											Spacing="6"
											Background="Transparent">
											<StackPanel.ContextMenu>
												<ContextMenu>
													<MenuItem Header="Copy" Click="OnCopyMessage" />
												</ContextMenu>
											</StackPanel.ContextMenu>
											<Border CornerRadius="6" Padding="6,2" Background="#FF262B36">
												<TextBlock Text="{Binding Tool}" FontSize="11" />
											</Border>
											<TextBlock
												Text="{Binding Title}"
												Opacity="0.8"
												TextTrimming="CharacterEllipsis"
												MaxWidth="480"
												VerticalAlignment="Center" />
											<TextBlock
												Text="{Binding Status}"
												Opacity="0.5"
												FontSize="11"
												VerticalAlignment="Center" />
										</StackPanel>
									</DataTemplate>

									<DataTemplate DataType="{x:Type m:ImageItem}">
										<Border
											HorizontalAlignment="Left"
											CornerRadius="10"
											Background="#FF23262E"
											Padding="8"
											MaxWidth="380"
											Margin="0,4,40,4">
											<Border.ContextMenu>
												<ContextMenu>
													<MenuItem Header="Copy image" Click="OnCopyMessage" />
												</ContextMenu>
											</Border.ContextMenu>
											<StackPanel Spacing="3">
												<Image
													Source="{Binding Preview}"
													MaxWidth="360"
													MaxHeight="240"
													Stretch="Uniform"
													HorizontalAlignment="Left" />
												<StackPanel Orientation="Horizontal" Spacing="6">
													<TextBlock Text="{Binding FileName}" FontSize="11" Opacity="0.6" VerticalAlignment="Center" />
													<TextBlock Classes="msg-time" Text="{Binding TimeLabel}" VerticalAlignment="Center" />
												</StackPanel>
											</StackPanel>
										</Border>
									</DataTemplate>

									<DataTemplate DataType="{x:Type m:PermissionItem}">
										<Border
											HorizontalAlignment="Left"
											CornerRadius="10"
											Background="#FF33291A"
											BorderBrush="#FFD08B3C"
											BorderThickness="1"
											Padding="10,8"
											MaxWidth="640"
											Margin="0,6,40,6">
											<Border.ContextMenu>
												<ContextMenu>
													<MenuItem Header="Copy" Click="OnCopyMessage" />
												</ContextMenu>
											</Border.ContextMenu>
											<StackPanel Spacing="6">
												<TextBlock Text="{Binding Title}" FontWeight="SemiBold" />
												<TextBlock
													Text="{Binding Detail}"
													FontFamily="DejaVu Sans Mono, Consolas, monospace"
													FontSize="12"
													TextWrapping="Wrap"
													Foreground="#FFE8D9BC" />
												<StackPanel Orientation="Horizontal" Spacing="8" IsVisible="{Binding IsPending}">
													<Button Content="Allow" Command="{Binding AllowCommand}" />
													<Button Content="Always allow" Command="{Binding AllowAlwaysCommand}" />
													<Button Content="Deny" Command="{Binding DenyCommand}" />
												</StackPanel>
												<TextBlock
													Text="{Binding Answer}"
													IsVisible="{Binding !IsPending}"
													Opacity="0.85"
													FontStyle="Italic" />
											</StackPanel>
										</Border>
									</DataTemplate>

									<DataTemplate DataType="{x:Type m:SystemNoteItem}">
										<TextBlock
											Classes="note"
											Classes.error="{Binding IsError}"
											Text="{Binding Text}" />
									</DataTemplate>

								</ItemsControl.DataTemplates>
							</ItemsControl>
							<TextBlock
								HorizontalAlignment="Left"
								Margin="8,6,0,2"
								IsVisible="{Binding IsBusy}"
								Opacity="0.65"
								FontStyle="Italic"
								FontSize="12"
								Foreground="#FF6EC0FF"
								Text="● opencode is working…" />
						</StackPanel>
					</ScrollViewer>
					<TextBlock
						HorizontalAlignment="Center"
						VerticalAlignment="Center"
						IsVisible="{Binding !HasMessages}"
						Opacity="0.45"
						FontSize="13"
						TextWrapping="Wrap"
						TextAlignment="Center"
						Text="Start a new chat — ask opencode anything.&#x0a;Tool asks appear here as cards you can allow or deny." />
					<Button
						x:Name="JumpLatest"
						IsVisible="False"
						HorizontalAlignment="Right"
						VerticalAlignment="Bottom"
						Margin="0,0,8,8"
						Content="↓ Latest"
						Click="OnJumpLatestClicked"
						ToolTip.Tip="Jump to the latest message" />
				</Grid>
			</Border>

			<!--  Input row  -->
			<Border
				Grid.Row="2"
				CornerRadius="10"
				Background="#FF1E222B"
				BorderBrush="#FF2E333F"
				BorderThickness="1"
				Padding="8">
				<StackPanel Spacing="6">
					<ItemsControl ItemsSource="{Binding Attachments}" IsVisible="{Binding HasAttachments}">
						<ItemsControl.ItemsPanel>
							<ItemsPanelTemplate>
								<StackPanel Orientation="Horizontal" Spacing="6" />
							</ItemsPanelTemplate>
						</ItemsControl.ItemsPanel>
						<ItemsControl.ItemTemplate>
							<DataTemplate>
								<Border CornerRadius="8" Background="#FF262B36" Padding="4">
									<StackPanel>
										<Image Source="{Binding Preview}" Width="56" Height="56" Stretch="Uniform" />
										<Button
											Classes="icon"
											Content="✕"
											FontSize="10"
											HorizontalAlignment="Center"
											Command="{Binding $parent[ItemsControl].DataContext.RemoveAttachmentCommand}"
											CommandParameter="{Binding}"
											ToolTip.Tip="Remove attachment" />
									</StackPanel>
								</Border>
							</DataTemplate>
						</ItemsControl.ItemTemplate>
					</ItemsControl>
					<Grid ColumnDefinitions="Auto,Auto,*,Auto,Auto" ColumnSpacing="8">
						<ComboBox
							MinWidth="210"
							ItemsSource="{Binding Models}"
							SelectedItem="{Binding SelectedModel}"
							VerticalAlignment="Top"
							ToolTip.Tip="Model for the next message" />
						<ComboBox
							Grid.Column="1"
							MinWidth="96"
							ItemsSource="{Binding Variants}"
							SelectedItem="{Binding SelectedVariant}"
							VerticalAlignment="Top"
							IsEnabled="{Binding HasVariants}"
							ToolTip.Tip="Model variant (e.g. reasoning effort)" />
						<TextBox
							x:Name="InputBox"
							Grid.Column="2"
							Text="{Binding Input}"
							PlaceholderText="Ask opencode…  (Enter to send, Shift+Enter for a new line)"
							AcceptsReturn="True"
							VerticalContentAlignment="Top"
							MinHeight="52"
							IsEnabled="{Binding IsServerRunning}" />
						<StackPanel Grid.Column="3" Orientation="Horizontal" Spacing="6">
							<Button
								Classes="icon"
								Content="Paste"
								Click="OnPasteClicked"
								VerticalAlignment="Top"
								ToolTip.Tip="Paste an image from the clipboard (Ctrl+V in the box works too)" />
							<Button
								Content="Send"
								Command="{Binding SendCommand}"
								IsDefault="True"
								IsVisible="{Binding !IsBusy}"
								IsEnabled="{Binding IsServerRunning}" />
							<Button
								Content="Stop"
								Command="{Binding AbortCommand}"
								IsVisible="{Binding IsBusy}"
								IsEnabled="{Binding IsServerRunning}" />
						</StackPanel>
					</Grid>
				</StackPanel>
			</Border>
		</Grid>
	</Grid>
</suki:SukiWindow>
