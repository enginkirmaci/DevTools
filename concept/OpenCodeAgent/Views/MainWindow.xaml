<?xml version="1.0" encoding="utf-8" ?>
<suki:SukiWindow
	x:Class="OpenCodeAgent.Views.MainWindow"
	xmlns="https://github.com/avaloniaui"
	xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
	xmlns:c="using:OpenCodeAgent.Controls"
	xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
	xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
	xmlns:suki="https://github.com/kikipoulet/SukiUI"
	xmlns:v="using:OpenCodeAgent.Views"
	xmlns:vm="using:OpenCodeAgent.ViewModels"
	Title="opencode agent"
	Width="1180"
	Height="800"
	MinWidth="860"
	MinHeight="580"
	BackgroundStyle="Flat"
	WindowStartupLocation="CenterScreen"
	x:DataType="vm:MainViewModel"
	mc:Ignorable="d">

	<suki:SukiWindow.Styles>
		<Style Selector="Border.pill">
			<Setter Property="CornerRadius" Value="20" />
			<Setter Property="Padding" Value="11,4" />
			<Setter Property="Background" Value="{DynamicResource HairlineBrush}" />
		</Style>
		<Style Selector="Border.pill.on">
			<Setter Property="Background" Value="{DynamicResource SuccessDimBrush}" />
		</Style>
		<Style Selector="TextBlock.sidebar-hint">
			<Setter Property="Opacity" Value="0.5" />
			<Setter Property="FontSize" Value="12" />
			<Setter Property="FontStyle" Value="Italic" />
			<Setter Property="TextWrapping" Value="Wrap" />
			<Setter Property="TextAlignment" Value="Center" />
			<Setter Property="Margin" Value="4,8" />
		</Style>

		<!--  sidebar / panel rows draw their own hover + selection  -->
		<Style Selector="Border.row-card">
			<Setter Property="CornerRadius" Value="8" />
			<Setter Property="Padding" Value="8,6" />
			<Setter Property="Background" Value="Transparent" />
		</Style>
		<Style Selector="Border.row-card:pointerover">
			<Setter Property="Background" Value="{DynamicResource HoverBrush}" />
		</Style>
		<Style Selector="Border.row-card.selected">
			<Setter Property="Background" Value="{DynamicResource SelectedBrush}" />
		</Style>

		<Style Selector="TextBlock.task-done">
			<Setter Property="TextDecorations" Value="Strikethrough" />
			<Setter Property="Opacity" Value="0.45" />
		</Style>

		<!--  buttons  -->
		<Style Selector="Button.btn-soft">
			<Setter Property="Padding" Value="10,5" />
			<Setter Property="CornerRadius" Value="8" />
			<Setter Property="MinHeight" Value="30" />
		</Style>
	</suki:SukiWindow.Styles>

	<Grid ColumnDefinitions="250,*">

		<!--  Sidebar: workspaces + their chats  -->
		<Border
			Grid.Column="0"
			Margin="10,10,0,10"
			CornerRadius="12"
			Background="{DynamicResource SurfaceBrush}"
			Padding="10">
			<Grid RowDefinitions="Auto,Auto,Auto,Auto,*,Auto">
				<Grid Margin="2,2,2,4" ColumnDefinitions="*,Auto">
					<TextBlock
						Text="Workspaces"
						FontWeight="SemiBold"
						FontSize="13"
						VerticalAlignment="Center" />
					<Button
						Grid.Column="1"
						Classes="icon"
						Click="OnAddWorkspaceClicked"
						ToolTip.Tip="Add a workspace folder">
						<PathIcon Data="{StaticResource IconPlus}" Width="14" Height="14" />
					</Button>
				</Grid>
				<ListBox
					Grid.Row="1"
					ItemsSource="{Binding Workspaces}"
					SelectedItem="{Binding SelectedWorkspace}"
					MaxHeight="150"
					Background="Transparent">
					<ListBox.ItemTemplate>
						<DataTemplate>
							<Border
								Classes="row-card"
								Classes.selected="{Binding $parent[ListBoxItem].IsSelected}"
								ToolTip.Tip="{Binding FolderPath}">
								<Border.ContextMenu>
									<ContextMenu>
										<MenuItem Header="Start server" Click="OnWorkspaceStartClick" IsVisible="{Binding !IsRunning}" />
										<MenuItem Header="Stop server" Click="OnWorkspaceStopClick" IsVisible="{Binding IsRunning}" />
										<MenuItem Header="Remove workspace" Click="OnWorkspaceRemoveClick" />
									</ContextMenu>
								</Border.ContextMenu>
								<StackPanel Orientation="Horizontal" Spacing="7">
									<PathIcon
										Data="{StaticResource IconFolder}"
										Width="13"
										Height="13"
										Foreground="{DynamicResource TextMutedBrush}"
										VerticalAlignment="Center" />
									<TextBlock
										Text="{Binding Name}"
										TextTrimming="CharacterEllipsis"
										FontSize="12.5"
										VerticalAlignment="Center" />
									<Ellipse
										Width="6"
										Height="6"
										Fill="{DynamicResource SuccessBrush}"
										VerticalAlignment="Center"
										IsVisible="{Binding IsRunning}" />
								</StackPanel>
							</Border>
						</DataTemplate>
					</ListBox.ItemTemplate>
				</ListBox>
				<Separator Grid.Row="2" Margin="0,6" />
				<Grid Grid.Row="3" Margin="2,0,2,8" ColumnDefinitions="*,Auto">
					<TextBlock
						Text="Chats"
						FontWeight="SemiBold"
						FontSize="13"
						VerticalAlignment="Center" />
					<Button
						Grid.Column="1"
						Classes="icon"
						Command="{Binding NewChatCommand}"
						IsEnabled="{Binding IsServerRunning}"
						ToolTip.Tip="New chat">
						<PathIcon Data="{StaticResource IconPlus}" Width="14" Height="14" />
					</Button>
				</Grid>
				<ListBox
					Grid.Row="4"
					ItemsSource="{Binding Sessions}"
					SelectedItem="{Binding SelectedSession}"
					Background="Transparent">
					<ListBox.ItemTemplate>
						<DataTemplate>
							<Border
								Classes="row-card"
								Classes.selected="{Binding $parent[ListBoxItem].IsSelected}"
								Margin="0,1">
								<Border.ContextMenu>
									<ContextMenu>
										<MenuItem Header="Pin" Click="OnPinClick" IsVisible="{Binding !IsPinned}" />
										<MenuItem Header="Unpin" Click="OnUnpinClick" IsVisible="{Binding IsPinned}" />
										<MenuItem Header="Rename" Click="OnRenameClick" />
										<MenuItem Header="Copy share link" Click="OnShareClick" />
										<MenuItem Header="Stop sharing" Click="OnUnshareClick" />
										<MenuItem Header="Remove from workspace" Click="OnUnlinkClick" />
										<MenuItem Header="Delete" Click="OnDeleteClick" />
									</ContextMenu>
								</Border.ContextMenu>
								<StackPanel>
									<StackPanel Orientation="Horizontal" Spacing="5">
										<PathIcon
											Data="{StaticResource IconPin}"
											Width="11"
											Height="11"
											Foreground="{DynamicResource AccentBrush}"
											VerticalAlignment="Center"
											IsVisible="{Binding IsPinned}" />
										<TextBlock
											Text="{Binding Title}"
											TextTrimming="CharacterEllipsis"
											FontSize="12.5"
											IsVisible="{Binding !IsEditing}" />
										<TextBox
											Text="{Binding DraftTitle}"
											IsVisible="{Binding IsEditing}"
											KeyDown="OnRenameKeyDown"
											LostFocus="OnRenameLostFocus" />
									</StackPanel>
									<TextBlock
										Text="{Binding UpdatedLabel}"
										FontSize="10.5"
										Opacity="0.45"
										Margin="0,1,0,0" />
								</StackPanel>
							</Border>
						</DataTemplate>
					</ListBox.ItemTemplate>
				</ListBox>
				<StackPanel Grid.Row="5">
					<TextBlock
						Classes="sidebar-hint"
						IsVisible="{Binding HasNoWorkspace}"
						Text="Add a workspace folder to begin." />
					<TextBlock
						Classes="sidebar-hint"
						IsVisible="{Binding HasIdleWorkspace}"
						Text="Start the server to load your chats." />
					<TextBlock
						Classes="sidebar-hint"
						IsVisible="{Binding HasSessionsHint}"
						Text="No chats yet for this workspace." />
				</StackPanel>
			</Grid>
		</Border>

		<Grid Grid.Column="1" Margin="10,10,10,10">
			<Grid ColumnDefinitions="*,Auto">
				<Grid RowDefinitions="Auto,*">

					<!--  Header: connection row + workspace row  -->
					<StackPanel Grid.Row="0" Spacing="8">
						<Grid ColumnDefinitions="Auto,Auto,Auto,*,Auto,Auto" ColumnSpacing="8">
							<Border Classes="pill" Classes.on="{Binding IsServerRunning}">
								<TextBlock Text="{Binding StatusText}" FontSize="12" VerticalAlignment="Center" />
							</Border>
							<Button
								Grid.Column="1"
								Classes="btn-soft"
								Command="{Binding StartWorkspaceCommand}"
								CommandParameter="{Binding SelectedWorkspace}"
								IsEnabled="{Binding CanStartSelected}"
								ToolTip.Tip="Start the workspace server">
								<StackPanel Orientation="Horizontal" Spacing="6">
									<PathIcon Data="{StaticResource IconPlay}" Width="11" Height="11" />
									<TextBlock Text="Start" VerticalAlignment="Center" />
								</StackPanel>
							</Button>
							<Button
								Grid.Column="2"
								Classes="btn-soft"
								Command="{Binding StopWorkspaceCommand}"
								CommandParameter="{Binding SelectedWorkspace}"
								IsEnabled="{Binding CanStopSelected}"
								ToolTip.Tip="Stop the workspace server">
								<StackPanel Orientation="Horizontal" Spacing="6">
									<PathIcon Data="{StaticResource IconStop}" Width="11" Height="11" />
									<TextBlock Text="Stop" VerticalAlignment="Center" />
								</StackPanel>
							</Button>
							<StackPanel
								Grid.Column="4"
								Orientation="Horizontal"
								Spacing="6"
								VerticalAlignment="Center"
								IsVisible="{Binding AnyBusy}">
								<Ellipse Classes="pulse" />
								<Ellipse Classes="pulse d2" />
								<Ellipse Classes="pulse d3" />
								<TextBlock
									Text="{Binding WorkingLabel}"
									FontSize="12"
									Foreground="{DynamicResource AccentBrush}"
									VerticalAlignment="Center" />
							</StackPanel>
							<Button
								Grid.Column="5"
								Classes="icon"
								Command="{Binding NewChatCommand}"
								ToolTip.Tip="New chat">
								<PathIcon Data="{StaticResource IconPlus}" Width="15" Height="15" />
							</Button>
						</Grid>
						<Grid ColumnDefinitions="Auto,*,Auto,Auto,Auto,Auto,Auto,Auto" ColumnSpacing="8">
							<PathIcon
								Data="{StaticResource IconFolder}"
								Width="14"
								Height="14"
								Foreground="{DynamicResource TextMutedBrush}"
								VerticalAlignment="Center" />
							<TextBlock
								Grid.Column="1"
								Text="{Binding WorkspacePathLabel}"
								VerticalAlignment="Center"
								TextTrimming="CharacterEllipsis"
								Opacity="0.8" />
							<CheckBox
								Grid.Column="2"
								Content="Auto-allow"
								IsChecked="{Binding AutoAllow}"
								VerticalAlignment="Center"
								ToolTip.Tip="Answer permission asks automatically with always-allow instead of waiting for a click" />
							<Border
								Grid.Column="3"
								Classes="pill"
								IsVisible="{Binding FocusedTile.HasContext}"
								VerticalAlignment="Center"
								ToolTip.Tip="Context usage of the focused chat's last assistant turn">
								<TextBlock Text="{Binding FocusedTile.ContextText}" FontSize="11" VerticalAlignment="Center" />
							</Border>
							<Button
								Grid.Column="4"
								Classes="btn-soft"
								IsVisible="{Binding FocusedTile.HasChanges}"
								ToolTip.Tip="Files the focused chat touched — click a row for its diff">
								<Button.Flyout>
									<Flyout Placement="BottomEdgeAlignedLeft">
										<Border MaxWidth="620" MaxHeight="420">
											<ScrollViewer HorizontalScrollBarVisibility="Disabled">
												<ItemsControl ItemsSource="{Binding FocusedTile.Changes}" Margin="4">
													<ItemsControl.ItemTemplate>
														<DataTemplate>
															<Expander Classes="disclose" Margin="0,2" HorizontalAlignment="Stretch" HorizontalContentAlignment="Stretch">
																<Expander.Header>
																	<Grid ColumnDefinitions="*,Auto,Auto,Auto" ColumnSpacing="10" Margin="0,2">
																		<TextBlock Text="{Binding Name}" TextTrimming="CharacterEllipsis" MaxWidth="300" VerticalAlignment="Center" ToolTip.Tip="{Binding FilePath}" />
																		<TextBlock Grid.Column="1" Text="+" FontSize="11" Opacity="0.5" VerticalAlignment="Center" />
																		<TextBlock Grid.Column="2" Text="{Binding Additions}" Foreground="{DynamicResource AddBrush}" FontSize="11" VerticalAlignment="Center" />
																		<TextBlock Grid.Column="3" Text="{Binding Deletions}" Foreground="{DynamicResource DelBrush}" FontSize="11" VerticalAlignment="Center" />
																	</Grid>
																</Expander.Header>
																<Border
																	Background="{DynamicResource DiffBgBrush}"
																	CornerRadius="8"
																	Padding="9,7"
																	HorizontalAlignment="Stretch">
																	<c:DiffTextBlock Text="{Binding Patch}" />
																</Border>
															</Expander>
														</DataTemplate>
													</ItemsControl.ItemTemplate>
												</ItemsControl>
											</ScrollViewer>
										</Border>
									</Flyout>
								</Button.Flyout>
								<TextBlock Text="Changes" VerticalAlignment="Center" />
							</Button>
							<Button
								Grid.Column="5"
								Classes="btn-soft"
								Command="{Binding UndoCommand}"
								ToolTip.Tip="Revert the focused chat's last turn (restores the files it changed)">
								<TextBlock Text="Undo" VerticalAlignment="Center" />
							</Button>
							<Button
								Grid.Column="6"
								Classes="btn-soft"
								Command="{Binding RedoCommand}"
								IsEnabled="{Binding FocusedTile.CanRedo}"
								ToolTip.Tip="Re-apply the reverted turn">
								<TextBlock Text="Redo" VerticalAlignment="Center" />
							</Button>
							<Button
								Grid.Column="7"
								Classes="btn-soft"
								Command="{Binding CompactCommand}"
								ToolTip.Tip="Summarize the focused chat to free context (POST /session/{id}/summarize)">
								<TextBlock Text="Compact" VerticalAlignment="Center" />
							</Button>
						</Grid>
					</StackPanel>

					<!--  Tile grid: every open chat is one tile  -->
					<Grid Grid.Row="1" Margin="0,8,0,0">
						<ItemsControl ItemsSource="{Binding OpenTiles}">
							<ItemsControl.ItemsPanel>
								<ItemsPanelTemplate>
									<UniformGrid Columns="{Binding TileColumns}" />
								</ItemsPanelTemplate>
							</ItemsControl.ItemsPanel>
							<ItemsControl.ItemTemplate>
								<DataTemplate>
									<v:ChatTile Margin="4" />
								</DataTemplate>
							</ItemsControl.ItemTemplate>
						</ItemsControl>
						<StackPanel
							HorizontalAlignment="Center"
							VerticalAlignment="Center"
							IsVisible="{Binding HasNoTiles}">
							<TextBlock
								Classes="sidebar-hint"
								IsVisible="{Binding HasNoWorkspace}"
								Text="Add a workspace folder to begin." />
							<TextBlock
								Classes="sidebar-hint"
								IsVisible="{Binding HasIdleWorkspace}"
								Text="Start the server to load your chats." />
						</StackPanel>
					</Grid>
				</Grid>

				<!--  Side panel: focused chat's tasks + running agents (titles only)  -->
				<Border
					Grid.Column="1"
					Width="264"
					Margin="8,0,0,0"
					CornerRadius="12"
					Background="{DynamicResource SurfaceBrush}"
					Padding="10"
					IsVisible="{Binding HasSidePanel}">
					<ScrollViewer HorizontalScrollBarVisibility="Disabled">
						<StackPanel Spacing="12">
							<StackPanel IsVisible="{Binding FocusedTile.HasTasks}" Spacing="2">
								<TextBlock Text="Tasks" FontWeight="SemiBold" FontSize="13" Margin="2,0,0,4" />
								<ItemsControl ItemsSource="{Binding FocusedTile.Tasks}">
									<ItemsControl.ItemTemplate>
										<DataTemplate>
											<StackPanel Orientation="Horizontal" Spacing="8" Margin="2,3">
												<PathIcon
													Data="{StaticResource IconCircle}"
													Width="12"
													Height="12"
													Foreground="{DynamicResource TextMutedBrush}"
													VerticalAlignment="Top"
													Margin="0,3,0,0"
													IsVisible="{Binding Pending}" />
												<PathIcon
													Data="{StaticResource IconPlay}"
													Width="11"
													Height="11"
													Foreground="{DynamicResource AccentBrush}"
													VerticalAlignment="Top"
													Margin="0,3,0,0"
													IsVisible="{Binding InProgress}" />
												<PathIcon
													Data="{StaticResource IconCheck}"
													Width="12"
													Height="12"
													Foreground="{DynamicResource SuccessBrush}"
													VerticalAlignment="Top"
													Margin="0,3,0,0"
													IsVisible="{Binding Completed}" />
												<PathIcon
													Data="{StaticResource IconDash}"
													Width="12"
													Height="12"
													Foreground="{DynamicResource TextMutedBrush}"
													VerticalAlignment="Top"
													Margin="0,3,0,0"
													IsVisible="{Binding Cancelled}" />
												<TextBlock Text="{Binding Content}" TextWrapping="Wrap" FontSize="12.5" Classes.task-done="{Binding Done}" />
											</StackPanel>
										</DataTemplate>
									</ItemsControl.ItemTemplate>
								</ItemsControl>
							</StackPanel>
							<StackPanel IsVisible="{Binding HasRunningAgents}" Spacing="2">
								<TextBlock Text="Running agents" FontWeight="SemiBold" FontSize="13" Margin="2,0,0,4" />
								<ItemsControl ItemsSource="{Binding RunningAgents}">
									<ItemsControl.ItemTemplate>
										<DataTemplate>
											<StackPanel Orientation="Horizontal" Spacing="7" Margin="2,3">
												<Ellipse Classes="pulse" VerticalAlignment="Center" />
												<PathIcon
													Data="{StaticResource IconWarn}"
													Width="13"
													Height="13"
													Foreground="{DynamicResource WarnBrush}"
													VerticalAlignment="Center"
													IsVisible="{Binding NeedsAttention}"
													ToolTip.Tip="Waiting for a permission answer" />
												<StackPanel
													VerticalAlignment="Center"
													Background="Transparent"
													Cursor="Hand"
													Tapped="OnRunningClick"
													ToolTip.Tip="Open this chat">
													<TextBlock
														Text="{Binding Title}"
														TextTrimming="CharacterEllipsis"
														MaxWidth="180"
														FontSize="12.5" />
													<TextBlock
														Text="{Binding Workspace}"
														FontSize="10"
														Opacity="0.5"
														IsVisible="{Binding $parent[ItemsControl].DataContext.MultipleWorkspaces}" />
												</StackPanel>
												<Button
													Classes="icon"
													Command="{Binding $parent[ItemsControl].DataContext.StopRunningCommand}"
													CommandParameter="{Binding SessionId}"
													VerticalAlignment="Center"
													ToolTip.Tip="Stop this agent">
													<PathIcon Data="{StaticResource IconStop}" Width="11" Height="11" />
												</Button>
											</StackPanel>
										</DataTemplate>
									</ItemsControl.ItemTemplate>
								</ItemsControl>
							</StackPanel>
						</StackPanel>
					</ScrollViewer>
				</Border>
			</Grid>
		</Grid>
	</Grid>
</suki:SukiWindow>
