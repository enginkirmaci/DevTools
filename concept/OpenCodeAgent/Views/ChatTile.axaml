<?xml version="1.0" encoding="utf-8" ?>
<UserControl
	x:Class="OpenCodeAgent.Views.ChatTile"
	xmlns="https://github.com/avaloniaui"
	xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
	xmlns:c="using:OpenCodeAgent.Controls"
	xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
	xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
	xmlns:m="using:OpenCodeAgent.Models"
	xmlns:vm="using:OpenCodeAgent.ViewModels"
	x:DataType="vm:ChatTileViewModel"
	mc:Ignorable="d">

	<UserControl.Styles>
		<Style Selector="Border.tile-root">
			<Setter Property="CornerRadius" Value="12" />
			<Setter Property="Background" Value="{DynamicResource CardBrush}" />
			<Setter Property="BorderThickness" Value="1" />
			<Setter Property="BorderBrush" Value="{DynamicResource HairlineBrush}" />
		</Style>
		<Style Selector="Border.tile-root.focused">
			<Setter Property="BorderBrush" Value="{DynamicResource AccentBrush}" />
		</Style>

		<Style Selector="TextBlock.note">
			<Setter Property="Opacity" Value="0.55" />
			<Setter Property="FontStyle" Value="Italic" />
			<Setter Property="FontSize" Value="12" />
			<Setter Property="HorizontalAlignment" Value="Center" />
			<Setter Property="Margin" Value="0,3" />
			<Setter Property="TextWrapping" Value="Wrap" />
		</Style>
		<Style Selector="TextBlock.note.error">
			<Setter Property="Opacity" Value="1" />
			<Setter Property="Foreground" Value="{DynamicResource DangerBrush}" />
			<Setter Property="HorizontalAlignment" Value="Left" />
			<Setter Property="FontFamily" Value="{StaticResource CodeFont}" />
			<Setter Property="FontSize" Value="11.5" />
			<Setter Property="Margin" Value="8,3" />
		</Style>
		<Style Selector="TextBlock.tool-error">
			<Setter Property="Foreground" Value="{DynamicResource DangerBrush}" />
			<Setter Property="FontSize" Value="11.5" />
		</Style>
		<Style Selector="TextBlock.mono-detail">
			<Setter Property="FontFamily" Value="{StaticResource CodeFont}" />
			<Setter Property="FontSize" Value="11.5" />
			<Setter Property="TextWrapping" Value="Wrap" />
			<Setter Property="Opacity" Value="0.75" />
		</Style>
		<Style Selector="TextBlock.msg-time">
			<Setter Property="FontSize" Value="10.5" />
			<Setter Property="Opacity" Value="0.55" />
			<Setter Property="HorizontalAlignment" Value="Right" />
			<Setter Property="VerticalAlignment" Value="Center" />
		</Style>

		<!--  hover-revealed copy on message bubbles  -->
		<Style Selector="Button.msg-copy">
			<Setter Property="Opacity" Value="0" />
			<Setter Property="Background" Value="Transparent" />
			<Setter Property="Padding" Value="3" />
		</Style>
		<Style Selector="Border.msg-surface:pointerover Button.msg-copy">
			<Setter Property="Opacity" Value="1" />
		</Style>

		<!--  markdown code-block copy affordance  -->
		<Style Selector="Button.code-copy">
			<Setter Property="Opacity" Value="0" />
			<Setter Property="Background" Value="Transparent" />
			<Setter Property="Padding" Value="3" />
		</Style>
		<Style Selector="Border.code-block:pointerover Button.code-copy">
			<Setter Property="Opacity" Value="1" />
		</Style>

		<!--  status dots  -->
		<Style Selector="Ellipse.tool-dot">
			<Setter Property="Width" Value="7" />
			<Setter Property="Height" Value="7" />
			<Setter Property="Fill" Value="{DynamicResource TextMutedBrush}" />
			<Setter Property="VerticalAlignment" Value="Center" />
		</Style>
		<Style Selector="Ellipse.tool-dot.running">
			<Setter Property="Fill" Value="{DynamicResource AccentBrush}" />
			<Style.Animations>
				<Animation Duration="0:0:1.1" IterationCount="Infinite">
					<KeyFrame Cue="0%"><Setter Property="Opacity" Value="0.25" /></KeyFrame>
					<KeyFrame Cue="35%"><Setter Property="Opacity" Value="1" /></KeyFrame>
					<KeyFrame Cue="70%"><Setter Property="Opacity" Value="0.25" /></KeyFrame>
				</Animation>
			</Style.Animations>
		</Style>
		<Style Selector="Ellipse.tool-dot.completed">
			<Setter Property="Fill" Value="{DynamicResource SuccessBrush}" />
		</Style>
		<Style Selector="Ellipse.tool-dot.error">
			<Setter Property="Fill" Value="{DynamicResource DangerBrush}" />
		</Style>

		<!--  buttons  -->
		<Style Selector="Button.btn-send">
			<Setter Property="Width" Value="38" />
			<Setter Property="Height" Value="38" />
			<Setter Property="Padding" Value="0" />
			<Setter Property="CornerRadius" Value="19" />
			<Setter Property="Background" Value="{DynamicResource AccentBrush}" />
			<Setter Property="Foreground" Value="#FF0E1116" />
		</Style>
		<Style Selector="Button.btn-queue">
			<Setter Property="Width" Value="38" />
			<Setter Property="Height" Value="38" />
			<Setter Property="Padding" Value="0" />
			<Setter Property="CornerRadius" Value="19" />
		</Style>
		<Style Selector="Button.btn-stop">
			<Setter Property="Width" Value="38" />
			<Setter Property="Height" Value="38" />
			<Setter Property="Padding" Value="0" />
			<Setter Property="CornerRadius" Value="19" />
			<Setter Property="Background" Value="{DynamicResource DangerDimBrush}" />
			<Setter Property="Foreground" Value="{DynamicResource DangerBrush}" />
		</Style>
		<Style Selector="Button.btn-allow">
			<Setter Property="Background" Value="{DynamicResource AccentBrush}" />
			<Setter Property="Foreground" Value="#FF0E1116" />
			<Setter Property="CornerRadius" Value="7" />
			<Setter Property="Padding" Value="11,4" />
			<Setter Property="FontSize" Value="12" />
			<Setter Property="FontWeight" Value="SemiBold" />
		</Style>
		<Style Selector="Button.btn-soft-accent">
			<Setter Property="Background" Value="{DynamicResource AccentDimBrush}" />
			<Setter Property="Foreground" Value="{DynamicResource AccentBrush}" />
			<Setter Property="CornerRadius" Value="7" />
			<Setter Property="Padding" Value="11,4" />
			<Setter Property="FontSize" Value="12" />
		</Style>
		<Style Selector="Button.btn-deny">
			<Setter Property="Background" Value="{DynamicResource DangerDimBrush}" />
			<Setter Property="Foreground" Value="{DynamicResource DangerBrush}" />
			<Setter Property="CornerRadius" Value="7" />
			<Setter Property="Padding" Value="11,4" />
			<Setter Property="FontSize" Value="12" />
		</Style>
		<Style Selector="Button.example-chip">
			<Setter Property="Background" Value="{DynamicResource ChipBrush}" />
			<Setter Property="CornerRadius" Value="16" />
			<Setter Property="Padding" Value="12,6" />
			<Setter Property="FontSize" Value="12" />
		</Style>
		<Style Selector="Button.example-chip:pointerover">
			<Setter Property="Background" Value="{DynamicResource AccentDimBrush}" />
		</Style>
		<Style Selector="Button.jump-btn">
			<Setter Property="Background" Value="{DynamicResource ChipBrush}" />
			<Setter Property="BorderBrush" Value="{DynamicResource HairlineBrush}" />
			<Setter Property="BorderThickness" Value="1" />
			<Setter Property="CornerRadius" Value="16" />
			<Setter Property="Padding" Value="11,6" />
			<Setter Property="FontSize" Value="12" />
		</Style>

		<!--  composer focus ring  -->
		<Style Selector="Border.input-card">
			<Setter Property="BorderBrush" Value="{DynamicResource HairlineBrush}" />
		</Style>
		<Style Selector="Border.input-card:focus-within">
			<Setter Property="BorderBrush" Value="{DynamicResource AccentBrush}" />
		</Style>
	</UserControl.Styles>

	<Border
		Classes="tile-root"
		Classes.focused="{Binding IsFocused}"
		Tapped="OnTileTapped">
		<Grid RowDefinitions="Auto,*,Auto">

			<!--  tile header  -->
			<Grid Grid.Row="0" Margin="10,7,7,0" ColumnDefinitions="Auto,*,Auto">
				<Ellipse Classes="pulse" VerticalAlignment="Center" IsVisible="{Binding IsBusy}" />
				<TextBlock
					Grid.Column="1"
					Text="{Binding Title}"
					Margin="7,0,0,0"
					FontSize="12.5"
					FontWeight="SemiBold"
					VerticalAlignment="Center"
					TextTrimming="CharacterEllipsis"
					ToolTip.Tip="{Binding Title}" />
				<Button
					Grid.Column="2"
					Classes="icon"
					Command="{Binding CloseCommand}"
					ToolTip.Tip="Close this tile — the chat stays in the sidebar and keeps running">
					<PathIcon Data="{StaticResource IconClose}" Width="11" Height="11" />
				</Button>
			</Grid>

			<!--  transcript  -->
			<Grid Grid.Row="1" Margin="4,2,4,4">
				<ScrollViewer x:Name="ChatScroll" HorizontalScrollBarVisibility="Disabled">
					<StackPanel Margin="4">
						<ItemsControl ItemsSource="{Binding ChatItems}">
							<ItemsControl.DataTemplates>

								<DataTemplate DataType="{x:Type m:UserMessageItem}">
									<Border
										Classes="msg-surface"
										HorizontalAlignment="Right"
										CornerRadius="12"
										Background="{DynamicResource BubbleUserBrush}"
										Padding="11,8"
										MaxWidth="560"
										Margin="40,4,0,4">
										<Border.ContextMenu>
											<ContextMenu>
												<MenuItem Header="Copy" Click="OnCopyMessage" />
												<MenuItem Header="Edit in input" Click="OnEditMessageClick" />
											</ContextMenu>
										</Border.ContextMenu>
										<StackPanel Spacing="2">
											<TextBlock Text="{Binding Text}" TextWrapping="Wrap" FontSize="13" LineHeight="19" />
											<StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Spacing="2">
												<Button
													Classes="icon msg-copy"
													Click="OnCopyMessage"
													ToolTip.Tip="Copy">
													<PathIcon Data="{StaticResource IconCopy}" Width="12" Height="12" />
												</Button>
												<TextBlock Classes="msg-time" Text="{Binding TimeLabel}" />
											</StackPanel>
										</StackPanel>
									</Border>
								</DataTemplate>

								<DataTemplate DataType="{x:Type m:QueuedMessageItem}">
									<Border
										HorizontalAlignment="Right"
										CornerRadius="12"
										Background="{DynamicResource BubbleQueuedBrush}"
										Padding="11,8"
										MaxWidth="560"
										Margin="40,4,0,4"
										BorderBrush="{DynamicResource QueuedBorderBrush}"
										BorderThickness="1"
										ToolTip.Tip="Queued — sent when the current turn finishes">
										<StackPanel Orientation="Horizontal" Spacing="8">
											<PathIcon
												Data="{StaticResource IconClock}"
												Width="13"
												Height="13"
												Opacity="0.7"
												VerticalAlignment="Center" />
											<TextBlock Text="{Binding Text}" TextWrapping="Wrap" MaxWidth="440" FontSize="13" VerticalAlignment="Center" />
											<TextBlock
												Text="{Binding ImageCount}"
												FontSize="11"
												Opacity="0.6"
												VerticalAlignment="Center"
												IsVisible="{Binding HasImages}" />
											<Button
												Classes="icon"
												Command="{Binding RemoveSelfCommand}"
												VerticalAlignment="Center"
												ToolTip.Tip="Remove from queue">
												<PathIcon Data="{StaticResource IconClose}" Width="11" Height="11" />
											</Button>
										</StackPanel>
									</Border>
								</DataTemplate>

								<DataTemplate DataType="{x:Type m:AssistantTextItem}">
									<Border
										Classes="msg-surface"
										HorizontalAlignment="Left"
										CornerRadius="12"
										Background="{DynamicResource BubbleAssistantBrush}"
										BorderBrush="{DynamicResource HairlineBrush}"
										BorderThickness="1"
										Padding="11,8"
										MaxWidth="640"
										Margin="0,4,40,4">
										<Border.ContextMenu>
											<ContextMenu>
												<MenuItem Header="Copy" Click="OnCopyMessage" />
											</ContextMenu>
										</Border.ContextMenu>
										<StackPanel Spacing="2">
											<c:MarkdownTextBlock Text="{Binding Text}" />
											<StackPanel Orientation="Horizontal" Spacing="2" HorizontalAlignment="Right">
												<Button
													Classes="icon msg-copy"
													Click="OnCopyMessage"
													ToolTip.Tip="Copy">
													<PathIcon Data="{StaticResource IconCopy}" Width="12" Height="12" />
												</Button>
												<TextBlock Classes="msg-time" Text="{Binding MetaLabel}" />
												<TextBlock Classes="msg-time" Text="{Binding TimeLabel}" />
											</StackPanel>
										</StackPanel>
									</Border>
								</DataTemplate>

								<DataTemplate DataType="{x:Type m:ReasoningItem}">
									<Expander IsExpanded="False" HorizontalAlignment="Left" MaxWidth="640" Margin="4,2,40,2">
										<Expander.Header>
											<StackPanel Orientation="Horizontal" Spacing="6">
												<PathIcon
													Data="{StaticResource IconBulb}"
													Width="12"
													Height="12"
													Foreground="{DynamicResource TextMutedBrush}"
													VerticalAlignment="Center" />
												<TextBlock Text="thinking" FontStyle="Italic" Opacity="0.5" FontSize="11.5" />
											</StackPanel>
										</Expander.Header>
										<TextBlock Text="{Binding Text}" FontStyle="Italic" Opacity="0.65" FontSize="12" TextWrapping="Wrap" />
									</Expander>
								</DataTemplate>

								<DataTemplate DataType="{x:Type m:ToolItem}">
									<StackPanel Margin="4,3,40,3" Spacing="3">
										<StackPanel.ContextMenu>
											<ContextMenu>
												<MenuItem Header="Copy" Click="OnCopyMessage" />
											</ContextMenu>
										</StackPanel.ContextMenu>
										<StackPanel Orientation="Horizontal" Spacing="7" Background="Transparent" VerticalAlignment="Center">
											<Ellipse
												Classes="tool-dot"
												Classes.running="{Binding IsRunning}"
												Classes.completed="{Binding IsCompleted}"
												Classes.error="{Binding IsError}" />
											<Border CornerRadius="6" Padding="6,2" Background="{DynamicResource ChipBrush}">
												<TextBlock Text="{Binding Tool}" FontSize="11" FontFamily="{StaticResource CodeFont}" />
											</Border>
											<TextBlock
												Text="{Binding Title}"
												Opacity="0.8"
												TextTrimming="CharacterEllipsis"
												MaxWidth="440"
												FontSize="12.5"
												VerticalAlignment="Center" />
											<TextBlock
												Text="{Binding Status}"
												Opacity="0.5"
												FontSize="11"
												VerticalAlignment="Center" />
										</StackPanel>
										<TextBlock
											Classes="tool-error"
											Text="{Binding ErrorPreview}"
											IsVisible="{Binding IsError}"
											MaxWidth="520"
											HorizontalAlignment="Left"
											TextTrimming="CharacterEllipsis"
											ToolTip.Tip="{Binding ErrorPreview}" />
										<Expander IsVisible="{Binding HasDiff}" IsExpanded="False" HorizontalAlignment="Stretch" HorizontalContentAlignment="Stretch" MaxWidth="560">
											<Expander.Header>
												<StackPanel Orientation="Horizontal" Spacing="8">
													<TextBlock Text="Changes" FontSize="11" Opacity="0.6" />
													<StackPanel Orientation="Horizontal" Spacing="2" IsVisible="{Binding HasNumstat}">
														<TextBlock Text="{Binding Additions}" Foreground="{DynamicResource AddBrush}" FontSize="11" />
														<TextBlock Text="{Binding Deletions}" Foreground="{DynamicResource DelBrush}" FontSize="11" />
													</StackPanel>
												</StackPanel>
											</Expander.Header>
											<Border Background="{DynamicResource DiffBgBrush}" CornerRadius="8" Padding="9,7" HorizontalAlignment="Stretch">
												<c:DiffTextBlock Text="{Binding FileDiff}" />
											</Border>
										</Expander>
										<Expander IsVisible="{Binding HasDetails}" IsExpanded="False" HorizontalAlignment="Left" MaxWidth="560">
											<Expander.Header>
												<TextBlock Text="details" FontSize="11" Opacity="0.5" />
											</Expander.Header>
											<ScrollViewer MaxHeight="260" HorizontalScrollBarVisibility="Disabled">
												<TextBlock Classes="mono-detail" Text="{Binding Details}" />
											</ScrollViewer>
										</Expander>
									</StackPanel>
								</DataTemplate>

								<DataTemplate DataType="{x:Type m:ImageItem}">
									<Border
										Classes="msg-surface"
										HorizontalAlignment="Left"
										CornerRadius="12"
										Background="{DynamicResource BubbleAssistantBrush}"
										BorderBrush="{DynamicResource HairlineBrush}"
										BorderThickness="1"
										Padding="8"
										MaxWidth="380"
										Margin="0,4,40,4">
										<Border.ContextMenu>
											<ContextMenu>
												<MenuItem Header="Copy image" Click="OnCopyMessage" />
											</ContextMenu>
										</Border.ContextMenu>
										<StackPanel Spacing="3">
											<Image
												Source="{Binding Preview}"
												MaxWidth="360"
												MaxHeight="240"
												Stretch="Uniform"
												HorizontalAlignment="Left" />
											<StackPanel Orientation="Horizontal" Spacing="6">
												<TextBlock Text="{Binding FileName}" FontSize="11" Opacity="0.6" VerticalAlignment="Center" />
												<TextBlock Classes="msg-time" Text="{Binding TimeLabel}" VerticalAlignment="Center" />
											</StackPanel>
										</StackPanel>
									</Border>
								</DataTemplate>

								<DataTemplate DataType="{x:Type m:PermissionItem}">
									<Border
										HorizontalAlignment="Left"
										CornerRadius="10"
										Background="{DynamicResource WarnBgBrush}"
										MaxWidth="640"
										Margin="0,4,40,4">
										<Border.ContextMenu>
											<ContextMenu>
												<MenuItem Header="Copy" Click="OnCopyMessage" />
											</ContextMenu>
										</Border.ContextMenu>
										<Grid ColumnDefinitions="Auto,*">
											<Border
												Width="3"
												Margin="6,8"
												CornerRadius="2"
												Background="{DynamicResource WarnBrush}" />
											<StackPanel Grid.Column="1" Spacing="4" Margin="0,7,10,7">
												<StackPanel Orientation="Horizontal" Spacing="8">
													<PathIcon
														Data="{StaticResource IconShield}"
														Width="14"
														Height="14"
														Foreground="{DynamicResource WarnBrush}"
														VerticalAlignment="Center" />
													<TextBlock
														Text="{Binding Kind}"
														FontWeight="SemiBold"
														Foreground="{DynamicResource WarnBrush}"
														VerticalAlignment="Center" />
													<TextBlock
														Text="{Binding DetailPreview}"
														FontFamily="{StaticResource CodeFont}"
														FontSize="11.5"
														MaxWidth="330"
														TextTrimming="CharacterEllipsis"
														VerticalAlignment="Center"
														Opacity="0.9"
														ToolTip.Tip="{Binding Detail}" />
													<StackPanel Orientation="Horizontal" Spacing="6" IsVisible="{Binding IsPending}">
														<Button Classes="btn-allow" Content="Allow" Command="{Binding AllowCommand}" />
														<Button
															Classes="btn-soft-accent"
															Content="Always"
															Command="{Binding AllowAlwaysCommand}"
															ToolTip.Tip="Always allow this permission" />
														<Button Classes="btn-deny" Content="Deny" Command="{Binding DenyCommand}" />
													</StackPanel>
													<TextBlock
														Text="{Binding Answer}"
														IsVisible="{Binding !IsPending}"
														Opacity="0.85"
														FontStyle="Italic"
														VerticalAlignment="Center" />
												</StackPanel>
												<Expander IsVisible="{Binding HasDiff}" HorizontalAlignment="Stretch" HorizontalContentAlignment="Stretch">
													<Expander.Header>
														<TextBlock Text="View diff" FontSize="11" Opacity="0.7" />
													</Expander.Header>
													<Border Background="{DynamicResource DiffBgBrush}" CornerRadius="8" Padding="9,7" HorizontalAlignment="Stretch">
														<c:DiffTextBlock Text="{Binding Diff}" />
													</Border>
												</Expander>
											</StackPanel>
										</Grid>
									</Border>
								</DataTemplate>

								<DataTemplate DataType="{x:Type m:SystemNoteItem}">
									<TextBlock
										Classes="note"
										Classes.error="{Binding IsError}"
										Text="{Binding Text}">
										<TextBlock.ContextMenu>
											<ContextMenu>
												<MenuItem Header="Copy" Click="OnCopyMessage" />
											</ContextMenu>
										</TextBlock.ContextMenu>
									</TextBlock>
								</DataTemplate>

							</ItemsControl.DataTemplates>
						</ItemsControl>
						<StackPanel
							Orientation="Horizontal"
							Spacing="7"
							Margin="8,6,0,2"
							IsVisible="{Binding IsBusy}">
							<Ellipse Classes="pulse" />
							<Ellipse Classes="pulse d2" />
							<Ellipse Classes="pulse d3" />
							<TextBlock
								Text="opencode is working…"
								FontStyle="Italic"
								FontSize="12"
								Foreground="{DynamicResource AccentBrush}"
								Opacity="0.85"
								VerticalAlignment="Center" />
						</StackPanel>
					</StackPanel>
				</ScrollViewer>

				<!--  Empty state  -->
				<StackPanel
					HorizontalAlignment="Center"
					VerticalAlignment="Center"
					IsVisible="{Binding !HasMessages}"
					MaxWidth="440"
					Spacing="10">
					<PathIcon
						Data="{StaticResource IconSpark}"
						Width="34"
						Height="34"
						Foreground="{DynamicResource AccentBrush}"
						HorizontalAlignment="Center" />
					<TextBlock Text="opencode agent" FontSize="17" FontWeight="SemiBold" HorizontalAlignment="Center" />
					<TextBlock
						Opacity="0.5"
						FontSize="12.5"
						TextWrapping="Wrap"
						TextAlignment="Center"
						Text="Ask anything — tool asks appear here as cards you can allow or deny." />
					<StackPanel Orientation="Horizontal" HorizontalAlignment="Center" Spacing="6">
						<Button Classes="example-chip" Content="Summarize this repo's structure" Click="OnExampleClick" />
						<Button Classes="example-chip" Content="Find and fix TODO comments" Click="OnExampleClick" />
						<Button Classes="example-chip" Content="Write tests for the last commit" Click="OnExampleClick" />
					</StackPanel>
				</StackPanel>

				<Button
					x:Name="JumpLatest"
					Classes="jump-btn"
					IsVisible="False"
					HorizontalAlignment="Right"
					VerticalAlignment="Bottom"
					Margin="0,0,8,8"
					Click="OnJumpLatestClicked"
					ToolTip.Tip="Jump to the latest message">
					<StackPanel Orientation="Horizontal" Spacing="6">
						<PathIcon Data="{StaticResource IconArrowDown}" Width="12" Height="12" />
						<TextBlock Text="Latest" VerticalAlignment="Center" />
					</StackPanel>
				</Button>
			</Grid>

			<!--  Composer  -->
			<Border
				Grid.Row="2"
				Classes="input-card"
				CornerRadius="14"
				Background="{DynamicResource InputBrush}"
				BorderThickness="1"
				Padding="8"
				Margin="6,0,6,8"
				DragDrop.DragOver="OnFileDragOver"
				DragDrop.Drop="OnFileDrop">
				<StackPanel Spacing="6">
					<ItemsControl ItemsSource="{Binding Attachments}" IsVisible="{Binding HasAttachments}">
						<ItemsControl.ItemsPanel>
							<ItemsPanelTemplate>
								<StackPanel Orientation="Horizontal" Spacing="6" />
							</ItemsPanelTemplate>
						</ItemsControl.ItemsPanel>
						<ItemsControl.ItemTemplate>
							<DataTemplate>
								<Border CornerRadius="8" Background="{DynamicResource ChipBrush}" Padding="4">
									<StackPanel>
										<Image
											Source="{Binding Preview}"
											Width="56"
											Height="56"
											Stretch="Uniform"
											IsVisible="{Binding IsImage}" />
										<PathIcon
											Data="{StaticResource IconDoc}"
											Width="56"
											Height="56"
											Foreground="{DynamicResource TextMutedBrush}"
											IsVisible="{Binding !IsImage}" />
										<Button
											Classes="icon"
											HorizontalAlignment="Center"
											Command="{Binding $parent[ItemsControl].DataContext.RemoveAttachmentCommand}"
											CommandParameter="{Binding}"
											ToolTip.Tip="Remove attachment">
											<PathIcon Data="{StaticResource IconClose}" Width="11" Height="11" />
										</Button>
									</StackPanel>
								</Border>
							</DataTemplate>
						</ItemsControl.ItemTemplate>
					</ItemsControl>
					<Grid ColumnDefinitions="*,Auto,Auto" ColumnSpacing="8">
						<TextBox
							x:Name="InputBox"
							Text="{Binding Input}"
							PlaceholderText="Ask opencode…  (Enter to send, Shift+Enter for a new line)"
							AcceptsReturn="True"
							VerticalContentAlignment="Top"
							MinHeight="52"
							IsEnabled="{Binding Owner.IsServerRunning}" />
						<Button
							Grid.Column="1"
							VerticalAlignment="Top"
							Classes="btn-send"
							Command="{Binding SendCommand}"
							IsVisible="{Binding !IsBusy}"
							IsEnabled="{Binding Owner.IsServerRunning}"
							ToolTip.Tip="Send">
							<PathIcon Data="{StaticResource IconSend}" Width="17" Height="17" />
						</Button>
						<Button
							Grid.Column="1"
							VerticalAlignment="Top"
							Classes="btn-queue"
							Command="{Binding SendCommand}"
							IsVisible="{Binding IsBusy}"
							IsEnabled="{Binding Owner.IsServerRunning}"
							ToolTip.Tip="Queue this message — it is sent when the current turn finishes">
							<PathIcon Data="{StaticResource IconClock}" Width="17" Height="17" />
						</Button>
						<Button
							Grid.Column="2"
							VerticalAlignment="Top"
							Classes="btn-stop"
							Command="{Binding AbortCommand}"
							IsVisible="{Binding IsBusy}"
							IsEnabled="{Binding Owner.IsServerRunning}"
							ToolTip.Tip="Stop this chat's running turn">
							<PathIcon Data="{StaticResource IconStop}" Width="15" Height="15" />
						</Button>
					</Grid>
					<WrapPanel Orientation="Horizontal">
						<WrapPanel.Styles>
							<Style Selector="WrapPanel > Control">
								<Setter Property="Margin" Value="0,0,6,6" />
							</Style>
						</WrapPanel.Styles>
						<ComboBox
							MinWidth="130"
							MaxWidth="240"
							ItemsSource="{Binding Owner.Models}"
							SelectedItem="{Binding SelectedModel}"
							ToolTip.Tip="Model for the next message" />
						<ComboBox
							MinWidth="84"
							MaxWidth="160"
							ItemsSource="{Binding Variants}"
							SelectedItem="{Binding SelectedVariant}"
							IsEnabled="{Binding HasVariants}"
							ToolTip.Tip="Model variant (e.g. reasoning effort)" />
						<ComboBox
							MinWidth="104"
							MaxWidth="180"
							ItemsSource="{Binding Owner.Agents}"
							SelectedItem="{Binding SelectedAgent}"
							IsVisible="{Binding Owner.HasAgents}"
							ToolTip.Tip="Agent mode (build executes, plan researches first)" />
						<Button VerticalAlignment="Center" ToolTip.Tip="Server commands and saved prompts">
							<Button.Flyout>
								<Flyout Placement="TopEdgeAlignedLeft">
									<StackPanel Width="320" MaxHeight="420" Spacing="8">
										<TextBlock Text="Server commands" FontWeight="SemiBold" FontSize="12" Opacity="0.8" />
										<ScrollViewer MaxHeight="170">
											<ItemsControl ItemsSource="{Binding Owner.Commands}">
												<ItemsControl.ItemTemplate>
													<DataTemplate>
														<Button
															HorizontalAlignment="Stretch"
															HorizontalContentAlignment="Left"
															Click="OnCommandClick"
															Margin="0,1"
															Padding="8,5"
															ToolTip.Tip="{Binding Description}">
															<TextBlock Text="{Binding Name}" />
														</Button>
													</DataTemplate>
												</ItemsControl.ItemTemplate>
											</ItemsControl>
										</ScrollViewer>
										<TextBlock Text="Saved prompts" FontWeight="SemiBold" FontSize="12" Opacity="0.8" />
										<ScrollViewer MaxHeight="170">
											<ItemsControl ItemsSource="{Binding Owner.Prompts}">
												<ItemsControl.ItemTemplate>
													<DataTemplate>
														<Grid ColumnDefinitions="*,Auto" Margin="0,1">
															<Button
																HorizontalAlignment="Stretch"
																HorizontalContentAlignment="Left"
																Click="OnPromptUseClick"
																Padding="8,5"
																Background="Transparent">
																<TextBlock Text="{Binding}" TextTrimming="CharacterEllipsis" MaxWidth="250" />
															</Button>
															<Button
																Grid.Column="1"
																Classes="icon"
																Command="{Binding $parent[ItemsControl].DataContext.Owner.DeletePromptCommand}"
																CommandParameter="{Binding}"
																ToolTip.Tip="Delete prompt">
																<PathIcon Data="{StaticResource IconClose}" Width="11" Height="11" />
															</Button>
														</Grid>
													</DataTemplate>
												</ItemsControl.ItemTemplate>
											</ItemsControl>
										</ScrollViewer>
										<Button
											Content="Save current input as prompt"
											HorizontalAlignment="Stretch"
											Command="{Binding SavePromptCommand}" />
									</StackPanel>
								</Flyout>
							</Button.Flyout>
							<StackPanel Orientation="Horizontal" Spacing="6">
								<PathIcon Data="{StaticResource IconChevronDown}" Width="12" Height="12" />
								<TextBlock Text="Prompts" VerticalAlignment="Center" />
							</StackPanel>
						</Button>
					</WrapPanel>
				</StackPanel>
			</Border>
		</Grid>
	</Border>
</UserControl>
