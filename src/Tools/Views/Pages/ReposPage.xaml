<UserControl
        x:Class="Tools.Views.Pages.ReposPage"
        xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:controls="using:Tools.Controls"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:entities="using:Tools.Library.Entities"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:suki="https://github.com/kikipoulet/SukiUI"
        xmlns:tools="using:Tools.Library.MarkupExtensions"
        xmlns:vm="using:Tools.ViewModels.Pages"
        x:Name="Root"
        d:DesignHeight="600"
        d:DesignWidth="1000"
        x:CompileBindings="True"
        x:DataType="vm:ReposViewModel"
        mc:Ignorable="d">

        <Grid
                Margin="16"
                ColumnDefinitions="*"
                RowDefinitions="Auto,Auto,*"
                RowSpacing="16">

                <Grid
                        Grid.Row="0"
                        ColumnDefinitions="*,Auto"
                        ColumnSpacing="8">
                        <StackPanel
                                Grid.Column="0"
                                Orientation="Horizontal"
                                Spacing="8">
                                <TextBlock VerticalAlignment="Center" Classes="section-title">
                                        <Run Text="Repositories" />
                                        <Run
                                                FontSize="13"
                                                Foreground="{DynamicResource MutedForegroundBrush}"
                                                Text=" (" />
                                        <Run
                                                FontSize="13"
                                                Foreground="{DynamicResource MutedForegroundBrush}"
                                                Text="{Binding FilteredRepos.Count}" />
                                        <Run
                                                FontSize="13"
                                                Foreground="{DynamicResource MutedForegroundBrush}"
                                                Text=")" />
                                </TextBlock>
                        </StackPanel>
                        <StackPanel
                                Grid.Column="1"
                                Margin="0,0,0,12"
                                HorizontalAlignment="Right"
                                Classes="actions">
                                <Button
                                        Classes="icon"
                                        Command="{Binding RefreshCommand}"
                                        IsEnabled="{Binding !IsRefreshing}"
                                        ToolTip.Tip="Refresh">
                                        <Path Classes="icon" Data="{tools:SvgPath icon-refresh}" />
                                </Button>
                                <Button
                                        Classes="icon"
                                        Command="{Binding OpenSettingsCommand}"
                                        ToolTip.Tip="Settings">
                                        <Path Classes="icon" Data="{tools:SvgPath icon-cog}" />
                                </Button>
                        </StackPanel>
                </Grid>

                <Border
                        Grid.Row="1"
                        Margin="0,-16,0,0"
                        Padding="12"
                        HorizontalAlignment="Stretch"
                        Classes="card">
                        <Grid ColumnDefinitions="*,Auto,Auto,Auto" ColumnSpacing="16">
                                <TextBox
                                        Grid.Column="0"
                                        VerticalAlignment="Center"
                                        Text="{Binding FilterText, Mode=TwoWay}"
                                        Watermark="Search repositories...">
                                        <TextBox.InnerRightContent>
                                                <Button
                                                        Width="20"
                                                        Height="20"
                                                        Padding="2"
                                                        Classes="icon"
                                                        Command="{Binding ClearFilterCommand}"
                                                        IsVisible="{Binding FilterText, Converter={StaticResource StringNullOrEmptyToVisibilityConverter}}">
                                                        <Path
                                                                Width="12"
                                                                Height="12"
                                                                Data="M19,6.41 L17.59,5 L12,10.59 L6.41,5 L5,6.41 L10.59,12 L5,17.59 L6.41,19 L12,13.41 L17.59,19 L19,17.59 L13.41,12 Z"
                                                                Fill="{DynamicResource MutedForegroundBrush}"
                                                                Stretch="Uniform" />
                                                </Button>
                                        </TextBox.InnerRightContent>
                                </TextBox>
                                <Border
                                        Grid.Column="1"
                                        Margin="0,4"
                                        Classes="vertical-divider" />


                                <ItemsControl
                                        Grid.Column="2"
                                        VerticalAlignment="Center"
                                        ItemsSource="{Binding TagFilters}">
                                        <ItemsControl.ItemsPanel>
                                                <ItemsPanelTemplate>
                                                        <WrapPanel Orientation="Horizontal" />
                                                </ItemsPanelTemplate>
                                        </ItemsControl.ItemsPanel>
                                        <ItemsControl.ItemTemplate>
                                                <DataTemplate x:DataType="entities:TagFilter">
                                                        <CheckBox
                                                                Margin="0,0,12,0"
                                                                Command="{ReflectionBinding #Root.DataContext.TagFilterChangedCommand}"
                                                                Content="{Binding Name}"
                                                                IsChecked="{Binding IsChecked, Mode=TwoWay}" />
                                                </DataTemplate>
                                        </ItemsControl.ItemTemplate>
                                </ItemsControl>
                                <Button
                                        Grid.Column="3"
                                        Width="44"
                                        Padding="8,2"
                                        VerticalAlignment="Center"
                                        Classes="icon"
                                        Command="{Binding ClearTagFiltersCommand}"
                                        ToolTip.Tip="Clear search and selected tags">
                                        <TextBlock
                                                VerticalAlignment="Center"
                                                Classes="subtle"
                                                Text="Clear" />
                                </Button>
                        </Grid>
                </Border>

                <!--
                        ListBox provides the internal ScrollViewer + VirtualizingStackPanel
                        viewport needed to actually virtualize: only the cards in (or near)
                        the viewport are realized, instead of building every card up front
                        (the dominant cost with the old plain ItemsControl + StackPanel).
                        Selection is neutralized below (the cards are non-interactive
                        containers; all actions are buttons inside the template), and the
                        default list chrome (background, border, padding, focus visual,
                        selected/pressed states) is cleared so the cards look exactly as
                        they did before.
                -->
                <ListBox
                        Grid.Row="2"
                        Grid.Column="0"
                        Padding="0"
                        Background="Transparent"
                        BorderThickness="0"
                        ItemsSource="{Binding FilteredRepos}"
                        SelectionChanged="OnRepoSelectionChanged"
                        SelectionMode="Single">
                        <ListBox.ItemsPanel>
                                <ItemsPanelTemplate>
                                        <VirtualizingStackPanel />
                                </ItemsPanelTemplate>
                        </ListBox.ItemsPanel>
                        <ListBox.Styles>
                                <!--
                                        Drop the per-item list chrome so each card renders as a plain content
                                        host. All card actions are explicit buttons (with CommandParameter), so
                                        ListBox selection is neither needed nor meaningful; neutralize its visual
                                        states (rest/selected/pressed/focused) to keep the cards looking exactly
                                        as they did as plain ItemsControl items.
                                -->
                                <Style Selector="ListBoxItem">
                                        <Setter Property="Padding" Value="0" />
                                        <Setter Property="Margin" Value="0" />
                                        <Setter Property="Background" Value="Transparent" />
                                        <Setter Property="FocusAdorner" Value="{x:Null}" />
                                </Style>
                                <!--
                                        The theme's pseudoclass selectors (e.g. ListBoxItem:pointerover) beat the
                                        plain ListBoxItem style above by specificity, so repeat the neutralization
                                        at matching specificity to keep hover/press/selection chrome invisible.
                                -->
                                <Style Selector="ListBoxItem:pointerover">
                                        <Setter Property="Background" Value="Transparent" />
                                </Style>
                                <Style Selector="ListBoxItem:pressed">
                                        <Setter Property="Background" Value="Transparent" />
                                </Style>
                                <Style Selector="ListBoxItem:selected">
                                        <Setter Property="Background" Value="Transparent" />
                                </Style>
                                <Style Selector="ListBoxItem:selected /template/ ContentPresenter">
                                        <Setter Property="Background" Value="Transparent" />
                                </Style>
                                <Style Selector="ListBoxItem:pointerover /template/ ContentPresenter">
                                        <Setter Property="Background" Value="Transparent" />
                                </Style>
                                <Style Selector="ListBoxItem:pressed /template/ ContentPresenter">
                                        <Setter Property="Background" Value="Transparent" />
                                </Style>
                                <!--
                                        SukiTheme's app-wide ListBoxItem ControlTheme replaces the item
                                        template with a GlassCard that carries a CircleCheck tick
                                        (PathIcon#CheckSelected) fading in while :selected, plus a
                                        SukiPrimaryColor tint on selected/hover. Those template parts
                                        aren't reachable by the ContentPresenter overrides above, so
                                        neutralize them at matching specificity as well.
                                -->
                                <Style Selector="ListBoxItem:selected /template/ PathIcon#CheckSelected">
                                        <Setter Property="Opacity" Value="0" />
                                </Style>
                                <Style Selector="ListBoxItem /template/ suki|GlassCard#BorderBasicStyle">
                                        <Setter Property="Background" Value="Transparent" />
                                        <Setter Property="BorderThickness" Value="0" />
                                </Style>
                                <Style Selector="ListBoxItem:pointerover /template/ suki|GlassCard#BorderBasicStyle">
                                        <Setter Property="Background" Value="Transparent" />
                                </Style>
                                <Style Selector="ListBoxItem:selected /template/ suki|GlassCard#BorderBasicStyle">
                                        <Setter Property="Background" Value="Transparent" />
                                        <Setter Property="BorderThickness" Value="0" />
                                </Style>
                        </ListBox.Styles>
                        <ListBox.ItemTemplate>
                                <DataTemplate x:DataType="entities:Repo">
                                        <!--  Bottom margin replaces the old items-panel Spacing="12"; VirtualizingStackPanel has no Spacing.  -->
                                        <Border
                                                Margin="0,0,0,8"
                                                Padding="16,12"
                                                Classes="card"
                                                PointerPressed="OnCardPointerPressed">
                                                <!--
                                                        Sections spread across the full card width
                                                        (space-between) on large windows and reflow onto
                                                        wrapped rows on small ones: SpaceBetweenPanel
                                                        distributes each row's leftover width as even gaps
                                                        between its zones, wrapping greedily when a zone no
                                                        longer fits. Zones after the first carry their own
                                                        left hairline divider.
                                                -->
                                                <controls:SpaceBetweenPanel ColumnSpacing="16" RowSpacing="6">

                                                        <!--  Info zone: favorite star, name/path, tags  -->
                                                        <StackPanel
                                                                Width="380"
                                                                VerticalAlignment="Center"
                                                                Orientation="Vertical"
                                                                Spacing="4">
                                                                <Grid ColumnDefinitions="Auto,*">
                                                                        <Button
                                                                                Grid.Column="0"
                                                                                VerticalAlignment="Top"
                                                                                Classes="icon"
                                                                                Command="{ReflectionBinding #Root.DataContext.ToggleFavoriteCommand}"
                                                                                CommandParameter="{Binding}"
                                                                                ToolTip.Tip="Toggle favorite">
                                                                                <Path
                                                                                        Width="16"
                                                                                        Height="16"
                                                                                        Data="{tools:SvgPath icon-star}"
                                                                                        Fill="{Binding Tags, Converter={StaticResource FavoriteStarBrushConverter}}"
                                                                                        Stretch="Uniform" />
                                                                        </Button>
                                                                        <StackPanel
                                                                                Grid.Column="1"
                                                                                VerticalAlignment="Center"
                                                                                Orientation="Vertical"
                                                                                Spacing="2">
                                                                                <TextBlock
                                                                                        FontSize="15"
                                                                                        FontWeight="SemiBold"
                                                                                        Foreground="{DynamicResource TitleForegroundBrush}"
                                                                                        Text="{Binding Name}"
                                                                                        TextTrimming="CharacterEllipsis" />
                                                                                <TextBlock
                                                                                        Classes="subtle"
                                                                                        Text="{Binding FolderPath}"
                                                                                        TextWrapping="Wrap" />
                                                                        </StackPanel>
                                                                </Grid>
                                                                <WrapPanel Orientation="Horizontal">
                                                                        <TextBlock
                                                                                Margin="0,0,6,4"
                                                                                VerticalAlignment="Center"
                                                                                Classes="subtle"
                                                                                Text="Tags:" />
                                                                        <ItemsControl ItemsSource="{Binding Tags}">
                                                                                <ItemsControl.ItemsPanel>
                                                                                        <ItemsPanelTemplate>
                                                                                                <WrapPanel Orientation="Horizontal" />
                                                                                        </ItemsPanelTemplate>
                                                                                </ItemsControl.ItemsPanel>
                                                                                <ItemsControl.ItemTemplate>
                                                                                        <DataTemplate x:DataType="entities:RepoTag">
                                                                                                <Border
                                                                                                        Margin="0,0,6,4"
                                                                                                        Padding="8,2"
                                                                                                        Classes="chip">
                                                                                                        <StackPanel Orientation="Horizontal" Spacing="4">
                                                                                                                <TextBlock
                                                                                                                        VerticalAlignment="Center"
                                                                                                                        Classes="subtle"
                                                                                                                        Text="{Binding Name}" />
                                                                                                                <Button
                                                                                                                        Width="14"
                                                                                                                        Height="14"
                                                                                                                        Padding="0"
                                                                                                                        Background="Transparent"
                                                                                                                        BorderThickness="0"
                                                                                                                        Command="{ReflectionBinding #Root.DataContext.RemoveTagCommand}"
                                                                                                                        CommandParameter="{Binding}"
                                                                                                                        Cursor="Hand"
                                                                                                                        ToolTip.Tip="Remove tag">
                                                                                                                        <Path
                                                                                                                                Width="9"
                                                                                                                                Height="9"
                                                                                                                                Data="M19,6.41 L17.59,5 L12,10.59 L6.41,5 L5,6.41 L10.59,12 L5,17.59 L6.41,19 L12,13.41 L17.59,19 L19,17.59 L13.41,12 Z"
                                                                                                                                Fill="{DynamicResource MutedForegroundBrush}"
                                                                                                                                Stretch="Uniform" />
                                                                                                                </Button>
                                                                                                        </StackPanel>
                                                                                                </Border>
                                                                                        </DataTemplate>
                                                                                </ItemsControl.ItemTemplate>
                                                                        </ItemsControl>
                                                                        <Button
                                                                                Margin="0,0,0,4"
                                                                                Padding="8,2"
                                                                                Background="Transparent"
                                                                                BorderBrush="{DynamicResource HairlineBrush}"
                                                                                BorderThickness="1"
                                                                                CornerRadius="{DynamicResource ChipRadius}"
                                                                                Cursor="Hand"
                                                                                ToolTip.Tip="Add tag">
                                                                                <TextBlock
                                                                                        FontSize="12"
                                                                                        Foreground="{DynamicResource MutedForegroundBrush}"
                                                                                        Text="+" />
                                                                                <Button.Flyout>
                                                                                        <Flyout Placement="BottomEdgeAlignedLeft">
                                                                                                <StackPanel Width="220" Spacing="10">
                                                                                                        <TextBlock Classes="field-label" Text="Quick add" />
                                                                                                        <ItemsControl ItemsSource="{ReflectionBinding #Root.DataContext.AvailableTags}">
                                                                                                                <ItemsControl.ItemsPanel>
                                                                                                                        <ItemsPanelTemplate>
                                                                                                                                <WrapPanel Orientation="Horizontal" />
                                                                                                                        </ItemsPanelTemplate>
                                                                                                                </ItemsControl.ItemsPanel>
                                                                                                                <ItemsControl.ItemTemplate>
                                                                                                                        <DataTemplate x:DataType="x:String">
                                                                                                                                <Button
                                                                                                                                        Margin="0,0,6,4"
                                                                                                                                        Padding="8,2"
                                                                                                                                        Background="Transparent"
                                                                                                                                        BorderBrush="{DynamicResource HairlineBrush}"
                                                                                                                                        BorderThickness="1"
                                                                                                                                        Command="{ReflectionBinding #Root.DataContext.AddTagByNameCommand}"
                                                                                                                                        Content="{Binding}"
                                                                                                                                        CornerRadius="{DynamicResource ChipRadius}"
                                                                                                                                        Cursor="Hand"
                                                                                                                                        FontSize="12">
                                                                                                                                        <Button.CommandParameter>
                                                                                                                                                <MultiBinding Converter="{StaticResource PairConverter}">
                                                                                                                                                        <Binding Path="DataContext" RelativeSource="{RelativeSource AncestorType=Border}" />
                                                                                                                                                        <Binding Path="." />
                                                                                                                                                </MultiBinding>
                                                                                                                                        </Button.CommandParameter>
                                                                                                                                </Button>
                                                                                                                        </DataTemplate>
                                                                                                                </ItemsControl.ItemTemplate>
                                                                                                        </ItemsControl>
                                                                                                        <Border Margin="0,4" Classes="horizontal-divider" />
                                                                                                        <TextBlock Classes="field-label" Text="New tag" />
                                                                                                        <Grid ColumnDefinitions="*,Auto" ColumnSpacing="8">
                                                                                                                <TextBox
                                                                                                                        Grid.Column="0"
                                                                                                                        Text="{ReflectionBinding #Root.DataContext.NewTagText,
                                                                                                                                                 Mode=TwoWay}"
                                                                                                                        Watermark="Tag name" />
                                                                                                                <Button
                                                                                                                        Grid.Column="1"
                                                                                                                        Classes="accent"
                                                                                                                        Command="{ReflectionBinding #Root.DataContext.AddTagCommand}"
                                                                                                                        CommandParameter="{ReflectionBinding DataContext,
                                                                                                                                                             RelativeSource={RelativeSource AncestorType=Border}}"
                                                                                                                        Content="Add" />
                                                                                                        </Grid>
                                                                                                </StackPanel>
                                                                                        </Flyout>
                                                                                </Button.Flyout>
                                                                        </Button>
                                                                </WrapPanel>
                                                        </StackPanel>

                                                        <!--  Workspace zone: icon-only launch buttons (tooltips name the actions)  -->
                                                        <Border
                                                                Width="320"
                                                                Padding="16,0"
                                                                VerticalAlignment="Stretch"
                                                                BorderBrush="{DynamicResource HairlineBrush}"
                                                                BorderThickness="1,0,0,0">
                                                                <StackPanel
                                                                        VerticalAlignment="Center"
                                                                        Orientation="Horizontal"
                                                                        Spacing="8">
                                                                        <!--
                                                                                OpenCode leads the workspace row: quick open plus a
                                                                                minimal options button, set apart from the other
                                                                                launch buttons by a hairline divider.
                                                                        -->
                                                                        <StackPanel
                                                                                IsVisible="{ReflectionBinding #Root.DataContext.IsOpenCodeEnabled}"
                                                                                Orientation="Horizontal"
                                                                                Spacing="8">
                                                                                <Button
                                                                                        Classes="tool-button accent-outline"
                                                                                        Command="{ReflectionBinding #Root.DataContext.QuickOpenOpenCodeCommand}"
                                                                                        CommandParameter="{Binding}"
                                                                                        ToolTip.Tip="Launch one opencode instance with the first model">
                                                                                        <Path
                                                                                                Width="22"
                                                                                                Height="22"
                                                                                                Data="{tools:SvgPath icon-opencode}"
                                                                                                Fill="{DynamicResource InfoAccentBrush}"
                                                                                                Stretch="Uniform" />
                                                                                </Button>
                                                                                <Button
                                                                                        Width="40"
                                                                                        Height="40"
                                                                                        VerticalAlignment="Center"
                                                                                        Classes="icon"
                                                                                        Command="{ReflectionBinding #Root.DataContext.OpenOpenCodePanelCommand}"
                                                                                        CommandParameter="{Binding}"
                                                                                        ToolTip.Tip="Open the options panel (model, instances, template, prompt)">
                                                                                        <Path
                                                                                                Width="18"
                                                                                                Height="18"
                                                                                                Data="{tools:SvgPath icon-options}"
                                                                                                Fill="{DynamicResource MutedForegroundBrush}"
                                                                                                Stretch="Uniform" />
                                                                                </Button>
                                                                                <Border Classes="vertical-divider" />
                                                                        </StackPanel>
                                                                        <Button
                                                                                Classes="tool-button"
                                                                                Command="{ReflectionBinding #Root.DataContext.OpenVisualStudioCommand}"
                                                                                CommandParameter="{Binding}"
                                                                                IsVisible="{Binding SolutionPath, Converter={StaticResource StringNotNullToBoolConverter}}"
                                                                                ToolTip.Tip="Open in Visual Studio">
                                                                                <Path
                                                                                        Width="22"
                                                                                        Height="22"
                                                                                        Data="{tools:SvgPath icon-sln-box}"
                                                                                        Fill="{DynamicResource PurpleAccentBrush}"
                                                                                        Stretch="Uniform" />
                                                                        </Button>
                                                                        <Button
                                                                                Classes="tool-button"
                                                                                Command="{ReflectionBinding #Root.DataContext.OpenWithVSCodeCommand}"
                                                                                CommandParameter="{Binding FolderPath}"
                                                                                ToolTip.Tip="Open in VS Code">
                                                                                <Path
                                                                                        Width="22"
                                                                                        Height="22"
                                                                                        Data="{tools:SvgPath icon-vscode}"
                                                                                        Fill="{DynamicResource InfoAccentBrush}"
                                                                                        Stretch="Uniform" />
                                                                        </Button>
                                                                        <Button
                                                                                Classes="tool-button"
                                                                                Command="{ReflectionBinding #Root.DataContext.OpenFolderCommand}"
                                                                                CommandParameter="{Binding FolderPath}"
                                                                                ToolTip.Tip="Open folder">
                                                                                <Path
                                                                                        Width="22"
                                                                                        Height="22"
                                                                                        Data="{tools:SvgPath icon-folder}"
                                                                                        Fill="{DynamicResource WarningAccentBrush}"
                                                                                        Stretch="Uniform" />
                                                                        </Button>
                                                                        <Button
                                                                                Classes="tool-button"
                                                                                Command="{ReflectionBinding #Root.DataContext.OpenWithTerminalCommand}"
                                                                                CommandParameter="{Binding FolderPath}"
                                                                                ToolTip.Tip="Open in Terminal">
                                                                                <Path
                                                                                        Width="22"
                                                                                        Height="22"
                                                                                        Data="{tools:SvgPath icon-terminal}"
                                                                                        Fill="{DynamicResource StatusActiveBrush}"
                                                                                        Stretch="Uniform" />
                                                                        </Button>
                                                                </StackPanel>
                                                        </Border>

                                                        <!--  Git zone: branch + modified / ahead / behind stats  -->
                                                        <Border
                                                                Padding="16,0"
                                                                VerticalAlignment="Stretch"
                                                                BorderBrush="{DynamicResource HairlineBrush}"
                                                                BorderThickness="1,0,0,0">
                                                                <StackPanel
                                                                        VerticalAlignment="Center"
                                                                        Orientation="Vertical"
                                                                        Spacing="16">
                                                                        <TextBlock
                                                                                Width="140"
                                                                                HorizontalAlignment="Left"
                                                                                FontSize="12"
                                                                                FontWeight="SemiBold"
                                                                                Foreground="{DynamicResource MutedForegroundBrush}"
                                                                                Text="{Binding GitBranchName}"
                                                                                TextTrimming="CharacterEllipsis"
                                                                                ToolTip.Tip="{Binding GitBranchName}" />

                                                                        <Grid>
                                                                                <StackPanel
                                                                                        IsVisible="{Binding GitStatusLoaded}"
                                                                                        Orientation="Horizontal"
                                                                                        Spacing="12">
                                                                                        <StackPanel Orientation="Horizontal" Spacing="4">
                                                                                                <Path
                                                                                                        Width="12"
                                                                                                        Height="12"
                                                                                                        VerticalAlignment="Center"
                                                                                                        Data="{tools:SvgPath icon-source-branch}"
                                                                                                        Fill="{DynamicResource WarningAccentBrush}"
                                                                                                        Stretch="Uniform" />
                                                                                                <TextBlock
                                                                                                        VerticalAlignment="Center"
                                                                                                        FontSize="13"
                                                                                                        FontWeight="SemiBold"
                                                                                                        Foreground="{DynamicResource WarningAccentBrush}"
                                                                                                        Text="{Binding GitModifiedCount}" />
                                                                                                <TextBlock
                                                                                                        VerticalAlignment="Center"
                                                                                                        Classes="subtle"
                                                                                                        FontSize="11"
                                                                                                        Text="changes" />
                                                                                        </StackPanel>
                                                                                        <StackPanel Orientation="Horizontal" Spacing="4">
                                                                                                <Path
                                                                                                        Width="12"
                                                                                                        Height="12"
                                                                                                        VerticalAlignment="Center"
                                                                                                        Data="{tools:SvgPath icon-arrow-up}"
                                                                                                        Fill="{DynamicResource StatusActiveBrush}"
                                                                                                        Stretch="Uniform" />
                                                                                                <TextBlock
                                                                                                        VerticalAlignment="Center"
                                                                                                        FontSize="13"
                                                                                                        FontWeight="SemiBold"
                                                                                                        Foreground="{DynamicResource StatusActiveBrush}"
                                                                                                        Text="{Binding GitToPushCount}" />
                                                                                                <TextBlock
                                                                                                        VerticalAlignment="Center"
                                                                                                        Classes="subtle"
                                                                                                        FontSize="11"
                                                                                                        Text="push" />
                                                                                        </StackPanel>
                                                                                        <StackPanel Orientation="Horizontal" Spacing="4">
                                                                                                <Path
                                                                                                        Width="12"
                                                                                                        Height="12"
                                                                                                        VerticalAlignment="Center"
                                                                                                        Data="{tools:SvgPath icon-arrow-down}"
                                                                                                        Fill="{DynamicResource InfoAccentBrush}"
                                                                                                        Stretch="Uniform" />
                                                                                                <TextBlock
                                                                                                        VerticalAlignment="Center"
                                                                                                        FontSize="13"
                                                                                                        FontWeight="SemiBold"
                                                                                                        Foreground="{DynamicResource InfoAccentBrush}"
                                                                                                        Text="{Binding GitToPullCount}" />
                                                                                                <TextBlock
                                                                                                        VerticalAlignment="Center"
                                                                                                        Classes="subtle"
                                                                                                        FontSize="11"
                                                                                                        Text="pull" />
                                                                                        </StackPanel>
                                                                                </StackPanel>
                                                                                <TextBlock
                                                                                        Classes="subtle"
                                                                                        IsVisible="{Binding GitStatusLoaded, Converter={StaticResource InverseBoolConverter}}"
                                                                                        Text="checking…" />
                                                                        </Grid>
                                                                </StackPanel>
                                                        </Border>

                                                </controls:SpaceBetweenPanel>
                                        </Border>
                                </DataTemplate>
                        </ListBox.ItemTemplate>
                </ListBox>

                <!--
                        OpenCode panel: an overlay docked to the right edge, floating above the
                        repo list (declared last so it wins z-order) rather than pushing the
                        content aside. The card class provides the opaque background; the shadow
                        separates it from the content underneath.
                -->
                <Border
                        Grid.Row="0"
                        Grid.RowSpan="3"
                        Width="340"
                        HorizontalAlignment="Right"
                        VerticalAlignment="Stretch"
                        BoxShadow="{DynamicResource FlyoutShadow}"
                        Classes="card"
                        IsVisible="{Binding IsOpenCodePanelOpen}">
                        <Grid RowDefinitions="Auto,Auto,Auto,Auto,Auto,Auto,*,Auto,Auto">
                                <Grid
                                        Grid.Row="0"
                                        Margin="0,0,0,16"
                                        ColumnDefinitions="*,Auto">
                                        <TextBlock
                                                Grid.Column="0"
                                                Classes="card-title"
                                                Text="{Binding OpenCodeRepoName}"
                                                TextTrimming="CharacterEllipsis" />
                                        <Button
                                                Grid.Column="1"
                                                VerticalAlignment="Top"
                                                Classes="icon"
                                                Command="{Binding CloseOpenCodePanelCommand}"
                                                ToolTip.Tip="Close">
                                                <Path
                                                        Width="14"
                                                        Height="14"
                                                        Data="M19,6.41 L17.59,5 L12,10.59 L6.41,5 L5,6.41 L10.59,12 L5,17.59 L6.41,19 L12,13.41 L17.59,19 L19,17.59 L13.41,12 Z"
                                                        Fill="{DynamicResource MutedForegroundBrush}"
                                                        Stretch="Uniform" />
                                        </Button>
                                </Grid>
                                <StackPanel
                                        Grid.Row="1"
                                        Margin="0,0,0,16"
                                        Spacing="8">
                                        <TextBlock Classes="field-label" Text="Model" />
                                        <ComboBox
                                                Name="OpenCodeModelPicker"
                                                HorizontalAlignment="Stretch"
                                                IsEditable="True"
                                                IsEnabled="{Binding OpenCodeHasModels}"
                                                ItemsSource="{Binding OpenCodeFilteredModels}"
                                                PlaceholderText="Search or select a model…"
                                                SelectionChanged="OnOpenCodeModelSelectionChanged"
                                                Text="{Binding OpenCodeModelFilter, Mode=TwoWay}" />
                                        <TextBlock
                                                Classes="subtle"
                                                FontSize="11"
                                                IsVisible="{Binding OpenCodeModelsEmpty}"
                                                Text="No models found. Is opencode installed and on the PATH?"
                                                TextWrapping="Wrap" />
                                </StackPanel>
                                <StackPanel
                                        Grid.Row="2"
                                        Margin="0,0,0,16"
                                        Spacing="8">
                                        <TextBlock
                                                Classes="field-label"
                                                Text="Instances"
                                                ToolTip.Tip="How many terminal windows to open, each running opencode" />
                                        <NumericUpDown
                                                FormatString="0"
                                                Increment="1"
                                                Maximum="9"
                                                Minimum="1"
                                                ParsingNumberStyle="Integer"
                                                Value="{Binding OpenCodeInstanceCount, Mode=TwoWay}" />
                                        <CheckBox
                                                Content="Arrange into grid"
                                                IsChecked="{Binding OpenCodeArrangeIntoGrid, Mode=TwoWay}"
                                                ToolTip.Tip="Tile the launched instances across the screen in a grid" />
                                </StackPanel>
                                <StackPanel
                                        Grid.Row="4"
                                        Margin="0,0,0,16"
                                        Spacing="8">
                                        <Grid ColumnDefinitions="*,Auto">
                                                <TextBlock
                                                        Grid.Column="0"
                                                        Classes="field-label"
                                                        Text="Template (optional)"
                                                        ToolTip.Tip="Copy a template's .opencode folder into the repo" />
                                                <Button
                                                        Grid.Column="1"
                                                        Padding="8,2"
                                                        VerticalAlignment="Center"
                                                        Command="{Binding ResetOpenCodeTemplateCommand}"
                                                        Content="Reset"
                                                        FontSize="11"
                                                        ToolTip.Tip="Remove the repo's .opencode folder and re-copy the selected template into it" />
                                        </Grid>
                                        <TextBlock
                                                Classes="subtle"
                                                FontSize="11"
                                                Text="Reset removes the repo's .opencode folder and re-copies the selected template into it."
                                                TextWrapping="Wrap" />
                                        <ComboBox
                                                HorizontalAlignment="Stretch"
                                                ItemsSource="{Binding OpenCodeTemplates}"
                                                SelectedItem="{Binding OpenCodeSelectedTemplate, Mode=TwoWay}" />
                                        <TextBlock
                                                Classes="subtle"
                                                FontSize="11"
                                                IsVisible="{Binding OpenCodeSelectedTemplateDescription, Converter={StaticResource StringNotNullToBoolConverter}}"
                                                Text="{Binding OpenCodeSelectedTemplateDescription}"
                                                TextWrapping="Wrap" />
                                </StackPanel>
                                <StackPanel
                                        Grid.Row="5"
                                        Margin="0,0,0,16"
                                        Spacing="8">
                                        <TextBlock
                                                Classes="field-label"
                                                Text="Prompt (optional)"
                                                ToolTip.Tip="Load a named prompt into the Start prompt box" />
                                        <ComboBox
                                                HorizontalAlignment="Stretch"
                                                ItemsSource="{Binding OpenCodePrompts}"
                                                SelectedItem="{Binding OpenCodeSelectedPrompt, Mode=TwoWay}" />
                                </StackPanel>
                                <Grid
                                        Grid.Row="6"
                                        Margin="0,0,0,16"
                                        RowDefinitions="Auto,*">
                                        <Grid ColumnDefinitions="*,Auto">
                                                <TextBlock
                                                        Grid.Column="0"
                                                        Classes="field-label"
                                                        Text="Start prompt (optional)" />
                                                <Button
                                                        Grid.Column="1"
                                                        Padding="8,2"
                                                        VerticalAlignment="Center"
                                                        Classes="accent"
                                                        Content="Save"
                                                        FontSize="11"
                                                        ToolTip.Tip="Save the current prompt under a name so it can be reused from the Prompt selector">
                                                        <Button.Flyout>
                                                                <Flyout Placement="BottomEdgeAlignedRight">
                                                                        <StackPanel Width="220" Spacing="10">
                                                                                <TextBlock Classes="field-label" Text="Save prompt as" />
                                                                                <TextBox Text="{Binding NewPromptName, Mode=TwoWay}" Watermark="Prompt name" />
                                                                                <Button
                                                                                        HorizontalAlignment="Right"
                                                                                        Classes="accent"
                                                                                        Command="{Binding SavePromptCommand}"
                                                                                        Content="Save" />
                                                                        </StackPanel>
                                                                </Flyout>
                                                        </Button.Flyout>
                                                </Button>
                                        </Grid>
                                        <TextBox
                                                Grid.Row="1"
                                                MinHeight="120"
                                                Margin="0,8,0,0"
                                                VerticalAlignment="Stretch"
                                                AcceptsReturn="True"
                                                Text="{Binding OpenCodePrompt, Mode=TwoWay}"
                                                TextWrapping="Wrap"
                                                Watermark="e.g. fix the login bug" />
                                </Grid>
                                <Button
                                        Grid.Row="7"
                                        HorizontalAlignment="Stretch"
                                        VerticalAlignment="Bottom"
                                        Classes="accent"
                                        Command="{Binding LaunchOpenCodeCommand}"
                                        Content="Open"
                                        IsEnabled="{Binding OpenCodeRepo, Converter={StaticResource NotNullToBoolConverter}}" />
                                <Border Grid.Row="8" />
                        </Grid>
                </Border>

        </Grid>
</UserControl>
