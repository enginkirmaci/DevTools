<UserControl
        x:Class="Tools.Views.Pages.ReposPage"
        xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:components="using:Tools.Views.Components"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:entities="using:Tools.Library.Entities"
        xmlns:lib="using:Tools.Library.Controls"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:suki="https://github.com/kikipoulet/SukiUI"
        xmlns:tools="using:Tools.Library.MarkupExtensions"
        xmlns:vm="using:Tools.ViewModels.Pages"
        x:Name="Root"
        d:DesignHeight="600"
        d:DesignWidth="1000"
        x:CompileBindings="True"
        x:DataType="vm:ReposViewModel"
        mc:Ignorable="d">

        <UserControl.Resources>
                <!--
                        Branch pill geometry: the branch column width and the pill text's
                        max width are coupled by the pill chrome —
                        BranchTextBudget = BranchColumnWidth − 16 cell margin − 18 pill
                        padding − 12 icon − 6 icon/text spacing. The budget is the only
                        finite width the pill text is ever measured with (the pill hugs its
                        content), so it is also the threshold where "..tail" trimming kicks
                        in. Change the two together.
                -->
                <GridLength x:Key="BranchColumnWidth">240</GridLength>
                <x:Double x:Key="BranchTextBudget">188</x:Double>
        </UserControl.Resources>

        <UserControl.Styles>
                <!--
                        Hover feedback for the table row's clickable chips (the
                        branch pill and the changes-count pill): a plain opacity
                        dip on pointerover. Was duplicated as an identical inline
                        Button.Styles block on each button; one class-scoped page
                        style now covers both, and only buttons carrying the
                        class are dimmed.
                -->
                <Style Selector="Button.chip-hover-dim:pointerover">
                        <Setter Property="Opacity" Value="0.85" />
                </Style>
        </UserControl.Styles>

        <Grid ColumnDefinitions="*" RowDefinitions="*,Auto">
                <!--  Bottom margin 0: the bar's divider row owns the table↔bar gap (its
                      28px drag band centers the grip dots); the strip keeps its own
                      bottom spacing.  -->
                <Grid
                        Grid.Row="0"
                        Margin="16,16,16,0"
                        ColumnDefinitions="*"
                        RowDefinitions="Auto,*"
                        RowSpacing="16">

                        <Grid
                                Grid.Row="0"
                                ColumnDefinitions="*,Auto"
                                ColumnSpacing="8">
                                <StackPanel
                                        Grid.Column="0"
                                        VerticalAlignment="Center"
                                        Orientation="Horizontal"
                                        Spacing="10">
                                        <!--
                                                Page identity: the package glyph marks the page, then the
                                                title and a quiet badge carrying the visible (filtered)
                                                repo count — the old "( N )" inside the title, promoted
                                                to a chip so the number reads at a glance.
                                        -->
                                        <Path
                                                Width="20"
                                                Height="20"
                                                VerticalAlignment="Center"
                                                Data="{tools:SvgPath icon-package}"
                                                Fill="{DynamicResource AccentPrimaryBrush}"
                                                Stretch="Uniform" />
                                        <TextBlock
                                                Margin="0"
                                                VerticalAlignment="Center"
                                                Classes="section-title"
                                                Text="Repositories" />
                                        <Border
                                                Padding="8,3"
                                                VerticalAlignment="Center"
                                                Background="{DynamicResource RowHoverBackgroundBrush}"
                                                CornerRadius="{DynamicResource ChipRadius}"
                                                ToolTip.Tip="Repositories matching the current filters">
                                                <TextBlock
                                                        VerticalAlignment="Center"
                                                        FontSize="13"
                                                        FontWeight="SemiBold"
                                                        Foreground="{DynamicResource BodyForegroundBrush}"
                                                        Text="{Binding FilteredRepos.Count}" />
                                        </Border>
                                        <!--
                                                Cross-repo stat chips behind a hairline divider, mirroring
                                                the table cells' treatments: the changes pill (amber tint,
                                                like the per-row modified count) leads, then the GitHub
                                                pull-request / issue chips (same tinted pills, icons and
                                                accent colors as the GitHub column's chips). The GitHub pair
                                                shows together while the GitHub column is on and at least
                                                one is open — an all-zero pair is noise, like the per-row
                                                chips — while the changes pill waits for the first change
                                                instead of showing an amber zero.
                                        -->
                                        <Border Classes="vertical-divider" IsVisible="{Binding HasHeaderStats}" />
                                        <StackPanel Orientation="Horizontal" Spacing="8">
                                                <Border
                                                        Padding="9,4"
                                                        VerticalAlignment="Center"
                                                        Background="{DynamicResource ChangesChipBrush}"
                                                        CornerRadius="{DynamicResource ChipRadius}"
                                                        IsVisible="{Binding HasChangesTotal}"
                                                        ToolTip.Tip="Uncommitted file changes across all repositories">
                                                        <TextBlock
                                                                VerticalAlignment="Center"
                                                                FontSize="12"
                                                                FontWeight="SemiBold"
                                                                Foreground="{DynamicResource WarningAccentBrush}"
                                                                Text="{Binding GitTotalModifiedCount}" />
                                                </Border>
                                                <Border
                                                        Padding="9,4"
                                                        VerticalAlignment="Center"
                                                        Background="{DynamicResource GitHubPrChipBrush}"
                                                        CornerRadius="{DynamicResource ChipRadius}"
                                                        IsVisible="{Binding HasGitHubTotals}"
                                                        ToolTip.Tip="Open pull requests across all GitHub repositories">
                                                        <StackPanel Orientation="Horizontal" Spacing="6">
                                                                <Path
                                                                        Width="13"
                                                                        Height="13"
                                                                        VerticalAlignment="Center"
                                                                        Data="{tools:SvgPath icon-git-pull-request}"
                                                                        Fill="{DynamicResource PurpleAccentBrush}"
                                                                        Stretch="Uniform" />
                                                                <TextBlock
                                                                        VerticalAlignment="Center"
                                                                        FontSize="12"
                                                                        FontWeight="SemiBold"
                                                                        Foreground="{DynamicResource PurpleAccentBrush}"
                                                                        Text="{Binding GitHubTotalPrCount}" />
                                                        </StackPanel>
                                                </Border>
                                                <Border
                                                        Padding="9,4"
                                                        VerticalAlignment="Center"
                                                        Background="{DynamicResource GitHubIssueChipBrush}"
                                                        CornerRadius="{DynamicResource ChipRadius}"
                                                        IsVisible="{Binding HasGitHubTotals}"
                                                        ToolTip.Tip="Open issues across all GitHub repositories">
                                                        <StackPanel Orientation="Horizontal" Spacing="6">
                                                                <Path
                                                                        Width="13"
                                                                        Height="13"
                                                                        VerticalAlignment="Center"
                                                                        Data="{tools:SvgPath icon-issue}"
                                                                        Fill="{DynamicResource StatusActiveBrush}"
                                                                        Stretch="Uniform" />
                                                                <TextBlock
                                                                        VerticalAlignment="Center"
                                                                        FontSize="12"
                                                                        FontWeight="SemiBold"
                                                                        Foreground="{DynamicResource StatusActiveBrush}"
                                                                        Text="{Binding GitHubTotalIssueCount}" />
                                                        </StackPanel>
                                                </Border>
                                        </StackPanel>
                                </StackPanel>
                                <!--
                                        Toolbar: tag filters, sort and page actions straight on the
                                        page background — no card border or fill. Hairline dividers
                                        still split the groups (filters / sort / actions).
                                -->
                                <StackPanel
                                        Grid.Column="1"
                                        VerticalAlignment="Center"
                                        Orientation="Horizontal"
                                        Spacing="14">
                                        <ItemsControl VerticalAlignment="Center" ItemsSource="{Binding TagFilters}">
                                                <ItemsControl.ItemsPanel>
                                                        <ItemsPanelTemplate>
                                                                <StackPanel Orientation="Horizontal" Spacing="16" />
                                                        </ItemsPanelTemplate>
                                                </ItemsControl.ItemsPanel>
                                                <ItemsControl.ItemTemplate>
                                                        <DataTemplate x:DataType="entities:TagFilter">
                                                                <CheckBox
                                                                        Command="{ReflectionBinding #Root.DataContext.TagFilterChangedCommand}"
                                                                        Content="{Binding Name}"
                                                                        IsChecked="{Binding IsChecked, Mode=TwoWay}" />
                                                        </DataTemplate>
                                                </ItemsControl.ItemTemplate>
                                        </ItemsControl>
                                        <Border Classes="vertical-divider" />
                                        <!--
                                                Sort selector: the whole list re-orders on pick
                                                (favorites still pin to the top). The choice is
                                                persisted in ReposSettings.SortMode.
                                        -->
                                        <ComboBox
                                                MinWidth="140"
                                                VerticalAlignment="Center"
                                                ItemsSource="{Binding SortOptions}"
                                                SelectedItem="{Binding SelectedSortOption, Mode=TwoWay}"
                                                ToolTip.Tip="Sort the repositories (favorites always stay on top)">
                                                <ComboBox.ItemTemplate>
                                                        <DataTemplate x:DataType="vm:RepoSortOption">
                                                                <TextBlock Text="{Binding Label}" />
                                                        </DataTemplate>
                                                </ComboBox.ItemTemplate>
                                        </ComboBox>
                                        <Button
                                                VerticalAlignment="Center"
                                                Classes="icon"
                                                Command="{Binding ClearTagFiltersCommand}"
                                                ToolTip.Tip="Clear selected tags">
                                                <TextBlock
                                                        VerticalAlignment="Center"
                                                        Classes="subtle"
                                                        Text="Clear" />
                                        </Button>
                                        <Border Classes="vertical-divider" />
                                        <!--
                                                Refresh: reloads the repo list and re-checks every git
                                                status; the icon gives way to the spinning ring for the
                                                whole cycle and the button stays click-locked (CanRefresh
                                                + IsEnabled). The ring is the app-wide Path.spinner style:
                                                element-space arc (13px native, no Stretch) so the circle's
                                                center is exactly the RenderTransformOrigin the rotation
                                                pivots on — same recipe as the bottom bar's commit spinner.
                                        -->
                                        <Button
                                                Classes="icon"
                                                Command="{Binding RefreshCommand}"
                                                IsEnabled="{Binding !IsRefreshing}"
                                                ToolTip.Tip="Refresh">
                                                <Panel>
                                                        <Path
                                                                Classes="icon"
                                                                IsVisible="{Binding !IsRefreshing}"
                                                                Data="{tools:SvgPath icon-refresh}" />
                                                        <Path
                                                                Width="13"
                                                                Height="13"
                                                                VerticalAlignment="Center"
                                                                IsVisible="{Binding IsRefreshing}"
                                                                Classes="spinner"
                                                                RenderTransformOrigin="50%,50%"
                                                                Data="{tools:SvgPath icon-spinner, Center=False}"
                                                                Stroke="{DynamicResource MutedForegroundBrush}"
                                                                StrokeThickness="2">
                                                                <Path.RenderTransform>
                                                                        <RotateTransform />
                                                                </Path.RenderTransform>
                                                        </Path>
                                                </Panel>
                                        </Button>
                                        <!--
                                                Add repository: picks a folder, scans it for git repos and
                                                tracks the ones the user selects (dialog via DialogService)
                                        -->
                                        <Button
                                                VerticalAlignment="Center"
                                                Classes="Outlined"
                                                Command="{Binding AddRepositoryCommand}"
                                                ToolTip.Tip="Scan a folder for git repositories and add them to the list">
                                                <StackPanel Orientation="Horizontal" Spacing="6">
                                                        <Path
                                                                Width="14"
                                                                Height="14"
                                                                VerticalAlignment="Center"
                                                                Data="{tools:SvgPath icon-plus}"
                                                                Fill="{Binding $parent[Button].Foreground}"
                                                                Stretch="Uniform" />
                                                        <TextBlock VerticalAlignment="Center" Text="Add Repository" />
                                                </StackPanel>
                                        </Button>
                                        <Button
                                                Classes="icon"
                                                Command="{Binding OpenSettingsCommand}"
                                                ToolTip.Tip="Settings">
                                                <Path Classes="icon" Data="{tools:SvgPath icon-cog}" />
                                        </Button>
                                </StackPanel>
                        </Grid>

                        <!--
                                Table of repo rows inside a single card surface, no header row.
                                ListBox provides the internal ScrollViewer + VirtualizingStackPanel
                                viewport needed to actually virtualize: only the rows in (or near)
                                the viewport are realized, instead of building every row up front.
                                Selection is neutralized below (the rows are non-interactive
                                containers; all actions are buttons inside the template), and the
                                default list chrome (background, border, padding, focus visual,
                                selected/pressed states) is cleared so only the row hover tint shows.
                        -->
                        <Border
                                Grid.Row="1"
                                Grid.Column="0"
                                Padding="0"
                                Classes="card">
                                <ListBox
                                        x:Name="ReposList"
                                        Padding="0"
                                        Background="Transparent"
                                        BorderThickness="0"
                                        ItemsSource="{Binding FilteredRepos}"
                                        ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                                        SelectionChanged="OnRepoSelectionChanged"
                                        SelectionMode="Single">
                                        <ListBox.ItemsPanel>
                                                <ItemsPanelTemplate>
                                                        <VirtualizingStackPanel />
                                                </ItemsPanelTemplate>
                                        </ListBox.ItemsPanel>
                                        <ListBox.Styles>
                                                <!--
                                                        Drop the per-item list chrome so each row renders as a plain content
                                                        host. All row actions are explicit buttons (with CommandParameter), so
                                                        ListBox selection is neither needed nor meaningful; neutralize its visual
                                                        states (rest/selected/pressed/focused) and every chrome layer behind the
                                                        rows stays transparent — rows carry no hover tint at all; only the
                                                        bar-selected repo lights up (Border.repo-row.selected below).
                                                -->
                                                <Style Selector="ListBoxItem">
                                                        <Setter Property="Padding" Value="0" />
                                                        <Setter Property="Margin" Value="0" />
                                                        <Setter Property="Background" Value="Transparent" />
                                                        <Setter Property="FocusAdorner" Value="{x:Null}" />
                                                </Style>
                                                <!--
                                                        The theme's pseudoclass selectors (e.g. ListBoxItem:pointerover) beat the
                                                        plain ListBoxItem style above by specificity, so repeat the neutralization
                                                        at matching specificity to keep hover/press/selection chrome invisible.
                                                -->
                                                <Style Selector="ListBoxItem:pointerover">
                                                        <Setter Property="Background" Value="Transparent" />
                                                </Style>
                                                <Style Selector="ListBoxItem:pressed">
                                                        <Setter Property="Background" Value="Transparent" />
                                                </Style>
                                                <Style Selector="ListBoxItem:selected">
                                                        <Setter Property="Background" Value="Transparent" />
                                                </Style>
                                                <Style Selector="ListBoxItem:selected /template/ ContentPresenter">
                                                        <Setter Property="Background" Value="Transparent" />
                                                </Style>
                                                <Style Selector="ListBoxItem:pointerover /template/ ContentPresenter">
                                                        <Setter Property="Background" Value="Transparent" />
                                                </Style>
                                                <Style Selector="ListBoxItem:pressed /template/ ContentPresenter">
                                                        <Setter Property="Background" Value="Transparent" />
                                                </Style>
                                                <!--
                                                        The bar's selected repo keeps the same tint the rows used to
                                                        show on hover, so the row feeding the bottom bar stays findable
                                                        in the shrunken table. This is the row's only highlight —
                                                        hover deliberately paints nothing.
                                                -->
                                                <Style Selector="Border.repo-row.selected">
                                                        <Setter Property="Background" Value="{DynamicResource RowHoverBackgroundBrush}" />
                                                </Style>
                                                <!--
                                                        SukiTheme's app-wide ListBoxItem ControlTheme replaces the item
                                                        template with a GlassCard that carries a CircleCheck tick
                                                        (PathIcon#CheckSelected) fading in while :selected, plus a
                                                        SukiPrimaryColor tint on selected/hover. Those template parts
                                                        aren't reachable by the ContentPresenter overrides above, so
                                                        neutralize them at matching specificity as well. The tick is
                                                        collapsed outright rather than faded — the theme only hides
                                                        it with Opacity, which still reserves its 17px width + 8px
                                                        margin as a dead inset on the right of every row. (The
                                                        GlassCard's own Padding="8,4" would need a full retemplate to
                                                        change — template-local values beat style setters.)
                                                -->
                                                <Style Selector="ListBoxItem /template/ PathIcon#CheckSelected">
                                                        <Setter Property="IsVisible" Value="False" />
                                                </Style>
                                                <!--
                                                        Row appearance must be instant: the row's GlassCard attaches
                                                        composition implicit animations on load while its IsAnimated
                                                        flag (default true) is set — a 700ms opacity+offset fade/slide
                                                        on the card's root panel and 450ms size+offset on its border
                                                        layers, re-fired every time virtualization realizes a row.
                                                        IsAnimated=False (the same switch SukiUI's own ".Control"
                                                        variant uses) skips that attach entirely.
                                                -->
                                                <Style Selector="ListBoxItem /template/ suki|GlassCard#BorderBasicStyle">
                                                        <Setter Property="IsAnimated" Value="False" />
                                                        <Setter Property="Background" Value="Transparent" />
                                                        <Setter Property="BorderThickness" Value="0" />
                                                </Style>
                                                <!--
                                                        Every button in the rows (star, launch actions, chips) inherits
                                                        the SukiUI Button theme's transitions (background/foreground/
                                                        border/opacity/render-transform, 0.1–0.35s) plus the app-wide
                                                        Button.tool-button hover transition. An empty Transitions
                                                        collection scoped to this list makes every state change inside
                                                        the rows instant; the hover/press feedback itself stays, it just
                                                        no longer animates.
                                                -->
                                                <Style Selector="Button">
                                                        <Setter Property="Transitions">
                                                                <Transitions />
                                                        </Setter>
                                                </Style>
                                                <Style Selector="ListBoxItem:pointerover /template/ suki|GlassCard#BorderBasicStyle">
                                                        <Setter Property="Background" Value="Transparent" />
                                                </Style>
                                                <Style Selector="ListBoxItem:selected /template/ suki|GlassCard#BorderBasicStyle">
                                                        <Setter Property="Background" Value="Transparent" />
                                                        <Setter Property="BorderThickness" Value="0" />
                                                </Style>
                                        </ListBox.Styles>
                                        <ListBox.ItemTemplate>
                                                <DataTemplate x:DataType="entities:Repo">
                                                        <!--
                                                                One table row: the bottom hairline is the row separator. The
                                                                name column is the only stretching one — it absorbs all
                                                                resize slack; branch, changes and datetime are fixed-width
                                                                and shortcuts/GitHub/Azure content-sized, so every realized
                                                                row resolves identical column widths and the table stays
                                                                aligned without a header or shared-size machinery.
                                                                Column order: star, name, launch shortcuts, branch, changes,
                                                                GitHub, Azure DevOps, last activity. The shortcut column is
                                                                content-sized (Auto) but constant per machine — every button in
                                                                it is gated by app-wide availability flags, and the
                                                                open-solution slot reserves its width even when a repo has no
                                                                .sln, so the cell stays the same width in every row.
                                                        -->
                                                        <Border
                                                                MinHeight="56"
                                                                Padding="12,0"
                                                                Classes="repo-row"
                                                                Classes.selected="{Binding IsBarSelected}"
                                                                PointerPressed="OnCardPointerPressed">
                                                                <Grid VerticalAlignment="Center">
                                                                        <Grid.ColumnDefinitions>
                                                                                <ColumnDefinition Width="Auto" />
                                                                                <ColumnDefinition Width="*" MinWidth="130" />
                                                                                <ColumnDefinition Width="Auto" />
                                                                                <ColumnDefinition Width="{StaticResource BranchColumnWidth}" />
                                                                                <ColumnDefinition Width="175" />
                                                                                <ColumnDefinition Width="Auto" />
                                                                                <ColumnDefinition Width="Auto" />
                                                                                <ColumnDefinition Width="70" />
                                                                        </Grid.ColumnDefinitions>

                                                                        <!--  Favorite star  -->
                                                                        <Button
                                                                                Grid.Column="0"
                                                                                VerticalAlignment="Center"
                                                                                Classes="icon"
                                                                                Command="{ReflectionBinding #Root.DataContext.ToggleFavoriteCommand}"
                                                                                CommandParameter="{Binding}"
                                                                                ToolTip.Tip="Toggle favorite">
                                                                                <Path
                                                                                        Width="16"
                                                                                        Height="16"
                                                                                        Data="{tools:SvgPath icon-star}"
                                                                                        Fill="{Binding Tags, Converter={StaticResource FavoriteStarBrushConverter}}"
                                                                                        Stretch="Uniform" />
                                                                        </Button>

                                                                        <!--  Repository name; the folder path lives on the tooltip  -->
                                                                        <TextBlock
                                                                                Grid.Column="1"
                                                                                Margin="0,0,16,0"
                                                                                VerticalAlignment="Center"
                                                                                FontSize="15"
                                                                                FontWeight="SemiBold"
                                                                                Foreground="{DynamicResource TitleForegroundBrush}"
                                                                                Text="{Binding Name}"
                                                                                TextTrimming="CharacterEllipsis"
                                                                                ToolTip.Tip="{Binding FolderPath}" />

                                                                        <!--
                                                                                Launch actions (icon-only; tooltips name the actions).
                                                                                OpenCode leads the row: quick open plus a minimal options
                                                                                button, set apart from the other launch buttons by a
                                                                                hairline divider.
                                                                        -->
                                                                        <StackPanel
                                                                                Grid.Column="2"
                                                                                Margin="0,0,16,0"
                                                                                VerticalAlignment="Center"
                                                                                Orientation="Horizontal"
                                                                                Spacing="8">
                                                                                <StackPanel
                                                                                        IsVisible="{ReflectionBinding #Root.DataContext.HasOpenCode}"
                                                                                        Orientation="Horizontal"
                                                                                        Spacing="8">
                                                                                        <Button
                                                                                                Classes="tool-button"
                                                                                                Command="{ReflectionBinding #Root.DataContext.QuickOpenOpenCodeCommand}"
                                                                                                CommandParameter="{Binding}"
                                                                                                ToolTip.Tip="Launch one opencode instance with the default model">
                                                                                                <Path
                                                                                                        Width="22"
                                                                                                        Height="22"
                                                                                                        Data="{tools:SvgPath icon-opencode}"
                                                                                                        Fill="{DynamicResource StatusActiveBrush}"
                                                                                                        Stretch="Uniform" />
                                                                                        </Button>
                                                                                        <Button
                                                                                                Width="40"
                                                                                                Height="40"
                                                                                                VerticalAlignment="Center"
                                                                                                Classes="icon"
                                                                                                Command="{ReflectionBinding #Root.DataContext.OpenOpenCodeCommand}"
                                                                                                CommandParameter="{Binding}"
                                                                                                ToolTip.Tip="Open the OpenCode panel (model, instances, template, prompt)">
                                                                                                <Path
                                                                                                        Width="18"
                                                                                                        Height="18"
                                                                                                        Data="{tools:SvgPath icon-options}"
                                                                                                        Fill="{DynamicResource MutedForegroundBrush}"
                                                                                                        Stretch="Uniform" />
                                                                                        </Button>
                                                                                        <Border Classes="vertical-divider" />
                                                                                </StackPanel>
                                                                                <Button
                                                                                        Classes="tool-button"
                                                                                        Command="{ReflectionBinding #Root.DataContext.OpenWithZCodeCommand}"
                                                                                        CommandParameter="{Binding}"
                                                                                        IsVisible="{ReflectionBinding #Root.DataContext.HasZCode}"
                                                                                        ToolTip.Tip="Open zcode on this repo (AppImage opens the desktop app)">
                                                                                        <Path
                                                                                                Width="22"
                                                                                                Height="22"
                                                                                                Data="{tools:SvgPath icon-zcode}"
                                                                                                Fill="{DynamicResource MutedForegroundBrush}"
                                                                                                Stretch="Uniform" />
                                                                                </Button>
                                                                                <!--
                                                                                        The open-solution button is a Visual Studio
                                                                                        shortcut: HasIde requires the EnableVisualStudio
                                                                                        toggle and Windows (VS exists nowhere else).
                                                                                        The 40px slot stays reserved for repos without
                                                                                        a solution so the table columns stay aligned.
                                                                                -->
                                                                                <Border Width="40" IsVisible="{ReflectionBinding #Root.DataContext.HasIde}">
                                                                                        <Button
                                                                                                Classes="tool-button"
                                                                                                Command="{ReflectionBinding #Root.DataContext.OpenVisualStudioCommand}"
                                                                                                CommandParameter="{Binding}"
                                                                                                IsVisible="{Binding SolutionPath, Converter={StaticResource StringNotNullToBoolConverter}}"
                                                                                                ToolTip.Tip="Open in Visual Studio">
                                                                                                <Path
                                                                                                        Width="22"
                                                                                                        Height="22"
                                                                                                        Data="{tools:SvgPath icon-sln-box}"
                                                                                                        Fill="{DynamicResource PurpleAccentBrush}"
                                                                                                        Stretch="Uniform" />
                                                                                        </Button>
                                                                                </Border>
                                                                                <Button
                                                                                        Classes="tool-button"
                                                                                        Command="{ReflectionBinding #Root.DataContext.OpenWithVSCodeCommand}"
                                                                                        CommandParameter="{Binding FolderPath}"
                                                                                        IsVisible="{ReflectionBinding #Root.DataContext.HasVSCode}"
                                                                                        ToolTip.Tip="Open in VS Code">
                                                                                        <Path
                                                                                                Width="22"
                                                                                                Height="22"
                                                                                                Data="{tools:SvgPath icon-vscode}"
                                                                                                Fill="{DynamicResource InfoAccentBrush}"
                                                                                                Stretch="Uniform" />
                                                                                </Button>
                                                                                <Button
                                                                                        Classes="tool-button"
                                                                                        Command="{ReflectionBinding #Root.DataContext.OpenFolderCommand}"
                                                                                        CommandParameter="{Binding FolderPath}"
                                                                                        ToolTip.Tip="Open folder">
                                                                                        <Path
                                                                                                Width="22"
                                                                                                Height="22"
                                                                                                Data="{tools:SvgPath icon-folder}"
                                                                                                Fill="{DynamicResource WarningAccentBrush}"
                                                                                                Stretch="Uniform" />
                                                                                </Button>
                                                                                <Button
                                                                                        Classes="tool-button"
                                                                                        Command="{ReflectionBinding #Root.DataContext.OpenWithTerminalCommand}"
                                                                                        CommandParameter="{Binding FolderPath}"
                                                                                        IsVisible="{ReflectionBinding #Root.DataContext.HasTerminal}"
                                                                                        ToolTip.Tip="Open in Terminal">
                                                                                        <Path
                                                                                                Width="22"
                                                                                                Height="22"
                                                                                                Data="{tools:SvgPath icon-terminal}"
                                                                                                Fill="{DynamicResource StatusActiveBrush}"
                                                                                                Stretch="Uniform" />
                                                                                </Button>
                                                                        </StackPanel>


                                                                        <!--
                                                                                Branch: colorized pill
                                                                                (main/develop/release/master pick up
                                                                                their own tint, everything else goes
                                                                                muted gray), or the checking
                                                                                placeholder. Clicking the pill opens
                                                                                the bottom bar's Changes tab for this
                                                                                repo. The pill sits in its own
                                                                                fixed-width column; an over-long
                                                                                name is tail-trimmed by the pill's
                                                                                text ("..name") instead of bleeding
                                                                                into the stats cell next door.
                                                                        -->
                                                                        <Grid Grid.Column="3" Margin="0,0,16,0">
                                                                                <Button
                                                                                        Padding="9,4"
                                                                                        HorizontalAlignment="Left"
                                                                                        VerticalAlignment="Center"
                                                                                        Background="{Binding GitBranchName, Converter={StaticResource BranchChipBrushConverter}, ConverterParameter=bg}"
                                                                                        BorderThickness="0"
                                                                                        Classes="chip-hover-dim"
                                                                                        ClipToBounds="True"
                                                                                        Command="{ReflectionBinding #Root.DataContext.OpenChangesCommand}"
                                                                                        CommandParameter="{Binding}"
                                                                                        CornerRadius="{DynamicResource ChipRadius}"
                                                                                        Cursor="Hand"
                                                                                        IsVisible="{Binding GitBranchName, Converter={StaticResource StringNullOrEmptyToVisibilityConverter}}"
                                                                                        ToolTip.Tip="{Binding GitBranchName}">
                                                                                        <Grid ColumnDefinitions="Auto,*" ColumnSpacing="6">
                                                                                                <Path
                                                                                                        Grid.Column="0"
                                                                                                        Width="12"
                                                                                                        Height="12"
                                                                                                        VerticalAlignment="Center"
                                                                                                        Data="{tools:SvgPath icon-source-branch}"
                                                                                                        Fill="{Binding GitBranchName, Converter={StaticResource BranchChipBrushConverter}}"
                                                                                                        Stretch="Uniform" />
                                                                                                <!--
                                                                                                        Budget from the BranchColumnWidth resource — see the
                                                                                                        paired resources at the page top. The pill button's
                                                                                                        tooltip carries the full branch name (the visible
                                                                                                        label is tail-trimmed at this budget).
                                                                                                -->
                                                                                                <lib:TailTrimmingTextBlock
                                                                                                        Grid.Column="1"
                                                                                                        MaxWidth="{StaticResource BranchTextBudget}"
                                                                                                        VerticalAlignment="Center"
                                                                                                        FontSize="12"
                                                                                                        FontWeight="SemiBold"
                                                                                                        Foreground="{Binding GitBranchName, Converter={StaticResource BranchChipBrushConverter}}"
                                                                                                        FullText="{Binding GitBranchName}" />
                                                                                        </Grid>
                                                                                </Button>
                                                                                <TextBlock
                                                                                        HorizontalAlignment="Left"
                                                                                        VerticalAlignment="Center"
                                                                                        Classes="subtle"
                                                                                        IsVisible="{Binding !GitStatusLoaded}"
                                                                                        Text="checking…" />
                                                                        </Grid>

                                                                        <!--
                                                                                Git stats split to two columns: the modified
                                                                                count pill right-aligned in a FIXED 48px column
                                                                                (the badges align down the table), "Changes (↑↓)"
                                                                                left-aligned after it — an auto-width pill let
                                                                                the text drift row to row. ONLY the count pill
                                                                                is clickable and opens the bottom bar's Changes
                                                                                tab (same command as the branch pill) — the
                                                                                "Changes (↑↓)" text next to it is inert.
                                                                        -->
                                                                        <Grid
                                                                                Grid.Column="4"
                                                                                Margin="0,0,16,0"
                                                                                VerticalAlignment="Center"
                                                                                ColumnDefinitions="48,*">
                                                                                <!--  Count pill: right-aligned in its fixed column.  -->
                                                                                <Button
                                                                                        Grid.Column="0"
                                                                                        Padding="0"
                                                                                        HorizontalAlignment="Right"
                                                                                        VerticalAlignment="Center"
                                                                                        Background="Transparent"
                                                                                        BorderThickness="0"
                                                                                        Classes="chip-hover-dim"
                                                                                        Command="{ReflectionBinding #Root.DataContext.OpenChangesCommand}"
                                                                                        CommandParameter="{Binding}"
                                                                                        Cursor="Hand"
                                                                                        IsVisible="{Binding GitStatusLoaded}"
                                                                                        ToolTip.Tip="Open the changes panel">
                                                                                                <Border
                                                                                                        Padding="9,4"
                                                                                                        VerticalAlignment="Center"
                                                                                                        Background="{DynamicResource ChangesChipBrush}"
                                                                                                        CornerRadius="{DynamicResource ChipRadius}">
                                                                                                        <TextBlock
                                                                                                                VerticalAlignment="Center"
                                                                                                                FontSize="12"
                                                                                                                FontWeight="SemiBold"
                                                                                                                Foreground="{DynamicResource WarningAccentBrush}"
                                                                                                                Text="{Binding GitModifiedCount}" />
                                                                                                </Border>
                                                                                        </Button>
                                                                                        <!--  Label + ahead/behind counts: left-aligned after
                                                                                              the fixed pill column, same x on every row.  -->
                                                                                        <StackPanel
                                                                                                Grid.Column="1"
                                                                                                Orientation="Horizontal"
                                                                                                IsVisible="{Binding GitStatusLoaded}">
                                                                                        <TextBlock
                                                                                                Margin="6,0,0,0"
                                                                                                VerticalAlignment="Center"
                                                                                                FontSize="12"
                                                                                                Text="Changes" />
                                                                                        <TextBlock
                                                                                                Margin="5,0,0,0"
                                                                                                VerticalAlignment="Center"
                                                                                                Classes="subtle"
                                                                                                Text="(" />
                                                                                        <TextBlock
                                                                                                VerticalAlignment="Center"
                                                                                                FontSize="12"
                                                                                                FontWeight="SemiBold"
                                                                                                Foreground="{DynamicResource StatusActiveBrush}"
                                                                                                Text="{Binding GitToPushCount}" />
                                                                                        <Path
                                                                                                Width="10"
                                                                                                Height="10"
                                                                                                Margin="1,0,0,0"
                                                                                                VerticalAlignment="Center"
                                                                                                Data="{tools:SvgPath icon-arrow-up}"
                                                                                                Fill="{DynamicResource StatusActiveBrush}"
                                                                                                Stretch="Uniform" />
                                                                                        <TextBlock
                                                                                                Margin="2,0,0,0"
                                                                                                VerticalAlignment="Center"
                                                                                                Classes="subtle"
                                                                                                Text="," />
                                                                                        <TextBlock
                                                                                                Margin="4,0,0,0"
                                                                                                VerticalAlignment="Center"
                                                                                                FontSize="12"
                                                                                                FontWeight="SemiBold"
                                                                                                Foreground="{DynamicResource InfoAccentBrush}"
                                                                                                Text="{Binding GitToPullCount}" />
                                                                                        <Path
                                                                                                Width="10"
                                                                                                Height="10"
                                                                                                Margin="1,0,0,0"
                                                                                                VerticalAlignment="Center"
                                                                                                Data="{tools:SvgPath icon-arrow-down}"
                                                                                                Fill="{DynamicResource InfoAccentBrush}"
                                                                                                Stretch="Uniform" />
                                                                                        <TextBlock
                                                                                                Margin="2,0,0,0"
                                                                                                VerticalAlignment="Center"
                                                                                                Classes="subtle"
                                                                                                Text=")" />
                                                                                        </StackPanel>
                                                                                <TextBlock
                                                                                        Grid.Column="0"
                                                                                        Grid.ColumnSpan="2"
                                                                                        HorizontalAlignment="Left"
                                                                                        Classes="subtle"
                                                                                        IsVisible="{Binding !GitStatusLoaded}"
                                                                                        Text="checking…" />
                                                                        </Grid>

                                                                        <!--
                                                                                GitHub: one chip per item kind with
                                                                                open counts; clicking a chip opens
                                                                                the bottom bar's matching tab (pull
                                                                                requests / issues). Only kinds with
                                                                                open items show a chip, a GitHub
                                                                                repo with nothing open shows a
                                                                                quiet tick, and anything without a
                                                                                GitHub remote stays empty. The
                                                                                whole cell hides when the settings
                                                                                disable the column — the gh probing
                                                                                stops with it. The cell is a
                                                                                FIXED-width border so the Auto
                                                                                column resolves identically in
                                                                                every row (rows are independent
                                                                                grids; Auto sized to varying chip
                                                                                sets would let the columns to the
                                                                                right drift per row), and it
                                                                                collapses to zero width when the
                                                                                column is off.
                                                                        -->
                                                                        <Border
                                                                                Grid.Column="5"
                                                                                Width="140"
                                                                                Margin="0,0,16,0"
                                                                                HorizontalAlignment="Left"
                                                                                ClipToBounds="True"
                                                                                IsVisible="{ReflectionBinding #Root.DataContext.IsGitHubColumnVisible}">
                                                                                <StackPanel
                                                                                        VerticalAlignment="Center"
                                                                                        Orientation="Horizontal"
                                                                                        Spacing="8">
                                                                                        <Button
                                                                                                Padding="9,4"
                                                                                                VerticalAlignment="Center"
                                                                                                Background="{DynamicResource GitHubPrChipBrush}"
                                                                                                BorderThickness="0"
                                                                                                Command="{ReflectionBinding #Root.DataContext.OpenPullRequestsCommand}"
                                                                                                CommandParameter="{Binding}"
                                                                                                CornerRadius="{DynamicResource ChipRadius}"
                                                                                                IsVisible="{Binding HasGitHubPullRequests}"
                                                                                                ToolTip.Tip="Open pull requests — click for details">
                                                                                                <StackPanel Orientation="Horizontal" Spacing="6">
                                                                                                        <Path
                                                                                                                Width="13"
                                                                                                                Height="13"
                                                                                                                VerticalAlignment="Center"
                                                                                                                Data="{tools:SvgPath icon-git-pull-request}"
                                                                                                                Fill="{DynamicResource PurpleAccentBrush}"
                                                                                                                Stretch="Uniform" />
                                                                                                        <TextBlock
                                                                                                                VerticalAlignment="Center"
                                                                                                                FontSize="12"
                                                                                                                FontWeight="SemiBold"
                                                                                                                Foreground="{DynamicResource PurpleAccentBrush}"
                                                                                                                Text="{Binding GitHubPrCount}" />
                                                                                                </StackPanel>
                                                                                        </Button>
                                                                                        <Button
                                                                                                Padding="9,4"
                                                                                                VerticalAlignment="Center"
                                                                                                Background="{DynamicResource GitHubIssueChipBrush}"
                                                                                                BorderThickness="0"
                                                                                                Command="{ReflectionBinding #Root.DataContext.OpenIssuesCommand}"
                                                                                                CommandParameter="{Binding}"
                                                                                                CornerRadius="{DynamicResource ChipRadius}"
                                                                                                IsVisible="{Binding HasGitHubIssues}"
                                                                                                ToolTip.Tip="Open issues — click for details">
                                                                                                <StackPanel Orientation="Horizontal" Spacing="6">
                                                                                                        <Path
                                                                                                                Width="13"
                                                                                                                Height="13"
                                                                                                                VerticalAlignment="Center"
                                                                                                                Data="{tools:SvgPath icon-issue}"
                                                                                                                Fill="{DynamicResource StatusActiveBrush}"
                                                                                                                Stretch="Uniform" />
                                                                                                        <TextBlock
                                                                                                                VerticalAlignment="Center"
                                                                                                                FontSize="12"
                                                                                                                FontWeight="SemiBold"
                                                                                                                Foreground="{DynamicResource StatusActiveBrush}"
                                                                                                                Text="{Binding GitHubIssueCount}" />
                                                                                                </StackPanel>
                                                                                        </Button>
                                                                                        <!--
                                                                                                All-clear tick in the disabled
                                                                                                tone (FaintForegroundBrush =
                                                                                                SukiDisabledText): present without
                                                                                                inviting a click — there is
                                                                                                nothing to open here.
                                                                                        -->
                                                                                        <Path
                                                                                                Width="14"
                                                                                                Height="14"
                                                                                                VerticalAlignment="Center"
                                                                                                Data="{tools:SvgPath icon-check,
                                                                                                                     Center=False}"
                                                                                                Fill="{DynamicResource FaintForegroundBrush}"
                                                                                                IsVisible="{Binding IsGitHubAllClear}"
                                                                                                Stretch="Uniform"
                                                                                                ToolTip.Tip="No open pull requests or issues" />
                                                                                </StackPanel>
                                                                        </Border>

                                                                        <!--
                                                                                Azure DevOps: the repo link plus one chip per
                                                                                activity kind — active pull-request count, open
                                                                                work-item count (the hosting project's items) and
                                                                                the latest pipeline run's state. Clicking a chip
                                                                                opens the details dialog. Only kinds with data show
                                                                                a chip, an Azure DevOps repo with nothing open and
                                                                                no failing pipeline shows "OK", and anything without
                                                                                an Azure DevOps remote stays empty. The whole cell
                                                                                hides when the settings disable the column — the
                                                                                REST probing stops with it. Like the GitHub cell it
                                                                                is a FIXED-width border so the Auto column resolves
                                                                                identically in every row.
                                                                        -->
                                                                        <Border
                                                                                Grid.Column="6"
                                                                                Width="200"
                                                                                Margin="0,0,16,0"
                                                                                HorizontalAlignment="Left"
                                                                                ClipToBounds="True"
                                                                                IsVisible="{ReflectionBinding #Root.DataContext.IsAzureDevOpsColumnVisible}">
                                                                                <StackPanel
                                                                                        VerticalAlignment="Center"
                                                                                        Orientation="Horizontal"
                                                                                        Spacing="8">
                                                                                        <Button
                                                                                                Width="32"
                                                                                                Height="32"
                                                                                                Padding="7"
                                                                                                VerticalAlignment="Center"
                                                                                                Classes="icon"
                                                                                                Command="{ReflectionBinding #Root.DataContext.OpenAzureDevOpsRepoCommand}"
                                                                                                CommandParameter="{Binding}"
                                                                                                IsVisible="{Binding AzureDevOpsRepoUrl, Converter={StaticResource StringNotNullToBoolConverter}}"
                                                                                                ToolTip.Tip="Open in Azure DevOps">
                                                                                                <Path
                                                                                                        Width="17"
                                                                                                        Height="17"
                                                                                                        Data="{tools:SvgPath icon-azure-devops}"
                                                                                                        Fill="{DynamicResource MutedForegroundBrush}"
                                                                                                        Stretch="Uniform" />
                                                                                        </Button>
                                                                                        <Button
                                                                                                Padding="9,4"
                                                                                                VerticalAlignment="Center"
                                                                                                Background="{DynamicResource AzureDevOpsPrChipBrush}"
                                                                                                BorderThickness="0"
                                                                                                Command="{ReflectionBinding #Root.DataContext.OpenAzureDevOpsDetailsCommand}"
                                                                                                CommandParameter="{Binding}"
                                                                                                CornerRadius="{DynamicResource ChipRadius}"
                                                                                                IsVisible="{Binding HasAzureDevOpsPullRequests}"
                                                                                                ToolTip.Tip="Active pull requests — click for details">
                                                                                                <StackPanel Orientation="Horizontal" Spacing="6">
                                                                                                        <Path
                                                                                                                Width="13"
                                                                                                                Height="13"
                                                                                                                VerticalAlignment="Center"
                                                                                                                Data="{tools:SvgPath icon-git-pull-request}"
                                                                                                                Fill="{DynamicResource PurpleAccentBrush}"
                                                                                                                Stretch="Uniform" />
                                                                                                        <TextBlock
                                                                                                                VerticalAlignment="Center"
                                                                                                                FontSize="12"
                                                                                                                FontWeight="SemiBold"
                                                                                                                Foreground="{DynamicResource PurpleAccentBrush}"
                                                                                                                Text="{Binding AzureDevOpsPrCount}" />
                                                                                                </StackPanel>
                                                                                        </Button>
                                                                                        <Button
                                                                                                Padding="9,4"
                                                                                                VerticalAlignment="Center"
                                                                                                Background="{DynamicResource AzureDevOpsWorkItemChipBrush}"
                                                                                                BorderThickness="0"
                                                                                                Command="{ReflectionBinding #Root.DataContext.OpenAzureDevOpsDetailsCommand}"
                                                                                                CommandParameter="{Binding}"
                                                                                                CornerRadius="{DynamicResource ChipRadius}"
                                                                                                IsVisible="{Binding HasAzureDevOpsWorkItems}"
                                                                                                ToolTip.Tip="Open work items — click for details">
                                                                                                <StackPanel Orientation="Horizontal" Spacing="6">
                                                                                                        <Path
                                                                                                                Width="13"
                                                                                                                Height="13"
                                                                                                                VerticalAlignment="Center"
                                                                                                                Data="{tools:SvgPath icon-issue}"
                                                                                                                Fill="{DynamicResource StatusActiveBrush}"
                                                                                                                Stretch="Uniform" />
                                                                                                        <TextBlock
                                                                                                                VerticalAlignment="Center"
                                                                                                                FontSize="12"
                                                                                                                FontWeight="SemiBold"
                                                                                                                Foreground="{DynamicResource StatusActiveBrush}"
                                                                                                                Text="{Binding AzureDevOpsWorkItemCount}" />
                                                                                                </StackPanel>
                                                                                        </Button>
                                                                                        <!--
                                                                                                Latest pipeline run: one button per state so each
                                                                                                carries its own tinted background and glyph.
                                                                                        -->
                                                                                        <Panel VerticalAlignment="Center">
                                                                                                <Button
                                                                                                        Padding="9,4"
                                                                                                        VerticalAlignment="Center"
                                                                                                        Background="{DynamicResource AzureDevOpsPipelineOkChipBrush}"
                                                                                                        BorderThickness="0"
                                                                                                        Command="{ReflectionBinding #Root.DataContext.OpenAzureDevOpsDetailsCommand}"
                                                                                                        CommandParameter="{Binding}"
                                                                                                        CornerRadius="{DynamicResource ChipRadius}"
                                                                                                        IsVisible="{Binding IsAzureDevOpsPipelineOk}"
                                                                                                        ToolTip.Tip="{Binding AzureDevOpsPipelineInfo}">
                                                                                                        <Path
                                                                                                                Width="13"
                                                                                                                Height="13"
                                                                                                                VerticalAlignment="Center"
                                                                                                                Data="{tools:SvgPath icon-check,
                                                                                                                                     Center=False}"
                                                                                                                Fill="{DynamicResource StatusActiveBrush}"
                                                                                                                Stretch="Uniform" />
                                                                                                </Button>
                                                                                                <Button
                                                                                                        Padding="9,4"
                                                                                                        VerticalAlignment="Center"
                                                                                                        Background="{DynamicResource AzureDevOpsPipelineFailedChipBrush}"
                                                                                                        BorderThickness="0"
                                                                                                        Command="{ReflectionBinding #Root.DataContext.OpenAzureDevOpsDetailsCommand}"
                                                                                                        CommandParameter="{Binding}"
                                                                                                        CornerRadius="{DynamicResource ChipRadius}"
                                                                                                        IsVisible="{Binding IsAzureDevOpsPipelineFailed}"
                                                                                                        ToolTip.Tip="{Binding AzureDevOpsPipelineInfo}">
                                                                                                        <Path
                                                                                                                Width="12"
                                                                                                                Height="12"
                                                                                                                VerticalAlignment="Center"
                                                                                                                Data="{tools:SvgPath icon-close,
                                                                                                                                     Center=False}"
                                                                                                                Fill="{DynamicResource DangerAccentBrush}"
                                                                                                                Stretch="Uniform" />
                                                                                                </Button>
                                                                                                <Button
                                                                                                        Padding="9,4"
                                                                                                        VerticalAlignment="Center"
                                                                                                        Background="{DynamicResource AzureDevOpsPipelineRunningChipBrush}"
                                                                                                        BorderThickness="0"
                                                                                                        Command="{ReflectionBinding #Root.DataContext.OpenAzureDevOpsDetailsCommand}"
                                                                                                        CommandParameter="{Binding}"
                                                                                                        CornerRadius="{DynamicResource ChipRadius}"
                                                                                                        IsVisible="{Binding IsAzureDevOpsPipelineRunning}"
                                                                                                        ToolTip.Tip="{Binding AzureDevOpsPipelineInfo}">
                                                                                                        <Path
                                                                                                                Width="11"
                                                                                                                Height="11"
                                                                                                                VerticalAlignment="Center"
                                                                                                                Data="{tools:SvgPath icon-play}"
                                                                                                                Fill="{DynamicResource InfoAccentBrush}"
                                                                                                                Stretch="Uniform" />
                                                                                                </Button>
                                                                                        </Panel>
                                                                                        <TextBlock
                                                                                                VerticalAlignment="Center"
                                                                                                Classes="subtle"
                                                                                                FontSize="12"
                                                                                                IsVisible="{Binding IsAzureDevOpsAllClear}"
                                                                                                Text="OK"
                                                                                                ToolTip.Tip="No open pull requests, work items or failing pipelines" />
                                                                                </StackPanel>
                                                                        </Border>


                                                                        <!--  Last Activity: relative age of the newest commit  -->
                                                                        <TextBlock
                                                                                Grid.Column="7"
                                                                                Margin="0,0,4,0"
                                                                                HorizontalAlignment="Right"
                                                                                VerticalAlignment="Center"
                                                                                Classes="subtle"
                                                                                Text="{Binding GitLastActivity}" />

                                                                </Grid>
                                                        </Border>
                                                </DataTemplate>
                                        </ListBox.ItemTemplate>
                                </ListBox>
                        </Border>

                </Grid>

                <!--
                        Bottom bar: this page's footer (repo context, tabs, expandable
                        panel), flush with the window bottom like the mockup. Hidden until
                        a repo is selected from the table (the bar binds IsBarVisible and
                        paints its own hairlines). Its DataContext binds to the page's
                        BottomBarViewModel singleton property (assigned before
                        InitializeComponent) instead of being attached in code-behind, so
                        the bar never inherits ReposViewModel — its compiled bindings
                        (declared against BottomBarViewModel) can never cast-fail, no
                        matter when the page's own DataContext is assigned.
                -->
                <Border Grid.Row="1">
                        <components:BottomBar
                                x:Name="BottomBarControl"
                                DataContext="{Binding #Root.BottomBarViewModel}" />
                </Border>

        </Grid>
</UserControl>
