<UserControl
        x:Class="Tools.Views.Pages.ReposPage"
        xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:entities="using:Tools.Library.Entities"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:suki="https://github.com/kikipoulet/SukiUI"
        xmlns:tools="using:Tools.Library.MarkupExtensions"
        xmlns:vm="using:Tools.ViewModels.Pages"
        x:Name="Root"
        d:DesignHeight="600"
        d:DesignWidth="1000"
        x:CompileBindings="True"
        x:DataType="vm:ReposViewModel"
        mc:Ignorable="d">

        <Grid
                Margin="16"
                ColumnDefinitions="*"
                RowDefinitions="Auto,Auto,*"
                RowSpacing="16">

                <Grid
                        Grid.Row="0"
                        ColumnDefinitions="*,Auto"
                        ColumnSpacing="8">
                        <StackPanel
                                Grid.Column="0"
                                Orientation="Horizontal"
                                Spacing="8">
                                <TextBlock VerticalAlignment="Center" Classes="section-title">
                                        <Run Text="Repositories" />
                                        <Run
                                                FontSize="13"
                                                Foreground="{DynamicResource MutedForegroundBrush}"
                                                Text=" (" />
                                        <Run
                                                FontSize="13"
                                                Foreground="{DynamicResource MutedForegroundBrush}"
                                                Text="{Binding FilteredRepos.Count}" />
                                        <Run
                                                FontSize="13"
                                                Foreground="{DynamicResource MutedForegroundBrush}"
                                                Text=")" />
                                </TextBlock>
                                <!--
                                        GitHub totals: open pull requests and issues summed across
                                        every GitHub repo, beside the page title. Shows only when the
                                        GitHub column is enabled and at least one item is open — an
                                        all-zero summary is noise, like the per-row chips.
                                -->
                                <StackPanel
                                        VerticalAlignment="Center"
                                        Orientation="Horizontal"
                                        Spacing="6"
                                        IsVisible="{Binding HasGitHubTotals}"
                                        ToolTip.Tip="Open pull requests and issues across all GitHub repositories">
                                        <Path
                                                Width="15"
                                                Height="15"
                                                VerticalAlignment="Center"
                                                Data="{tools:SvgPath icon-github}"
                                                Fill="{DynamicResource MutedForegroundBrush}"
                                                Stretch="Uniform" />
                                        <Path
                                                Width="13"
                                                Height="13"
                                                VerticalAlignment="Center"
                                                Data="{tools:SvgPath icon-git-pull-request}"
                                                Fill="{DynamicResource StatusActiveBrush}"
                                                Stretch="Uniform" />
                                        <TextBlock
                                                VerticalAlignment="Center"
                                                FontSize="13"
                                                FontWeight="SemiBold"
                                                Foreground="{DynamicResource StatusActiveBrush}"
                                                Text="{Binding GitHubTotalPrCount}" />
                                        <Path
                                                Width="13"
                                                Height="13"
                                                VerticalAlignment="Center"
                                                Data="{tools:SvgPath icon-issue}"
                                                Fill="{DynamicResource WarningAccentBrush}"
                                                Stretch="Uniform" />
                                        <TextBlock
                                                VerticalAlignment="Center"
                                                FontSize="13"
                                                FontWeight="SemiBold"
                                                Foreground="{DynamicResource WarningAccentBrush}"
                                                Text="{Binding GitHubTotalIssueCount}" />
                                </StackPanel>
                        </StackPanel>
                        <StackPanel
                                Grid.Column="1"
                                Margin="0,0,0,12"
                                HorizontalAlignment="Right"
                                Classes="actions">
                                <Button
                                        Classes="icon"
                                        Command="{Binding RefreshCommand}"
                                        IsEnabled="{Binding !IsRefreshing}"
                                        ToolTip.Tip="Refresh">
                                        <Path Classes="icon" Data="{tools:SvgPath icon-refresh}" />
                                </Button>
                                <Button
                                        Classes="icon"
                                        Command="{Binding OpenSettingsCommand}"
                                        ToolTip.Tip="Settings">
                                        <Path Classes="icon" Data="{tools:SvgPath icon-cog}" />
                                </Button>
                        </StackPanel>
                </Grid>

                <Border
                        Grid.Row="1"
                        Margin="0,-16,0,0"
                        Padding="12"
                        HorizontalAlignment="Stretch"
                        Classes="card">
                        <Grid ColumnDefinitions="*,Auto,Auto,Auto,Auto,Auto" ColumnSpacing="16">
                                <TextBox
                                        Grid.Column="0"
                                        VerticalAlignment="Center"
                                        Text="{Binding FilterText, Mode=TwoWay}"
                                        Watermark="Search repositories...">
                                        <TextBox.InnerRightContent>
                                                <Button
                                                        Width="20"
                                                        Height="20"
                                                        Padding="2"
                                                        Classes="icon"
                                                        Command="{Binding ClearFilterCommand}"
                                                        IsVisible="{Binding FilterText, Converter={StaticResource StringNullOrEmptyToVisibilityConverter}}">
                                                        <Path
                                                                Width="12"
                                                                Height="12"
                                                                Data="M19,6.41 L17.59,5 L12,10.59 L6.41,5 L5,6.41 L10.59,12 L5,17.59 L6.41,19 L12,13.41 L17.59,19 L19,17.59 L13.41,12 Z"
                                                                Fill="{DynamicResource MutedForegroundBrush}"
                                                                Stretch="Uniform" />
                                                </Button>
                                        </TextBox.InnerRightContent>
                                </TextBox>
                                <Border
                                        Grid.Column="1"
                                        Margin="0,4"
                                        Classes="vertical-divider" />


                                <ItemsControl
                                        Grid.Column="2"
                                        VerticalAlignment="Center"
                                        ItemsSource="{Binding TagFilters}">
                                        <ItemsControl.ItemsPanel>
                                                <ItemsPanelTemplate>
                                                        <WrapPanel Orientation="Horizontal" />
                                                </ItemsPanelTemplate>
                                        </ItemsControl.ItemsPanel>
                                        <ItemsControl.ItemTemplate>
                                                <DataTemplate x:DataType="entities:TagFilter">
                                                        <CheckBox
                                                                Margin="0,0,12,0"
                                                                Command="{ReflectionBinding #Root.DataContext.TagFilterChangedCommand}"
                                                                Content="{Binding Name}"
                                                                IsChecked="{Binding IsChecked, Mode=TwoWay}" />
                                                </DataTemplate>
                                        </ItemsControl.ItemTemplate>
                                </ItemsControl>
                                <!--
                                        Sort selector: the whole list re-orders on pick
                                        (favorites still pin to the top). The choice is
                                        persisted in ReposSettings.SortMode.
                                -->
                                <Border
                                        Grid.Column="3"
                                        Margin="0,4"
                                        Classes="vertical-divider" />
                                <ComboBox
                                        Grid.Column="4"
                                        MinWidth="140"
                                        VerticalAlignment="Center"
                                        ItemsSource="{Binding SortOptions}"
                                        SelectedItem="{Binding SelectedSortOption, Mode=TwoWay}"
                                        ToolTip.Tip="Sort the repositories (favorites always stay on top)">
                                        <ComboBox.ItemTemplate>
                                                <DataTemplate x:DataType="vm:RepoSortOption">
                                                        <TextBlock Text="{Binding Label}" />
                                                </DataTemplate>
                                        </ComboBox.ItemTemplate>
                                </ComboBox>
                                <Button
                                        Grid.Column="5"
                                        Width="44"
                                        Padding="8,2"
                                        VerticalAlignment="Center"
                                        Classes="icon"
                                        Command="{Binding ClearTagFiltersCommand}"
                                        ToolTip.Tip="Clear search and selected tags">
                                        <TextBlock
                                                VerticalAlignment="Center"
                                                Classes="subtle"
                                                Text="Clear" />
                                </Button>
                        </Grid>
                </Border>

                <!--
                        Table of repo rows inside a single card surface, no header row.
                        ListBox provides the internal ScrollViewer + VirtualizingStackPanel
                        viewport needed to actually virtualize: only the rows in (or near)
                        the viewport are realized, instead of building every row up front.
                        Selection is neutralized below (the rows are non-interactive
                        containers; all actions are buttons inside the template), and the
                        default list chrome (background, border, padding, focus visual,
                        selected/pressed states) is cleared so only the row hover tint shows.
                -->
                <Border
                        Grid.Row="2"
                        Grid.Column="0"
                        Padding="0"
                        Classes="card">
                        <ListBox
                                Padding="0"
                                Background="Transparent"
                                BorderThickness="0"
                                ItemsSource="{Binding FilteredRepos}"
                                ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                                SelectionChanged="OnRepoSelectionChanged"
                                SelectionMode="Single">
                                <ListBox.ItemsPanel>
                                        <ItemsPanelTemplate>
                                                <VirtualizingStackPanel />
                                        </ItemsPanelTemplate>
                                </ListBox.ItemsPanel>
                                <ListBox.Styles>
                                        <!--
                                                Drop the per-item list chrome so each row renders as a plain content
                                                host. All row actions are explicit buttons (with CommandParameter), so
                                                ListBox selection is neither needed nor meaningful; neutralize its visual
                                                states (rest/selected/pressed/focused) and keep a single hover surface:
                                                the full-bleed repo-row Border tints while every chrome layer behind it
                                                stays transparent.
                                        -->
                                        <Style Selector="ListBoxItem">
                                                <Setter Property="Padding" Value="0" />
                                                <Setter Property="Margin" Value="0" />
                                                <Setter Property="Background" Value="Transparent" />
                                                <Setter Property="FocusAdorner" Value="{x:Null}" />
                                        </Style>
                                        <!--
                                                The theme's pseudoclass selectors (e.g. ListBoxItem:pointerover) beat the
                                                plain ListBoxItem style above by specificity, so repeat the neutralization
                                                at matching specificity to keep hover/press/selection chrome invisible.
                                        -->
                                        <Style Selector="ListBoxItem:pointerover">
                                                <Setter Property="Background" Value="Transparent" />
                                        </Style>
                                        <Style Selector="ListBoxItem:pressed">
                                                <Setter Property="Background" Value="Transparent" />
                                        </Style>
                                        <Style Selector="ListBoxItem:selected">
                                                <Setter Property="Background" Value="Transparent" />
                                        </Style>
                                        <Style Selector="ListBoxItem:selected /template/ ContentPresenter">
                                                <Setter Property="Background" Value="Transparent" />
                                        </Style>
                                        <Style Selector="ListBoxItem:pointerover /template/ ContentPresenter">
                                                <Setter Property="Background" Value="Transparent" />
                                        </Style>
                                        <Style Selector="ListBoxItem:pressed /template/ ContentPresenter">
                                                <Setter Property="Background" Value="Transparent" />
                                        </Style>
                                        <!--  The table's only hover feedback: a subtle full-width row tint.  -->
                                        <Style Selector="ListBoxItem:pointerover Border.repo-row">
                                                <Setter Property="Background" Value="{DynamicResource RowHoverBackgroundBrush}" />
                                        </Style>
                                        <!--
                                                SukiTheme's app-wide ListBoxItem ControlTheme replaces the item
                                                template with a GlassCard that carries a CircleCheck tick
                                                (PathIcon#CheckSelected) fading in while :selected, plus a
                                                SukiPrimaryColor tint on selected/hover. Those template parts
                                                aren't reachable by the ContentPresenter overrides above, so
                                                neutralize them at matching specificity as well.
                                        -->
                                        <Style Selector="ListBoxItem:selected /template/ PathIcon#CheckSelected">
                                                <Setter Property="Opacity" Value="0" />
                                        </Style>
                                        <Style Selector="ListBoxItem /template/ suki|GlassCard#BorderBasicStyle">
                                                <Setter Property="Background" Value="Transparent" />
                                                <Setter Property="BorderThickness" Value="0" />
                                        </Style>
                                        <Style Selector="ListBoxItem:pointerover /template/ suki|GlassCard#BorderBasicStyle">
                                                <Setter Property="Background" Value="Transparent" />
                                        </Style>
                                        <Style Selector="ListBoxItem:selected /template/ suki|GlassCard#BorderBasicStyle">
                                                <Setter Property="Background" Value="Transparent" />
                                                <Setter Property="BorderThickness" Value="0" />
                                        </Style>
                                </ListBox.Styles>
                                <ListBox.ItemTemplate>
                                        <DataTemplate x:DataType="entities:Repo">
                                                <!--
                                                        One table row: the bottom hairline is the row separator. The
                                                        grid columns are star-sized against the shared viewport width,
                                                        so every realized row resolves identical column widths and the
                                                        table stays aligned without a header or shared-size machinery.
                                                        The action column is content-sized (Auto) but constant per
                                                        machine — every button in it is gated by app-wide availability
                                                        flags, and the open-solution slot reserves its width even when
                                                        a repo has no .sln, so the columns to its right never shift.
                                                -->
                                                <Border
                                                        MinHeight="56"
                                                        Padding="12,0"
                                                        Classes="repo-row"
                                                        PointerPressed="OnCardPointerPressed">
                                                        <Grid VerticalAlignment="Center">
                                                                <Grid.ColumnDefinitions>
                                                                        <ColumnDefinition Width="Auto" />
                                                                        <ColumnDefinition Width="1.9*" MinWidth="170" />
                                                                        <ColumnDefinition Width="0.9*" MinWidth="80" />
                                                                        <ColumnDefinition Width="2.2*" MinWidth="195" />
                                                                        <ColumnDefinition Width="Auto" />
                                                                        <ColumnDefinition Width="Auto" />
                                                                        <ColumnDefinition Width="Auto" />
                                                                        <ColumnDefinition Width="1.2*" MinWidth="105" />
                                                                        <ColumnDefinition Width="0.8*" MinWidth="60" />
                                                                </Grid.ColumnDefinitions>

                                                                <!--  Favorite star  -->
                                                                <Button
                                                                        Grid.Column="0"
                                                                        VerticalAlignment="Center"
                                                                        Classes="icon"
                                                                        Command="{ReflectionBinding #Root.DataContext.ToggleFavoriteCommand}"
                                                                        CommandParameter="{Binding}"
                                                                        ToolTip.Tip="Toggle favorite">
                                                                        <Path
                                                                                Width="16"
                                                                                Height="16"
                                                                                Data="{tools:SvgPath icon-star}"
                                                                                Fill="{Binding Tags, Converter={StaticResource FavoriteStarBrushConverter}}"
                                                                                Stretch="Uniform" />
                                                                </Button>

                                                                <!--  Repository: name over folder path  -->
                                                                <StackPanel
                                                                        Grid.Column="1"
                                                                        Margin="0,0,16,0"
                                                                        VerticalAlignment="Center"
                                                                        Orientation="Vertical"
                                                                        Spacing="2">
                                                                        <TextBlock
                                                                                FontSize="15"
                                                                                FontWeight="SemiBold"
                                                                                Foreground="{DynamicResource TitleForegroundBrush}"
                                                                                Text="{Binding Name}"
                                                                                TextTrimming="CharacterEllipsis" />
                                                                        <TextBlock
                                                                                Classes="subtle"
                                                                                Text="{Binding FolderPath}"
                                                                                TextTrimming="CharacterEllipsis"
                                                                                ToolTip.Tip="{Binding FolderPath}" />
                                                                </StackPanel>

                                                                <!--  Branch: icon + name, or the checking placeholder. The
                                                                        name sits in its own star-sized column so long
                                                                        branch names trim instead of bleeding into the
                                                                        stats cell next door.  -->
                                                                <Grid Grid.Column="2" Margin="0,0,16,0" ColumnDefinitions="Auto,*">
                                                                        <Path
                                                                                Grid.Column="0"
                                                                                Width="14"
                                                                                Height="14"
                                                                                VerticalAlignment="Center"
                                                                                Data="{tools:SvgPath icon-source-branch}"
                                                                                Fill="{DynamicResource WarningAccentBrush}"
                                                                                IsVisible="{Binding GitBranchName, Converter={StaticResource StringNullOrEmptyToVisibilityConverter}}"
                                                                                Stretch="Uniform" />
                                                                        <TextBlock
                                                                                Grid.Column="1"
                                                                                Margin="6,0,0,0"
                                                                                VerticalAlignment="Center"
                                                                                FontSize="13"
                                                                                Foreground="{DynamicResource SubtitleForegroundBrush}"
                                                                                IsVisible="{Binding GitBranchName, Converter={StaticResource StringNullOrEmptyToVisibilityConverter}}"
                                                                                Text="{Binding GitBranchName}"
                                                                                TextTrimming="CharacterEllipsis"
                                                                                ToolTip.Tip="{Binding GitBranchName}" />
                                                                        <TextBlock
                                                                                Grid.Column="0"
                                                                                Grid.ColumnSpan="2"
                                                                                VerticalAlignment="Center"
                                                                                Classes="subtle"
                                                                                IsVisible="{Binding GitStatusLoaded, Converter={StaticResource InverseBoolConverter}}"
                                                                                Text="checking…" />
                                                                </Grid>

                                                                <!--  Git stats: modified / ahead / behind. Sized so all
                                                                        three groups fit the column at the default window
                                                                        width; ClipToBounds keeps a pathological count
                                                                        from painting into the actions cell. Right-aligned
                                                                        so the counts hug the GitHub column next door.  -->
                                                                <StackPanel
                                                                        Grid.Column="3"
                                                                        Margin="0,0,16,0"
                                                                        HorizontalAlignment="Right"
                                                                        VerticalAlignment="Center"
                                                                        ClipToBounds="True">
                                                                        <StackPanel
                                                                                IsVisible="{Binding GitStatusLoaded}"
                                                                                Orientation="Horizontal">
                                                                                <TextBlock
                                                                                        VerticalAlignment="Center"
                                                                                        FontSize="12"
                                                                                        FontWeight="SemiBold"
                                                                                        Foreground="{DynamicResource WarningAccentBrush}"
                                                                                        Text="{Binding GitModifiedCount}" />
                                                                                <TextBlock
                                                                                        Margin="4,0,0,0"
                                                                                        VerticalAlignment="Center"
                                                                                        FontSize="12"
                                                                                        Text="Changes" />
                                                                                <TextBlock
                                                                                        Margin="5,0,0,0"
                                                                                        VerticalAlignment="Center"
                                                                                        Classes="subtle"
                                                                                        Text="(" />
                                                                                <TextBlock
                                                                                        VerticalAlignment="Center"
                                                                                        FontSize="12"
                                                                                        FontWeight="SemiBold"
                                                                                        Foreground="{DynamicResource StatusActiveBrush}"
                                                                                        Text="{Binding GitToPushCount}" />
                                                                                <Path
                                                                                        Width="10"
                                                                                        Height="10"
                                                                                        Margin="1,0,0,0"
                                                                                        VerticalAlignment="Center"
                                                                                        Data="{tools:SvgPath icon-arrow-up}"
                                                                                        Fill="{DynamicResource StatusActiveBrush}"
                                                                                        Stretch="Uniform" />
                                                                                <TextBlock
                                                                                        Margin="2,0,0,0"
                                                                                        VerticalAlignment="Center"
                                                                                        Classes="subtle"
                                                                                        Text="," />
                                                                                <TextBlock
                                                                                        Margin="4,0,0,0"
                                                                                        VerticalAlignment="Center"
                                                                                        FontSize="12"
                                                                                        FontWeight="SemiBold"
                                                                                        Foreground="{DynamicResource InfoAccentBrush}"
                                                                                        Text="{Binding GitToPullCount}" />
                                                                                <Path
                                                                                        Width="10"
                                                                                        Height="10"
                                                                                        Margin="1,0,0,0"
                                                                                        VerticalAlignment="Center"
                                                                                        Data="{tools:SvgPath icon-arrow-down}"
                                                                                        Fill="{DynamicResource InfoAccentBrush}"
                                                                                        Stretch="Uniform" />
                                                                                <TextBlock
                                                                                        Margin="2,0,0,0"
                                                                                        VerticalAlignment="Center"
                                                                                        Classes="subtle"
                                                                                        Text=")" />
                                                                        </StackPanel>
                                                                        <TextBlock
                                                                                Classes="subtle"
                                                                                IsVisible="{Binding GitStatusLoaded, Converter={StaticResource InverseBoolConverter}}"
                                                                                Text="checking…" />
                                                                </StackPanel>

                                                                <!--
                                                                        GitHub: the repo link plus one chip per item
                                                                        kind with open counts; clicking a chip opens the
                                                                        details dialog. Only kinds with open items show a
                                                                        chip, a GitHub repo with nothing open shows "OK",
                                                                        and anything without a GitHub remote stays empty.
                                                                        The whole cell hides when the settings disable the
                                                                        column — the gh probing stops with it. The cell is
                                                                        a FIXED-width border so the Auto column resolves
                                                                        identically in every row (rows are independent
                                                                        grids; Auto sized to varying chip sets would let
                                                                        the columns to the right drift per row), and it
                                                                        collapses to zero width when the column is off.
                                                                -->
                                                                <Border
                                                                        Grid.Column="4"
                                                                        Width="180"
                                                                        Margin="0,0,16,0"
                                                                        HorizontalAlignment="Left"
                                                                        ClipToBounds="True"
                                                                        IsVisible="{ReflectionBinding #Root.DataContext.IsGitHubColumnVisible}">
                                                                        <StackPanel
                                                                                VerticalAlignment="Center"
                                                                                Orientation="Horizontal"
                                                                                Spacing="8">
                                                                        <Button
                                                                                Width="32"
                                                                                Height="32"
                                                                                Padding="7"
                                                                                VerticalAlignment="Center"
                                                                                Classes="icon"
                                                                                Command="{ReflectionBinding #Root.DataContext.OpenGitHubRepoCommand}"
                                                                                CommandParameter="{Binding}"
                                                                                IsVisible="{Binding GitHubRepoUrl, Converter={StaticResource StringNotNullToBoolConverter}}"
                                                                                ToolTip.Tip="Open on GitHub">
                                                                                <Path
                                                                                        Width="17"
                                                                                        Height="17"
                                                                                        Data="{tools:SvgPath icon-github}"
                                                                                        Fill="{DynamicResource MutedForegroundBrush}"
                                                                                        Stretch="Uniform" />
                                                                        </Button>
                                                                        <Button
                                                                                Padding="9,4"
                                                                                VerticalAlignment="Center"
                                                                                Background="{DynamicResource GitHubPrChipBrush}"
                                                                                BorderThickness="0"
                                                                                CornerRadius="{DynamicResource ChipRadius}"
                                                                                Command="{ReflectionBinding #Root.DataContext.OpenGitHubDetailsCommand}"
                                                                                CommandParameter="{Binding}"
                                                                                IsVisible="{Binding HasGitHubPullRequests}"
                                                                                ToolTip.Tip="Open pull requests — click for details">
                                                                                <StackPanel Orientation="Horizontal" Spacing="6">
                                                                                        <Path
                                                                                                Width="13"
                                                                                                Height="13"
                                                                                                VerticalAlignment="Center"
                                                                                                Data="{tools:SvgPath icon-git-pull-request}"
                                                                                                Fill="{DynamicResource StatusActiveBrush}"
                                                                                                Stretch="Uniform" />
                                                                                        <TextBlock
                                                                                                VerticalAlignment="Center"
                                                                                                FontSize="12"
                                                                                                FontWeight="SemiBold"
                                                                                                Foreground="{DynamicResource StatusActiveBrush}"
                                                                                                Text="{Binding GitHubPrCount}" />
                                                                                </StackPanel>
                                                                        </Button>
                                                                        <Button
                                                                                Padding="9,4"
                                                                                VerticalAlignment="Center"
                                                                                Background="{DynamicResource GitHubIssueChipBrush}"
                                                                                BorderThickness="0"
                                                                                CornerRadius="{DynamicResource ChipRadius}"
                                                                                Command="{ReflectionBinding #Root.DataContext.OpenGitHubDetailsCommand}"
                                                                                CommandParameter="{Binding}"
                                                                                IsVisible="{Binding HasGitHubIssues}"
                                                                                ToolTip.Tip="Open issues — click for details">
                                                                                <StackPanel Orientation="Horizontal" Spacing="6">
                                                                                        <Path
                                                                                                Width="13"
                                                                                                Height="13"
                                                                                                VerticalAlignment="Center"
                                                                                                Data="{tools:SvgPath icon-issue}"
                                                                                                Fill="{DynamicResource WarningAccentBrush}"
                                                                                                Stretch="Uniform" />
                                                                                        <TextBlock
                                                                                                VerticalAlignment="Center"
                                                                                                FontSize="12"
                                                                                                FontWeight="SemiBold"
                                                                                                Foreground="{DynamicResource WarningAccentBrush}"
                                                                                                Text="{Binding GitHubIssueCount}" />
                                                                                </StackPanel>
                                                                        </Button>
                                                                        <TextBlock
                                                                                VerticalAlignment="Center"
                                                                                Classes="subtle"
                                                                                FontSize="12"
                                                                                IsVisible="{Binding IsGitHubAllClear}"
                                                                                Text="OK"
                                                                                ToolTip.Tip="No open pull requests or issues" />
                                                                        </StackPanel>
                                                                </Border>

                                                                <!--
                                                                        Azure DevOps: the repo link plus one chip per
                                                                        activity kind — active pull-request count, open
                                                                        work-item count (the hosting project's items) and
                                                                        the latest pipeline run's state. Clicking a chip
                                                                        opens the details dialog. Only kinds with data show
                                                                        a chip, an Azure DevOps repo with nothing open and
                                                                        no failing pipeline shows "OK", and anything without
                                                                        an Azure DevOps remote stays empty. The whole cell
                                                                        hides when the settings disable the column — the
                                                                        REST probing stops with it. Like the GitHub cell it
                                                                        is a FIXED-width border so the Auto column resolves
                                                                        identically in every row.
                                                                -->
                                                                <Border
                                                                        Grid.Column="5"
                                                                        Width="200"
                                                                        Margin="0,0,16,0"
                                                                        HorizontalAlignment="Left"
                                                                        ClipToBounds="True"
                                                                        IsVisible="{ReflectionBinding #Root.DataContext.IsAzureDevOpsColumnVisible}">
                                                                        <StackPanel
                                                                                VerticalAlignment="Center"
                                                                                Orientation="Horizontal"
                                                                                Spacing="8">
                                                                        <Button
                                                                                Width="32"
                                                                                Height="32"
                                                                                Padding="7"
                                                                                VerticalAlignment="Center"
                                                                                Classes="icon"
                                                                                Command="{ReflectionBinding #Root.DataContext.OpenAzureDevOpsRepoCommand}"
                                                                                CommandParameter="{Binding}"
                                                                                IsVisible="{Binding AzureDevOpsRepoUrl, Converter={StaticResource StringNotNullToBoolConverter}}"
                                                                                ToolTip.Tip="Open in Azure DevOps">
                                                                                <Path
                                                                                        Width="17"
                                                                                        Height="17"
                                                                                        Data="{tools:SvgPath icon-azure-devops}"
                                                                                        Fill="{DynamicResource MutedForegroundBrush}"
                                                                                        Stretch="Uniform" />
                                                                        </Button>
                                                                        <Button
                                                                                Padding="9,4"
                                                                                VerticalAlignment="Center"
                                                                                Background="{DynamicResource AzureDevOpsPrChipBrush}"
                                                                                BorderThickness="0"
                                                                                CornerRadius="{DynamicResource ChipRadius}"
                                                                                Command="{ReflectionBinding #Root.DataContext.OpenAzureDevOpsDetailsCommand}"
                                                                                CommandParameter="{Binding}"
                                                                                IsVisible="{Binding HasAzureDevOpsPullRequests}"
                                                                                ToolTip.Tip="Active pull requests — click for details">
                                                                                <StackPanel Orientation="Horizontal" Spacing="6">
                                                                                        <Path
                                                                                                Width="13"
                                                                                                Height="13"
                                                                                                VerticalAlignment="Center"
                                                                                                Data="{tools:SvgPath icon-git-pull-request}"
                                                                                                Fill="{DynamicResource StatusActiveBrush}"
                                                                                                Stretch="Uniform" />
                                                                                        <TextBlock
                                                                                                VerticalAlignment="Center"
                                                                                                FontSize="12"
                                                                                                FontWeight="SemiBold"
                                                                                                Foreground="{DynamicResource StatusActiveBrush}"
                                                                                                Text="{Binding AzureDevOpsPrCount}" />
                                                                                </StackPanel>
                                                                        </Button>
                                                                        <Button
                                                                                Padding="9,4"
                                                                                VerticalAlignment="Center"
                                                                                Background="{DynamicResource AzureDevOpsWorkItemChipBrush}"
                                                                                BorderThickness="0"
                                                                                CornerRadius="{DynamicResource ChipRadius}"
                                                                                Command="{ReflectionBinding #Root.DataContext.OpenAzureDevOpsDetailsCommand}"
                                                                                CommandParameter="{Binding}"
                                                                                IsVisible="{Binding HasAzureDevOpsWorkItems}"
                                                                                ToolTip.Tip="Open work items — click for details">
                                                                                <StackPanel Orientation="Horizontal" Spacing="6">
                                                                                        <Path
                                                                                                Width="13"
                                                                                                Height="13"
                                                                                                VerticalAlignment="Center"
                                                                                                Data="{tools:SvgPath icon-issue}"
                                                                                                Fill="{DynamicResource WarningAccentBrush}"
                                                                                                Stretch="Uniform" />
                                                                                        <TextBlock
                                                                                                VerticalAlignment="Center"
                                                                                                FontSize="12"
                                                                                                FontWeight="SemiBold"
                                                                                                Foreground="{DynamicResource WarningAccentBrush}"
                                                                                                Text="{Binding AzureDevOpsWorkItemCount}" />
                                                                                </StackPanel>
                                                                        </Button>
                                                                        <!--  Latest pipeline run: one button per state so each
                                                                                carries its own tinted background and glyph.  -->
                                                                        <Panel VerticalAlignment="Center">
                                                                                <Button
                                                                                        Padding="9,4"
                                                                                        VerticalAlignment="Center"
                                                                                        Background="{DynamicResource AzureDevOpsPipelineOkChipBrush}"
                                                                                        BorderThickness="0"
                                                                                        CornerRadius="{DynamicResource ChipRadius}"
                                                                                        Command="{ReflectionBinding #Root.DataContext.OpenAzureDevOpsDetailsCommand}"
                                                                                        CommandParameter="{Binding}"
                                                                                        IsVisible="{Binding IsAzureDevOpsPipelineOk}"
                                                                                        ToolTip.Tip="{Binding AzureDevOpsPipelineInfo}">
                                                                                        <Path
                                                                                                Width="13"
                                                                                                Height="13"
                                                                                                VerticalAlignment="Center"
                                                                                                Data="M9,16.17 L4.83,12 L3.41,13.41 L9,19 L21,7 L19.59,5.59 Z"
                                                                                                Fill="{DynamicResource StatusActiveBrush}"
                                                                                                Stretch="Uniform" />
                                                                                </Button>
                                                                                <Button
                                                                                        Padding="9,4"
                                                                                        VerticalAlignment="Center"
                                                                                        Background="{DynamicResource AzureDevOpsPipelineFailedChipBrush}"
                                                                                        BorderThickness="0"
                                                                                        CornerRadius="{DynamicResource ChipRadius}"
                                                                                        Command="{ReflectionBinding #Root.DataContext.OpenAzureDevOpsDetailsCommand}"
                                                                                        CommandParameter="{Binding}"
                                                                                        IsVisible="{Binding IsAzureDevOpsPipelineFailed}"
                                                                                        ToolTip.Tip="{Binding AzureDevOpsPipelineInfo}">
                                                                                        <Path
                                                                                                Width="12"
                                                                                                Height="12"
                                                                                                VerticalAlignment="Center"
                                                                                                Data="M19,6.41 L17.59,5 L12,10.59 L6.41,5 L5,6.41 L10.59,12 L5,17.59 L6.41,19 L12,13.41 L17.59,19 L19,17.59 L13.41,12 Z"
                                                                                                Fill="{DynamicResource DangerAccentBrush}"
                                                                                                Stretch="Uniform" />
                                                                                </Button>
                                                                                <Button
                                                                                        Padding="9,4"
                                                                                        VerticalAlignment="Center"
                                                                                        Background="{DynamicResource AzureDevOpsPipelineRunningChipBrush}"
                                                                                        BorderThickness="0"
                                                                                        CornerRadius="{DynamicResource ChipRadius}"
                                                                                        Command="{ReflectionBinding #Root.DataContext.OpenAzureDevOpsDetailsCommand}"
                                                                                        CommandParameter="{Binding}"
                                                                                        IsVisible="{Binding IsAzureDevOpsPipelineRunning}"
                                                                                        ToolTip.Tip="{Binding AzureDevOpsPipelineInfo}">
                                                                                        <Path
                                                                                                Width="11"
                                                                                                Height="11"
                                                                                                VerticalAlignment="Center"
                                                                                                Data="{tools:SvgPath icon-play}"
                                                                                                Fill="{DynamicResource InfoAccentBrush}"
                                                                                                Stretch="Uniform" />
                                                                                </Button>
                                                                        </Panel>
                                                                        <TextBlock
                                                                                VerticalAlignment="Center"
                                                                                Classes="subtle"
                                                                                FontSize="12"
                                                                                IsVisible="{Binding IsAzureDevOpsAllClear}"
                                                                                Text="OK"
                                                                                ToolTip.Tip="No open pull requests, work items or failing pipelines" />
                                                                        </StackPanel>
                                                                </Border>

                                                                <!--
                                                                        Launch actions (icon-only; tooltips name the actions).
                                                                        OpenCode leads the row: quick open plus a minimal options
                                                                        button, set apart from the other launch buttons by a
                                                                        hairline divider.
                                                                -->
                                                                <StackPanel
                                                                        Grid.Column="6"
                                                                        Margin="0,0,16,0"
                                                                        VerticalAlignment="Center"
                                                                        Orientation="Horizontal"
                                                                        Spacing="8">
                                                                        <StackPanel
                                                                                IsVisible="{ReflectionBinding #Root.DataContext.HasOpenCode}"
                                                                                Orientation="Horizontal"
                                                                                Spacing="8">
                                                                                <Button
                                                                                        Classes="tool-button accent-outline"
                                                                                        Command="{ReflectionBinding #Root.DataContext.QuickOpenOpenCodeCommand}"
                                                                                        CommandParameter="{Binding}"
                                                                                        ToolTip.Tip="Launch one opencode instance with the default model">
                                                                                        <Path
                                                                                                Width="22"
                                                                                                Height="22"
                                                                                                Data="{tools:SvgPath icon-opencode}"
                                                                                                Fill="White"
                                                                                                Stretch="Uniform" />
                                                                                </Button>
                                                                                <Button
                                                                                        Width="40"
                                                                                        Height="40"
                                                                                        VerticalAlignment="Center"
                                                                                        Classes="icon"
                                                                                        Command="{ReflectionBinding #Root.DataContext.OpenOpenCodePanelCommand}"
                                                                                        CommandParameter="{Binding}"
                                                                                        ToolTip.Tip="Open the options panel (model, instances, template, prompt)">
                                                                                        <Path
                                                                                                Width="18"
                                                                                                Height="18"
                                                                                                Data="{tools:SvgPath icon-options}"
                                                                                                Fill="{DynamicResource MutedForegroundBrush}"
                                                                                                Stretch="Uniform" />
                                                                                </Button>
                                                                                <Border Classes="vertical-divider" />
                                                                        </StackPanel>
                                                                        <Button
                                                                                Classes="tool-button"
                                                                                Command="{ReflectionBinding #Root.DataContext.OpenWithZCodeCommand}"
                                                                                CommandParameter="{Binding}"
                                                                                IsVisible="{ReflectionBinding #Root.DataContext.HasZCode}"
                                                                                ToolTip.Tip="Open zcode on this repo — the AppImage opens the desktop app directly; a standalone CLI runs in the terminal">
                                                                                <Path
                                                                                        Width="22"
                                                                                        Height="22"
                                                                                        Data="{tools:SvgPath icon-zcode}"
                                                                                        Fill="{DynamicResource MutedForegroundBrush}"
                                                                                        Stretch="Uniform" />
                                                                        </Button>
                                                                        <!--
                                                                                The open-solution button is a Visual Studio
                                                                                shortcut: HasIde requires VS to be installed,
                                                                                or an IDE explicitly configured in settings.
                                                                                The 40px slot stays reserved for repos without
                                                                                a solution so the table columns stay aligned.
                                                                        -->
                                                                        <Border Width="40" IsVisible="{ReflectionBinding #Root.DataContext.HasIde}">
                                                                                <Button
                                                                                        Classes="tool-button"
                                                                                        Command="{ReflectionBinding #Root.DataContext.OpenVisualStudioCommand}"
                                                                                        CommandParameter="{Binding}"
                                                                                        IsVisible="{Binding SolutionPath, Converter={StaticResource StringNotNullToBoolConverter}}"
                                                                                        ToolTip.Tip="Open in Visual Studio">
                                                                                        <Path
                                                                                                Width="22"
                                                                                                Height="22"
                                                                                                Data="{tools:SvgPath icon-sln-box}"
                                                                                                Fill="{DynamicResource PurpleAccentBrush}"
                                                                                                Stretch="Uniform" />
                                                                                </Button>
                                                                        </Border>
                                                                        <Button
                                                                                Classes="tool-button"
                                                                                Command="{ReflectionBinding #Root.DataContext.OpenWithVSCodeCommand}"
                                                                                CommandParameter="{Binding FolderPath}"
                                                                                IsVisible="{ReflectionBinding #Root.DataContext.HasVSCode}"
                                                                                ToolTip.Tip="Open in VS Code">
                                                                                <Path
                                                                                        Width="22"
                                                                                        Height="22"
                                                                                        Data="{tools:SvgPath icon-vscode}"
                                                                                        Fill="{DynamicResource InfoAccentBrush}"
                                                                                        Stretch="Uniform" />
                                                                        </Button>
                                                                        <Button
                                                                                Classes="tool-button"
                                                                                Command="{ReflectionBinding #Root.DataContext.OpenFolderCommand}"
                                                                                CommandParameter="{Binding FolderPath}"
                                                                                ToolTip.Tip="Open folder">
                                                                                <Path
                                                                                        Width="22"
                                                                                        Height="22"
                                                                                        Data="{tools:SvgPath icon-folder}"
                                                                                        Fill="{DynamicResource WarningAccentBrush}"
                                                                                        Stretch="Uniform" />
                                                                        </Button>
                                                                        <Button
                                                                                Classes="tool-button"
                                                                                Command="{ReflectionBinding #Root.DataContext.OpenWithTerminalCommand}"
                                                                                CommandParameter="{Binding FolderPath}"
                                                                                IsVisible="{ReflectionBinding #Root.DataContext.HasTerminal}"
                                                                                ToolTip.Tip="Open in Terminal">
                                                                                <Path
                                                                                        Width="22"
                                                                                        Height="22"
                                                                                        Data="{tools:SvgPath icon-terminal}"
                                                                                        Fill="{DynamicResource StatusActiveBrush}"
                                                                                        Stretch="Uniform" />
                                                                        </Button>
                                                                </StackPanel>

                                                                <!--  Tags: chips wrap inside the column, add-tag pinned right  -->
                                                                <Grid
                                                                        Grid.Column="7"
                                                                        Margin="0,0,16,0"
                                                                        VerticalAlignment="Center"
                                                                        ColumnDefinitions="*,Auto">
                                                                        <ItemsControl
                                                                                Grid.Column="0"
                                                                                Margin="0,3"
                                                                                ItemsSource="{Binding Tags}">
                                                                                <ItemsControl.ItemsPanel>
                                                                                        <ItemsPanelTemplate>
                                                                                                <WrapPanel Orientation="Horizontal" />
                                                                                        </ItemsPanelTemplate>
                                                                                </ItemsControl.ItemsPanel>
                                                                                <ItemsControl.ItemTemplate>
                                                                                        <DataTemplate x:DataType="entities:RepoTag">
                                                                                                <Border
                                                                                                        Margin="0,2,6,2"
                                                                                                        Padding="8,2"
                                                                                                        Classes="chip">
                                                                                                        <StackPanel Orientation="Horizontal" Spacing="4">
                                                                                                                <TextBlock
                                                                                                                        VerticalAlignment="Center"
                                                                                                                        Classes="subtle"
                                                                                                                        Text="{Binding Name}" />
                                                                                                                <Button
                                                                                                                        Width="14"
                                                                                                                        Height="14"
                                                                                                                        Padding="0"
                                                                                                                        Background="Transparent"
                                                                                                                        BorderThickness="0"
                                                                                                                        Command="{ReflectionBinding #Root.DataContext.RemoveTagCommand}"
                                                                                                                        CommandParameter="{Binding}"
                                                                                                                        Cursor="Hand"
                                                                                                                        ToolTip.Tip="Remove tag">
                                                                                                                        <Path
                                                                                                                                Width="9"
                                                                                                                                Height="9"
                                                                                                                                Data="M19,6.41 L17.59,5 L12,10.59 L6.41,5 L5,6.41 L10.59,12 L5,17.59 L6.41,19 L12,13.41 L17.59,19 L19,17.59 L13.41,12 Z"
                                                                                                                                Fill="{DynamicResource MutedForegroundBrush}"
                                                                                                                                Stretch="Uniform" />
                                                                                                                </Button>
                                                                                                        </StackPanel>
                                                                                                </Border>
                                                                                        </DataTemplate>
                                                                                </ItemsControl.ItemTemplate>
                                                                        </ItemsControl>
                                                                        <Button
                                                                                Grid.Column="1"
                                                                                Margin="0,3,0,0"
                                                                                Padding="8,2"
                                                                                VerticalAlignment="Center"
                                                                                Background="Transparent"
                                                                                BorderBrush="{DynamicResource HairlineBrush}"
                                                                                BorderThickness="1"
                                                                                CornerRadius="{DynamicResource ChipRadius}"
                                                                                Cursor="Hand"
                                                                                ToolTip.Tip="Add tag">
                                                                                <TextBlock
                                                                                        FontSize="12"
                                                                                        Foreground="{DynamicResource MutedForegroundBrush}"
                                                                                        Text="+" />
                                                                                <Button.Flyout>
                                                                                        <Flyout Placement="BottomEdgeAlignedLeft">
                                                                                                <StackPanel Width="220" Spacing="10">
                                                                                                        <TextBlock Classes="field-label" Text="Quick add" />
                                                                                                        <ItemsControl ItemsSource="{ReflectionBinding #Root.DataContext.AvailableTags}">
                                                                                                                <ItemsControl.ItemsPanel>
                                                                                                                        <ItemsPanelTemplate>
                                                                                                                                <WrapPanel Orientation="Horizontal" />
                                                                                                                        </ItemsPanelTemplate>
                                                                                                                </ItemsControl.ItemsPanel>
                                                                                                                <ItemsControl.ItemTemplate>
                                                                                                                        <DataTemplate x:DataType="x:String">
                                                                                                                                <Button
                                                                                                                                        Margin="0,0,6,4"
                                                                                                                                        Padding="8,2"
                                                                                                                                        Background="Transparent"
                                                                                                                                        BorderBrush="{DynamicResource HairlineBrush}"
                                                                                                                                        BorderThickness="1"
                                                                                                                                        Command="{ReflectionBinding #Root.DataContext.AddTagByNameCommand}"
                                                                                                                                        Content="{Binding}"
                                                                                                                                        CornerRadius="{DynamicResource ChipRadius}"
                                                                                                                                        Cursor="Hand"
                                                                                                                                        FontSize="12">
                                                                                                                                        <Button.CommandParameter>
                                                                                                                                                <MultiBinding Converter="{StaticResource PairConverter}">
                                                                                                                                                        <Binding Path="DataContext" RelativeSource="{RelativeSource AncestorType=Border}" />
                                                                                                                                                        <Binding Path="." />
                                                                                                                                                </MultiBinding>
                                                                                                                                        </Button.CommandParameter>
                                                                                                                                </Button>
                                                                                                                        </DataTemplate>
                                                                                                                </ItemsControl.ItemTemplate>
                                                                                                        </ItemsControl>
                                                                                                        <Border Margin="0,4" Classes="horizontal-divider" />
                                                                                                        <TextBlock Classes="field-label" Text="New tag" />
                                                                                                        <Grid ColumnDefinitions="*,Auto" ColumnSpacing="8">
                                                                                                                <TextBox
                                                                                                                        Grid.Column="0"
                                                                                                                        Text="{ReflectionBinding #Root.DataContext.NewTagText,
                                                                                                                                                                                 Mode=TwoWay}"
                                                                                                                        Watermark="Tag name" />
                                                                                                                <Button
                                                                                                                        Grid.Column="1"
                                                                                                                        Classes="accent"
                                                                                                                        Command="{ReflectionBinding #Root.DataContext.AddTagCommand}"
                                                                                                                        CommandParameter="{ReflectionBinding DataContext,
                                                                                                                                                                         RelativeSource={RelativeSource AncestorType=Border}}"
                                                                                                                        Content="Add" />
                                                                                                        </Grid>
                                                                                                </StackPanel>
                                                                                        </Flyout>
                                                                                </Button.Flyout>
                                                                        </Button>
                                                                </Grid>

                                                                <!--  Last Activity: relative age of the newest commit  -->
                                                                <TextBlock
                                                                        Grid.Column="8"
                                                                        Margin="0,0,4,0"
                                                                        HorizontalAlignment="Right"
                                                                        VerticalAlignment="Center"
                                                                        Classes="subtle"
                                                                        Text="{Binding GitLastActivity}" />

                                                        </Grid>
                                                </Border>
                                        </DataTemplate>
                                </ListBox.ItemTemplate>
                        </ListBox>
                </Border>

                <!--
                        OpenCode panel: an overlay docked to the right edge, floating above the
                        repo list (declared last so it wins z-order) rather than pushing the
                        content aside. The card class provides the opaque background; the shadow
                        separates it from the content underneath.
                -->
                <Border
                        Grid.Row="0"
                        Grid.RowSpan="3"
                        Width="340"
                        HorizontalAlignment="Right"
                        VerticalAlignment="Stretch"
                        BoxShadow="{DynamicResource FlyoutShadow}"
                        Classes="card"
                        IsVisible="{Binding IsOpenCodePanelOpen}">
                        <Grid RowDefinitions="Auto,Auto,Auto,Auto,Auto,Auto,*,Auto,Auto">
                                <Grid
                                        Grid.Row="0"
                                        Margin="0,0,0,16"
                                        ColumnDefinitions="*,Auto">
                                        <TextBlock
                                                Grid.Column="0"
                                                Classes="card-title"
                                                Text="{Binding OpenCodeRepoName}"
                                                TextTrimming="CharacterEllipsis" />
                                        <Button
                                                Grid.Column="1"
                                                VerticalAlignment="Top"
                                                Classes="icon"
                                                Command="{Binding CloseOpenCodePanelCommand}"
                                                ToolTip.Tip="Close">
                                                <Path
                                                        Width="14"
                                                        Height="14"
                                                        Data="M19,6.41 L17.59,5 L12,10.59 L6.41,5 L5,6.41 L10.59,12 L5,17.59 L6.41,19 L12,13.41 L17.59,19 L19,17.59 L13.41,12 Z"
                                                        Fill="{DynamicResource MutedForegroundBrush}"
                                                        Stretch="Uniform" />
                                        </Button>
                                </Grid>
                                <StackPanel
                                        Grid.Row="1"
                                        Margin="0,0,0,16"
                                        Spacing="8">
                                        <TextBlock Classes="field-label" Text="Model" />
                                        <ComboBox
                                                Name="OpenCodeModelPicker"
                                                HorizontalAlignment="Stretch"
                                                IsEditable="True"
                                                IsEnabled="{Binding OpenCodeHasModels}"
                                                ItemsSource="{Binding OpenCodeFilteredModels}"
                                                PlaceholderText="Search or select a model…"
                                                SelectedItem="{Binding OpenCodeSelectedModel, Mode=OneWay}"
                                                SelectionChanged="OnOpenCodeModelSelectionChanged"
                                                Text="{Binding OpenCodeModelFilter, Mode=TwoWay}" />
                                        <TextBlock
                                                Classes="subtle"
                                                FontSize="11"
                                                IsVisible="{Binding OpenCodeModelsEmpty}"
                                                Text="No models found. Is opencode installed and on the PATH?"
                                                TextWrapping="Wrap" />
                                </StackPanel>
                                <StackPanel
                                        Grid.Row="2"
                                        Margin="0,0,0,16"
                                        Spacing="8">
                                        <TextBlock
                                                Classes="field-label"
                                                Text="Instances"
                                                ToolTip.Tip="How many terminal windows to open, each running opencode" />
                                        <NumericUpDown
                                                FormatString="0"
                                                Increment="1"
                                                Maximum="9"
                                                Minimum="1"
                                                ParsingNumberStyle="Integer"
                                                Value="{Binding OpenCodeInstanceCount, Mode=TwoWay}" />
                                        <CheckBox
                                                Content="Arrange into grid"
                                                IsChecked="{Binding OpenCodeArrangeIntoGrid, Mode=TwoWay}"
                                                IsVisible="{Binding CanArrangeIntoGrid}"
                                                ToolTip.Tip="Tile the launched instances across the screen in a grid" />
                                </StackPanel>
                                <StackPanel
                                        Grid.Row="4"
                                        Margin="0,0,0,16"
                                        Spacing="8">
                                        <Grid ColumnDefinitions="*,Auto">
                                                <TextBlock
                                                        Grid.Column="0"
                                                        Classes="field-label"
                                                        Text="Template (optional)"
                                                        ToolTip.Tip="Copy a template's .opencode folder into the repo" />
                                                <Button
                                                        Grid.Column="1"
                                                        Padding="8,2"
                                                        VerticalAlignment="Center"
                                                        Command="{Binding ResetOpenCodeTemplateCommand}"
                                                        Content="Reset"
                                                        FontSize="11"
                                                        ToolTip.Tip="Remove the repo's .opencode folder and re-copy the selected template into it" />
                                        </Grid>
                                        <TextBlock
                                                Classes="subtle"
                                                FontSize="11"
                                                Text="Reset removes the repo's .opencode folder and re-copies the selected template into it."
                                                TextWrapping="Wrap" />
                                        <ComboBox
                                                HorizontalAlignment="Stretch"
                                                ItemsSource="{Binding OpenCodeTemplates}"
                                                SelectedItem="{Binding OpenCodeSelectedTemplate, Mode=TwoWay}" />
                                        <TextBlock
                                                Classes="subtle"
                                                FontSize="11"
                                                IsVisible="{Binding OpenCodeSelectedTemplateDescription, Converter={StaticResource StringNotNullToBoolConverter}}"
                                                Text="{Binding OpenCodeSelectedTemplateDescription}"
                                                TextWrapping="Wrap" />
                                </StackPanel>
                                <StackPanel
                                        Grid.Row="5"
                                        Margin="0,0,0,16"
                                        Spacing="8">
                                        <TextBlock
                                                Classes="field-label"
                                                Text="Prompt (optional)"
                                                ToolTip.Tip="Load a named prompt into the Start prompt box" />
                                        <ComboBox
                                                HorizontalAlignment="Stretch"
                                                ItemsSource="{Binding OpenCodePrompts}"
                                                SelectedItem="{Binding OpenCodeSelectedPrompt, Mode=TwoWay}" />
                                </StackPanel>
                                <Grid
                                        Grid.Row="6"
                                        Margin="0,0,0,16"
                                        RowDefinitions="Auto,*">
                                        <Grid ColumnDefinitions="*,Auto">
                                                <TextBlock
                                                        Grid.Column="0"
                                                        Classes="field-label"
                                                        Text="Start prompt (optional)" />
                                                <Button
                                                        Grid.Column="1"
                                                        Padding="8,2"
                                                        VerticalAlignment="Center"
                                                        Classes="accent"
                                                        Content="Save"
                                                        FontSize="11"
                                                        ToolTip.Tip="Save the current prompt under a name so it can be reused from the Prompt selector">
                                                        <Button.Flyout>
                                                                <Flyout Placement="BottomEdgeAlignedRight">
                                                                        <StackPanel Width="220" Spacing="10">
                                                                                <TextBlock Classes="field-label" Text="Save prompt as" />
                                                                                <TextBox Text="{Binding NewPromptName, Mode=TwoWay}" Watermark="Prompt name" />
                                                                                <Button
                                                                                        HorizontalAlignment="Right"
                                                                                        Classes="accent"
                                                                                        Command="{Binding SavePromptCommand}"
                                                                                        Content="Save" />
                                                                        </StackPanel>
                                                                </Flyout>
                                                        </Button.Flyout>
                                                </Button>
                                        </Grid>
                                        <TextBox
                                                Grid.Row="1"
                                                MinHeight="120"
                                                Margin="0,8,0,0"
                                                VerticalAlignment="Stretch"
                                                AcceptsReturn="True"
                                                Text="{Binding OpenCodePrompt, Mode=TwoWay}"
                                                TextWrapping="Wrap"
                                                Watermark="e.g. fix the login bug" />
                                </Grid>
                                <Button
                                        Grid.Row="7"
                                        HorizontalAlignment="Stretch"
                                        VerticalAlignment="Bottom"
                                        Classes="accent"
                                        Command="{Binding LaunchOpenCodeCommand}"
                                        Content="Open"
                                        IsEnabled="{Binding OpenCodeRepo, Converter={StaticResource NotNullToBoolConverter}}" />
                                <Border Grid.Row="8" />
                        </Grid>
                </Border>

        </Grid>
</UserControl>
