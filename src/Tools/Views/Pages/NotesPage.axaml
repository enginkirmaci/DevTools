<?xml version="1.0" encoding="utf-8" ?>
<!--
    Dedicated Notes page (title-bar note button; back link returns to the
    Repositories page). The tree is scoped to the bottom bar's selected repository:
    each repo keeps markdown notes in a subfolder of the configured store path
    (Settings page). Unsaved edits live in the view model and survive navigation.
-->
<UserControl
    x:Class="Tools.Views.Pages.NotesPage"
    xmlns="https://github.com/avaloniaui"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:lib="using:Tools.Library.Services.Abstractions"
    xmlns:md="using:Markdown.Avalonia"
    xmlns:tools="using:Tools.Library.MarkupExtensions"
    xmlns:vm="using:Tools.ViewModels.Pages"
    d:DesignHeight="800"
    d:DesignWidth="1200"
    x:CompileBindings="True"
    x:DataType="vm:NotesPageViewModel"
    mc:Ignorable="d">

    <UserControl.Styles>
        <!--  Tree rows: transparent chrome, app hover tint, accent-selected header  -->
        <Style Selector="TreeViewItem">
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="Padding" Value="0" />
            <Setter Property="Margin" Value="0,1" />
        </Style>
        <Style Selector="TreeViewItem /template/ Border#PART_Header">
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="MinHeight" Value="26" />
            <Setter Property="CornerRadius" Value="{DynamicResource ControlRadius}" />
        </Style>
        <Style Selector="TreeViewItem:pointerover /template/ Border#PART_Header">
            <Setter Property="Background" Value="{DynamicResource HoverBackgroundBrush}" />
        </Style>
        <Style Selector="TreeViewItem:selected /template/ Border#PART_Header">
            <Setter Property="Background" Value="{DynamicResource SukiPrimaryColor10}" />
        </Style>
        <!--  Edit/Preview segmented pair  -->
        <Style Selector="ToggleButton.seg">
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="Padding" Value="10,4" />
            <Setter Property="CornerRadius" Value="6" />
            <Setter Property="FontSize" Value="12.5" />
            <Setter Property="Foreground" Value="{DynamicResource MutedForegroundBrush}" />
        </Style>
        <Style Selector="ToggleButton.seg:checked">
            <Setter Property="Background" Value="{DynamicResource SukiPrimaryColor15}" />
            <Setter Property="Foreground" Value="{DynamicResource TitleForegroundBrush}" />
        </Style>
    </UserControl.Styles>

    <Grid RowDefinitions="Auto,*">
        <!--  Identity bar: back link, title, repo chip, folder jump, Save  -->
        <Grid
            Grid.Row="0"
            Margin="16,10,16,6"
            ColumnDefinitions="Auto,Auto,Auto,*,Auto,Auto"
            ColumnSpacing="12">
            <Button
                Grid.Column="0"
                Classes="icon"
                Click="OnBackClick"
                ToolTip.Tip="Back to repositories">
                <Path
                    Width="14"
                    Height="14"
                    Data="{tools:SvgPath icon-arrow-left}"
                    Fill="{DynamicResource BodyForegroundBrush}"
                    Stretch="Uniform" />
            </Button>
            <TextBlock
                Grid.Column="1"
                VerticalAlignment="Center"
                FontSize="18"
                FontWeight="SemiBold"
                Text="Notes" />
            <TextBlock
                Grid.Column="2"
                VerticalAlignment="Center"
                Classes="subtle"
                IsVisible="{Binding HasRepo}"
                Text="{Binding RepoName}" />
            <Button
                Grid.Column="4"
                Classes="icon"
                Command="{Binding OpenStoreFolderCommand}"
                ToolTip.Tip="Open the notes folder">
                <Path
                    Width="15"
                    Height="15"
                    Data="{tools:SvgPath icon-folder}"
                    Fill="{DynamicResource BodyForegroundBrush}"
                    Stretch="Uniform" />
            </Button>
            <Button
                Grid.Column="5"
                Classes="Outlined"
                Command="{Binding SaveCommand}"
                Content="Save"
                IsVisible="{Binding IsDirty}" />
        </Grid>

        <Grid
            Grid.Row="1"
            Margin="16,4,16,16"
            ColumnDefinitions="300,*"
            ColumnSpacing="12">
            <!--  Left card: search, new note/folder, tree  -->
            <Border Grid.Column="0" Classes="card">
                <Grid RowDefinitions="Auto,*">
                    <Grid
                        Grid.Row="0"
                        Margin="0,0,0,8"
                        ColumnDefinitions="*,Auto,Auto"
                        ColumnSpacing="4">
                        <TextBox
                            Grid.Column="0"
                            HorizontalContentAlignment="Left"
                            KeyDown="OnSearchBoxKeyDown"
                            Text="{Binding SearchText, UpdateSourceTrigger=PropertyChanged}"
                            Watermark="Search notes…" />
                        <Button
                            x:Name="NewNoteButton"
                            Grid.Column="1"
                            Classes="icon"
                            ToolTip.Tip="New note">
                            <Path
                                Width="15"
                                Height="15"
                                Data="{tools:SvgPath icon-plus}"
                                Fill="{DynamicResource BodyForegroundBrush}"
                                Stretch="Uniform" />
                            <Button.Flyout>
                                <Flyout Placement="BottomEdgeAlignedLeft" Opened="OnNewNoteFlyoutOpened">
                                    <StackPanel Spacing="8">
                                        <TextBlock Classes="field-label" Text="New note name" />
                                        <TextBox
                                            Width="220"
                                            KeyDown="OnNewNoteNameKeyDown"
                                            Text="{Binding NewNoteName, UpdateSourceTrigger=PropertyChanged}" />
                                        <Button
                                            Classes="Outlined"
                                            Click="OnNewNoteCreateClick"
                                            Content="Create" />
                                    </StackPanel>
                                </Flyout>
                            </Button.Flyout>
                        </Button>
                        <Button
                            x:Name="NewFolderButton"
                            Grid.Column="2"
                            Classes="icon"
                            ToolTip.Tip="New folder">
                            <Path
                                Width="15"
                                Height="15"
                                Data="{tools:SvgPath icon-folder-alt}"
                                Fill="{DynamicResource BodyForegroundBrush}"
                                Stretch="Uniform" />
                            <Button.Flyout>
                                <Flyout Placement="BottomEdgeAlignedLeft" Opened="OnNewFolderFlyoutOpened">
                                    <StackPanel Spacing="8">
                                        <TextBlock Classes="field-label" Text="New folder name" />
                                        <TextBox
                                            Width="220"
                                            KeyDown="OnNewFolderNameKeyDown"
                                            Text="{Binding NewFolderName, UpdateSourceTrigger=PropertyChanged}" />
                                        <Button
                                            Classes="Outlined"
                                            Click="OnNewFolderCreateClick"
                                            Content="Create" />
                                    </StackPanel>
                                </Flyout>
                            </Button.Flyout>
                        </Button>
                    </Grid>
                    <Panel Grid.Row="1">
                        <!--  Browsing: the tree, or the repo's empty state  -->
                        <Panel IsVisible="{Binding !IsSearching}">
                            <TreeView
                                IsVisible="{Binding HasNotes}"
                                ItemsSource="{Binding Tree}"
                                SelectedItem="{Binding SelectedNode, Mode=TwoWay}">
                                <TreeView.ItemTemplate>
                                    <TreeDataTemplate
                                        x:DataType="vm:NoteNodeViewModel"
                                        ItemsSource="{Binding Children}">
                                        <StackPanel Orientation="Horizontal" Spacing="6">
                                            <Path
                                                Width="14"
                                                Height="14"
                                                Data="{tools:SvgPath icon-folder}"
                                                Fill="{DynamicResource MutedForegroundBrush}"
                                                IsVisible="{Binding IsFolder}"
                                                Stretch="Uniform" />
                                            <Path
                                                Width="14"
                                                Height="14"
                                                Data="{tools:SvgPath icon-note}"
                                                Fill="{DynamicResource MutedForegroundBrush}"
                                                IsVisible="{Binding !IsFolder}"
                                                Stretch="Uniform" />
                                            <TextBlock Text="{Binding Name}" VerticalAlignment="Center" />
                                            <Ellipse
                                                Width="6"
                                                Height="6"
                                                VerticalAlignment="Center"
                                                Fill="{DynamicResource AccentPrimaryBrush}"
                                                IsVisible="{Binding IsDirty}" />
                                        </StackPanel>
                                    </TreeDataTemplate>
                                </TreeView.ItemTemplate>
                            </TreeView>
                            <StackPanel
                                HorizontalAlignment="Center"
                                VerticalAlignment="Center"
                                IsVisible="{Binding !HasNotes}"
                                Spacing="6">
                                <Path
                                    Width="28"
                                    Height="28"
                                    HorizontalAlignment="Center"
                                    Data="{tools:SvgPath icon-note}"
                                    Fill="{DynamicResource MutedForegroundBrush}"
                                    Stretch="Uniform" />
                                <TextBlock
                                    HorizontalAlignment="Center"
                                    Classes="subtle"
                                    IsVisible="{Binding HasRepo}"
                                    Text="{Binding RepoName, StringFormat='No notes yet for {0}.'}"
                                    TextAlignment="Center" />
                                <TextBlock
                                    HorizontalAlignment="Center"
                                    Classes="subtle"
                                    IsVisible="{Binding !HasRepo}"
                                    Text="Select a repository in the table to see its notes."
                                    TextAlignment="Center"
                                    TextWrapping="Wrap" />
                            </StackPanel>
                        </Panel>
                        <!--  Search results replace the tree while a term is active  -->
                        <ListBox
                            x:Name="SearchResultsList"
                            Classes="plain-list"
                            IsVisible="{Binding IsSearching}"
                            ItemsSource="{Binding SearchResults}"
                            SelectionChanged="OnSearchResultSelected">
                            <ListBox.ItemTemplate>
                                <DataTemplate x:DataType="lib:NotesSearchHit">
                                    <StackPanel Margin="0,2" Spacing="1">
                                        <Grid ColumnDefinitions="*,Auto" ColumnSpacing="8">
                                            <TextBlock
                                                Grid.Column="0"
                                                FontWeight="SemiBold"
                                                Text="{Binding Name}"
                                                TextTrimming="CharacterEllipsis" />
                                            <TextBlock
                                                Grid.Column="1"
                                                Classes="subtle"
                                                Text="{Binding RelativePath}"
                                                TextTrimming="CharacterEllipsis" />
                                        </Grid>
                                        <TextBlock
                                            Classes="subtle"
                                            Text="{Binding Excerpt}"
                                            TextTrimming="CharacterEllipsis" />
                                    </StackPanel>
                                </DataTemplate>
                            </ListBox.ItemTemplate>
                        </ListBox>
                    </Panel>
                </Grid>
            </Border>

            <!--  Right card: the open note  -->
            <Border Grid.Column="1" Classes="card">
                <Panel>
                    <Grid IsVisible="{Binding HasOpenNote}" RowDefinitions="Auto,*">
                        <Grid
                            Grid.Row="0"
                            Margin="0,0,0,8"
                            ColumnDefinitions="*,Auto,Auto,Auto"
                            ColumnSpacing="8">
                            <StackPanel
                                Grid.Column="0"
                                Orientation="Horizontal"
                                Spacing="8"
                                VerticalAlignment="Center">
                                <TextBlock
                                    FontWeight="SemiBold"
                                    Text="{Binding OpenNoteName}"
                                    TextTrimming="CharacterEllipsis" />
                                <Ellipse
                                    Width="7"
                                    Height="7"
                                    VerticalAlignment="Center"
                                    Fill="{DynamicResource AccentPrimaryBrush}"
                                    IsVisible="{Binding IsDirty}" />
                            </StackPanel>
                            <StackPanel
                                Grid.Column="1"
                                Orientation="Horizontal"
                                Spacing="2"
                                VerticalAlignment="Center">
                                <ToggleButton Classes="seg" Content="Edit" IsChecked="{Binding IsEditMode}" />
                                <ToggleButton Classes="seg" Content="Preview" IsChecked="{Binding !IsEditMode}" />
                            </StackPanel>
                            <Button
                                Grid.Column="3"
                                Classes="icon"
                                Command="{Binding DeleteOpenNoteCommand}"
                                ToolTip.Tip="{Binding DeleteTooltip}">
                                <Path
                                    Width="15"
                                    Height="15"
                                    Data="{tools:SvgPath icon-trash}"
                                    Fill="{DynamicResource BodyForegroundBrush}"
                                    Stretch="Uniform" />
                            </Button>
                        </Grid>
                        <Panel Grid.Row="1">
                            <TextBox
                                AcceptsReturn="True"
                                Background="Transparent"
                                BorderThickness="0"
                                IsVisible="{Binding IsEditMode}"
                                KeyDown="OnNoteEditorKeyDown"
                                Padding="0"
                                Text="{Binding NoteText, UpdateSourceTrigger=PropertyChanged}"
                                TextWrapping="Wrap"
                                VerticalContentAlignment="Top" />
                            <!--  Default markdown style (its text colors follow the app
                                 theme), with the code-block chrome re-tinted dark: the
                                 style's alpha-shaded background renders opaque light in
                                 the Tight build, so the override must sit on the viewer
                                 itself (same style frame, appended after → wins).  -->
                            <md:MarkdownScrollViewer
                                IsVisible="{Binding !IsEditMode}"
                                Markdown="{Binding NoteText}">
                                <md:MarkdownScrollViewer.Styles>
                                    <Style Selector="Border.CodeBlock">
                                        <Setter Property="Background" Value="#232329" />
                                        <Setter Property="BorderBrush" Value="{DynamicResource HairlineBrush}" />
                                    </Style>
                                    <Style Selector="TextBlock.CodeBlock">
                                        <Setter Property="Foreground" Value="{DynamicResource BodyForegroundBrush}" />
                                    </Style>
                                </md:MarkdownScrollViewer.Styles>
                            </md:MarkdownScrollViewer>
                        </Panel>
                    </Grid>
                    <!--  No note open  -->
                    <StackPanel
                        HorizontalAlignment="Center"
                        VerticalAlignment="Center"
                        IsVisible="{Binding !HasOpenNote}"
                        Spacing="8">
                        <Path
                            Width="32"
                            Height="32"
                            HorizontalAlignment="Center"
                            Data="{tools:SvgPath icon-note}"
                            Fill="{DynamicResource MutedForegroundBrush}"
                            Stretch="Uniform" />
                        <TextBlock
                            HorizontalAlignment="Center"
                            Classes="subtle"
                            Text="Select a note from the tree, or create one with +"
                            TextAlignment="Center" />
                    </StackPanel>
                </Panel>
            </Border>
        </Grid>
    </Grid>
</UserControl>
