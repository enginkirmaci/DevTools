<?xml version="1.0" encoding="utf-8" ?>
<!--
    Dedicated Notes page (back link returns to the Repositories page). The
    title-bar note button opens the whole notes store — one folder per
    repository; a repo row's note button opens the page scoped to that repo's
    folder. Unsaved edits live in the view model and survive navigation.
-->
<UserControl
    x:Class="Tools.Views.Pages.NotesPage"
    xmlns="https://github.com/avaloniaui"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:helpers="using:Tools.Helpers"
    xmlns:lib="using:Tools.Library.Services.Abstractions"
    xmlns:mk="using:MarkdownViewerKit"
    xmlns:tools="using:Tools.Library.MarkupExtensions"
    xmlns:vm="using:Tools.ViewModels.Pages"
    d:DesignHeight="800"
    d:DesignWidth="1200"
    x:CompileBindings="True"
    x:DataType="vm:NotesPageViewModel"
    mc:Ignorable="d">

    <UserControl.Styles>
        <!--  Tree rows: transparent chrome, app hover tint, accent-selected header;
             expansion lives on the node (x:DataType makes the setter binding compile
             against the row VM, not the TreeViewItem)  -->
        <Style Selector="TreeViewItem" x:DataType="vm:NoteNodeViewModel">
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="Padding" Value="0" />
            <Setter Property="Margin" Value="0,1" />
            <Setter Property="IsExpanded" Value="{Binding IsExpanded, Mode=TwoWay}" />
        </Style>
        <Style Selector="TreeViewItem /template/ Border#PART_Header">
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="MinHeight" Value="26" />
            <Setter Property="CornerRadius" Value="{DynamicResource ControlRadius}" />
        </Style>
        <Style Selector="TreeViewItem:pointerover /template/ Border#PART_Header">
            <Setter Property="Background" Value="{DynamicResource HoverBackgroundBrush}" />
        </Style>
        <Style Selector="TreeViewItem:selected /template/ Border#PART_Header">
            <Setter Property="Background" Value="{DynamicResource SukiPrimaryColor15}" />
        </Style>
        <!--  Edit/Split/Preview segmented pair  -->
        <Style Selector="ToggleButton.seg">
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="Padding" Value="10,4" />
            <Setter Property="CornerRadius" Value="6" />
            <Setter Property="FontSize" Value="12.5" />
            <Setter Property="Foreground" Value="{DynamicResource MutedForegroundBrush}" />
        </Style>
        <Style Selector="ToggleButton.seg:checked">
            <Setter Property="Background" Value="{DynamicResource SukiPrimaryColor15}" />
            <Setter Property="Foreground" Value="{DynamicResource TitleForegroundBrush}" />
            <Setter Property="FontWeight" Value="SemiBold" />
        </Style>
        <!--  Markdown toolbar: 28px quiet buttons (icon paths + text glyphs)  -->
        <Style Selector="Button.mdtool">
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="Padding" Value="0" />
            <Setter Property="Width" Value="28" />
            <Setter Property="Height" Value="28" />
            <Setter Property="CornerRadius" Value="5" />
            <Setter Property="Margin" Value="0,0,2,2" />
            <Setter Property="Foreground" Value="{DynamicResource MutedForegroundBrush}" />
        </Style>
        <Style Selector="Button.mdtool:pointerover">
            <Setter Property="Background" Value="{DynamicResource HoverBackgroundBrush}" />
            <Setter Property="Foreground" Value="{DynamicResource TitleForegroundBrush}" />
        </Style>
        <Style Selector="Border.tool-sep">
            <Setter Property="Width" Value="1" />
            <Setter Property="Height" Value="16" />
            <Setter Property="Margin" Value="4,7,6,5" />
            <Setter Property="Background" Value="{DynamicResource HairlineBrush}" />
        </Style>
    </UserControl.Styles>

    <Grid RowDefinitions="Auto,*">
        <!--  Identity bar: back link, title, current repo chip, folder jump, Save  -->
        <!--  MinHeight reserves the Save button's slot (39 = its rendered height) so
             IsDirty appearing does not grow the row and shift every preview line  -->
        <Grid
            Grid.Row="0"
            Margin="16,10,16,6"
            MinHeight="39"
            ColumnDefinitions="Auto,Auto,Auto,*,Auto,Auto"
            ColumnSpacing="12">
            <Button
                Grid.Column="0"
                Classes="icon"
                Click="OnBackClick"
                ToolTip.Tip="Back to repositories">
                <Path
                    Width="14"
                    Height="14"
                    Data="{tools:SvgPath icon-arrow-left}"
                    Fill="{DynamicResource BodyForegroundBrush}"
                    Stretch="Uniform" />
            </Button>
            <TextBlock
                Grid.Column="1"
                VerticalAlignment="Center"
                FontSize="18"
                FontWeight="SemiBold"
                Text="Notes" />
            <TextBlock
                Grid.Column="2"
                VerticalAlignment="Center"
                Classes="subtle"
                IsVisible="{Binding HasRepo}"
                Text="{Binding RepoName}" />
            <Button
                Grid.Column="4"
                Classes="icon"
                Command="{Binding OpenStoreFolderCommand}"
                ToolTip.Tip="Open the notes folder">
                <Path
                    Width="15"
                    Height="15"
                    Data="{tools:SvgPath icon-folder}"
                    Fill="{DynamicResource BodyForegroundBrush}"
                    Stretch="Uniform" />
            </Button>
            <Button
                Grid.Column="5"
                Classes="Outlined"
                Command="{Binding SaveCommand}"
                Content="Save"
                IsVisible="{Binding IsDirty}" />
        </Grid>

        <Grid
            Grid.Row="1"
            Margin="16,4,16,16"
            ColumnDefinitions="300,*"
            ColumnSpacing="12">
            <!--  Left card: search, new note/folder, tree  -->
            <Border Grid.Column="0" Classes="card">
                <Grid RowDefinitions="Auto,*">
                    <Grid
                        Grid.Row="0"
                        Margin="0,0,0,8"
                        ColumnDefinitions="*,Auto,Auto"
                        ColumnSpacing="4">
                        <TextBox
                            Grid.Column="0"
                            HorizontalContentAlignment="Left"
                            KeyDown="OnSearchBoxKeyDown"
                            Text="{Binding SearchText, UpdateSourceTrigger=PropertyChanged}"
                            PlaceholderText="{Binding SearchPlaceholder}" />
                        <Button
                            x:Name="NewNoteButton"
                            Grid.Column="1"
                            Classes="icon"
                            ToolTip.Tip="New note">
                            <Path
                                Width="15"
                                Height="15"
                                Data="{tools:SvgPath icon-plus}"
                                Fill="{DynamicResource BodyForegroundBrush}"
                                Stretch="Uniform" />
                            <Button.Flyout>
                                <Flyout Placement="BottomEdgeAlignedLeft" Opened="OnNewNoteFlyoutOpened">
                                    <StackPanel Spacing="8">
                                        <TextBlock Classes="field-label" Text="New note name" />
                                        <TextBox
                                            Width="220"
                                            KeyDown="OnNewNoteNameKeyDown"
                                            Text="{Binding NewNoteName, UpdateSourceTrigger=PropertyChanged}" />
                                        <Button
                                            Classes="Outlined"
                                            Click="OnNewNoteCreateClick"
                                            Content="Create" />
                                    </StackPanel>
                                </Flyout>
                            </Button.Flyout>
                        </Button>
                        <Button
                            x:Name="NewFolderButton"
                            Grid.Column="2"
                            Classes="icon"
                            ToolTip.Tip="New folder">
                            <Path
                                Width="15"
                                Height="15"
                                Data="{tools:SvgPath icon-folder-alt}"
                                Fill="{DynamicResource BodyForegroundBrush}"
                                Stretch="Uniform" />
                            <Button.Flyout>
                                <Flyout Placement="BottomEdgeAlignedLeft" Opened="OnNewFolderFlyoutOpened">
                                    <StackPanel Spacing="8">
                                        <TextBlock Classes="field-label" Text="New folder name" />
                                        <TextBox
                                            Width="220"
                                            KeyDown="OnNewFolderNameKeyDown"
                                            Text="{Binding NewFolderName, UpdateSourceTrigger=PropertyChanged}" />
                                        <Button
                                            Classes="Outlined"
                                            Click="OnNewFolderCreateClick"
                                            Content="Create" />
                                    </StackPanel>
                                </Flyout>
                            </Button.Flyout>
                        </Button>
                    </Grid>
                    <Panel Grid.Row="1">
                        <!--  Browsing: the whole-store tree, or the store's empty state  -->
                        <Panel IsVisible="{Binding !IsSearching}">
                            <TreeView
                                IsVisible="{Binding HasNotes}"
                                ItemsSource="{Binding Tree}"
                                SelectedItem="{Binding SelectedNode, Mode=TwoWay}">
                                <TreeView.ItemTemplate>
                                    <TreeDataTemplate
                                        x:DataType="vm:NoteNodeViewModel"
                                        ItemsSource="{Binding Children}">
                                        <StackPanel Orientation="Horizontal" Spacing="6">
                                            <Path
                                                Width="14"
                                                Height="14"
                                                Data="{tools:SvgPath icon-folder}"
                                                Fill="{DynamicResource MutedForegroundBrush}"
                                                IsVisible="{Binding IsFolder}"
                                                Stretch="Uniform" />
                                            <Path
                                                Width="14"
                                                Height="14"
                                                Data="{tools:SvgPath icon-note}"
                                                Fill="{DynamicResource MutedForegroundBrush}"
                                                IsVisible="{Binding !IsFolder}"
                                                Stretch="Uniform" />
                                            <TextBlock Text="{Binding Name}" VerticalAlignment="Center" />
                                            <Ellipse
                                                Width="6"
                                                Height="6"
                                                VerticalAlignment="Center"
                                                Fill="{DynamicResource AccentPrimaryBrush}"
                                                IsVisible="{Binding IsDirty}" />
                                        </StackPanel>
                                    </TreeDataTemplate>
                                </TreeView.ItemTemplate>
                            </TreeView>
                            <StackPanel
                                HorizontalAlignment="Center"
                                VerticalAlignment="Center"
                                IsVisible="{Binding !HasNotes}"
                                Spacing="6">
                                <Path
                                    Width="28"
                                    Height="28"
                                    HorizontalAlignment="Center"
                                    Data="{tools:SvgPath icon-note}"
                                    Fill="{DynamicResource MutedForegroundBrush}"
                                    Stretch="Uniform" />
                                <TextBlock
                                    HorizontalAlignment="Center"
                                    Classes="subtle"
                                    Text="No notes yet."
                                    TextAlignment="Center" />
                                <TextBlock
                                    HorizontalAlignment="Center"
                                    Classes="subtle"
                                    Text="{Binding EmptyStateHint}"
                                    TextAlignment="Center"
                                    TextWrapping="Wrap" />
                            </StackPanel>
                        </Panel>
                        <!--  Search results replace the tree while a term is active  -->
                        <ListBox
                            x:Name="SearchResultsList"
                            Classes="plain-list"
                            IsVisible="{Binding IsSearching}"
                            ItemsSource="{Binding SearchResults}"
                            SelectionChanged="OnSearchResultSelected">
                            <ListBox.ItemTemplate>
                                <DataTemplate x:DataType="lib:NotesSearchHit">
                                    <StackPanel Margin="0,2" Spacing="1">
                                        <Grid ColumnDefinitions="*,Auto" ColumnSpacing="8">
                                            <TextBlock
                                                Grid.Column="0"
                                                FontWeight="SemiBold"
                                                Text="{Binding Name}"
                                                TextTrimming="CharacterEllipsis" />
                                            <TextBlock
                                                Grid.Column="1"
                                                Classes="subtle"
                                                Text="{Binding RelativePath}"
                                                TextTrimming="CharacterEllipsis" />
                                        </Grid>
                                        <TextBlock
                                            Classes="subtle"
                                            Text="{Binding Excerpt}"
                                            TextTrimming="CharacterEllipsis" />
                                    </StackPanel>
                                </DataTemplate>
                            </ListBox.ItemTemplate>
                        </ListBox>
                    </Panel>
                </Grid>
            </Border>

            <!--  Right card: the open note  -->
            <Border Grid.Column="1" Classes="card">
                <Panel>
                    <Grid
                        IsVisible="{Binding HasOpenNote}"
                        RowDefinitions="Auto,Auto,*,Auto">
                        <Grid
                            Grid.Row="0"
                            Margin="0,0,0,8"
                            ColumnDefinitions="*,Auto,Auto,Auto"
                            ColumnSpacing="8">
                            <StackPanel
                                Grid.Column="0"
                                Orientation="Horizontal"
                                Spacing="8"
                                VerticalAlignment="Center">
                                <TextBlock
                                    FontWeight="SemiBold"
                                    Text="{Binding OpenNoteName}"
                                    TextTrimming="CharacterEllipsis" />
                                <Ellipse
                                    Width="7"
                                    Height="7"
                                    VerticalAlignment="Center"
                                    Fill="{DynamicResource AccentPrimaryBrush}"
                                    IsVisible="{Binding IsDirty}" />
                            </StackPanel>
                            <StackPanel
                                Grid.Column="1"
                                Orientation="Horizontal"
                                Spacing="2"
                                VerticalAlignment="Center">
                                <ToggleButton Classes="seg" Content="Edit" IsChecked="{Binding IsEditMode}" />
                                <ToggleButton Classes="seg" Content="Split" IsChecked="{Binding IsSplitMode}" />
                                <ToggleButton Classes="seg" Content="Preview" IsChecked="{Binding IsPreviewMode}" />
                            </StackPanel>
                            <Button
                                Grid.Column="3"
                                Classes="icon"
                                Command="{Binding DeleteOpenNoteCommand}"
                                ToolTip.Tip="{Binding DeleteTooltip}">
                                <Path
                                    Width="15"
                                    Height="15"
                                    Data="{tools:SvgPath icon-trash}"
                                    Fill="{DynamicResource BodyForegroundBrush}"
                                    Stretch="Uniform" />
                            </Button>
                        </Grid>
                        <!--  Formatting toolbar: transforms run through MarkdownEditing
                             via the shared OnFormatClick (format named in Tag)  -->
                        <WrapPanel
                            Grid.Row="1"
                            Margin="0,0,0,8"
                            IsVisible="{Binding IsEditorVisible}">
                            <Button
                                Classes="mdtool"
                                Click="OnFormatClick"
                                Tag="{x:Static helpers:MarkdownEditing.Bold}"
                                ToolTip.Tip="Bold (Ctrl+B)">
                                <TextBlock FontWeight="Bold" Text="B" />
                            </Button>
                            <Button
                                Classes="mdtool"
                                Click="OnFormatClick"
                                Tag="{x:Static helpers:MarkdownEditing.Italic}"
                                ToolTip.Tip="Italic (Ctrl+I)">
                                <TextBlock FontStyle="Italic" FontWeight="SemiBold" Text="I" />
                            </Button>
                            <Button
                                Classes="mdtool"
                                Click="OnFormatClick"
                                Tag="{x:Static helpers:MarkdownEditing.Strikethrough}"
                                ToolTip.Tip="Strikethrough">
                                <TextBlock Text="S" TextDecorations="Strikethrough" />
                            </Button>
                            <Border Classes="tool-sep" />
                            <Button
                                Classes="mdtool"
                                Click="OnFormatClick"
                                Tag="{x:Static helpers:MarkdownEditing.Heading1}"
                                ToolTip.Tip="Heading 1">
                                <TextBlock FontSize="11" FontWeight="SemiBold" Text="H1" />
                            </Button>
                            <Button
                                Classes="mdtool"
                                Click="OnFormatClick"
                                Tag="{x:Static helpers:MarkdownEditing.Heading2}"
                                ToolTip.Tip="Heading 2">
                                <TextBlock FontSize="11" FontWeight="SemiBold" Text="H2" />
                            </Button>
                            <Button
                                Classes="mdtool"
                                Click="OnFormatClick"
                                Tag="{x:Static helpers:MarkdownEditing.Heading3}"
                                ToolTip.Tip="Heading 3">
                                <TextBlock FontSize="11" FontWeight="SemiBold" Text="H3" />
                            </Button>
                            <Border Classes="tool-sep" />
                            <Button
                                Classes="mdtool"
                                Click="OnFormatClick"
                                Tag="{x:Static helpers:MarkdownEditing.BulletList}"
                                ToolTip.Tip="Bullet list">
                                <Path
                                    Width="15"
                                    Height="15"
                                    Data="{tools:SvgPath icon-list-bullet}"
                                    Fill="{Binding $parent[Button].Foreground}"
                                    Stretch="Uniform" />
                            </Button>
                            <Button
                                Classes="mdtool"
                                Click="OnFormatClick"
                                Tag="{x:Static helpers:MarkdownEditing.OrderedList}"
                                ToolTip.Tip="Numbered list">
                                <Path
                                    Width="15"
                                    Height="15"
                                    Data="{tools:SvgPath icon-list-ordered}"
                                    Fill="{Binding $parent[Button].Foreground}"
                                    Stretch="Uniform" />
                            </Button>
                            <Button
                                Classes="mdtool"
                                Click="OnFormatClick"
                                Tag="{x:Static helpers:MarkdownEditing.TaskList}"
                                ToolTip.Tip="Task list">
                                <Path
                                    Width="15"
                                    Height="15"
                                    Data="{tools:SvgPath icon-task}"
                                    Fill="{Binding $parent[Button].Foreground}"
                                    Stretch="Uniform" />
                            </Button>
                            <Border Classes="tool-sep" />
                            <Button
                                Classes="mdtool"
                                Click="OnFormatClick"
                                Tag="{x:Static helpers:MarkdownEditing.Blockquote}"
                                ToolTip.Tip="Quote">
                                <Path
                                    Width="15"
                                    Height="15"
                                    Data="{tools:SvgPath icon-quote}"
                                    Fill="{Binding $parent[Button].Foreground}"
                                    Stretch="Uniform" />
                            </Button>
                            <Button
                                Classes="mdtool"
                                Click="OnFormatClick"
                                Tag="{x:Static helpers:MarkdownEditing.Rule}"
                                ToolTip.Tip="Horizontal rule">
                                <Path
                                    Width="15"
                                    Height="15"
                                    Data="{tools:SvgPath icon-minus}"
                                    Fill="{Binding $parent[Button].Foreground}"
                                    Stretch="Uniform" />
                            </Button>
                            <Border Classes="tool-sep" />
                            <Button
                                Classes="mdtool"
                                Click="OnFormatClick"
                                Tag="{x:Static helpers:MarkdownEditing.InlineCode}"
                                ToolTip.Tip="Inline code">
                                <Path
                                    Width="15"
                                    Height="15"
                                    Data="{tools:SvgPath icon-code}"
                                    Fill="{Binding $parent[Button].Foreground}"
                                    Stretch="Uniform" />
                            </Button>
                            <Button
                                Classes="mdtool"
                                Click="OnFormatClick"
                                Tag="{x:Static helpers:MarkdownEditing.CodeBlock}"
                                ToolTip.Tip="Code block">
                                <Path
                                    Width="15"
                                    Height="15"
                                    Data="{tools:SvgPath icon-code-block}"
                                    Fill="{Binding $parent[Button].Foreground}"
                                    Stretch="Uniform" />
                            </Button>
                            <Border Classes="tool-sep" />
                            <Button
                                Classes="mdtool"
                                Click="OnFormatClick"
                                Tag="{x:Static helpers:MarkdownEditing.Link}"
                                ToolTip.Tip="Link (Ctrl+K)">
                                <Path
                                    Width="15"
                                    Height="15"
                                    Data="{tools:SvgPath icon-link}"
                                    Fill="{Binding $parent[Button].Foreground}"
                                    Stretch="Uniform" />
                            </Button>
                        </WrapPanel>
                        <Panel Grid.Row="2">
                            <!--  Edit only: mono source editor  -->
                            <TextBox
                                x:Name="NoteEditor"
                                AcceptsReturn="True"
                                Background="Transparent"
                                BorderThickness="0"
                                FontFamily="menlo,monaco,consolas,courier new,monospace"
                                FontSize="13"
                                IsVisible="{Binding IsEditMode}"
                                Padding="0"
                                SelectionBrush="#4D6E9BF7"
                                Text="{Binding NoteText, UpdateSourceTrigger=PropertyChanged}"
                                TextWrapping="Wrap"
                                VerticalContentAlignment="Top" />
                            <!--  Split: source editor beside the live preview  -->
                            <Grid
                                ColumnDefinitions="*,1,*"
                                IsVisible="{Binding IsSplitMode}">
                                <TextBox
                                    x:Name="NoteEditorSplit"
                                    Grid.Column="0"
                                    AcceptsReturn="True"
                                    Background="Transparent"
                                    BorderThickness="0"
                                    FontFamily="menlo,monaco,consolas,courier new,monospace"
                                    FontSize="13"
                                    Padding="0"
                                    SelectionBrush="#4D6E9BF7"
                                    Text="{Binding NoteText, UpdateSourceTrigger=PropertyChanged}"
                                    TextWrapping="Wrap"
                                    VerticalContentAlignment="Top" />
                                <Border
                                    Grid.Column="1"
                                    Margin="10,0"
                                    Background="{DynamicResource HairlineBrush}" />
                                <mk:MarkdownViewer
                                    Grid.Column="2"
                                    x:Name="SplitPreview"
                                    InteractiveTaskLists="True"
                                    Markdown="{Binding NoteText, Mode=OneWay}"
                                    TaskToggled="OnTaskToggled" />
                            </Grid>
                            <mk:MarkdownViewer
                                x:Name="PreviewOnly"
                                IsVisible="{Binding IsPreviewMode}"
                                InteractiveTaskLists="True"
                                Markdown="{Binding NoteText, Mode=OneWay}"
                                TaskToggled="OnTaskToggled" />
                        </Panel>
                        <!--  Status bar: document stats + caret position  -->
                        <StackPanel Grid.Row="3" Margin="0,8,0,0">
                            <Border Height="1" Background="{DynamicResource HairlineBrush}" />
                            <Grid Margin="0,6,0,0" ColumnDefinitions="*,Auto">
                                <TextBlock
                                    Grid.Column="0"
                                    Classes="subtle"
                                    FontSize="11"
                                    Text="{Binding StatusStats}" />
                                <TextBlock
                                    Grid.Column="1"
                                    Classes="subtle"
                                    FontSize="11"
                                    Text="{Binding CursorPosition}" />
                            </Grid>
                        </StackPanel>
                    </Grid>
                    <!--  No note open  -->
                    <StackPanel
                        HorizontalAlignment="Center"
                        VerticalAlignment="Center"
                        IsVisible="{Binding !HasOpenNote}"
                        Spacing="8">
                        <Path
                            Width="32"
                            Height="32"
                            HorizontalAlignment="Center"
                            Data="{tools:SvgPath icon-note}"
                            Fill="{DynamicResource MutedForegroundBrush}"
                            Stretch="Uniform" />
                        <TextBlock
                            HorizontalAlignment="Center"
                            Classes="subtle"
                            Text="Select a note from the tree, or create one with +"
                            TextAlignment="Center" />
                    </StackPanel>
                </Panel>
            </Border>
        </Grid>
    </Grid>
</UserControl>
