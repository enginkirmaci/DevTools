<UserControl
        x:Class="Tools.Views.Pages.DashboardPage"
        xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:controls="using:Tools.Controls"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        d:DesignHeight="600"
        d:DesignWidth="900"
        mc:Ignorable="d">

        <Grid Classes="page-root" RowDefinitions="Auto,*">

                <!--  Header Banner  -->
                <Border
                        Grid.Row="0"
                        Padding="28,24,28,16"
                        Background="{DynamicResource ContentBackgroundBrush}">
                        <Grid ColumnDefinitions="*,Auto">
                                <StackPanel
                                        Grid.Column="0"
                                        VerticalAlignment="Center"
                                        Spacing="6">
                                        <TextBlock Classes="page-title" Text="Development Tools" />
                                        <TextBlock Classes="page-subtitle" Text="Quick access to your development utilities" />
                                </StackPanel>
                        </Grid>
                </Border>

                <!--  Dashboard Cards Grid  -->
                <ScrollViewer
                        Grid.Row="1"
                        Padding="28,16,28,20"
                        HorizontalScrollBarVisibility="Disabled"
                        VerticalScrollBarVisibility="Auto">
                        <ItemsControl ItemsSource="{Binding DashboardCards}">
                                <ItemsControl.ItemsPanel>
                                        <ItemsPanelTemplate>
                                                <controls:ResponsiveWrapPanel MinItemWidth="260" Spacing="12" />
                                        </ItemsPanelTemplate>
                                </ItemsControl.ItemsPanel>
                                <ItemsControl.ItemTemplate>
                                        <DataTemplate>
                                                <Button
                                                        Height="116"
                                                        Margin="1"
                                                        Padding="16"
                                                        HorizontalAlignment="Stretch"
                                                        HorizontalContentAlignment="Stretch"
                                                        VerticalContentAlignment="Top"
                                                        BorderThickness="1"
                                                        Classes="card-button"
                                                        Command="{Binding Command}"
                                                        CommandParameter="{Binding PageKey}"
                                                        CornerRadius="{DynamicResource CardRadius}"
                                                        Cursor="Hand">
                                                        <Grid ColumnDefinitions="*,Auto" ColumnSpacing="12">
                                                                <!--  Big bold title at top-left, muted subtitle below  -->
                                                                <StackPanel
                                                                        Grid.Column="0"
                                                                        VerticalAlignment="Top"
                                                                        Spacing="6">
                                                                        <TextBlock
                                                                                FontSize="17"
                                                                                FontWeight="SemiBold"
                                                                                Foreground="{DynamicResource TitleForegroundBrush}"
                                                                                Text="{Binding Title}"
                                                                                TextWrapping="Wrap" />
                                                                        <TextBlock
                                                                                VerticalAlignment="Top"
                                                                                FontSize="12"
                                                                                Foreground="{DynamicResource MutedForegroundBrush}"
                                                                                LineHeight="16"
                                                                                Text="{Binding Subtitle}"
                                                                                TextWrapping="Wrap" />
                                                                </StackPanel>

                                                                <!--  Accent-tinted icon chip, pinned top-right  -->
                                                                <Border
                                                                        Grid.Column="1"
                                                                        Width="36"
                                                                        Height="36"
                                                                        HorizontalAlignment="Right"
                                                                        VerticalAlignment="Top"
                                                                        Background="{DynamicResource IconChipBackgroundBrush}"
                                                                        CornerRadius="{DynamicResource ControlRadius}">
                                                                        <Path
                                                                                Width="20"
                                                                                Height="20"
                                                                                HorizontalAlignment="Center"
                                                                                VerticalAlignment="Center"
                                                                                Data="{Binding IconPath, Converter={StaticResource StringToGeometryConverter}}"
                                                                                Fill="{Binding AccentColor, Converter={StaticResource StringToBrushConverter}}"
                                                                                Stretch="Uniform" />
                                                                </Border>
                                                        </Grid>
                                                </Button>
                                        </DataTemplate>
                                </ItemsControl.ItemTemplate>
                        </ItemsControl>
                </ScrollViewer>
        </Grid>
</UserControl>
