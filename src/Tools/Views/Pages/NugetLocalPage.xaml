<UserControl
	x:Class="Tools.Views.Pages.NugetLocalPage"
	xmlns="https://github.com/avaloniaui"
	xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
	xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
	xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
	xmlns:tools="using:Tools.Library.MarkupExtensions"
	d:DesignHeight="500"
	d:DesignWidth="700"
	mc:Ignorable="d">

	<Grid Classes="page-root" RowDefinitions="Auto,Auto,*">

		<TextBlock
			Grid.Row="0"
			Classes="section-title"
			Text="NuGet Package Manager" />

		<Border
			Grid.Row="1"
			Margin="0,0,0,12"
			Classes="card">
			<Grid ColumnDefinitions="*,Auto">
				<StackPanel Grid.Column="0" Classes="field-stack">
					<StackPanel Spacing="4">
						<TextBlock
							Margin="0,2,0,0"
							Classes="field-label"
							Text="Watch Directory" />
						<Grid ColumnDefinitions="*,Auto">
							<TextBox
								Grid.Column="0"
								Margin="0,0,0,8"
								Text="{Binding WatchFolder, Mode=TwoWay}"
								Watermark="Select a folder to watch for .nupkg files..." />
							<Button
								Grid.Column="1"
								Margin="0,0,0,8"
								Classes="icon"
								Command="{Binding SelectFolderCommand}"
								CommandParameter="Watch">
								<Path Classes="icon" Data="{tools:SvgPath icon-folder}" />
							</Button>
						</Grid>
					</StackPanel>

					<Grid ColumnDefinitions="Auto,*,Auto" RowDefinitions="Auto,Auto">
						<TextBlock
							Grid.Column="0"
							Margin="0,0,0,8"
							Text="NuGet Local Cache" />
						<TextBlock
							Grid.Column="1"
							Classes="subtle"
							Text="{Binding ComputedCopyFolder}"
							TextTrimming="CharacterEllipsis" />

						<TextBlock
							Grid.Row="1"
							Grid.Column="0"
							Text="NuGet Global Cache" />
						<TextBlock
							Grid.Row="1"
							Grid.Column="1"
							Classes="subtle"
							Text="{Binding GlobalPackagesFolder}"
							TextTrimming="CharacterEllipsis" />

						<Button
							Grid.RowSpan="2"
							Grid.Column="2"
							Classes="Outlined"
							Command="{Binding RegisterSourceCommand}">
							<StackPanel Orientation="Horizontal" Spacing="4">
								<Path
									Width="16"
									Height="16"
									Data="{tools:SvgPath icon-account}"
									Fill="{Binding $parent[Button].Foreground}"
									Stretch="Uniform" />
								<TextBlock Text="Register" />
							</StackPanel>
						</Button>
					</Grid>
				</StackPanel>

				<StackPanel
					Grid.Column="1"
					Margin="16,0,0,0"
					VerticalAlignment="Top"
					Spacing="8">
					<TextBlock
						HorizontalAlignment="Center"
						Classes="field-label"
						Text="Operations" />
					<Button
						HorizontalAlignment="Center"
						Classes="Outlined"
						Command="{Binding WatchChangesCommand}"
						CommandParameter="{Binding !WatchStarted}">
						<Panel>
							<StackPanel
								IsVisible="{Binding !WatchStarted}"
								Orientation="Horizontal"
								Spacing="4">
								<Path
									Width="16"
									Height="16"
									Data="{tools:SvgPath icon-play}"
									Fill="{Binding $parent[Button].Foreground}"
									Stretch="Uniform" />
								<TextBlock Text="Start" />
							</StackPanel>
							<StackPanel
								IsVisible="{Binding WatchStarted}"
								Orientation="Horizontal"
								Spacing="4">
								<Path
									Width="16"
									Height="16"
									Data="{tools:SvgPath icon-stop}"
									Fill="{Binding $parent[Button].Foreground}"
									Stretch="Uniform" />
								<TextBlock Text="Stop" />
							</StackPanel>
						</Panel>
					</Button>
				</StackPanel>
			</Grid>
		</Border>

		<Grid
			Grid.Row="2"
			RowDefinitions="Auto,*"
			RowSpacing="12">

			<Grid
				Grid.Row="0"
				ColumnDefinitions="Auto,*"
				ColumnSpacing="12">
				<Border Grid.Column="0" Classes="card">
					<!--  Stat card in the repos panel's vocabulary: tinted icon badge
					        with the full-strength glyph on top, big number + label beside.  -->
					<StackPanel Orientation="Horizontal" Spacing="12">
						<Grid Width="36" Height="36" VerticalAlignment="Top">
							<Border Background="{DynamicResource InfoAccentBrush}" Classes="stat-badge" />
							<Path
								Width="18"
								Height="18"
								HorizontalAlignment="Center"
								VerticalAlignment="Center"
								Data="{tools:SvgPath icon-chart-bar}"
								Fill="{DynamicResource InfoAccentBrush}"
								Stretch="Uniform" />
						</Grid>
						<StackPanel VerticalAlignment="Center" Spacing="2">
							<TextBlock
								FontSize="22"
								FontWeight="Bold"
								Foreground="{DynamicResource TitleForegroundBrush}"
								Text="{Binding Count}" />
							<TextBlock Classes="subtle" Text="Packages Refreshed" />
						</StackPanel>
					</StackPanel>
				</Border>

				<Border Grid.Column="1" Classes="card">
					<StackPanel Spacing="8">
						<TextBlock Classes="card-title" Text="How it works" />
						<TextBlock Classes="body-text" Text="1. Register your build folder as a local NuGet source." />
						<TextBlock Classes="body-text" Text="2. Start Watch to monitor for new build outputs (.nupkg)." />
						<TextBlock Classes="body-text" Text="3. On every build, the tool clears the global cache, forcing consumer projects to fetch your fresh DLLs." />
					</StackPanel>
				</Border>
			</Grid>

			<Border Grid.Row="1" Classes="card">
				<Grid RowDefinitions="Auto,*">
					<TextBlock
						Grid.Row="0"
						Margin="0,0,0,8"
						Classes="card-title"
						Text="Activity Log" />
					<ScrollViewer Grid.Row="1">
						<ItemsControl ItemsSource="{Binding FileList}">
							<ItemsControl.ItemTemplate>
								<DataTemplate>
									<!--  Activity rows in the repos table's row language:
									        contiguous, bottom hairline separator, hover tint.  -->
									<Border Classes="list-row">
										<TextBlock
											Classes="subtle"
											Text="{Binding}"
											TextTrimming="CharacterEllipsis"
											ToolTip.Tip="{Binding}" />
									</Border>
								</DataTemplate>
							</ItemsControl.ItemTemplate>
						</ItemsControl>
					</ScrollViewer>
				</Grid>
			</Border>
		</Grid>
	</Grid>
</UserControl>
