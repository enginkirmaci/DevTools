<?xml version="1.0" encoding="utf-8" ?>
<UserControl
    x:Class="Tools.Views.Components.RepoHeader"
    xmlns="https://github.com/avaloniaui"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:tools="using:Tools.Library.MarkupExtensions"
    xmlns:vm="using:Tools.ViewModels.Components"
    d:DesignHeight="150"
    d:DesignWidth="1200"
    x:CompileBindings="True"
    x:DataType="vm:BottomBarViewModel"
    mc:Ignorable="d">

    <!--
            Repo detail header (per the mockup): one top row with the favorite star,
            the repo name and the "• folder path" link (opens the folder), the actions
            (kebab, X) right-aligned on the same line, then the tab row. The GitHub
            link lives in the kebab menu only. Lives INSIDE the bottom bar's
            expandable panel, above the active tab's content; the tabs drive that
            panel. The X button (far right) closes the whole bar until another row is
            picked from the table.
    -->
    <UserControl.Styles>
        <!--  Quiet accent links on the branch line (branch view + repo URL): transparent,
              no box — the accent text IS the affordance.  -->
        <Style Selector="Button.header-link">
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="Padding" Value="0" />
            <Setter Property="Cursor" Value="Hand" />
        </Style>
        <Style Selector="Button.header-link:pointerover /template/ ContentPresenter">
            <Setter Property="Opacity" Value="0.8" />
        </Style>
        <!--  Action buttons are plain default SukiUI buttons (like the Add-Repository
              dialog's Browse…) — the native theme hover highlights the whole surface,
              so no custom hover styles here.  -->
        <!--  Tab button: quiet label + count chip, accent underline when active.  -->
        <Style Selector="Button.bar-tab">
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="Padding" Value="0,9" />
            <Setter Property="CornerRadius" Value="0" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="VerticalContentAlignment" Value="Center" />
        </Style>
        <Style Selector="Button.bar-tab TextBlock.tab-label">
            <Setter Property="FontSize" Value="13" />
            <Setter Property="FontWeight" Value="Medium" />
            <Setter Property="Foreground" Value="{DynamicResource MutedForegroundBrush}" />
        </Style>
        <Style Selector="Button.bar-tab:pointerover TextBlock.tab-label">
            <Setter Property="Foreground" Value="{DynamicResource BodyForegroundBrush}" />
        </Style>
        <Style Selector="Button.bar-tab.active">
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="BorderBrush" Value="{DynamicResource AccentPrimaryBrush}" />
            <Setter Property="BorderThickness" Value="0,0,0,2" />
            <Setter Property="Padding" Value="0,9" />
        </Style>
        <Style Selector="Button.bar-tab.active TextBlock.tab-label">
            <Setter Property="Foreground" Value="{DynamicResource TitleForegroundBrush}" />
            <Setter Property="FontWeight" Value="SemiBold" />
        </Style>
        <!--  Tab badge: the count carried over from the row chips, in a small rounded chip.  -->
        <Style Selector="Border.tab-badge-chip">
            <Setter Property="Background" Value="{DynamicResource CardSubtleBackgroundBrush}" />
            <Setter Property="CornerRadius" Value="5" />
            <Setter Property="Padding" Value="6,1" />
            <Setter Property="VerticalAlignment" Value="Center" />
        </Style>
        <Style Selector="TextBlock.tab-badge">
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="Foreground" Value="{DynamicResource BodyForegroundBrush}" />
        </Style>
    </UserControl.Styles>

    <StackPanel Spacing="2">

        <!--  Top row: favorite star, repo name, then "• folder path" as a link that
              opens the folder; actions (kebab, panel close) right-aligned on the same
              line. The path sits in a star cell so it trims there instead of pushing
              into the actions, and its trimming survives the button (finite measure
              from the grid cell, not an infinite StackPanel chain).  -->
        <Grid ColumnDefinitions="*,Auto" ColumnSpacing="12">
            <Grid Grid.Column="0" ColumnDefinitions="Auto,Auto,Auto,*" ColumnSpacing="10">
                <Button
                    Grid.Column="0"
                    VerticalAlignment="Center"
                    Classes="icon"
                    Command="{Binding ToggleSelectedRepoFavoriteCommand}"
                    ToolTip.Tip="Toggle favorite">
                    <Path
                        Width="18"
                        Height="18"
                        Data="{tools:SvgPath icon-star}"
                        Fill="{Binding SelectedRepo?.Tags, Converter={StaticResource FavoriteStarBrushConverter}}"
                        Stretch="Uniform" />
                </Button>
                <TextBlock
                    Grid.Column="1"
                    VerticalAlignment="Center"
                    FontSize="22"
                    FontWeight="Bold"
                    Foreground="{DynamicResource TitleForegroundBrush}"
                    Text="{Binding SelectedRepoName}"
                    TextTrimming="CharacterEllipsis" />
                <!--  Vertical hairline separator between the name and the folder
                      path — same divider language as the toolbar, sized to the
                      title row (full row height would reach into the star button).  -->
                <Border
                    Grid.Column="2"
                    Height="16"
                    Classes="vertical-divider" />
                <Button
                    Grid.Column="3"
                    Classes="header-link"
                    Command="{Binding OpenRepoFolderCommand}"
                    HorizontalAlignment="Left"
                    ToolTip.Tip="Open the repository folder">
                    <StackPanel Orientation="Horizontal" Spacing="6">
                        <TextBlock
                            VerticalAlignment="Center"
                            FontSize="13"
                            Foreground="{DynamicResource BodyForegroundBrush}"
                            Text="{Binding SelectedRepoFolderPath}"
                            TextTrimming="CharacterEllipsis" />
                        <Path
                            Width="12"
                            Height="12"
                            VerticalAlignment="Center"
                            Data="{tools:SvgPath icon-open-in-new}"
                            Fill="{DynamicResource MutedForegroundBrush}"
                            Stretch="Uniform" />
                    </StackPanel>
                </Button>
            </Grid>
            <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
                <!--  Refresh: reloads the open panel's data.  -->
                <Button Command="{Binding RefreshPanelCommand}" ToolTip.Tip="Refresh panel">
                    <Path
                        Width="14"
                        Height="14"
                        Data="{tools:SvgPath icon-refresh}"
                        Fill="{DynamicResource BodyForegroundBrush}"
                        Stretch="Uniform" />
                </Button>
                <!--  Plain default buttons (like the Add-Repository dialog's Browse…):
                      the native theme hover highlights the whole surface. The kebab
                      carries the repo's GitHub entries; the Overview tab's Repository
                      Details card also links the GitHub page.  -->
                <Button ToolTip.Tip="More actions">
                    <Path
                        Width="14"
                        Height="14"
                        Data="{tools:SvgPath icon-ellipsis-vertical}"
                        Fill="{DynamicResource BodyForegroundBrush}"
                        Stretch="Uniform" />
                    <Button.Flyout>
                        <MenuFlyout Placement="BottomEdgeAlignedRight">
                            <MenuItem
                                Command="{Binding OpenGitHubRepoCommand}"
                                Header="Open in GitHub"
                                IsVisible="{Binding HasSelectedRepoGitHubUrl}" />
                            <MenuItem
                                Command="{Binding CopyGitHubUrlCommand}"
                                Header="Copy GitHub URL"
                                IsVisible="{Binding HasSelectedRepoGitHubUrl}" />
                            <MenuItem
                                Command="{Binding CopyRepoPathCommand}"
                                Header="Copy folder path"
                                IsVisible="{Binding HasSelectedRepo}" />
                        </MenuFlyout>
                    </Button.Flyout>
                </Button>
                <!--  Same compact icon button as the tool drawer's close (26x26,
                      Padding 0, muted 13px glyph) so both panels close alike.  -->
                <Button
                    Width="26"
                    Height="26"
                    Padding="0"
                    Classes="icon"
                    Command="{Binding CloseCommand}"
                    ToolTip.Tip="Close panel">
                    <Path
                        Width="13"
                        Height="13"
                        Data="{tools:SvgPath icon-close}"
                        Fill="{DynamicResource MutedForegroundBrush}"
                        Stretch="Uniform" />
                </Button>
            </StackPanel>
        </Grid>

        <!--  Tabs: drive the bottom bar's panel; bottom margin keeps the active
              tab's underline off the tab content below.  -->
        <StackPanel Margin="0,0,0,8" Orientation="Horizontal" Spacing="36">
            <Button Classes="bar-tab" Classes.active="{Binding IsActiveOverview}" Command="{Binding ToggleOverviewTabCommand}">
                <TextBlock Classes="tab-label" Text="Overview" />
            </Button>
            <Button Classes="bar-tab" Classes.active="{Binding IsActiveChanges}" Command="{Binding ToggleChangesTabCommand}">
                <StackPanel Orientation="Horizontal" Spacing="8">
                    <TextBlock Classes="tab-label" Text="Changes" />
                    <Border Classes="tab-badge-chip" IsVisible="{Binding ShowChangesBadge}">
                        <TextBlock Classes="tab-badge" Text="{Binding ChangesCount}" />
                    </Border>
                </StackPanel>
            </Button>
            <Button
                Classes="bar-tab"
                Classes.active="{Binding IsActivePullRequests}"
                Command="{Binding TogglePullRequestsTabCommand}"
                IsVisible="{Binding IsGitHubEnabled}">
                <StackPanel Orientation="Horizontal" Spacing="8">
                    <TextBlock Classes="tab-label" Text="Pull Requests" />
                    <Border Classes="tab-badge-chip" IsVisible="{Binding ShowPullRequestBadge}">
                        <TextBlock Classes="tab-badge" Text="{Binding PullRequestCount}" />
                    </Border>
                </StackPanel>
            </Button>
            <Button
                Classes="bar-tab"
                Classes.active="{Binding IsActiveIssues}"
                Command="{Binding ToggleIssuesTabCommand}"
                IsVisible="{Binding IsGitHubEnabled}">
                <StackPanel Orientation="Horizontal" Spacing="8">
                    <TextBlock Classes="tab-label" Text="Issues" />
                    <Border Classes="tab-badge-chip" IsVisible="{Binding ShowIssueBadge}">
                        <TextBlock Classes="tab-badge" Text="{Binding IssueCount}" />
                    </Border>
                </StackPanel>
            </Button>
            <Button
                Classes="bar-tab"
                Classes.active="{Binding IsActiveAzure}"
                Command="{Binding ToggleAzureTabCommand}"
                IsVisible="{Binding IsAzureDevOpsEnabled}">
                <TextBlock Classes="tab-label" Text="Pipelines" />
            </Button>
        </StackPanel>
    </StackPanel>
</UserControl>
