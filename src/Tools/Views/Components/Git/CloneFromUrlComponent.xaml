<?xml version="1.0" encoding="utf-8" ?>
<!--
    Clone from URL drawer component: opened by the repos page toolbar. The repository
    URL, the destination folder name (kept in step with the URL's last segment until
    the user edits it) and the destination folder (pre-typed with the first scan root);
    Clone runs git clone and the page registers the result. Failures (unknown host,
    missing credentials, existing destination) surface as an inline note under the
    fields. Follows the shared drawer vocabulary: grouped card with field labels,
    footer band with Cancel/Clone.
-->
<UserControl
    x:Class="Tools.Views.Components.Git.CloneFromUrlComponent"
    xmlns="https://github.com/avaloniaui"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:tools="using:Tools.Library.MarkupExtensions"
    xmlns:vm="using:Tools.ViewModels.Windows"
    d:DesignHeight="480"
    d:DesignWidth="520"
    x:CompileBindings="True"
    x:DataType="vm:CloneFromUrlViewModel"
    mc:Ignorable="d">

    <Grid RowDefinitions="*,Auto">
        <ScrollViewer Grid.Row="0" VerticalScrollBarVisibility="Auto">
            <StackPanel Margin="16,4,16,12" Spacing="12">

                <Border Classes="card">
                    <StackPanel Spacing="8">
                        <TextBlock Classes="card-title" Text="Clone from URL" />
                        <StackPanel Spacing="4">
                            <TextBlock
                                Classes="field-label"
                                Text="Repository URL"
                                ToolTip.Tip="An https or ssh URL, or a local path — anything git clone accepts" />
                            <TextBox
                                x:Name="UrlBox"
                                Text="{Binding RepositoryUrl, UpdateSourceTrigger=PropertyChanged}"
                                TextChanged="OnUrlBoxTextChanged"
                                Watermark="https://github.com/owner/repo.git" />
                        </StackPanel>
                        <StackPanel Spacing="4">
                            <TextBlock
                                Classes="field-label"
                                Text="Folder Name"
                                ToolTip.Tip="The folder git creates for the repository; pre-filled from the URL" />
                            <TextBox
                                x:Name="NameBox"
                                Text="{Binding RepoName, UpdateSourceTrigger=PropertyChanged}"
                                TextChanged="OnNameBoxTextChanged"
                                Watermark="repo" />
                        </StackPanel>
                        <StackPanel Spacing="4">
                            <TextBlock
                                Classes="field-label"
                                Text="Destination Folder"
                                ToolTip.Tip="The repository is cloned into the folder above inside this one" />
                            <TextBox
                                Text="{Binding DestinationFolder, UpdateSourceTrigger=PropertyChanged}"
                                Watermark="/home/you/developments" />
                        </StackPanel>
                        <TextBlock
                            Classes="subtle"
                            IsVisible="{Binding HasError}"
                            Foreground="{DynamicResource WarningAccentBrush}"
                            Text="{Binding ErrorText}"
                            TextWrapping="Wrap" />
                    </StackPanel>
                </Border>
            </StackPanel>
        </ScrollViewer>

        <!--  Footer with action buttons (outside scroll area)  -->
        <Border
            Grid.Row="1"
            Padding="16,12"
            BorderBrush="{DynamicResource DividerBrush}"
            BorderThickness="0,1,0,0">
            <StackPanel
                HorizontalAlignment="Right"
                Classes="actions">
                <Button Command="{Binding CancelCommand}" Content="Cancel" />
                <!--
                        Clone: the label row gives way to the app-wide spinning ring while
                        the transfer runs (clones have no progress stream to show, so the
                        ring is the whole busy surface; the button is click-locked too).
                -->
                <Button
                    Command="{Binding CloneCommand}"
                    Classes="Outlined"
                    IsDefault="True"
                    IsEnabled="{Binding !IsCloning}">
                    <Panel>
                        <StackPanel
                            Orientation="Horizontal"
                            Spacing="6"
                            IsVisible="{Binding !IsCloning}">
                            <Path
                                Width="14"
                                Height="14"
                                VerticalAlignment="Center"
                                Data="{tools:SvgPath icon-cloud-download}"
                                Fill="{Binding $parent[Button].Foreground}"
                                Stretch="Uniform" />
                            <TextBlock VerticalAlignment="Center" Text="Clone" />
                        </StackPanel>
                        <Path
                            Width="13"
                            Height="13"
                            IsVisible="{Binding IsCloning}"
                            Classes="spinner"
                            RenderTransformOrigin="50%,50%"
                            Data="{tools:SvgPath icon-spinner, Center=False}"
                            Stroke="{Binding $parent[Button].Foreground}"
                            StrokeThickness="2">
                            <Path.RenderTransform>
                                <RotateTransform />
                            </Path.RenderTransform>
                        </Path>
                    </Panel>
                </Button>
            </StackPanel>
        </Border>
    </Grid>
</UserControl>
