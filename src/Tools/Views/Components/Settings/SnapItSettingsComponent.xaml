<?xml version="1.0" encoding="utf-8" ?>
<!--
    SnapIt settings tool-drawer component (Windows-only tool): auto-start preference
    plus start/stop. Same drawer vocabulary as the Add Repositories component: card
    content on top, footer band with the live status chip on the left and the toggle
    on the right.
-->
<UserControl
    x:Class="Tools.Views.Components.Settings.SnapItSettingsComponent"
    xmlns="https://github.com/avaloniaui"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:vm="using:Tools.ViewModels.Pages"
    d:DesignHeight="400"
    d:DesignWidth="520"
    x:CompileBindings="True"
    x:DataType="vm:SnapItSettingsViewModel"
    mc:Ignorable="d">

    <Grid RowDefinitions="*,Auto">
        <!--  Preferences card  -->
        <Border
            Grid.Row="0"
            Margin="16,4,16,0"
            VerticalAlignment="Top"
            Classes="card">
            <CheckBox
                Content="Start SnapIt automatically on launch"
                IsChecked="{Binding AutoStart, Mode=TwoWay}" />
        </Border>

        <!--  Footer: status on the left, toggle on the right.
              The dot rides the window-wide status-dot classes (red stopped,
              green running), matching the title-bar status chips.  -->
        <Border
            Grid.Row="1"
            Padding="16,12"
            BorderBrush="{DynamicResource DividerBrush}"
            BorderThickness="0,1,0,0">
            <Grid ColumnDefinitions="*,Auto" ColumnSpacing="12">
                <Border
                    Grid.Column="0"
                    HorizontalAlignment="Left"
                    VerticalAlignment="Center"
                    Classes="chip">
                    <StackPanel Orientation="Horizontal" Spacing="8">
                        <Ellipse
                            Width="10"
                            Height="10"
                            Classes="status-dot"
                            Classes.running="{Binding IsRunning}" />
                        <TextBlock VerticalAlignment="Center" Text="{Binding StatusText}" />
                    </StackPanel>
                </Border>
                <StackPanel
                    Grid.Column="1"
                    HorizontalAlignment="Right"
                    Classes="actions">
                    <Button
                        Classes="Outlined"
                        Command="{Binding ToggleSnapItCommand}"
                        Content="{Binding ToggleButtonText}"
                        IsDefault="True" />
                </StackPanel>
            </Grid>
        </Border>
    </Grid>
</UserControl>
