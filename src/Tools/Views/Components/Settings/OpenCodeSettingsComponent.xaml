<?xml version="1.0" encoding="utf-8" ?>
<!--
    OpenCode launch drawer: a per-launch model picker (the saved default model is edited
    in the Repo Settings drawer), instances, template + prompt and the launch button —
    the former OpenCode bottom panel, restyled in the tool drawer's card vocabulary
    (same card/field-label language as the Repo Settings component). Grouped into three
    cards: Model / Launch / Start prompt.
-->
<UserControl
    x:Class="Tools.Views.Components.OpenCodeSettingsComponent"
    xmlns="https://github.com/avaloniaui"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:vm="using:Tools.ViewModels.Windows"
    d:DesignHeight="700"
    d:DesignWidth="540"
    x:CompileBindings="True"
    x:DataType="vm:OpenCodeSettingsViewModel"
    mc:Ignorable="d">

    <ScrollViewer HorizontalScrollBarVisibility="Disabled">
        <StackPanel Margin="16,4,16,12" Spacing="12">

            <!--  Per-launch model  -->
            <Border Classes="card">
                <StackPanel Spacing="8">
                    <TextBlock Classes="card-title" Text="Model" />
                    <TextBlock
                        Classes="field-label"
                        Text="Model"
                        ToolTip.Tip="Model for the instances launched from this panel" />
                    <ComboBox
                        Name="OpenCodeModelPicker"
                        HorizontalAlignment="Stretch"
                        IsEditable="True"
                        IsEnabled="{Binding OpenCodeHasModels}"
                        ItemsSource="{Binding OpenCodeFilteredModels}"
                        PlaceholderText="Search or select a model…"
                        SelectedItem="{Binding OpenCodeSelectedModel, Mode=OneWay}"
                        SelectionChanged="OnOpenCodeModelSelectionChanged"
                        Text="{Binding OpenCodeModelFilter, Mode=TwoWay}" />
                    <TextBlock
                        Classes="subtle"
                        IsVisible="{Binding OpenCodeModelsEmpty}"
                        Text="No models found. Is opencode installed and on the PATH?"
                        TextWrapping="Wrap" />
                    <TextBlock
                        Classes="subtle"
                        Text="Preselected from the default model in Repo Settings; a pick here applies to the instances launched from this panel."
                        TextWrapping="Wrap" />
                </StackPanel>
            </Border>

            <!--  Target + instances + template + prompt  -->
            <Border Classes="card">
                <StackPanel Spacing="8">
                    <TextBlock Classes="card-title" Text="Launch" />
                    <Grid ColumnDefinitions="*,Auto" ColumnSpacing="8">
                        <StackPanel
                            Grid.Column="0"
                            Spacing="4"
                            IsVisible="{Binding HasOpenCode}">
                            <TextBlock Classes="field-label" Text="Repository" />
                            <TextBlock
                                VerticalAlignment="Center"
                                Foreground="{DynamicResource TitleForegroundBrush}"
                                Text="{Binding TargetRepoName}" />
                        </StackPanel>
                        <TextBlock
                            Grid.Column="0"
                            Classes="subtle"
                            VerticalAlignment="Center"
                            IsVisible="{Binding !HasOpenCode}"
                            Text="opencode is disabled in settings." />
                        <StackPanel
                            Grid.Column="1"
                            Spacing="4"
                            IsVisible="{Binding CanArrangeIntoGrid}">
                            <TextBlock Classes="field-label" Text="Arrange" />
                            <CheckBox
                                Content="Into grid"
                                IsChecked="{Binding OpenCodeArrangeIntoGrid, Mode=TwoWay}"
                                ToolTip.Tip="Tile the launched instances across the screen in a grid" />
                        </StackPanel>
                    </Grid>
                    <TextBlock
                        Classes="field-label"
                        Text="Instances"
                        ToolTip.Tip="How many terminal windows to open, each running opencode" />
                    <NumericUpDown
                        Width="110"
                        HorizontalAlignment="Left"
                        FormatString="0"
                        Increment="1"
                        Maximum="9"
                        Minimum="1"
                        ParsingNumberStyle="Integer"
                        Value="{Binding OpenCodeInstanceCount, Mode=TwoWay}" />
                    <Grid ColumnDefinitions="*,Auto" ColumnSpacing="8">
                        <TextBlock
                            Grid.Column="0"
                            Classes="field-label"
                            VerticalAlignment="Center"
                            Text="Template (optional)"
                            ToolTip.Tip="Copy a template's .opencode folder into the repo" />
                        <Button
                            Grid.Column="1"
                            Padding="8,2"
                            VerticalAlignment="Center"
                            Command="{Binding ResetOpenCodeTemplateCommand}"
                            Content="Reset"
                            ToolTip.Tip="Reset the repo's .opencode folder to the selected template" />
                    </Grid>
                    <ComboBox
                        HorizontalAlignment="Stretch"
                        ItemsSource="{Binding OpenCodeTemplates}"
                        SelectedItem="{Binding OpenCodeSelectedTemplate, Mode=TwoWay}" />
                    <TextBlock
                        Classes="subtle"
                        IsVisible="{Binding OpenCodeSelectedTemplateDescription}"
                        Text="{Binding OpenCodeSelectedTemplateDescription}"
                        TextWrapping="Wrap" />
                    <TextBlock Classes="field-label" Text="Prompt (optional)" />
                    <ComboBox
                        HorizontalAlignment="Stretch"
                        ItemsSource="{Binding OpenCodePrompts}"
                        SelectedItem="{Binding OpenCodeSelectedPrompt, Mode=TwoWay}" />
                </StackPanel>
            </Border>

            <!--  Start prompt + launch  -->
            <Border Classes="card">
                <StackPanel Spacing="8">
                    <Grid ColumnDefinitions="*,Auto">
                        <TextBlock
                            Grid.Column="0"
                            Classes="card-title"
                            VerticalAlignment="Center"
                            Text="Start prompt" />
                        <Button
                            Grid.Column="1"
                            Padding="8,2"
                            VerticalAlignment="Center"
                            Classes="Outlined"
                            Content="Save"
                            ToolTip.Tip="Save the current prompt to reuse it from the Prompt selector">
                            <Button.Flyout>
                                <Flyout Placement="BottomEdgeAlignedRight">
                                    <StackPanel Width="220" Spacing="10">
                                        <TextBlock Classes="field-label" Text="Save prompt as" />
                                        <TextBox Text="{Binding NewPromptName, Mode=TwoWay}" Watermark="Prompt name" />
                                        <Button
                                            HorizontalAlignment="Right"
                                            Classes="Outlined"
                                            Command="{Binding SavePromptCommand}"
                                            Content="Save" />
                                    </StackPanel>
                                </Flyout>
                            </Button.Flyout>
                        </Button>
                    </Grid>
                    <TextBox
                        MinHeight="96"
                        AcceptsReturn="True"
                        VerticalContentAlignment="Top"
                        Text="{Binding OpenCodePrompt, Mode=TwoWay}"
                        TextWrapping="Wrap"
                        Watermark="e.g. fix the login bug" />
                    <Button
                        HorizontalAlignment="Stretch"
                        Classes="Outlined"
                        Command="{Binding LaunchOpenCodeCommand}"
                        Content="Open opencode" />
                </StackPanel>
            </Border>
        </StackPanel>
    </ScrollViewer>
</UserControl>
