<?xml version="1.0" encoding="utf-8" ?>
<!--
    Repo Settings tool-drawer component (the former modal dialog): edits the repo scan
    settings and resolves them back to DialogService on Save. Cancel closes the drawer
    through the ViewModel; the drawer header's X and the backdrop/Escape close path land
    as a cancel too. Sections follow the shared drawer vocabulary: grouped cards with
    field labels, footer band with Cancel/Save on the right.
-->
<UserControl
    x:Class="Tools.Views.Components.ReposSettingsComponent"
    xmlns="https://github.com/avaloniaui"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:vm="using:Tools.ViewModels.Windows"
    d:DesignHeight="620"
    d:DesignWidth="520"
    x:CompileBindings="True"
    x:DataType="vm:ReposSettingsViewModel"
    mc:Ignorable="d">

    <Grid RowDefinitions="*,Auto">
        <!--  Scrollable content: three grouped cards  -->
        <ScrollViewer Grid.Row="0" VerticalScrollBarVisibility="Auto">
            <StackPanel Margin="16,4,16,12" Spacing="12">

                <!--  Scanning: folders and patterns  -->
                <Border Classes="card">
                    <StackPanel Spacing="8">
                        <TextBlock Classes="card-title" Text="Scanning" />
                        <StackPanel Spacing="4">
                            <TextBlock
                                Classes="field-label"
                                Text="Repo Scan Folders"
                                ToolTip.Tip="Folders to scan for repositories (one per line)" />
                            <TextBox
                                Height="120"
                                AcceptsReturn="True"
                                VerticalContentAlignment="Top"
                                Text="{Binding RepoScanFoldersText, UpdateSourceTrigger=PropertyChanged}"
                                TextWrapping="Wrap"
                                Watermark="Enter folder paths, one per line&#x0a;Example:&#x0a;C:\Projects&#x0a;D:\Development" />
                        </StackPanel>
                        <StackPanel Spacing="4">
                            <TextBlock
                                Classes="field-label"
                                Text="Excluded Folders"
                                ToolTip.Tip="Folders to exclude from scanning (one per line)" />
                            <TextBox
                                Height="100"
                                AcceptsReturn="True"
                                VerticalContentAlignment="Top"
                                Text="{Binding ExcludedFoldersText, UpdateSourceTrigger=PropertyChanged}"
                                TextWrapping="Wrap"
                                Watermark="Enter folder paths to exclude, one per line&#x0a;Example:&#x0a;C:\Projects\Archive&#x0a;node_modules" />
                        </StackPanel>
                        <Grid
                            ColumnDefinitions="*,*"
                            ColumnSpacing="16"
                            RowDefinitions="Auto,Auto"
                            RowSpacing="8">
                            <StackPanel Grid.Row="0" Grid.Column="0" Spacing="4">
                                <TextBlock
                                    Classes="field-label"
                                    Text="Git Folder Pattern"
                                    ToolTip.Tip="Pattern to search for git folders" />
                                <TextBox Text="{Binding GitFolderPattern, UpdateSourceTrigger=PropertyChanged}" Watermark="*.git" />
                            </StackPanel>
                            <StackPanel Grid.Row="0" Grid.Column="1" Spacing="4">
                                <TextBlock
                                    Classes="field-label"
                                    Text="Solution File Pattern"
                                    ToolTip.Tip="Solution file patterns, comma-separated (e.g. *.sln,*.slnx)" />
                                <TextBox Text="{Binding SolutionFilePattern, UpdateSourceTrigger=PropertyChanged}" Watermark="*.sln,*.slnx" />
                            </StackPanel>
                            <StackPanel Grid.Row="1" Grid.Column="0" Grid.ColumnSpan="2" Spacing="4">
                                <TextBlock
                                    Classes="field-label"
                                    Text="Platform Folder Name"
                                    ToolTip.Tip="Path marker used to auto-tag platform repos" />
                                <TextBox Text="{Binding PlatformFolderName, UpdateSourceTrigger=PropertyChanged}" Watermark="platform" />
                            </StackPanel>
                        </Grid>
                    </StackPanel>
                </Border>

                <!--  External tools: launchers for editors, terminals and agents  -->
                <Border Classes="card">
                    <StackPanel Spacing="8">
                        <TextBlock Classes="card-title" Text="External Tools" />
                        <!--
                            Launch-button visibility: pure settings toggles — the app
                            never probes whether an executable is installed. Visual
                            Studio additionally only exists on Windows (enforced by the
                            page, not here).
                        -->
                        <Grid
                            ColumnDefinitions="*,*"
                            ColumnSpacing="16"
                            RowDefinitions="Auto,Auto,Auto"
                            RowSpacing="10">
                            <CheckBox
                                Grid.Row="0" Grid.Column="0"
                                Content="Enable Visual Studio"
                                IsChecked="{Binding EnableVisualStudio, Mode=TwoWay}"
                                ToolTip.Tip="Show the open-solution button (Windows only)" />
                            <CheckBox
                                Grid.Row="0" Grid.Column="1"
                                Content="Enable VS Code"
                                IsChecked="{Binding EnableVSCode, Mode=TwoWay}"
                                ToolTip.Tip="Show the VS Code button on the repo rows" />
                            <CheckBox
                                Grid.Row="1" Grid.Column="0"
                                Content="Enable Terminal"
                                IsChecked="{Binding EnableTerminal, Mode=TwoWay}"
                                ToolTip.Tip="Show the terminal button on the repo rows" />
                            <CheckBox
                                Grid.Row="1" Grid.Column="1"
                                Content="Enable ZCode"
                                IsChecked="{Binding EnableZCode, Mode=TwoWay}"
                                ToolTip.Tip="Show the zcode button on the repo rows" />
                            <CheckBox
                                Grid.Row="2" Grid.Column="0"
                                Content="Enable NuGet"
                                IsChecked="{Binding EnableNuget, Mode=TwoWay}"
                                ToolTip.Tip="Show the NuGet package tool and allow its folder watch" />
                        </Grid>
                        <Grid
                            ColumnDefinitions="*,*"
                            ColumnSpacing="16"
                            RowDefinitions="Auto,Auto,Auto,Auto"
                            RowSpacing="8">
                            <StackPanel Grid.Row="0" Grid.Column="0" Spacing="4">
                                <TextBlock
                                    Classes="field-label"
                                    Text="VS Code Executable"
                                    ToolTip.Tip="Path or command for VS Code" />
                                <TextBox Text="{Binding VsCodeExecutable, UpdateSourceTrigger=PropertyChanged}" Watermark="code" />
                            </StackPanel>
                            <StackPanel Grid.Row="0" Grid.Column="1" Spacing="4">
                                <TextBlock
                                    Classes="field-label"
                                    Text="VS Code Profile"
                                    ToolTip.Tip="VS Code profile to launch with (--profile); empty = default" />
                                <TextBox Text="{Binding VsCodeProfile, UpdateSourceTrigger=PropertyChanged}" Watermark="Leave empty for default profile" />
                            </StackPanel>
                            <StackPanel Grid.Row="1" Grid.Column="0" Spacing="4">
                                <TextBlock
                                    Classes="field-label"
                                    Text="Terminal Executable"
                                    ToolTip.Tip="Terminal path/command; 'wt' (default) auto-detects on Linux" />
                                <TextBox Text="{Binding TerminalExecutable, UpdateSourceTrigger=PropertyChanged}" Watermark="wt" />
                            </StackPanel>
                            <StackPanel Grid.Row="1" Grid.Column="1" Spacing="4">
                                <TextBlock
                                    Classes="field-label"
                                    Text="IDE Executable"
                                    ToolTip.Tip="IDE used to open solutions; empty = .sln association (Windows)" />
                                <TextBox Text="{Binding IdeExecutable, UpdateSourceTrigger=PropertyChanged}" Watermark="Empty = .sln association" />
                            </StackPanel>
                            <StackPanel Grid.Row="2" Grid.Column="0" Spacing="4">
                                <TextBlock
                                    Classes="field-label"
                                    Text="OpenCode Executable"
                                    ToolTip.Tip="Path or command for OpenCode" />
                                <TextBox Text="{Binding OpenCodeExecutable, UpdateSourceTrigger=PropertyChanged}" Watermark="opencode" />
                            </StackPanel>
                            <StackPanel Grid.Row="2" Grid.Column="1" Spacing="4">
                                <TextBlock
                                    Classes="field-label"
                                    Text="ZCode Executable"
                                    ToolTip.Tip="Path or command for zcode; AppImage opens the desktop app" />
                                <TextBox Text="{Binding ZCodeExecutable, UpdateSourceTrigger=PropertyChanged}" Watermark="zcode" />
                            </StackPanel>
                            <StackPanel Grid.Row="3" Grid.Column="0" Spacing="4">
                                <TextBlock
                                    Classes="field-label"
                                    Text="OpenCode Model (default)"
                                    ToolTip.Tip="Model the opencode quick-launch button starts; passed verbatim" />
                                <TextBox Text="{Binding OpenCodeDefaultModel, UpdateSourceTrigger=PropertyChanged}" Watermark="provider/model, e.g. opencode-go/glm-5.3-flash" />
                            </StackPanel>
                            <StackPanel Grid.Row="3" Grid.Column="1" Spacing="4">
                                <TextBlock
                                    Classes="field-label"
                                    Text="OpenCode Commit Model (wand)"
                                    ToolTip.Tip="Model for the commit-message wand; empty = default model" />
                                <TextBox Text="{Binding OpenCodeCommitModel, UpdateSourceTrigger=PropertyChanged}" Watermark="(empty = default model)" />
                            </StackPanel>
                        </Grid>
                    </StackPanel>
                </Border>

                <!--  Columns: GitHub / Azure DevOps toggles and their credentials  -->
                <Border Classes="card">
                    <StackPanel Spacing="8">
                        <TextBlock Classes="card-title" Text="Columns" />
                        <CheckBox
                            Content="Show GitHub column"
                            IsChecked="{Binding EnableGitHub, Mode=TwoWay}"
                            ToolTip.Tip="Show the GitHub column on the Repos page (uses the gh CLI)" />
                        <StackPanel Spacing="4">
                            <TextBlock
                                Classes="field-label"
                                Text="GitHub CLI Executable"
                                ToolTip.Tip="Path or command for the gh CLI (GitHub column)" />
                            <TextBox
                                IsEnabled="{Binding EnableGitHub}"
                                Text="{Binding GitHubExecutable, UpdateSourceTrigger=PropertyChanged}"
                                Watermark="gh" />
                        </StackPanel>
                        <CheckBox
                            Content="Show Azure DevOps column"
                            IsChecked="{Binding EnableAzureDevOps, Mode=TwoWay}"
                            ToolTip.Tip="Show the Azure DevOps column on the Repos page" />
                        <StackPanel Spacing="4">
                            <TextBlock
                                Classes="field-label"
                                Text="Azure DevOps URL"
                                ToolTip.Tip="Custom server URL, e.g. https://devops.company.com (empty = public)" />
                            <TextBox
                                IsEnabled="{Binding EnableAzureDevOps}"
                                Text="{Binding AzureDevOpsUrl, UpdateSourceTrigger=PropertyChanged}"
                                Watermark="https://devops.company.com/DefaultCollection" />
                        </StackPanel>
                        <StackPanel Spacing="4">
                            <TextBlock
                                Classes="field-label"
                                Text="Azure DevOps Token"
                                ToolTip.Tip="Azure DevOps PAT; empty = AZURE_DEVOPS_PAT env variable" />
                            <TextBox
                                IsEnabled="{Binding EnableAzureDevOps}"
                                PasswordChar="•"
                                Text="{Binding AzureDevOpsPat, UpdateSourceTrigger=PropertyChanged}"
                                Watermark="personal access token" />
                        </StackPanel>
                        <TextBlock
                            Classes="subtle"
                            Text="Repos are matched to Azure DevOps by their git remote; query the REST API with a personal access token (Build/Code/Work Items read scopes). Company-hosted servers are matched too when a custom server URL is set. Falls back to the AZURE_DEVOPS_PAT environment variable when empty."
                            TextWrapping="Wrap" />
                    </StackPanel>
                </Border>
            </StackPanel>
        </ScrollViewer>

        <!--  Footer with action buttons (outside scroll area)  -->
        <Border
            Grid.Row="1"
            Padding="16,12"
            BorderBrush="{DynamicResource DividerBrush}"
            BorderThickness="0,1,0,0">
            <StackPanel
                HorizontalAlignment="Right"
                Classes="actions">
                <Button
                    Command="{Binding CancelCommand}"
                    Content="Cancel" />
                <Button
                    Command="{Binding SaveCommand}"
                    Classes="Outlined"
                    Content="Save"
                    IsDefault="True" />
            </StackPanel>
        </Border>
    </Grid>
</UserControl>
