<?xml version="1.0" encoding="utf-8" ?>
<!--
    Colored unified-diff viewer: the caller feeds raw patch text into the Text
    property; DiffLineParser splits it into typed rows rendered by one template
    per kind — additions green, deletions red (the numstat pill pairing), hunk
    headers in the info accent, metadata rows muted, context lines in the plain
    theme foreground. Virtualized inside a bounded viewport (the patch text is
    capped upstream, but a maxed patch still spans well past the viewport).
-->
<UserControl
    x:Class="Tools.Views.Components.History.DiffViewer"
    x:Name="Root"
    xmlns="https://github.com/avaloniaui"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:lib="using:Tools.Library.Services"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    x:CompileBindings="True"
    mc:Ignorable="d">
    <Panel>
        <ScrollViewer
            MaxHeight="180"
            HorizontalScrollBarVisibility="Auto"
            IsVisible="{Binding #Root.HasLines}"
            VerticalScrollBarVisibility="Auto">
            <ItemsControl ItemsSource="{Binding #Root.Lines}">
                <ItemsControl.ItemsPanel>
                    <ItemsPanelTemplate>
                        <VirtualizingStackPanel />
                    </ItemsPanelTemplate>
                </ItemsControl.ItemsPanel>
                <ItemsControl.ItemTemplate>
                    <DataTemplate x:DataType="lib:DiffLine">
                        <ContentControl Content="{Binding}">
                            <ContentControl.DataTemplates>
                                <DataTemplate x:DataType="lib:DiffAddLine">
                                    <Border
                                        Padding="10,0"
                                        Background="{DynamicResource AddedCountChipBrush}">
                                        <TextBlock
                                            Classes="mono"
                                            Foreground="{DynamicResource AddedCountBrush}"
                                            Text="{Binding Text}"
                                            TextWrapping="NoWrap" />
                                    </Border>
                                </DataTemplate>
                                <DataTemplate x:DataType="lib:DiffRemoveLine">
                                    <Border
                                        Padding="10,0"
                                        Background="{DynamicResource RemovedCountChipBrush}">
                                        <TextBlock
                                            Classes="mono"
                                            Foreground="{DynamicResource RemovedCountBrush}"
                                            Text="{Binding Text}"
                                            TextWrapping="NoWrap" />
                                    </Border>
                                </DataTemplate>
                                <DataTemplate x:DataType="lib:DiffHunkLine">
                                    <TextBlock
                                        Margin="10,0"
                                        Classes="mono"
                                        Foreground="{DynamicResource InfoAccentBrush}"
                                        Text="{Binding Text}"
                                        TextWrapping="NoWrap" />
                                </DataTemplate>
                                <DataTemplate x:DataType="lib:DiffMetaLine">
                                    <TextBlock
                                        Margin="10,0"
                                        Classes="mono subtle"
                                        Text="{Binding Text}"
                                        TextWrapping="NoWrap" />
                                </DataTemplate>
                                <DataTemplate x:DataType="lib:DiffContextLine">
                                    <TextBlock
                                        Margin="10,0"
                                        Classes="mono"
                                        Text="{Binding Text}"
                                        TextWrapping="NoWrap" />
                                </DataTemplate>
                            </ContentControl.DataTemplates>
                        </ContentControl>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>
        </ScrollViewer>
        <TextBlock
            Classes="subtle"
            IsVisible="{Binding !#Root.HasLines}"
            Margin="4,2"
            Text="Patch unavailable" />
    </Panel>
</UserControl>
