<?xml version="1.0" encoding="utf-8" ?>
<!--
    Yesterday's Summary tool-drawer component: opencode's markdown report of ALL
    repositories with activity on the previous local day. The drawer header (title,
    icon, close) is the window's; this hosts the covered day + regenerate wand and the
    report body.
-->
<UserControl
    x:Class="Tools.Views.Components.Tools.YesterdaySummaryComponent"
    xmlns="https://github.com/avaloniaui"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:mk="using:MarkdownViewerKit"
    xmlns:tools="using:Tools.Library.MarkupExtensions"
    xmlns:vm="using:Tools.ViewModels.Pages"
    d:DesignHeight="600"
    d:DesignWidth="540"
    x:CompileBindings="True"
    x:DataType="vm:YesterdaySummaryViewModel"
    mc:Ignorable="d">

    <Grid Margin="16,4,16,16" RowDefinitions="Auto,*">
        <!--  Subtitle row: the covered day, regenerate on the right (same ring
              recipe as the bar's wands)  -->
        <Grid Grid.Row="0" ColumnDefinitions="*,Auto" Margin="0,0,0,10">
            <TextBlock
                Grid.Column="0"
                VerticalAlignment="Center"
                Classes="subtle"
                Text="{Binding SummaryDateLabel}" />
            <Button
                Grid.Column="1"
                Width="26"
                Height="26"
                Padding="0"
                VerticalAlignment="Center"
                Classes="icon"
                Command="{Binding GenerateCommand}"
                IsVisible="{Binding CanGenerate}"
                ToolTip.Tip="Regenerate summary">
                <Grid>
                    <Path
                        Width="16"
                        Height="16"
                        Classes="spinner"
                        Data="M 8 1 A 7 7 0 1 1 1 8"
                        IsVisible="{Binding IsGenerating}"
                        RenderTransformOrigin="50%,50%"
                        Stroke="{DynamicResource AccentPrimaryBrush}"
                        StrokeThickness="2">
                        <Path.RenderTransform>
                            <RotateTransform />
                        </Path.RenderTransform>
                    </Path>
                    <Path
                        Width="16"
                        Height="16"
                        Data="{tools:SvgPath icon-wand}"
                        Fill="{DynamicResource MutedForegroundBrush}"
                        IsVisible="{Binding !IsGenerating}"
                        Stretch="Uniform" />
                </Grid>
            </Button>
        </Grid>

        <Panel Grid.Row="1">
            <mk:MarkdownViewer
                IsVisible="{Binding HasSummary}"
                Markdown="{Binding SummaryMarkdown, Mode=OneWay}" />
            <StackPanel
                HorizontalAlignment="Center"
                VerticalAlignment="Center"
                Spacing="10"
                IsVisible="{Binding IsGenerating}">
                <Path
                    Width="22"
                    Height="22"
                    HorizontalAlignment="Center"
                    Classes="spinner"
                    Data="M 11 1.5 A 9.5 9.5 0 1 1 1.5 11"
                    RenderTransformOrigin="50%,50%"
                    Stroke="{DynamicResource AccentPrimaryBrush}"
                    StrokeThickness="2">
                    <Path.RenderTransform>
                        <RotateTransform />
                    </Path.RenderTransform>
                </Path>
                <TextBlock
                    Classes="subtle"
                    HorizontalAlignment="Center"
                    Text="Generating yesterday's summary…" />
            </StackPanel>
            <TextBlock
                Classes="subtle"
                HorizontalAlignment="Center"
                IsVisible="{Binding ShowEmptyState}"
                Text="{Binding EmptyStateText}"
                TextAlignment="Center"
                TextWrapping="Wrap" />
        </Panel>
    </Grid>
</UserControl>
