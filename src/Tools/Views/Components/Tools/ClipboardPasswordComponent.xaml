<?xml version="1.0" encoding="utf-8" ?>
<!--
    Clipboard Password tool-drawer component: stores a password (encoded in the app
    settings) that the global hotkey pastes anywhere with Ctrl+Shift+V. Same drawer
    vocabulary as the Add Repositories component: card content with the actions
    inline under the input (the Add Repositories Scan-row position) instead of a
    bottom footer band.
-->
<UserControl
    x:Class="Tools.Views.Components.ClipboardPasswordComponent"
    xmlns="https://github.com/avaloniaui"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:vm="using:Tools.ViewModels.Pages"
    d:DesignHeight="400"
    d:DesignWidth="520"
    x:CompileBindings="True"
    x:DataType="vm:ClipboardPasswordViewModel"
    mc:Ignorable="d">

    <Grid Margin="16,4,16,16" RowDefinitions="Auto,*">
        <!--  Password card: actions right under the input, status line beneath  -->
        <Border Grid.Row="0" VerticalAlignment="Top" Classes="card">
            <StackPanel Spacing="8">
                <StackPanel Spacing="4">
                    <TextBlock
                        Classes="field-label"
                        Text="Password"
                        ToolTip.Tip="Encoded and stored in the app settings" />
                    <TextBox
                        PasswordChar="●"
                        Text="{Binding Password, Mode=TwoWay}"
                        Watermark="Type your password here…" />
                </StackPanel>
                <StackPanel
                    HorizontalAlignment="Left"
                    Orientation="Horizontal"
                    Spacing="8">
                    <Button
                        Command="{Binding ClearPasswordCommand}"
                        Content="Clear Stored Password"
                        IsEnabled="{Binding HasStoredPassword}" />
                    <Button
                        Classes="Outlined"
                        Command="{Binding SavePasswordCommand}"
                        Content="Save Password"
                        IsDefault="True"
                        IsEnabled="{Binding !HasStoredPassword}" />
                </StackPanel>
                <TextBlock
                    Classes="subtle"
                    Text="{Binding StatusMessage}"
                    TextWrapping="Wrap" />
            </StackPanel>
        </Border>
    </Grid>
</UserControl>
