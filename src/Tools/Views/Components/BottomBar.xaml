<?xml version="1.0" encoding="utf-8" ?>
<UserControl
    x:Class="Tools.Views.Components.BottomBar"
    xmlns="https://github.com/avaloniaui"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:components="using:Tools.Views.Components"
    xmlns:controls="using:Tools.Controls"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:entities="using:Tools.Library.Entities"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:tools="using:Tools.Library.MarkupExtensions"
    xmlns:vm="using:Tools.ViewModels.Components"
    d:DesignHeight="280"
    d:DesignWidth="1200"
    x:CompileBindings="True"
    x:DataType="vm:BottomBarViewModel"
    mc:Ignorable="d">

    <!--
        Bottom bar: the expandable panel with the active tab's content (Overview,
        Changes, Pull Requests, Issues, Pipelines). The whole control stays hidden
        until a repo is selected from the table: a row press or a row chip reveals
        it (IsBarVisible); the header's X hides it again. The tab row lives in the
        RepoHeader inside the panel; the git context (branch dropdown + Fetch +
        last-fetched) lives in the Changes tab's toolbar row — the old bottom strip
        that held them is gone. Chrome matches the floating tool drawer: one docked
        card (CardBackgroundBrush surface, HairlineBrush border, CardRadius corners)
        that lives in the page layout — the table shrinks around it, nothing floats
        over the page. The bar lives on the Repositories page (it is that page's
        footer), not on every page.
    -->
    <!--
        Stretch button theme: replaces SukiUI's Button template for the bar's clickable
        surfaces (list rows + Overview cards). SukiUI's own template renders the
        content presenter content-sized even when the button stretches, so rows hug
        left and their trailing age/chip columns drift with the text length instead of
        pinning to the row's right edge, and card hovers only cover the content. This
        template stretches one Border + ContentPresenter across the whole button; the
        hover tint rides on Button.Background (TemplateBinding), so no template-part
        targeting is needed.
    -->
    <UserControl.Resources>
        <ControlTheme x:Key="StretchButtonTheme" TargetType="Button">
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="Padding" Value="10,7" />
            <Setter Property="CornerRadius" Value="6" />
            <Setter Property="HorizontalAlignment" Value="Stretch" />
            <Setter Property="HorizontalContentAlignment" Value="Stretch" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Template">
                <ControlTemplate>
                    <Border
                        Background="{TemplateBinding Background}"
                        BorderBrush="{TemplateBinding BorderBrush}"
                        BorderThickness="{TemplateBinding BorderThickness}"
                        CornerRadius="{TemplateBinding CornerRadius}">
                        <ContentPresenter
                            Margin="{TemplateBinding Padding}"
                            Content="{TemplateBinding Content}"
                            ContentTemplate="{TemplateBinding ContentTemplate}"
                            HorizontalContentAlignment="Stretch"
                            VerticalContentAlignment="{TemplateBinding VerticalContentAlignment}" />
                    </Border>
                </ControlTemplate>
            </Setter>
        </ControlTheme>

        <!--
            Shared row/card bodies. The bar repeats the same markup across the Overview
            previews and the Changes / Pull Requests / Issues / Azure tabs; these keyed
            templates hold the shared pieces. They are applied explicitly via
            ContentTemplate / ItemTemplate (not by DataType): several rows share one CLR
            type but need different commands per site, and two type-keyed templates for
            the same type cannot coexist.
        -->

        <!--  Git numstat: the +/− pills of a GitChangedFile row (hidden for binary /
              untracked files, which have no counts). The pills ride in FIXED 48px
              columns — additions right-aligned, deletions left-aligned — so the
              numbers form the same +N −N pair on every row; an Auto pill column
              drifts row to row with the path length, and a hidden pill keeps its
              cell reserved.  -->
        <DataTemplate x:Key="NumstatPillsTemplate" x:DataType="entities:GitChangedFile">
            <Grid
                ColumnDefinitions="48,48"
                ColumnSpacing="8"
                VerticalAlignment="Center"
                IsVisible="{Binding HasCounts}">
                <!--  Additions pill (green)  -->
                <Border
                    Grid.Column="0"
                    Padding="6,1"
                    HorizontalAlignment="Right"
                    VerticalAlignment="Center"
                    Background="{DynamicResource AddedCountChipBrush}"
                    CornerRadius="{DynamicResource ChipRadius}"
                    IsVisible="{Binding AddedText, Converter={StaticResource StringNullOrEmptyToVisibilityConverter}}">
                    <TextBlock
                        Classes="mono"
                        Foreground="{DynamicResource AddedCountBrush}"
                        Text="{Binding AddedText}" />
                </Border>
                <!--  Deletions pill (light red)  -->
                <Border
                    Grid.Column="1"
                    Padding="6,1"
                    HorizontalAlignment="Left"
                    VerticalAlignment="Center"
                    Background="{DynamicResource RemovedCountChipBrush}"
                    CornerRadius="{DynamicResource ChipRadius}"
                    IsVisible="{Binding RemovedText, Converter={StaticResource StringNullOrEmptyToVisibilityConverter}}">
                    <TextBlock
                        Classes="mono"
                        Foreground="{DynamicResource RemovedCountBrush}"
                        Text="{Binding RemovedText}" />
                </Border>
            </Grid>
        </DataTemplate>

        <!--  Staged/unstaged file row: status chip + path + numstat + the action
              button. The button's command, tooltip and icon come from the owning
              list's class (ItemsControl.stage-actions / .unstage-actions styles).
              The numstat column is FIXED 104px (48 + 8 + 48) so the action button
              holds its x on rows without counts (binary/untracked) too.  -->
        <DataTemplate x:Key="GitChangedFileRowTemplate" x:DataType="entities:GitChangedFile">
            <Grid ColumnDefinitions="Auto,*,104,Auto" ColumnSpacing="8">
                <Border
                    Grid.Column="0"
                    Width="30"
                    Padding="0,2"
                    VerticalAlignment="Center"
                    Background="{DynamicResource CardSubtleBackgroundBrush}"
                    BorderBrush="{DynamicResource HairlineBrush}"
                    BorderThickness="1"
                    CornerRadius="{DynamicResource ChipRadius}">
                    <TextBlock
                        HorizontalAlignment="Center"
                        Classes="mono"
                        Foreground="{Binding StatusCode, Converter={StaticResource GitStatusBrushConverter}}"
                        Text="{Binding DisplayStatusCode}" />
                </Border>
                <TextBlock
                    Grid.Column="1"
                    VerticalAlignment="Center"
                    Classes="mono"
                    Foreground="{DynamicResource BodyForegroundBrush}"
                    Text="{Binding Path}"
                    TextTrimming="CharacterEllipsis" />
                <ContentControl
                    Grid.Column="2"
                    Content="{Binding}"
                    ContentTemplate="{StaticResource NumstatPillsTemplate}" />
                <Button
                    Grid.Column="3"
                    VerticalAlignment="Center"
                    Classes="icon row-action"
                    CommandParameter="{Binding}">
                    <Path
                        Width="14"
                        Height="14"
                        Fill="{DynamicResource MutedForegroundBrush}"
                        Stretch="Uniform" />
                </Button>
            </Grid>
        </DataTemplate>

        <!--  Overview stat-card bodies. The cards are written twice (4-column grid with
              the Pipelines slot, 3-column without it); only the Button's command /
              visibility differ per site, so the bodies live here. The icon badge is
              Border.stat-badge, the count rides the card's title brush.  -->
        <DataTemplate x:Key="StatCardChanges" x:DataType="vm:BottomBarViewModel">
            <StackPanel Orientation="Horizontal" Spacing="12">
                <Grid
                    Width="36"
                    Height="36"
                    VerticalAlignment="Top">
                    <Border Background="{DynamicResource WarningAccentBrush}" Classes="stat-badge" />
                    <Path
                        Width="18"
                        Height="18"
                        HorizontalAlignment="Center"
                        VerticalAlignment="Center"
                        Data="{tools:SvgPath icon-source-branch}"
                        Fill="{DynamicResource WarningAccentBrush}"
                        Stretch="Uniform" />
                </Grid>
                <StackPanel Spacing="2">
                    <TextBlock
                        FontSize="22"
                        FontWeight="Bold"
                        Foreground="{DynamicResource TitleForegroundBrush}"
                        Text="{Binding ChangesCount}" />
                    <TextBlock Classes="subtle" Text="Local Changes" />
                </StackPanel>
            </StackPanel>
        </DataTemplate>
        <DataTemplate x:Key="StatCardPullRequests" x:DataType="vm:BottomBarViewModel">
            <StackPanel Orientation="Horizontal" Spacing="12">
                <Grid
                    Width="36"
                    Height="36"
                    VerticalAlignment="Top">
                    <Border Background="{DynamicResource PurpleAccentBrush}" Classes="stat-badge" />
                    <Path
                        Width="18"
                        Height="18"
                        HorizontalAlignment="Center"
                        VerticalAlignment="Center"
                        Data="{tools:SvgPath icon-git-pull-request}"
                        Fill="{DynamicResource PurpleAccentBrush}"
                        Stretch="Uniform" />
                </Grid>
                <StackPanel Spacing="2">
                    <TextBlock
                        FontSize="22"
                        FontWeight="Bold"
                        Foreground="{DynamicResource TitleForegroundBrush}"
                        Text="{Binding PullRequestCount}" />
                    <TextBlock Classes="subtle" Text="Open Pull Requests" />
                </StackPanel>
            </StackPanel>
        </DataTemplate>
        <DataTemplate x:Key="StatCardIssues" x:DataType="vm:BottomBarViewModel">
            <StackPanel Orientation="Horizontal" Spacing="12">
                <Grid
                    Width="36"
                    Height="36"
                    VerticalAlignment="Top">
                    <Border Background="{DynamicResource StatusActiveBrush}" Classes="stat-badge" />
                    <Path
                        Width="18"
                        Height="18"
                        HorizontalAlignment="Center"
                        VerticalAlignment="Center"
                        Data="{tools:SvgPath icon-issue}"
                        Fill="{DynamicResource StatusActiveBrush}"
                        Stretch="Uniform" />
                </Grid>
                <StackPanel Spacing="2">
                    <TextBlock
                        FontSize="22"
                        FontWeight="Bold"
                        Foreground="{DynamicResource TitleForegroundBrush}"
                        Text="{Binding IssueCount}" />
                    <TextBlock Classes="subtle" Text="Open Issues" />
                </StackPanel>
            </StackPanel>
        </DataTemplate>

        <!--  GitHub label pill: same pill chrome as the state chips
              (Border.state-chip) plus a local right gap; tinted by
              GitHubLabelBrushConverter ("bg" param for the pill, default for text).  -->
        <DataTemplate x:Key="LabelPillTemplate" x:DataType="x:String">
            <Border
                Margin="0,0,6,0"
                Classes="state-chip"
                Background="{Binding Converter={StaticResource GitHubLabelBrushConverter}, ConverterParameter=bg}"
                ToolTip.Tip="{Binding}">
                <TextBlock
                    Foreground="{Binding Converter={StaticResource GitHubLabelBrushConverter}}"
                    Text="{Binding}" />
            </Border>
        </DataTemplate>

        <!--  GitHub labels row: pill flow (WrapPanel), shown only when the item has
              labels.  -->
        <DataTemplate x:Key="GitHubLabelsFlow" x:DataType="entities:GitHubItem">
            <ItemsControl
                IsVisible="{Binding HasLabels}"
                ItemTemplate="{StaticResource LabelPillTemplate}"
                ItemsSource="{Binding Labels}">
                <ItemsControl.ItemsPanel>
                    <ItemsPanelTemplate>
                        <WrapPanel Orientation="Horizontal" />
                    </ItemsPanelTemplate>
                </ItemsControl.ItemsPanel>
            </ItemsControl>
        </DataTemplate>

        <!--  GitHub PR branch line: head → base (hidden when there is no summary).  -->
        <DataTemplate x:Key="BranchSummaryTemplate" x:DataType="entities:GitHubItem">
            <StackPanel
                Orientation="Horizontal"
                Spacing="6"
                IsVisible="{Binding BranchSummary, Converter={StaticResource StringNullOrEmptyToVisibilityConverter}}">
                <TextBlock
                    Classes="mono"
                    Foreground="{DynamicResource MutedForegroundBrush}"
                    Text="{Binding HeadRef}" />
                <TextBlock
                    Classes="mono"
                    Foreground="{DynamicResource AccentPrimaryBrush}"
                    Text="→" />
                <TextBlock
                    Classes="mono"
                    Foreground="{DynamicResource MutedForegroundBrush}"
                    Text="{Binding BaseRef, TargetNullValue=main}" />
            </StackPanel>
        </DataTemplate>

        <!--  Pull-request state chip (Draft / Approved / Review): tinted by
              GitHubStateChipBrushConverter ("bg" param for the pill, default for the
              text).  -->
        <DataTemplate x:Key="StateChipTemplate" x:DataType="entities:GitHubItem">
            <Border
                Classes="state-chip"
                Background="{Binding StateChip, Converter={StaticResource GitHubStateChipBrushConverter}, ConverterParameter=bg}"
                ToolTip.Tip="{Binding StateChip}">
                <TextBlock
                    FontWeight="SemiBold"
                    Foreground="{Binding StateChip, Converter={StaticResource GitHubStateChipBrushConverter}}"
                    Text="{Binding StateChip}" />
            </Border>
        </DataTemplate>

        <!--  GitHub/Azure item title line: "#N title" in a star cell, so a long title
              trims instead of painting over the trailing columns. Tab lists use the
              13px variants.  -->
        <DataTemplate x:Key="GitHubTitleLine" x:DataType="entities:GitHubItem">
            <Grid ColumnDefinitions="Auto,*" ColumnSpacing="6">
                <TextBlock
                    FontWeight="SemiBold"
                    Foreground="{DynamicResource TitleForegroundBrush}"
                    Text="{Binding Number, StringFormat='#{0}'}" />
                <TextBlock
                    Grid.Column="1"
                    Foreground="{DynamicResource TitleForegroundBrush}"
                    Text="{Binding Title}"
                    TextTrimming="CharacterEllipsis" />
            </Grid>
        </DataTemplate>
        <DataTemplate x:Key="GitHubTitleLine13" x:DataType="entities:GitHubItem">
            <Grid ColumnDefinitions="Auto,*" ColumnSpacing="6">
                <TextBlock
                    VerticalAlignment="Center"
                    FontSize="13"
                    FontWeight="SemiBold"
                    Foreground="{DynamicResource TitleForegroundBrush}"
                    Text="{Binding Number, StringFormat='#{0}'}" />
                <TextBlock
                    Grid.Column="1"
                    VerticalAlignment="Center"
                    FontSize="13"
                    Foreground="{DynamicResource TitleForegroundBrush}"
                    Text="{Binding Title}"
                    TextTrimming="CharacterEllipsis" />
            </Grid>
        </DataTemplate>
        <DataTemplate x:Key="AzureTitleLine" x:DataType="entities:AzureDevOpsItem">
            <Grid ColumnDefinitions="Auto,*" ColumnSpacing="6">
                <TextBlock
                    VerticalAlignment="Center"
                    FontWeight="SemiBold"
                    Foreground="{DynamicResource TitleForegroundBrush}"
                    Text="{Binding Number, StringFormat='#{0}'}" />
                <TextBlock
                    Grid.Column="1"
                    VerticalAlignment="Center"
                    Foreground="{DynamicResource TitleForegroundBrush}"
                    Text="{Binding Title}"
                    TextTrimming="CharacterEllipsis" />
            </Grid>
        </DataTemplate>
        <DataTemplate x:Key="AzureTitleLine13" x:DataType="entities:AzureDevOpsItem">
            <Grid
                VerticalAlignment="Center"
                ColumnDefinitions="Auto,*"
                ColumnSpacing="6">
                <TextBlock
                    VerticalAlignment="Center"
                    FontSize="13"
                    FontWeight="SemiBold"
                    Foreground="{DynamicResource TitleForegroundBrush}"
                    Text="{Binding Number, StringFormat='#{0}'}" />
                <TextBlock
                    Grid.Column="1"
                    VerticalAlignment="Center"
                    FontSize="13"
                    Foreground="{DynamicResource TitleForegroundBrush}"
                    Text="{Binding Title}"
                    TextTrimming="CharacterEllipsis" />
            </Grid>
        </DataTemplate>
    </UserControl.Resources>

    <UserControl.Styles>
        <!--
            Panel item row: transparent full-width button with the table's hover tint;
            the template comes from StretchButtonTheme above.
        -->
        <Style Selector="Button.bar-item">
            <Setter Property="Theme" Value="{DynamicResource StretchButtonTheme}" />
        </Style>
        <Style Selector="Button.bar-item:pointerover">
            <Setter Property="Background" Value="{DynamicResource RowHoverBackgroundBrush}" />
        </Style>
        <!--  Quiet accent link (like RepoHeader's header-link): transparent, no box —
              the text plus the open-in-new glyph is the affordance.  -->
        <Style Selector="Button.detail-link">
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="Padding" Value="0" />
            <Setter Property="Cursor" Value="Hand" />
        </Style>
        <Style Selector="Button.detail-link:pointerover /template/ ContentPresenter">
            <Setter Property="Opacity" Value="0.8" />
        </Style>
        <!--
            Overview clickable card: the ov-card look on a Button using the same
            stretch template, so the WHOLE card routes to its tab and the hover tint
            covers the full card. Rows inside the recent-activity cards keep their own
            click targets — a press on an inner row button never reaches the card.
        -->
        <Style Selector="Button.ov-card-btn">
            <Setter Property="Theme" Value="{DynamicResource StretchButtonTheme}" />
            <Setter Property="Background" Value="{DynamicResource CardSubtleBackgroundBrush}" />
            <Setter Property="BorderBrush" Value="{DynamicResource HairlineBrush}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="CornerRadius" Value="8" />
            <Setter Property="Padding" Value="12,8" />
            <Setter Property="VerticalContentAlignment" Value="Stretch" />
        </Style>
        <Style Selector="Button.ov-card-btn:pointerover">
            <Setter Property="Background" Value="{DynamicResource RowHoverBackgroundBrush}" />
        </Style>
        <!--  Overview / Git list card: panel background inset card.  -->
        <Style Selector="Border.ov-card">
            <Setter Property="Background" Value="{DynamicResource CardSubtleBackgroundBrush}" />
            <Setter Property="BorderBrush" Value="{DynamicResource HairlineBrush}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="CornerRadius" Value="8" />
            <Setter Property="Padding" Value="12,8" />
        </Style>
        <Style Selector="TextBlock.ov-card-title">
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="Foreground" Value="{DynamicResource TitleForegroundBrush}" />
        </Style>
        <!--
            Overview stat-card icon badge (Border.stat-badge) lives app-wide in
            AppStyles.axaml so pages share the same vocabulary.
        -->
        <!--  Pill chrome (state chips + label pills): fully-rounded tinted pill. The
              Border's Background comes per row from GitHubStateChipBrushConverter
              ("bg" param) or GitHubLabelBrushConverter; label pills add their right
              gap locally (they used to be a separate .label-pill style one Margin
              apart).  -->
        <Style Selector="Border.state-chip">
            <Setter Property="CornerRadius" Value="10" />
            <Setter Property="Padding" Value="8,2" />
            <Setter Property="VerticalAlignment" Value="Center" />
        </Style>
        <!--
            The stepped spinner ring behind Classes="spinner" (commit button + commit-
            message wand) lives app-wide in AppStyles.axaml so pages outside the bar
            share it (the Repos page's refresh button) — same pattern as stat-badge.
        -->
        <!--  Centered muted list message ("Loading…", empty states); sites that sit
              tighter override Margin locally.  -->
        <Style Selector="TextBlock.list-note">
            <Setter Property="HorizontalAlignment" Value="Center" />
            <Setter Property="Margin" Value="0,24" />
        </Style>
        <!--  Staged/unstaged file-row action: one shared row template
              (GitChangedFileRowTemplate) serves both lists; the +/− button's command,
              tooltip and icon come from the list's class — .stage-actions stages with
              a plus, .unstage-actions unstages with a minus.  -->
        <Style Selector="ItemsControl.stage-actions Button.row-action">
            <Setter Property="Command" Value="{Binding $parent[UserControl].((vm:BottomBarViewModel)DataContext).StageFileCommand}" />
            <Setter Property="ToolTip.Tip" Value="Stage this file" />
        </Style>
        <Style Selector="ItemsControl.stage-actions Button.row-action Path">
            <Setter Property="Data" Value="{tools:SvgPath icon-plus}" />
        </Style>
        <Style Selector="ItemsControl.unstage-actions Button.row-action">
            <Setter Property="Command" Value="{Binding $parent[UserControl].((vm:BottomBarViewModel)DataContext).UnstageFileCommand}" />
            <Setter Property="ToolTip.Tip" Value="Unstage this file — the working tree keeps the change" />
        </Style>
        <Style Selector="ItemsControl.unstage-actions Button.row-action Path">
            <Setter Property="Data" Value="{tools:SvgPath icon-minus}" />
        </Style>
    </UserControl.Styles>

    <!--  The bar sits inset from the page edges, aligned with the table card above.  -->
    <Grid IsVisible="{Binding IsBarVisible}" Margin="16,0,16,16" RowDefinitions="Auto,Auto">

        <!--  ============ Panel-top drag divider ====
              Three grip dots between the repo table and the bar; the WHOLE row (not just
              the dots) is the drag surface and resizes the expanded panel (the table
              above shrinks/grows to match). Visible whenever the bar is, so it always
              separates the table from the bar. The band is
              16px and the dots sit dead-center (6.5 above / 6.5 below) — the page's
              table margin no longer adds a top gap. The dots, cursor and hit
              background live in the shared controls:ResizeGrip (same markup as the
              tool drawer's left-edge grip).  -->
        <controls:ResizeGrip
            Grid.Row="0"
            x:Name="PanelResizer"
            Height="16"
            Orientation="Vertical" />

        <!--  ============ Expandable panel (repo header + active tab's content) ====
              The whole docked card (the old strip is gone — its branch/Fetch row
              moved into the Changes tab's toolbar): full rounded corners, hairline
              border on all four sides.  -->
        <Border
            Grid.Row="1"
            Height="{Binding PanelHeight}"
            Background="{DynamicResource CardBackgroundBrush}"
            BorderBrush="{DynamicResource HairlineBrush}"
            BorderThickness="1"
            ClipToBounds="True"
            CornerRadius="{DynamicResource CardRadius}"
            IsVisible="{Binding IsPanelOpen}">
            <Grid Margin="12,8,12,12" RowDefinitions="Auto,*">

                <!--
                    Repo header (mockup): back link, repo name + star, branch / URL
                    line and the tab row — lives INSIDE the panel, above its content.
                -->
                <components:RepoHeader Grid.Row="0" />

                <!--  Overview tab: stat cards, three activity lists, repository details  -->
                <Grid
                    Grid.Row="1"
                    ColumnDefinitions="*,290"
                    ColumnSpacing="10"
                    IsVisible="{Binding IsActiveOverview}">

                    <Grid
                        Grid.Column="0"
                        RowDefinitions="Auto,*"
                        RowSpacing="10">

                        <!--  Stat cards (whole card opens its tab)  -->
                        <UniformGrid
                            Grid.Row="0"
                            Columns="4"
                            IsVisible="{Binding IsAzureDevOpsEnabled}">
                            <Button
                                Grid.Column="0"
                                Margin="0,0,10,0"
                                Classes="ov-card-btn"
                                Command="{Binding ToggleChangesTabCommand}"
                                Content="{Binding}"
                                ContentTemplate="{StaticResource StatCardChanges}"
                                ToolTip.Tip="Open the Changes tab" />
                            <Button
                                Grid.Column="1"
                                Margin="0,0,10,0"
                                Classes="ov-card-btn"
                                Command="{Binding TogglePullRequestsTabCommand}"
                                Content="{Binding}"
                                ContentTemplate="{StaticResource StatCardPullRequests}"
                                IsVisible="{Binding IsGitHubEnabled}"
                                ToolTip.Tip="Open the Pull Requests tab" />
                            <Button
                                Grid.Column="2"
                                Margin="0,0,10,0"
                                Classes="ov-card-btn"
                                Command="{Binding ToggleIssuesTabCommand}"
                                Content="{Binding}"
                                ContentTemplate="{StaticResource StatCardIssues}"
                                IsVisible="{Binding IsGitHubEnabled}"
                                ToolTip.Tip="Open the Issues tab" />
                            <Button
                                Grid.Column="3"
                                Margin="0,0,10,0"
                                Classes="ov-card-btn"
                                Command="{Binding ToggleAzureTabCommand}"
                                IsVisible="{Binding IsAzureDevOpsEnabled}"
                                ToolTip.Tip="Open the Pipelines tab">
                                <StackPanel Orientation="Horizontal" Spacing="12">
                                    <Grid
                                        Width="36"
                                        Height="36"
                                        VerticalAlignment="Top">
                                        <Border Background="{DynamicResource InfoAccentBrush}" Classes="stat-badge" />
                                        <Path
                                            Width="18"
                                            Height="18"
                                            HorizontalAlignment="Center"
                                            VerticalAlignment="Center"
                                            Data="{tools:SvgPath icon-azure-devops}"
                                            Fill="{DynamicResource InfoAccentBrush}"
                                            Stretch="Uniform" />
                                    </Grid>
                                    <StackPanel Spacing="2">
                                        <TextBlock
                                            FontSize="14"
                                            FontWeight="SemiBold"
                                            Foreground="{DynamicResource TitleForegroundBrush}"
                                            Text="{Binding PipelineStatusText}"
                                            TextTrimming="CharacterEllipsis"
                                            ToolTip.Tip="Latest Azure DevOps pipeline results" />
                                        <TextBlock Classes="subtle" Text="Pipelines" />
                                    </StackPanel>
                                </StackPanel>
                            </Button>
                        </UniformGrid>

                        <!--
                            Same cards without the Pipelines slot (Azure DevOps off):
                            a collapsed UniformGrid child keeps its cell, so the
                            three remaining cards need their own 3-column grid.
                        -->
                        <UniformGrid
                            Grid.Row="0"
                            Columns="3"
                            IsVisible="{Binding !IsAzureDevOpsEnabled}">
                            <Button
                                Margin="0,0,10,0"
                                Classes="ov-card-btn"
                                Command="{Binding ToggleChangesTabCommand}"
                                Content="{Binding}"
                                ContentTemplate="{StaticResource StatCardChanges}"
                                ToolTip.Tip="Open the Changes tab" />
                            <Button
                                Margin="0,0,10,0"
                                Classes="ov-card-btn"
                                Command="{Binding TogglePullRequestsTabCommand}"
                                Content="{Binding}"
                                ContentTemplate="{StaticResource StatCardPullRequests}"
                                IsVisible="{Binding IsGitHubEnabled}"
                                ToolTip.Tip="Open the Pull Requests tab" />
                            <Button
                                Margin="0,0,10,0"
                                Classes="ov-card-btn"
                                Command="{Binding ToggleIssuesTabCommand}"
                                Content="{Binding}"
                                ContentTemplate="{StaticResource StatCardIssues}"
                                IsVisible="{Binding IsGitHubEnabled}"
                                ToolTip.Tip="Open the Issues tab" />
                        </UniformGrid>

                        <!--  Activity lists  -->
                        <Grid
                            Grid.Row="1"
                            ColumnDefinitions="3*,3*,3*"
                            ColumnSpacing="10">

                            <!--  Local Changes  -->
                            <Button
                                Grid.Column="0"
                                Classes="ov-card-btn"
                                Command="{Binding ToggleChangesTabCommand}">
                                <DockPanel>
                                    <TextBlock
                                        Margin="0,0,0,4"
                                        Classes="ov-card-title"
                                        DockPanel.Dock="Top"
                                        Text="Local Changes" />
                                    <TextBlock
                                        Margin="0,4,0,0"
                                        Classes="subtle"
                                        DockPanel.Dock="Bottom"
                                        IsVisible="{Binding ShowChangesBadge}"
                                        Text="{Binding ChangesCount, StringFormat='{}{0} changed files'}" />
                                    <ScrollViewer HorizontalScrollBarVisibility="Disabled">
                                        <StackPanel Spacing="10">
                                            <TextBlock
                                                Margin="0,16"
                                                Classes="list-note subtle"
                                                IsVisible="{Binding ShowChangesEmpty}"
                                                Text="Working tree is clean" />
                                            <ItemsControl ItemsSource="{Binding ChangedFilesPreview}">
                                                <ItemsControl.ItemTemplate>
                                                    <DataTemplate x:DataType="entities:GitChangedFile">
                                                        <Grid ColumnDefinitions="Auto,*,Auto" ColumnSpacing="8">
                                                            <Border
                                                                Grid.Column="0"
                                                                Width="24"
                                                                Padding="0,1"
                                                                VerticalAlignment="Center"
                                                                Background="{DynamicResource CardBackgroundBrush}"
                                                                BorderBrush="{DynamicResource HairlineBrush}"
                                                                BorderThickness="1"
                                                                CornerRadius="{DynamicResource ChipRadius}">
                                                                <TextBlock
                                                                    HorizontalAlignment="Center"
                                                                    Classes="mono"
                                                                    Foreground="{Binding StatusCode, Converter={StaticResource GitStatusBrushConverter}}"
                                                                    Text="{Binding DisplayStatusCode}" />
                                                            </Border>
                                                            <TextBlock
                                                                Grid.Column="1"
                                                                VerticalAlignment="Center"
                                                                Classes="mono"
                                                                Foreground="{DynamicResource BodyForegroundBrush}"
                                                                Text="{Binding Path}"
                                                                TextTrimming="CharacterEllipsis" />
                                                            <ContentControl
                                                                Grid.Column="2"
                                                                Content="{Binding}"
                                                                ContentTemplate="{StaticResource NumstatPillsTemplate}" />
                                                        </Grid>
                                                    </DataTemplate>
                                                </ItemsControl.ItemTemplate>
                                            </ItemsControl>
                                        </StackPanel>
                                    </ScrollViewer>
                                </DockPanel>
                            </Button>

                            <!--  Recent Pull Requests  -->
                            <Button
                                Grid.Column="1"
                                Classes="ov-card-btn"
                                Command="{Binding TogglePullRequestsTabCommand}">
                                <DockPanel>
                                    <TextBlock
                                        Margin="0,0,0,4"
                                        Classes="ov-card-title"
                                        DockPanel.Dock="Top"
                                        Text="Recent Pull Requests" />
                                    <ScrollViewer HorizontalScrollBarVisibility="Disabled">
                                        <StackPanel Spacing="10">
                                            <TextBlock
                                                Margin="0,16"
                                                Classes="list-note subtle"
                                                IsVisible="{Binding ShowPullRequestsEmpty}"
                                                Text="No open pull requests" />
                                            <ItemsControl ItemsSource="{Binding GitHubPullRequestsPreview}">
                                                <ItemsControl.ItemTemplate>
                                                    <DataTemplate x:DataType="entities:GitHubItem">
                                                        <Button
                                                            Padding="4,5"
                                                            Classes="bar-item"
                                                            Command="{Binding $parent[UserControl].((vm:BottomBarViewModel)DataContext).OpenGitHubItemCommand}"
                                                            CommandParameter="{Binding}"
                                                            ToolTip.Tip="{Binding Url}">
                                                            <Grid ColumnDefinitions="*,Auto,Auto,Auto" ColumnSpacing="8">
                                                                <StackPanel Grid.Column="0" Spacing="1">
                                                                    <!--  Title + branch lines are shared templates;
                                                                          the star cell constrains the title so it
                                                                          trims instead of painting over the
                                                                          trailing author/age columns.  -->
                                                                    <ContentControl
                                                                        Content="{Binding}"
                                                                        ContentTemplate="{StaticResource GitHubTitleLine}" />
                                                                    <ContentControl
                                                                        Content="{Binding}"
                                                                        ContentTemplate="{StaticResource BranchSummaryTemplate}" />
                                                                </StackPanel>
                                                                <TextBlock
                                                                    Grid.Column="1"
                                                                    VerticalAlignment="Center"
                                                                    Classes="subtle"
                                                                    IsVisible="{Binding Author, Converter={StaticResource StringNullOrEmptyToVisibilityConverter}}"
                                                                    Text="{Binding Author}" />
                                                                <TextBlock
                                                                    Grid.Column="2"
                                                                    VerticalAlignment="Center"
                                                                    Classes="subtle"
                                                                    Text="{Binding AgeText}" />
                                                                <ContentControl
                                                                    Grid.Column="3"
                                                                    Content="{Binding}"
                                                                    ContentTemplate="{StaticResource StateChipTemplate}" />
                                                            </Grid>
                                                        </Button>
                                                    </DataTemplate>
                                                </ItemsControl.ItemTemplate>
                                            </ItemsControl>

                                            <!--  Azure DevOps pull requests preview  -->
                                            <StackPanel IsVisible="{Binding HasAzurePullRequests}" Spacing="4">
                                                <TextBlock
                                                    Classes="field-label"
                                                    Text="{Binding AzurePullRequests.Count, StringFormat='Azure DevOps ({0})'}" />
                                                <ItemsControl ItemsSource="{Binding AzurePullRequestsPreview}">
                                                    <ItemsControl.ItemTemplate>
                                                        <DataTemplate x:DataType="entities:AzureDevOpsItem">
                                                            <Button
                                                                Padding="4,5"
                                                                Classes="bar-item"
                                                                Command="{Binding $parent[UserControl].((vm:BottomBarViewModel)DataContext).OpenAzureItemCommand}"
                                                                CommandParameter="{Binding}"
                                                                ToolTip.Tip="{Binding Url}">
                                                                <Grid ColumnDefinitions="*,Auto" ColumnSpacing="8">
                                                                    <ContentControl
                                                                        Grid.Column="0"
                                                                        Content="{Binding}"
                                                                        ContentTemplate="{StaticResource AzureTitleLine}" />
                                                                    <TextBlock
                                                                        Grid.Column="1"
                                                                        VerticalAlignment="Center"
                                                                        Classes="subtle"
                                                                        IsVisible="{Binding Author, Converter={StaticResource StringNullOrEmptyToVisibilityConverter}}"
                                                                        Text="{Binding Author}" />
                                                                </Grid>
                                                            </Button>
                                                        </DataTemplate>
                                                    </ItemsControl.ItemTemplate>
                                                </ItemsControl>
                                            </StackPanel>
                                        </StackPanel>
                                    </ScrollViewer>
                                </DockPanel>
                            </Button>

                            <!--  Recent Issues  -->
                            <Button
                                Grid.Column="2"
                                Classes="ov-card-btn"
                                Command="{Binding ToggleIssuesTabCommand}">
                                <DockPanel>
                                    <TextBlock
                                        Margin="0,0,0,4"
                                        Classes="ov-card-title"
                                        DockPanel.Dock="Top"
                                        Text="Recent Issues" />
                                    <ScrollViewer HorizontalScrollBarVisibility="Disabled">
                                        <StackPanel Spacing="10">
                                            <TextBlock
                                                Margin="0,16"
                                                Classes="list-note subtle"
                                                IsVisible="{Binding ShowIssuesEmpty}"
                                                Text="No open issues" />
                                            <ItemsControl ItemsSource="{Binding GitHubIssuesPreview}">
                                                <ItemsControl.ItemTemplate>
                                                    <DataTemplate x:DataType="entities:GitHubItem">
                                                        <Button
                                                            Padding="4,5"
                                                            Classes="bar-item"
                                                            Command="{Binding $parent[UserControl].((vm:BottomBarViewModel)DataContext).OpenGitHubItemCommand}"
                                                            CommandParameter="{Binding}"
                                                            ToolTip.Tip="{Binding Url}">
                                                            <Grid ColumnDefinitions="*,Auto,Auto" ColumnSpacing="6">
                                                                <StackPanel Grid.Column="0" Spacing="1">
                                                                    <!--  Title line + label pills are shared
                                                                          templates; the star cell constrains the
                                                                          title so it trims instead of painting
                                                                          over the trailing author/age columns.  -->
                                                                    <ContentControl
                                                                        Content="{Binding}"
                                                                        ContentTemplate="{StaticResource GitHubTitleLine}" />
                                                                    <ContentControl
                                                                        Content="{Binding}"
                                                                        ContentTemplate="{StaticResource GitHubLabelsFlow}" />
                                                                </StackPanel>
                                                                <TextBlock
                                                                    Grid.Column="1"
                                                                    VerticalAlignment="Center"
                                                                    Classes="subtle"
                                                                    IsVisible="{Binding Author, Converter={StaticResource StringNullOrEmptyToVisibilityConverter}}"
                                                                    Text="{Binding Author}" />
                                                                <TextBlock
                                                                    Grid.Column="2"
                                                                    VerticalAlignment="Center"
                                                                    Classes="subtle"
                                                                    IsVisible="{Binding AgeText, Converter={StaticResource StringNullOrEmptyToVisibilityConverter}}"
                                                                    Text="{Binding AgeText}" />
                                                            </Grid>
                                                        </Button>
                                                    </DataTemplate>
                                                </ItemsControl.ItemTemplate>
                                            </ItemsControl>

                                            <!--  Azure DevOps work items preview  -->
                                            <StackPanel IsVisible="{Binding HasAzureWorkItems}" Spacing="4">
                                                <TextBlock
                                                    Classes="field-label"
                                                    Text="{Binding AzureWorkItems.Count, StringFormat='Azure DevOps ({0})'}" />
                                                <ItemsControl ItemsSource="{Binding AzureWorkItemsPreview}">
                                                    <ItemsControl.ItemTemplate>
                                                        <DataTemplate x:DataType="entities:AzureDevOpsItem">
                                                            <Button
                                                                Padding="4,5"
                                                                Classes="bar-item"
                                                                Command="{Binding $parent[UserControl].((vm:BottomBarViewModel)DataContext).OpenAzureItemCommand}"
                                                                CommandParameter="{Binding}"
                                                                ToolTip.Tip="{Binding Url}">
                                                                <Grid ColumnDefinitions="*,Auto" ColumnSpacing="8">
                                                                    <ContentControl
                                                                        Grid.Column="0"
                                                                        Content="{Binding}"
                                                                        ContentTemplate="{StaticResource AzureTitleLine}" />
                                                                    <TextBlock
                                                                        Grid.Column="1"
                                                                        VerticalAlignment="Center"
                                                                        Classes="subtle"
                                                                        Text="{Binding State}" />
                                                                </Grid>
                                                            </Button>
                                                        </DataTemplate>
                                                    </ItemsControl.ItemTemplate>
                                                </ItemsControl>
                                            </StackPanel>
                                        </StackPanel>
                                    </ScrollViewer>
                                </DockPanel>
                            </Button>
                        </Grid>
                    </Grid>

                    <!--  Repository Details sidebar  -->
                    <Border Grid.Column="1" Classes="ov-card">
                        <DockPanel>
                            <TextBlock
                                Margin="0,0,0,6"
                                Classes="ov-card-title"
                                DockPanel.Dock="Top"
                                Text="Repository Details" />
                            <ScrollViewer HorizontalScrollBarVisibility="Disabled">
                                <StackPanel Spacing="8">
                                    <StackPanel.Styles>
                                        <Style Selector="TextBlock.detail-key">
                                            <Setter Property="Foreground" Value="{DynamicResource MutedForegroundBrush}" />
                                        </Style>
                                        <Style Selector="TextBlock.detail-value">
                                            <Setter Property="Foreground" Value="{DynamicResource BodyForegroundBrush}" />
                                        </Style>
                                    </StackPanel.Styles>
                                    <TextBlock
                                        Classes="subtle"
                                        IsVisible="{Binding !HasRepoDetails}"
                                        Text="No GitHub data for this repository"
                                        TextWrapping="Wrap" />
                                    <!--
                                        GitHub link row: the repo's page as a clickable
                                        display URL. Sits OUTSIDE the details gate so it
                                        shows whenever the repo has a GitHub remote — even
                                        while the gh details are still loading (or absent).
                                    -->
                                    <Grid
                                        ColumnDefinitions="110,*"
                                        ColumnSpacing="10"
                                        IsVisible="{Binding HasSelectedRepoGitHubUrl}">
                                        <TextBlock Classes="detail-key" Text="GitHub" />
                                        <Button
                                            Grid.Column="1"
                                            Classes="detail-link"
                                            Command="{Binding OpenGitHubRepoCommand}"
                                            HorizontalAlignment="Left"
                                            ToolTip.Tip="Open the repository's GitHub page">
                                            <StackPanel Orientation="Horizontal" Spacing="6">
                                                <!--  The details sidebar is a fixed 290px column, so
                                                      after the 110px key + paddings the value cell
                                                      has ~130px: cap the URL explicitly (desired-
                                                      sized presenter would otherwise overflow the
                                                      card) and let the ellipsis take the rest.  -->
                                                <TextBlock
                                                    MaxWidth="126"
                                                    VerticalAlignment="Center"
                                                    Classes="detail-value"
                                                    Text="{Binding SelectedRepoGitHubDisplayUrl}"
                                                    TextTrimming="CharacterEllipsis" />
                                                <Path
                                                    Width="12"
                                                    Height="12"
                                                    VerticalAlignment="Center"
                                                    Data="{tools:SvgPath icon-open-in-new}"
                                                    Fill="{DynamicResource MutedForegroundBrush}"
                                                    Stretch="Uniform" />
                                            </StackPanel>
                                        </Button>
                                    </Grid>
                                    <Grid
                                        ColumnDefinitions="Auto,*"
                                        ColumnSpacing="10"
                                        IsVisible="{Binding HasRepoDetails}">
                                        <StackPanel Grid.ColumnSpan="2" Spacing="6">
                                            <Grid
                                                ColumnDefinitions="110,*"
                                                ColumnSpacing="10"
                                                IsVisible="{Binding SelectedRepoDetails?.Owner, Converter={StaticResource StringNullOrEmptyToVisibilityConverter}}">
                                                <TextBlock Classes="detail-key" Text="Owner" />
                                                <TextBlock
                                                    Grid.Column="1"
                                                    Classes="detail-value"
                                                    Text="{Binding SelectedRepoDetails?.Owner}"
                                                    TextTrimming="CharacterEllipsis" />
                                            </Grid>
                                            <Grid
                                                ColumnDefinitions="110,*"
                                                ColumnSpacing="10"
                                                IsVisible="{Binding SelectedRepoDetails?.CreatedAt, Converter={StaticResource NotNullToBoolConverter}}">
                                                <TextBlock Classes="detail-key" Text="Created" />
                                                <TextBlock
                                                    Grid.Column="1"
                                                    Classes="detail-value"
                                                    Text="{Binding SelectedRepoDetails?.CreatedAt, StringFormat='d MMM yyyy'}" />
                                            </Grid>
                                            <Grid
                                                ColumnDefinitions="110,*"
                                                ColumnSpacing="10"
                                                IsVisible="{Binding SelectedRepoDetails?.Language, Converter={StaticResource StringNullOrEmptyToVisibilityConverter}}">
                                                <TextBlock Classes="detail-key" Text="Language" />
                                                <TextBlock
                                                    Grid.Column="1"
                                                    Classes="detail-value"
                                                    Text="{Binding SelectedRepoDetails?.Language}" />
                                            </Grid>
                                            <Grid
                                                ColumnDefinitions="110,*"
                                                ColumnSpacing="10"
                                                IsVisible="{Binding SelectedRepoDetails?.License, Converter={StaticResource StringNullOrEmptyToVisibilityConverter}}">
                                                <TextBlock Classes="detail-key" Text="License" />
                                                <TextBlock
                                                    Grid.Column="1"
                                                    Classes="detail-value"
                                                    Text="{Binding SelectedRepoDetails?.License}" />
                                            </Grid>
                                            <Grid
                                                ColumnDefinitions="110,*"
                                                ColumnSpacing="10"
                                                IsVisible="{Binding SelectedRepoDetails?.DefaultBranch, Converter={StaticResource StringNullOrEmptyToVisibilityConverter}}">
                                                <TextBlock Classes="detail-key" Text="Default Branch" />
                                                <TextBlock
                                                    Grid.Column="1"
                                                    Classes="detail-value"
                                                    Text="{Binding SelectedRepoDetails?.DefaultBranch}" />
                                            </Grid>
                                        </StackPanel>
                                    </Grid>
                                    <!--  Topics chips  -->
                                    <StackPanel IsVisible="{Binding SelectedRepoDetails?.HasTopics, TargetNullValue=False}">
                                        <TextBlock Classes="detail-key" Text="Topics" />
                                        <ItemsControl Margin="0,4,0,0" ItemsSource="{Binding SelectedRepoDetails?.Topics}">
                                            <ItemsControl.ItemsPanel>
                                                <ItemsPanelTemplate>
                                                    <WrapPanel Orientation="Horizontal" />
                                                </ItemsPanelTemplate>
                                            </ItemsControl.ItemsPanel>
                                            <ItemsControl.ItemTemplate>
                                                <DataTemplate x:DataType="x:String">
                                                    <Border
                                                        Margin="0,0,6,6"
                                                        Padding="7,2"
                                                        Classes="chip">
                                                        <TextBlock Classes="subtle" Text="{Binding}" />
                                                    </Border>
                                                </DataTemplate>
                                            </ItemsControl.ItemTemplate>
                                        </ItemsControl>
                                    </StackPanel>
                                </StackPanel>
                            </ScrollViewer>
                        </DockPanel>
                    </Border>
                </Grid>

                <!--
                    Changes tab (commit workspace, mockup): TOP — the branch dropdown +
                    Pull/Push/Fetch + last-fetched row (moved up from the old strip); LEFT — the
                    staged/unstaged tree as two sections, each with its own header (icon
                    + name + count + Stage All / Unstage All) and one row per file with
                    a status chip, per-side numstat and a + / − button; RIGHT — the
                    commit message box with the wand button and Commit; BOTTOM — the
                    repo's history (recent commits), collapsed by default behind a header toggle.
                -->
                <DockPanel Grid.Row="1" IsVisible="{Binding IsActiveChanges}">

                    <!--  Top toolbar: branch dropdown (pick to check out) + Pull/Push/
                          Fetch and last-fetched — moved up from the old bottom strip,
                          which held nothing else and was removed with it.  -->
                    <Grid
                        DockPanel.Dock="Top"
                        Margin="0,0,0,8"
                        ColumnDefinitions="Auto,*,Auto"
                        ColumnSpacing="14">

                        <!--
                            Branch dropdown — outlined box with a branch icon + name;
                            picking an entry checks it out. The box follows the branch
                            name's width (the toolbar's Auto column grants the content
                            size) up to the cap, past which the name ellipsizes instead
                            of eating the Pull/Push/Fetch side of the row; the dropdown
                            popup grows with its widest entry under the same cap, so
                            full names show there.
                        -->
                        <ComboBox
                            x:Name="BranchPicker"
                            Grid.Column="0"
                            Height="30"
                            MinWidth="88"
                            MaxWidth="360"
                            VerticalAlignment="Center"
                            Background="Transparent"
                            BorderBrush="{DynamicResource HairlineBrush}"
                            BorderThickness="1"
                            CornerRadius="6"
                            ItemsSource="{Binding Branches}"
                            PlaceholderText="branch"
                            SelectedItem="{Binding SelectedBranch, Mode=OneWay}"
                            SelectionChanged="OnBranchSelectionChanged"
                            ToolTip.Tip="Current branch — pick another to check it out">
                            <ComboBox.Styles>
                                <!--  The popup is at least the box's width and otherwise
                                      follows its widest entry (theme MinWidth binding);
                                      the cap keeps an extreme name on screen, where the
                                      entry's own ellipsis (ItemTemplate) takes over.  -->
                                <Style Selector="ComboBoxItem">
                                    <Setter Property="MaxWidth" Value="360" />
                                </Style>
                            </ComboBox.Styles>
                            <ComboBox.ItemTemplate>
                                <DataTemplate x:DataType="x:String">
                                    <StackPanel Orientation="Horizontal" Spacing="6">
                                        <Path
                                            Width="12"
                                            Height="12"
                                            Data="{tools:SvgPath icon-source-branch}"
                                            Fill="{DynamicResource MutedForegroundBrush}"
                                            Stretch="Uniform" />
                                        <!--
                                            Explicit foreground: SukiUI brightens only TextBlocks that
                                            are the ComboBoxItem's DIRECT content; inside this
                                            StackPanel the inherited popup color is too dim. The
                                            ellipsis bites only under the caps (the closed box's
                                            MaxWidth, the item's) — the popup sizes to the widest
                                            entry otherwise, so entries never trim in it.
                                        -->
                                        <TextBlock
                                            Foreground="{DynamicResource BodyForegroundBrush}"
                                            Text="{Binding}"
                                            TextTrimming="CharacterEllipsis" />
                                    </StackPanel>
                                </DataTemplate>
                            </ComboBox.ItemTemplate>
                        </ComboBox>

                        <!--  Pull / Push / Fetch + last fetched (pinned right): plain
                              buttons with arrow icons, then the status dot + relative
                              label.  -->
                        <StackPanel
                            Grid.Column="2"
                            VerticalAlignment="Center"
                            IsVisible="{Binding HasSelectedRepo}"
                            Orientation="Horizontal"
                            Spacing="10">
                            <!--  Plain default buttons (Browse…-style native hover). The
                                  count after the label shows the ahead/behind commits
                                  git reported (Repo.GitToPushCount/GitToPullCount) and
                                  hides while zero/not yet known.  -->
                            <Button Command="{Binding PullCommand}" ToolTip.Tip="git pull for the selected repository">
                                <StackPanel Orientation="Horizontal" Spacing="6">
                                    <Path
                                        Width="13"
                                        Height="13"
                                        VerticalAlignment="Center"
                                        Classes="icon"
                                        Data="{tools:SvgPath icon-arrow-down}" />
                                    <TextBlock VerticalAlignment="Center" Text="Pull" />
                                    <TextBlock
                                        VerticalAlignment="Center"
                                        FontSize="12"
                                        FontWeight="SemiBold"
                                        Foreground="{DynamicResource InfoAccentBrush}"
                                        IsVisible="{Binding GitToPullCount, Converter={StaticResource PositiveCountToVisibilityConverter}}"
                                        Text="{Binding GitToPullCount}" />
                                </StackPanel>
                            </Button>
                            <Button Command="{Binding PushCommand}" ToolTip.Tip="git push for the selected repository">
                                <StackPanel Orientation="Horizontal" Spacing="6">
                                    <Path
                                        Width="13"
                                        Height="13"
                                        VerticalAlignment="Center"
                                        Classes="icon"
                                        Data="{tools:SvgPath icon-arrow-up}" />
                                    <TextBlock VerticalAlignment="Center" Text="Push" />
                                    <TextBlock
                                        VerticalAlignment="Center"
                                        FontSize="12"
                                        FontWeight="SemiBold"
                                        Foreground="{DynamicResource StatusActiveBrush}"
                                        IsVisible="{Binding GitToPushCount, Converter={StaticResource PositiveCountToVisibilityConverter}}"
                                        Text="{Binding GitToPushCount}" />
                                </StackPanel>
                            </Button>
                            <Button Command="{Binding FetchCommand}" ToolTip.Tip="git fetch --prune for the selected repository">
                                <StackPanel Orientation="Horizontal" Spacing="6">
                                    <Path
                                        Width="13"
                                        Height="13"
                                        VerticalAlignment="Center"
                                        Classes="icon"
                                        Data="{tools:SvgPath icon-cloud-download}" />
                                    <TextBlock VerticalAlignment="Center" Text="Fetch" />
                                </StackPanel>
                            </Button>
                            <StackPanel
                                VerticalAlignment="Center"
                                Orientation="Horizontal"
                                Spacing="8">
                                <Border
                                    Width="7"
                                    Height="7"
                                    VerticalAlignment="Center"
                                    Background="{Binding HasFetched, Converter={StaticResource BoolToBrushConverter}}"
                                    CornerRadius="4" />
                                <TextBlock
                                    VerticalAlignment="Center"
                                    Foreground="{DynamicResource BodyForegroundBrush}"
                                    Text="{Binding LastFetchText, TargetNullValue='Not fetched'}" />
                            </StackPanel>
                        </StackPanel>
                    </Grid>

                    <!--  Bottom part: History (the repo's recent commits) — collapsed by
                          default; the header row is the toggle (chevron flips, hairline +
                          list hide), and the history loads on first expand.  -->
                    <StackPanel DockPanel.Dock="Bottom" Margin="0,10,0,0" Spacing="2">
                        <Border
                            Height="1"
                            Margin="0,2,0,6"
                            Background="{DynamicResource HairlineBrush}"
                            IsVisible="{Binding ShowRecentCommits}" />
                        <Button
                            Padding="2,2,6,2"
                            Classes="bar-item"
                            Command="{Binding ToggleRecentCommitsCommand}"
                            ToolTip.Tip="Show / hide this repository's history">
                            <Grid ColumnDefinitions="Auto,Auto,Auto,*,Auto" ColumnSpacing="6">
                                <Path
                                    Grid.Column="0"
                                    Width="13"
                                    Height="13"
                                    VerticalAlignment="Center"
                                    Data="{tools:SvgPath icon-clock}"
                                    Fill="{DynamicResource MutedForegroundBrush}"
                                    Stretch="Uniform" />
                                <TextBlock
                                    Grid.Column="1"
                                    VerticalAlignment="Center"
                                    Classes="ov-card-title"
                                    Text="History" />
                                <!--  count only when expanded: collapsed, the list isn't
                                      loaded and "(0)" would read as "no commits"  -->
                                <TextBlock
                                    Grid.Column="2"
                                    VerticalAlignment="Center"
                                    Classes="subtle"
                                    IsVisible="{Binding ShowRecentCommits}"
                                    Text="{Binding GitCommits.Count, StringFormat='({0})'}" />
                                <!--  box sized to the chevron's ink aspect (12x7.4):
                                      16x10 keeps it centered; 12x8 read as dead pixels  -->
                                <Path
                                    Grid.Column="4"
                                    Width="16"
                                    Height="10"
                                    VerticalAlignment="Center"
                                    IsVisible="{Binding ShowRecentCommits}"
                                    Data="{tools:SvgPath icon-chevron-down}"
                                    Fill="{DynamicResource MutedForegroundBrush}"
                                    Stretch="Uniform" />
                                <Path
                                    Grid.Column="4"
                                    Width="16"
                                    Height="10"
                                    VerticalAlignment="Center"
                                    IsVisible="{Binding !ShowRecentCommits}"
                                    Data="{tools:SvgPath icon-chevron-right}"
                                    Fill="{DynamicResource MutedForegroundBrush}"
                                    Stretch="Uniform" />
                            </Grid>
                        </Button>
                        <ScrollViewer
                            MaxHeight="220"
                            HorizontalScrollBarVisibility="Disabled"
                            VerticalScrollBarVisibility="Auto"
                            IsVisible="{Binding ShowRecentCommits}">
                            <!--  One row per commit: initials avatar + two text lines
                                  (subject, then the muted info line "author • time") with
                                  the hash link and a chevron on the right — the hash sits
                                  on the info line, so no cross-row columns exist and no
                                  fixed-width alignment machinery is needed.  -->
                            <StackPanel Spacing="2" Margin="2,0,0,0">
                                                <TextBlock
                                                    Margin="0,10"
                                                    Classes="list-note subtle"
                                                    IsVisible="{Binding ShowCommitsEmpty}"
                                                    Text="No commits yet" />
                                <ItemsControl ItemsSource="{Binding GitCommits}">
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate x:DataType="entities:GitCommitInfo">
                                                <Grid
                                                    Margin="0,4"
                                                    ColumnDefinitions="Auto,*,Auto,Auto"
                                                    ColumnSpacing="10"
                                                    RowDefinitions="Auto,Auto"
                                                    RowSpacing="3"
                                                    Cursor="Hand"
                                                    Tapped="OnHistoryRowTapped"
                                                    ToolTip.Tip="Open this commit's details">
                                                <!--  Author-initials avatar: tinted circle (the
                                                      tint is a nested layer so the initials
                                                      keep full opacity).  -->
                                                <Border
                                                    Grid.RowSpan="2"
                                                    Width="30"
                                                    Height="30"
                                                    VerticalAlignment="Center">
                                                    <Grid>
                                                        <Border
                                                            Background="{DynamicResource MutedForegroundBrush}"
                                                            CornerRadius="15"
                                                            Opacity="0.24" />
                                                        <TextBlock
                                                            Classes="subtle"
                                                            HorizontalAlignment="Center"
                                                            VerticalAlignment="Center"
                                                            FontSize="11"
                                                            FontWeight="SemiBold"
                                                            Text="{Binding Initials}" />
                                                    </Grid>
                                                </Border>
                                                <TextBlock
                                                    Grid.Row="0"
                                                    Grid.Column="1"
                                                    Foreground="{DynamicResource BodyForegroundBrush}"
                                                    Text="{Binding Subject}"
                                                    MaxLines="2"
                                                    TextTrimming="CharacterEllipsis"
                                                    TextWrapping="Wrap" />
                                                <!--  The info line: author • relative time.  -->
                                                <StackPanel
                                                    Grid.Row="1"
                                                    Grid.Column="1"
                                                    Orientation="Horizontal"
                                                    Spacing="5">
                                                    <TextBlock
                                                        Classes="subtle"
                                                        IsVisible="{Binding Author, Converter={StaticResource StringNullOrEmptyToVisibilityConverter}}"
                                                        Text="{Binding Author}" />
                                                    <TextBlock
                                                        Classes="subtle"
                                                        IsVisible="{Binding Author, Converter={StaticResource StringNullOrEmptyToVisibilityConverter}}"
                                                        Text="•" />
                                                    <TextBlock
                                                        Classes="subtle"
                                                        Text="{Binding RelativeTime}" />
                                                </StackPanel>
                                                <!--  the hash is a quiet link: click copies the full
                                                      SHA; it rides the info line (Grid.Row 1)  -->
                                                <Button
                                                    Grid.Row="1"
                                                    Grid.Column="2"
                                                    VerticalAlignment="Center"
                                                    Classes="detail-link"
                                                    Command="{Binding $parent[UserControl].((vm:BottomBarViewModel)DataContext).CopyCommitHashCommand}"
                                                    CommandParameter="{Binding}"
                                                    ToolTip.Tip="Copy commit hash">
                                                    <TextBlock
                                                        Classes="mono"
                                                        Foreground="{DynamicResource MutedForegroundBrush}"
                                                        Text="{Binding ShortHash}" />
                                                </Button>
                                                <!--  box sized to the chevron's ink aspect (12x7.4):
                                                      16x10 keeps it centered  -->
                                                <Path
                                                    Grid.RowSpan="2"
                                                    Grid.Column="3"
                                                    Width="16"
                                                    Height="10"
                                                    VerticalAlignment="Center"
                                                    Data="{tools:SvgPath icon-chevron-right}"
                                                    Fill="{DynamicResource MutedForegroundBrush}"
                                                    Stretch="Uniform" />
                                            </Grid>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                            </StackPanel>
                        </ScrollViewer>
                    </StackPanel>

                    <!--  Main row: staged/unstaged tree (left) + commit workspace (right)  -->
                    <Grid ColumnDefinitions="58*,42*" ColumnSpacing="10">

                        <!--  LEFT: the staged/unstaged tree  -->
                        <Border Grid.Column="0" Classes="ov-card">
                            <ScrollViewer HorizontalScrollBarVisibility="Disabled">
                                <StackPanel Spacing="2" Margin="4,4,4,4">
                                    <TextBlock
                                        Margin="0,20"
                                        Classes="list-note subtle"
                                        IsVisible="{Binding ShowChangesTabEmpty}"
                                        Text="No changes — the working tree is clean" />

                                    <!--  Unstaged section  -->
                                    <Grid
                                        ColumnDefinitions="*,Auto"
                                        Margin="2,2,2,2"
                                        IsVisible="{Binding ShowUnstagedSection}">
                                        <StackPanel
                                            Grid.Column="0"
                                            VerticalAlignment="Center"
                                            Orientation="Horizontal"
                                            Spacing="6">
                                            <Path
                                                Width="13"
                                                Height="13"
                                                VerticalAlignment="Center"
                                                Data="{tools:SvgPath icon-source-branch}"
                                                Fill="{DynamicResource WarningAccentBrush}"
                                                Stretch="Uniform" />
                                            <TextBlock Classes="ov-card-title" Text="Unstaged Changes" />
                                            <TextBlock
                                                VerticalAlignment="Center"
                                                Classes="subtle"
                                                Text="{Binding UnstagedCount, StringFormat='({0})'}" />
                                        </StackPanel>
                                        <Button
                                            Grid.Column="1"
                                            VerticalAlignment="Center"
                                            Classes="text-subtle"
                                            Command="{Binding StageAllCommand}"
                                            Content="Stage All"
                                            ToolTip.Tip="Stage all unstaged files" />
                                    </Grid>
                                    <ItemsControl
                                        Classes="stage-actions"
                                        IsVisible="{Binding ShowUnstagedSection}"
                                        ItemTemplate="{StaticResource GitChangedFileRowTemplate}"
                                        ItemsSource="{Binding UnstagedFiles}" />

                                    <!--  Staged section  -->
                                    <Grid
                                        ColumnDefinitions="*,Auto"
                                        Margin="2,8,2,2"
                                        IsVisible="{Binding ShowStagedSection}">
                                        <StackPanel
                                            Grid.Column="0"
                                            VerticalAlignment="Center"
                                            Orientation="Horizontal"
                                            Spacing="6">
                                            <Path
                                                Width="13"
                                                Height="13"
                                                VerticalAlignment="Center"
                                                Data="{tools:SvgPath icon-check}"
                                                Fill="{DynamicResource StatusActiveBrush}"
                                                Stretch="Uniform" />
                                            <TextBlock Classes="ov-card-title" Text="Staged Changes" />
                                            <TextBlock
                                                VerticalAlignment="Center"
                                                Classes="subtle"
                                                Text="{Binding StagedCount, StringFormat='({0})'}" />
                                        </StackPanel>
                                        <Button
                                            Grid.Column="1"
                                            VerticalAlignment="Center"
                                            Classes="text-subtle"
                                            Command="{Binding UnstageAllCommand}"
                                            Content="Unstage All"
                                            ToolTip.Tip="Unstage all files" />
                                    </Grid>
                                    <ItemsControl
                                        Classes="unstage-actions"
                                        IsVisible="{Binding ShowStagedSection}"
                                        ItemTemplate="{StaticResource GitChangedFileRowTemplate}"
                                        ItemsSource="{Binding StagedFiles}" />
                                </StackPanel>
                            </ScrollViewer>
                        </Border>

                        <!--  RIGHT: the commit workspace  -->
                        <Border Grid.Column="1" Classes="ov-card">
                            <DockPanel>

                                <TextBlock
                                    Margin="0,0,0,6"
                                    Classes="ov-card-title"
                                    DockPanel.Dock="Top"
                                    Text="Commit message" />


                                <!--  Commit button: an empty message box turns it into "Generate & Commit" —
                                      the press then writes the message first (the wand's run) and commits  -->
                                <Button
                                    Margin="0,8,0,0"
                                    HorizontalAlignment="Left"
                                    Classes="Outlined"
                                    Command="{Binding CommitCommand}"
                                    DockPanel.Dock="Bottom"
                                    ToolTip.Tip="Commit staged changes; empty message auto-generates (opencode)">
                                    <StackPanel Orientation="Horizontal" Spacing="6">
                                        <!--  wand while the box is empty, check once a message is typed;
                                              both give way to the spinning ring while the commit runs;
                                              Fill/Stroke track the button's Foreground so hover turns it white with the text  -->
                                        <Path
                                            Width="13"
                                            Height="13"
                                            VerticalAlignment="Center"
                                            IsVisible="{Binding CommitShowsWand}"
                                            Data="{tools:SvgPath icon-wand}"
                                            Fill="{Binding $parent[Button].Foreground}"
                                            Stretch="Uniform" />
                                        <Path
                                            Width="13"
                                            Height="13"
                                            VerticalAlignment="Center"
                                            IsVisible="{Binding CommitShowsCheck}"
                                            Data="{tools:SvgPath icon-check}"
                                            Fill="{Binding $parent[Button].Foreground}"
                                            Stretch="Uniform" />
                                        <!--  same ring recipe as the wand button: element-space arc,
                                              no Stretch, so the circle's center is exactly the
                                              RenderTransformOrigin the rotation pivots on  -->
                                        <Path
                                            Width="13"
                                            Height="13"
                                            VerticalAlignment="Center"
                                            IsVisible="{Binding IsCommitting}"
                                            Classes="spinner"
                                            RenderTransformOrigin="50%,50%"
                                            Data="{tools:SvgPath icon-spinner, Center=False}"
                                            Stroke="{Binding $parent[Button].Foreground}"
                                            StrokeThickness="2">
                                            <Path.RenderTransform>
                                                <RotateTransform />
                                            </Path.RenderTransform>
                                        </Path>
                                        <TextBlock VerticalAlignment="Center" Text="{Binding CommitButtonText}" />
                                    </StackPanel>
                                </Button>

                                <!--  Message box; the wand sits over its bottom-right corner  -->
                                <Grid>
                                    <TextBox
                                        AcceptsReturn="True"
                                        Padding="0,0,26,0"
                                        VerticalContentAlignment="Top"
                                        Text="{Binding CommitMessage}"
                                        TextWrapping="Wrap"
                                        Watermark="Commit message (empty = auto-generate)" />
                                    <!--
                                        Commit-message wand: a bare icon floating over the message
                                        box's corner — a detail-link (transparent, dims on hover)
                                        with its own padding, so the TextBox shows through.
                                    -->
                                    <Button
                                        Margin="0,0,4,4"
                                        HorizontalAlignment="Right"
                                        VerticalAlignment="Bottom"
                                        Padding="4"
                                        Classes="detail-link"
                                        Command="{Binding GenerateCommitMessageCommand}"
                                        ToolTip.Tip="Generate a commit message from the staged diff (opencode)">
                                            <Grid>
                                                <!--  spinning arc while the generation runs; drawn at final size
                                                      in element coordinates (no Stretch) so the circle's center
                                                      is exactly the RenderTransformOrigin the rotation pivots on;
                                                      the ring is the Path.spinner shared style  -->
                                                <Path
                                                    Width="16"
                                                    Height="16"
                                                    IsVisible="{Binding IsGeneratingMessage}"
                                                    Classes="spinner"
                                                    RenderTransformOrigin="50%,50%"
                                                    Data="M 8 1 A 7 7 0 1 1 1 8"
                                                    Stroke="{DynamicResource AccentPrimaryBrush}"
                                                    StrokeThickness="2">
                                                    <Path.RenderTransform>
                                                        <RotateTransform />
                                                    </Path.RenderTransform>
                                                </Path>
                                            <Path
                                                Width="16"
                                                Height="16"
                                                IsVisible="{Binding !IsGeneratingMessage}"
                                                Data="{tools:SvgPath icon-wand}"
                                                Fill="{DynamicResource MutedForegroundBrush}"
                                                Stretch="Uniform" />
                                        </Grid>
                                    </Button>
                                </Grid>
                            </DockPanel>
                        </Border>
                    </Grid>
                </DockPanel>

                <!--  Pull requests tab  -->
                <DockPanel Grid.Row="1" IsVisible="{Binding IsActivePullRequests}">
                    <Grid
                        Margin="0,6,0,4"
                        ColumnDefinitions="*,Auto,Auto"
                        ColumnSpacing="4"
                        DockPanel.Dock="Top">
                        <TextBlock
                            Grid.Column="0"
                            VerticalAlignment="Center"
                            Classes="subtle"
                            Text="{Binding OpenPullRequestCount, StringFormat='{}{0} open pull requests'}" />
                        <Button
                            Grid.Column="1"
                            VerticalAlignment="Center"
                            Classes="icon"
                            Command="{Binding RefreshGitHubCommand}"
                            IsEnabled="{Binding !IsGitHubRefreshing}"
                            ToolTip.Tip="Refresh">
                            <Path Classes="icon" Data="{tools:SvgPath icon-refresh}" />
                        </Button>
                        <Button
                            Grid.Column="2"
                            VerticalAlignment="Center"
                            Classes="icon"
                            Command="{Binding OpenGitHubPullsCommand}"
                            ToolTip.Tip="Open the pull requests page on GitHub">
                            <Path
                                Width="17"
                                Height="17"
                                Data="{tools:SvgPath icon-github}"
                                Fill="{DynamicResource MutedForegroundBrush}"
                                Stretch="Uniform" />
                        </Button>
                    </Grid>
                    <ScrollViewer HorizontalScrollBarVisibility="Disabled">
                        <StackPanel Spacing="2">
                            <TextBlock
                                Classes="list-note subtle"
                                IsVisible="{Binding !GitHubHasLoaded}"
                                Text="Loading…" />
                            <TextBlock
                                Classes="list-note subtle"
                                IsVisible="{Binding ShowPullRequestsEmpty}"
                                Text="No open pull requests" />
                            <TextBlock
                                Classes="list-note subtle"
                                IsVisible="{Binding ShowGitHubUnavailable}"
                                Text="No GitHub data for this repository (is it hosted on GitHub, and is gh authenticated?)" />
                            <ItemsControl ItemsSource="{Binding GitHubPullRequests}">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate x:DataType="entities:GitHubItem">
                                        <Button
                                            Classes="bar-item"
                                            Command="{Binding $parent[UserControl].((vm:BottomBarViewModel)DataContext).OpenGitHubItemCommand}"
                                            CommandParameter="{Binding}"
                                            ToolTip.Tip="{Binding Url}">
                                            <Grid ColumnDefinitions="Auto,*,Auto,Auto,Auto" ColumnSpacing="10">
                                                <Path
                                                    Grid.Column="0"
                                                    Width="15"
                                                    Height="15"
                                                    VerticalAlignment="Center"
                                                    Data="{tools:SvgPath icon-git-pull-request}"
                                                    Fill="{DynamicResource PurpleAccentBrush}"
                                                    Stretch="Uniform" />
                                                <StackPanel
                                                    Grid.Column="1"
                                                    VerticalAlignment="Center"
                                                    Orientation="Vertical"
                                                    Spacing="2">
                                                    <!--  Title / branch / label lines are shared templates;
                                                          the star cell constrains the title so it trims
                                                          instead of painting over the trailing
                                                          author/age/chip columns.  -->
                                                    <ContentControl
                                                        Content="{Binding}"
                                                        ContentTemplate="{StaticResource GitHubTitleLine13}" />
                                                    <ContentControl
                                                        Content="{Binding}"
                                                        ContentTemplate="{StaticResource BranchSummaryTemplate}" />
                                                    <ContentControl
                                                        Content="{Binding}"
                                                        ContentTemplate="{StaticResource GitHubLabelsFlow}" />
                                                    </StackPanel>
                                                <TextBlock
                                                    Grid.Column="2"
                                                    VerticalAlignment="Center"
                                                    Classes="subtle"
                                                    IsVisible="{Binding Author, Converter={StaticResource StringNullOrEmptyToVisibilityConverter}}"
                                                    Text="{Binding Author}" />
                                                <TextBlock
                                                    Grid.Column="3"
                                                    VerticalAlignment="Center"
                                                    Classes="subtle"
                                                    IsVisible="{Binding AgeText, Converter={StaticResource StringNullOrEmptyToVisibilityConverter}}"
                                                    Text="{Binding AgeText}" />
                                                    <ContentControl
                                                        Grid.Column="4"
                                                        Content="{Binding}"
                                                        ContentTemplate="{StaticResource StateChipTemplate}" />
                                            </Grid>
                                        </Button>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>

                            <!--  Azure DevOps pull requests, in the same tab as the GitHub list  -->
                            <StackPanel IsVisible="{Binding HasAzurePullRequests}" Spacing="2">
                                <TextBlock
                                    Margin="0,10,0,0"
                                    Classes="field-label"
                                    Text="{Binding AzurePullRequests.Count, StringFormat='Azure DevOps Pull Requests ({0})'}" />
                                <ItemsControl ItemsSource="{Binding AzurePullRequests}">
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate x:DataType="entities:AzureDevOpsItem">
                                            <Button
                                                Classes="bar-item"
                                                Command="{Binding $parent[UserControl].((vm:BottomBarViewModel)DataContext).OpenAzureItemCommand}"
                                                CommandParameter="{Binding}"
                                                ToolTip.Tip="{Binding Url}">
                                                <Grid ColumnDefinitions="Auto,*,Auto" ColumnSpacing="10">
                                                    <Path
                                                        Grid.Column="0"
                                                        Width="15"
                                                        Height="15"
                                                        VerticalAlignment="Center"
                                                        Data="{tools:SvgPath icon-git-pull-request}"
                                                        Fill="{DynamicResource PurpleAccentBrush}"
                                                        Stretch="Uniform" />
                                                    <ContentControl
                                                        Grid.Column="1"
                                                        Content="{Binding}"
                                                        ContentTemplate="{StaticResource AzureTitleLine13}" />
                                                    <TextBlock
                                                        Grid.Column="2"
                                                        VerticalAlignment="Center"
                                                        Classes="subtle"
                                                        IsVisible="{Binding Author, Converter={StaticResource StringNullOrEmptyToVisibilityConverter}}"
                                                        Text="{Binding Author}" />
                                                </Grid>
                                            </Button>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                            </StackPanel>
                        </StackPanel>
                    </ScrollViewer>
                </DockPanel>

                <!--  Issues tab  -->
                <DockPanel Grid.Row="1" IsVisible="{Binding IsActiveIssues}">
                    <Grid
                        Margin="0,6,0,4"
                        ColumnDefinitions="*,Auto,Auto"
                        ColumnSpacing="4"
                        DockPanel.Dock="Top">
                        <TextBlock
                            Grid.Column="0"
                            VerticalAlignment="Center"
                            Classes="subtle"
                            Text="{Binding OpenIssueCount, StringFormat='{}{0} open issues'}" />
                        <Button
                            Grid.Column="1"
                            VerticalAlignment="Center"
                            Classes="icon"
                            Command="{Binding RefreshGitHubCommand}"
                            IsEnabled="{Binding !IsGitHubRefreshing}"
                            ToolTip.Tip="Refresh">
                            <Path Classes="icon" Data="{tools:SvgPath icon-refresh}" />
                        </Button>
                        <Button
                            Grid.Column="2"
                            VerticalAlignment="Center"
                            Classes="icon"
                            Command="{Binding OpenGitHubIssuesCommand}"
                            ToolTip.Tip="Open the issues page on GitHub">
                            <Path
                                Width="17"
                                Height="17"
                                Data="{tools:SvgPath icon-github}"
                                Fill="{DynamicResource MutedForegroundBrush}"
                                Stretch="Uniform" />
                        </Button>
                    </Grid>
                    <ScrollViewer HorizontalScrollBarVisibility="Disabled">
                        <StackPanel Spacing="2">
                                            <TextBlock
                                                Classes="list-note subtle"
                                                IsVisible="{Binding !GitHubHasLoaded}"
                                                Text="Loading…" />
                                            <TextBlock
                                                Classes="list-note subtle"
                                                IsVisible="{Binding ShowIssuesEmpty}"
                                                Text="No open issues" />
                                            <TextBlock
                                                Classes="list-note subtle"
                                                IsVisible="{Binding ShowGitHubUnavailable}"
                                                Text="No GitHub data for this repository (is it hosted on GitHub, and is gh authenticated?)" />
                                            <ItemsControl ItemsSource="{Binding GitHubIssues}">
                                                <ItemsControl.ItemTemplate>
                                                    <DataTemplate x:DataType="entities:GitHubItem">
                                                        <Button
                                                            Classes="bar-item"
                                                            Command="{Binding $parent[UserControl].((vm:BottomBarViewModel)DataContext).OpenGitHubItemCommand}"
                                                            CommandParameter="{Binding}"
                                                            ToolTip.Tip="{Binding Url}">
                                                            <Grid ColumnDefinitions="Auto,*,Auto,Auto,Auto" ColumnSpacing="10">
                                                                <Path
                                                                    Grid.Column="0"
                                                                    Width="15"
                                                                    Height="15"
                                                                    VerticalAlignment="Center"
                                                                    Data="{tools:SvgPath icon-issue}"
                                                                    Fill="{DynamicResource StatusActiveBrush}"
                                                                    Stretch="Uniform" />
                                                                <!--  One line: number + title, then the tag
                                                                      pills, the author and the relative age.
                                                                      The title (shared template) lives in a
                                                                      star grid cell (not a horizontal
                                                                      StackPanel, which measures at infinite
                                                                      width and would never trim).  -->
                                                                <ContentControl
                                                                    Grid.Column="1"
                                                                    Content="{Binding}"
                                                                    ContentTemplate="{StaticResource GitHubTitleLine13}" />
                                                                <ItemsControl
                                                                    Grid.Column="2"
                                                                    VerticalAlignment="Center"
                                                                    ClipToBounds="True"
                                                                    IsVisible="{Binding HasLabels}"
                                                                    ItemTemplate="{StaticResource LabelPillTemplate}"
                                                                    ItemsSource="{Binding Labels}"
                                                                    MaxWidth="260">
                                                                    <ItemsControl.ItemsPanel>
                                                                        <ItemsPanelTemplate>
                                                                            <StackPanel Orientation="Horizontal" />
                                                                        </ItemsPanelTemplate>
                                                                    </ItemsControl.ItemsPanel>
                                                                </ItemsControl>
                                                                <TextBlock
                                                                    Grid.Column="3"
                                                                    VerticalAlignment="Center"
                                                                    Classes="subtle"
                                                                    IsVisible="{Binding Author, Converter={StaticResource StringNullOrEmptyToVisibilityConverter}}"
                                                                    Text="{Binding Author}" />
                                                                <TextBlock
                                                                    Grid.Column="4"
                                                                    VerticalAlignment="Center"
                                                                    Classes="subtle"
                                                                    IsVisible="{Binding AgeText, Converter={StaticResource StringNullOrEmptyToVisibilityConverter}}"
                                                                    Text="{Binding AgeText}" />
                                                            </Grid>
                                                        </Button>
                                                    </DataTemplate>
                                                </ItemsControl.ItemTemplate>
                                            </ItemsControl>

                                            <!--  Azure DevOps work items, in the same tab as the GitHub list  -->
                                            <StackPanel IsVisible="{Binding HasAzureWorkItems}" Spacing="2">
                                                <TextBlock
                                                    Margin="0,10,0,0"
                                                    Classes="field-label"
                                                    Text="{Binding AzureWorkItems.Count, StringFormat='Azure DevOps Work Items ({0})'}" />
                                                <ItemsControl ItemsSource="{Binding AzureWorkItems}">
                                                    <ItemsControl.ItemTemplate>
                                                        <DataTemplate x:DataType="entities:AzureDevOpsItem">
                                                            <Button
                                                                Classes="bar-item"
                                                                Command="{Binding $parent[UserControl].((vm:BottomBarViewModel)DataContext).OpenAzureItemCommand}"
                                                                CommandParameter="{Binding}"
                                                                ToolTip.Tip="{Binding Url}">
                                                                <Grid ColumnDefinitions="Auto,*,Auto,Auto" ColumnSpacing="10">
                                                                    <Path
                                                                        Grid.Column="0"
                                                                        Width="15"
                                                                        Height="15"
                                                                        VerticalAlignment="Center"
                                                                        Data="{tools:SvgPath icon-issue}"
                                                                        Fill="{DynamicResource StatusActiveBrush}"
                                                                        Stretch="Uniform" />
                                                                    <ContentControl
                                                                        Grid.Column="1"
                                                                        Content="{Binding}"
                                                                        ContentTemplate="{StaticResource AzureTitleLine13}" />
                                                                    <TextBlock
                                                                        Grid.Column="2"
                                                                        VerticalAlignment="Center"
                                                                        Classes="subtle"
                                                                        IsVisible="{Binding Author, Converter={StaticResource StringNullOrEmptyToVisibilityConverter}}"
                                                                        Text="{Binding Author}" />
                                                                    <TextBlock
                                                                        Grid.Column="3"
                                                                        VerticalAlignment="Center"
                                                                        Classes="subtle"
                                                                        IsVisible="{Binding State, Converter={StaticResource StringNullOrEmptyToVisibilityConverter}}"
                                                                        Text="{Binding State}" />
                                                                </Grid>
                                                            </Button>
                                                        </DataTemplate>
                                                    </ItemsControl.ItemTemplate>
                                                </ItemsControl>
                                            </StackPanel>
                                        </StackPanel>
                                    </ScrollViewer>
                                </DockPanel>

                                <!--  Azure DevOps tab: pull requests, work items, pipeline runs  -->
                <DockPanel Grid.Row="1" IsVisible="{Binding IsActiveAzure}">
                    <Grid
                        Margin="0,6,0,4"
                        ColumnDefinitions="*,Auto,Auto"
                        ColumnSpacing="4"
                        DockPanel.Dock="Top">
                        <TextBlock
                            Grid.Column="0"
                            VerticalAlignment="Center"
                            Classes="subtle"
                            Text="Active pull requests, open work items and recent pipeline runs" />
                        <Button
                            Grid.Column="1"
                            VerticalAlignment="Center"
                            Classes="icon"
                            Command="{Binding RefreshAzureCommand}"
                            IsEnabled="{Binding !IsAzureRefreshing}"
                            ToolTip.Tip="Refresh">
                            <Path Classes="icon" Data="{tools:SvgPath icon-refresh}" />
                        </Button>
                        <Button
                            Grid.Column="2"
                            VerticalAlignment="Center"
                            Classes="icon"
                            Command="{Binding OpenAzureRepoCommand}"
                            ToolTip.Tip="Open the repository in Azure DevOps">
                            <Path
                                Width="17"
                                Height="17"
                                Data="{tools:SvgPath icon-azure-devops}"
                                Fill="{DynamicResource MutedForegroundBrush}"
                                Stretch="Uniform" />
                        </Button>
                    </Grid>
                    <ScrollViewer HorizontalScrollBarVisibility="Disabled">
                        <StackPanel Spacing="2">
                            <TextBlock
                                Classes="list-note subtle"
                                IsVisible="{Binding !AzureHasLoaded}"
                                Text="Loading…" />
                            <TextBlock
                                Classes="list-note subtle"
                                IsVisible="{Binding ShowAzureEmpty}"
                                Text="Nothing open — no pull requests, work items or pipeline runs" />
                            <TextBlock
                                Classes="list-note subtle"
                                IsVisible="{Binding ShowAzureUnavailable}"
                                Text="No Azure DevOps data for this repository (is it hosted on Azure DevOps, and is a token configured?)" />

                            <!--  Pull requests section  -->
                            <StackPanel IsVisible="{Binding HasAzurePullRequests}" Spacing="2">
                                <TextBlock
                                    Margin="4,4,0,0"
                                    Classes="field-label"
                                    Text="{Binding AzurePullRequests.Count, StringFormat='Pull Requests ({0})'}" />
                                <ItemsControl ItemsSource="{Binding AzurePullRequests}">
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate x:DataType="entities:AzureDevOpsItem">
                                            <Button
                                                Classes="bar-item"
                                                Command="{Binding $parent[UserControl].((vm:BottomBarViewModel)DataContext).OpenAzureItemCommand}"
                                                CommandParameter="{Binding}"
                                                ToolTip.Tip="{Binding Url}">
                                                <Grid ColumnDefinitions="Auto,*,Auto" ColumnSpacing="10">
                                                    <Path
                                                        Grid.Column="0"
                                                        Width="15"
                                                        Height="15"
                                                        VerticalAlignment="Center"
                                                        Data="{tools:SvgPath icon-git-pull-request}"
                                                        Fill="{DynamicResource PurpleAccentBrush}"
                                                        Stretch="Uniform" />
                                                    <StackPanel
                                                        Grid.Column="1"
                                                        VerticalAlignment="Center"
                                                        Orientation="Horizontal"
                                                        Spacing="6">
                                                        <TextBlock
                                                            VerticalAlignment="Center"
                                                            FontSize="13"
                                                            FontWeight="SemiBold"
                                                            Foreground="{DynamicResource TitleForegroundBrush}"
                                                            Text="{Binding Number, StringFormat='#{0}'}" />
                                                        <TextBlock
                                                            VerticalAlignment="Center"
                                                            FontSize="13"
                                                            Foreground="{DynamicResource TitleForegroundBrush}"
                                                            Text="{Binding Title}"
                                                            TextTrimming="CharacterEllipsis" />
                                                    </StackPanel>
                                                    <TextBlock
                                                        Grid.Column="2"
                                                        VerticalAlignment="Center"
                                                        Classes="subtle"
                                                        IsVisible="{Binding Author, Converter={StaticResource StringNullOrEmptyToVisibilityConverter}}"
                                                        Text="{Binding Author}" />
                                                </Grid>
                                            </Button>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                            </StackPanel>

                            <!--  Work items section  -->
                            <StackPanel IsVisible="{Binding HasAzureWorkItems}" Spacing="2">
                                <TextBlock
                                    Margin="4,8,0,0"
                                    Classes="field-label"
                                    Text="{Binding AzureWorkItems.Count, StringFormat='Work Items ({0})'}" />
                                <ItemsControl ItemsSource="{Binding AzureWorkItems}">
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate x:DataType="entities:AzureDevOpsItem">
                                            <Button
                                                Classes="bar-item"
                                                Command="{Binding $parent[UserControl].((vm:BottomBarViewModel)DataContext).OpenAzureItemCommand}"
                                                CommandParameter="{Binding}"
                                                ToolTip.Tip="{Binding Url}">
                                                <Grid ColumnDefinitions="Auto,*,Auto,Auto" ColumnSpacing="10">
                                                    <Path
                                                        Grid.Column="0"
                                                        Width="15"
                                                        Height="15"
                                                        VerticalAlignment="Center"
                                                        Data="{tools:SvgPath icon-issue}"
                                                        Fill="{DynamicResource StatusActiveBrush}"
                                                        Stretch="Uniform" />
                                                    <TextBlock
                                                        Grid.Column="1"
                                                        VerticalAlignment="Center"
                                                        FontSize="13"
                                                        FontWeight="SemiBold"
                                                        Foreground="{DynamicResource TitleForegroundBrush}"
                                                        Text="{Binding Number, StringFormat='#{0}'}" />
                                                    <TextBlock
                                                        Grid.Column="2"
                                                        VerticalAlignment="Center"
                                                        FontSize="13"
                                                        Foreground="{DynamicResource TitleForegroundBrush}"
                                                        Text="{Binding Title}"
                                                        TextTrimming="CharacterEllipsis" />
                                                    <TextBlock
                                                        Grid.Column="3"
                                                        VerticalAlignment="Center"
                                                        Classes="subtle"
                                                        Text="{Binding State}" />
                                                </Grid>
                                            </Button>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                            </StackPanel>

                            <!--  Pipeline runs section  -->
                            <StackPanel IsVisible="{Binding HasAzurePipelineRuns}" Spacing="2">
                                <TextBlock
                                    Margin="4,8,0,0"
                                    Classes="field-label"
                                    Text="Pipeline Runs" />
                                <ItemsControl ItemsSource="{Binding AzurePipelineRuns}">
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate x:DataType="entities:AzureDevOpsPipelineRun">
                                            <Button
                                                Classes="bar-item"
                                                Command="{Binding $parent[UserControl].((vm:BottomBarViewModel)DataContext).OpenAzurePipelineCommand}"
                                                CommandParameter="{Binding}"
                                                ToolTip.Tip="{Binding Url}">
                                                <Grid ColumnDefinitions="Auto,*,Auto" ColumnSpacing="10">
                                                    <Path
                                                        Grid.Column="0"
                                                        Width="15"
                                                        Height="15"
                                                        VerticalAlignment="Center"
                                                        Data="{tools:SvgPath icon-play}"
                                                        Fill="{Binding IsFailed, Converter={StaticResource BoolToBrushConverter}}"
                                                        Stretch="Uniform" />
                                                    <StackPanel
                                                        Grid.Column="1"
                                                        VerticalAlignment="Center"
                                                        Orientation="Horizontal"
                                                        Spacing="6">
                                                        <TextBlock
                                                            VerticalAlignment="Center"
                                                            FontSize="13"
                                                            FontWeight="SemiBold"
                                                            Foreground="{DynamicResource TitleForegroundBrush}"
                                                            Text="{Binding BuildNumber, StringFormat='Build #{0}'}" />
                                                        <TextBlock
                                                            VerticalAlignment="Center"
                                                            FontSize="13"
                                                            Foreground="{DynamicResource TitleForegroundBrush}"
                                                            Text="{Binding DefinitionName}"
                                                            TextTrimming="CharacterEllipsis" />
                                                        <TextBlock
                                                            VerticalAlignment="Center"
                                                            Classes="subtle"
                                                            Text="{Binding DisplayBranch, StringFormat='· {0}'}" />
                                                    </StackPanel>
                                                    <TextBlock
                                                        Grid.Column="2"
                                                        VerticalAlignment="Center"
                                                        Classes="subtle"
                                                        FontWeight="SemiBold"
                                                        Foreground="{Binding IsFailed, Converter={StaticResource BoolToBrushConverter}}"
                                                        Text="{Binding Result}" />
                                                </Grid>
                                            </Button>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                            </StackPanel>
                        </StackPanel>
                    </ScrollViewer>
                </DockPanel>
            </Grid>
        </Border>

    </Grid>
</UserControl>
