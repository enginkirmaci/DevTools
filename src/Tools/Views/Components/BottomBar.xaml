<?xml version="1.0" encoding="utf-8" ?>
<UserControl
    x:Class="Tools.Views.Components.BottomBar"
    xmlns="https://github.com/avaloniaui"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:components="using:Tools.Views.Components"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:entities="using:Tools.Library.Entities"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:tools="using:Tools.Library.MarkupExtensions"
    xmlns:vm="using:Tools.ViewModels.Components"
    d:DesignHeight="280"
    d:DesignWidth="1200"
    x:CompileBindings="True"
    x:DataType="vm:BottomBarViewModel"
    mc:Ignorable="d">

    <!--
        Bottom bar: an expandable panel (the active tab's content — Overview with
        stat cards + activity lists + repository details, Changes, Pull Requests,
        Issues, Pipelines and Git) plus a 40px strip (git context + Fetch).
        The whole control stays hidden until a repo is selected from the table: a
        row press or a row chip reveals it (IsBarVisible); the header's X hides it
        again, strip included. The tab row lives in the RepoHeader inside the panel;
        the strip keeps
        only the git context (branch dropdown + bare "N changes" label) and the
        Fetch + last-fetched actions, pinned left/right like the mockup. Chrome
        matches the floating tool drawer: one docked card (CardBackgroundBrush
        surface, HairlineBrush border, CardRadius corners) that lives in the page
        layout — the table shrinks around it, nothing floats over the page. The bar
        lives on the Repositories page (it is that page's footer), not on every page.
    -->
    <!--
        Stretch button theme: replaces SukiUI's Button template for the bar's clickable
        surfaces (list rows + Overview cards). SukiUI's own template renders the
        content presenter content-sized even when the button stretches, so rows hug
        left and their trailing age/chip columns drift with the text length instead of
        pinning to the row's right edge, and card hovers only cover the content. This
        template stretches one Border + ContentPresenter across the whole button; the
        hover tint rides on Button.Background (TemplateBinding), so no template-part
        targeting is needed.
    -->
    <UserControl.Resources>
        <ControlTheme x:Key="StretchButtonTheme" TargetType="Button">
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="Padding" Value="10,7" />
            <Setter Property="CornerRadius" Value="6" />
            <Setter Property="HorizontalAlignment" Value="Stretch" />
            <Setter Property="HorizontalContentAlignment" Value="Stretch" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Template">
                <ControlTemplate>
                    <Border
                        Background="{TemplateBinding Background}"
                        BorderBrush="{TemplateBinding BorderBrush}"
                        BorderThickness="{TemplateBinding BorderThickness}"
                        CornerRadius="{TemplateBinding CornerRadius}">
                        <ContentPresenter
                            Margin="{TemplateBinding Padding}"
                            Content="{TemplateBinding Content}"
                            ContentTemplate="{TemplateBinding ContentTemplate}"
                            HorizontalContentAlignment="Stretch"
                            VerticalContentAlignment="{TemplateBinding VerticalContentAlignment}" />
                    </Border>
                </ControlTemplate>
            </Setter>
        </ControlTheme>
    </UserControl.Resources>

    <UserControl.Styles>
        <!--
            Panel item row: transparent full-width button with the table's hover tint;
            the template comes from StretchButtonTheme above.
        -->
        <Style Selector="Button.bar-item">
            <Setter Property="Theme" Value="{DynamicResource StretchButtonTheme}" />
        </Style>
        <Style Selector="Button.bar-item:pointerover">
            <Setter Property="Background" Value="{DynamicResource RowHoverBackgroundBrush}" />
        </Style>
        <!--
            Overview clickable card: the ov-card look on a Button using the same
            stretch template, so the WHOLE card routes to its tab and the hover tint
            covers the full card. Rows inside the recent-activity cards keep their own
            click targets — a press on an inner row button never reaches the card.
        -->
        <Style Selector="Button.ov-card-btn">
            <Setter Property="Theme" Value="{DynamicResource StretchButtonTheme}" />
            <Setter Property="Background" Value="{DynamicResource CardSubtleBackgroundBrush}" />
            <Setter Property="BorderBrush" Value="{DynamicResource HairlineBrush}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="CornerRadius" Value="8" />
            <Setter Property="Padding" Value="12,8" />
            <Setter Property="VerticalContentAlignment" Value="Stretch" />
        </Style>
        <Style Selector="Button.ov-card-btn:pointerover">
            <Setter Property="Background" Value="{DynamicResource RowHoverBackgroundBrush}" />
        </Style>
        <!--  Overview / Git list card: panel background inset card.  -->
        <Style Selector="Border.ov-card">
            <Setter Property="Background" Value="{DynamicResource CardSubtleBackgroundBrush}" />
            <Setter Property="BorderBrush" Value="{DynamicResource HairlineBrush}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="CornerRadius" Value="8" />
            <Setter Property="Padding" Value="12,8" />
        </Style>
        <Style Selector="TextBlock.ov-card-title">
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="Foreground" Value="{DynamicResource TitleForegroundBrush}" />
        </Style>
        <!--
            The strip sits on the window's bottom edge: the branch dropdown must open
            upward. SukiUI 7.0.1's drop-down (PART_Popup) leaves Placement at its Bottom
            default and nothing owns that value programmatically, so a style can flip
            it for this box alone.
        -->
        <Style Selector="ComboBox#BranchPicker /template/ Popup#PART_Popup">
            <Setter Property="Placement" Value="Top" />
        </Style>
        <!--
            Overview stat-card icon badge (Border.stat-badge) lives app-wide in
            AppStyles.axaml so pages share the same vocabulary.
        -->
        <!--  Pull-request state pill (Draft / Approved / Review): fully-rounded tinted
              pill — the Border's Background comes from GitHubStateChipBrushConverter
              ("bg" param) on each row.  -->
        <Style Selector="Border.state-chip">
            <Setter Property="CornerRadius" Value="10" />
            <Setter Property="Padding" Value="8,2" />
            <Setter Property="VerticalAlignment" Value="Center" />
        </Style>
        <!--  GitHub label pill: same pill shape, tinted by GitHubLabelBrushConverter.  -->
        <Style Selector="Border.label-pill">
            <Setter Property="CornerRadius" Value="10" />
            <Setter Property="Padding" Value="8,2" />
            <Setter Property="VerticalAlignment" Value="Center" />
            <Setter Property="Margin" Value="0,0,6,0" />
        </Style>
        <!--
            Changes label in the strip (opens the Changes tab): bare orange icon + text,
            no pill — per the mockup.
        -->
        <Style Selector="Button.bar-chip">
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="Padding" Value="0" />
            <Setter Property="Cursor" Value="Hand" />
        </Style>
        <Style Selector="Button.bar-chip:pointerover /template/ ContentPresenter">
            <Setter Property="Opacity" Value="0.8" />
        </Style>
    </UserControl.Styles>

    <!--  The bar sits inset from the page edges, aligned with the table card above.  -->
    <Grid IsVisible="{Binding IsBarVisible}" Margin="16,0,16,16" RowDefinitions="Auto,Auto">

        <!--  ============ Expandable panel (repo header + active tab's content) ====
              Top half of the docked card: rounded top corners, hairline border on
              three sides (the strip's top hairline closes the card at the middle).  -->
        <Border
            Grid.Row="0"
            Height="{Binding PanelHeight}"
            Background="{DynamicResource CardBackgroundBrush}"
            BorderBrush="{DynamicResource HairlineBrush}"
            BorderThickness="1,1,1,0"
            ClipToBounds="True"
            CornerRadius="{DynamicResource CardRadiusTop}"
            IsVisible="{Binding IsPanelOpen}">
            <Grid Margin="12,8,12,12" RowDefinitions="Auto,*">

                <!--
                    Repo header (mockup): back link, repo name + star, branch / URL
                    line and the tab row — lives INSIDE the panel, above its content.
                -->
                <components:RepoHeader Grid.Row="0" />

                <!--  Overview tab: stat cards, three activity lists, repository details  -->
                <Grid
                    Grid.Row="1"
                    ColumnDefinitions="*,290"
                    ColumnSpacing="10"
                    IsVisible="{Binding IsActiveOverview}">

                    <Grid
                        Grid.Column="0"
                        RowDefinitions="Auto,*"
                        RowSpacing="10">

                        <!--  Stat cards (whole card opens its tab)  -->
                        <UniformGrid
                            Grid.Row="0"
                            Columns="4"
                            IsVisible="{Binding IsAzureDevOpsEnabled}">
                            <Button
                                Grid.Column="0"
                                Margin="0,0,10,0"
                                Classes="ov-card-btn"
                                Command="{Binding ToggleChangesTabCommand}">
                                <StackPanel Orientation="Horizontal" Spacing="12">
                                    <Grid
                                        Width="36"
                                        Height="36"
                                        VerticalAlignment="Top">
                                        <Border Background="{DynamicResource WarningAccentBrush}" Classes="stat-badge" />
                                        <Path
                                            Width="18"
                                            Height="18"
                                            HorizontalAlignment="Center"
                                            VerticalAlignment="Center"
                                            Data="{tools:SvgPath icon-source-branch}"
                                            Fill="{DynamicResource WarningAccentBrush}"
                                            Stretch="Uniform" />
                                    </Grid>
                                    <StackPanel Spacing="2">
                                        <TextBlock
                                            FontSize="22"
                                            FontWeight="Bold"
                                            Foreground="{DynamicResource TitleForegroundBrush}"
                                            Text="{Binding ChangesCount}" />
                                        <TextBlock Classes="subtle" Text="Local Changes" />
                                    </StackPanel>
                                </StackPanel>
                            </Button>
                            <Button
                                Grid.Column="1"
                                Margin="0,0,10,0"
                                Classes="ov-card-btn"
                                Command="{Binding TogglePullRequestsTabCommand}"
                                IsVisible="{Binding IsGitHubEnabled}">
                                <StackPanel Orientation="Horizontal" Spacing="12">
                                    <Grid
                                        Width="36"
                                        Height="36"
                                        VerticalAlignment="Top">
                                        <Border Background="{DynamicResource PurpleAccentBrush}" Classes="stat-badge" />
                                        <Path
                                            Width="18"
                                            Height="18"
                                            HorizontalAlignment="Center"
                                            VerticalAlignment="Center"
                                            Data="{tools:SvgPath icon-git-pull-request}"
                                            Fill="{DynamicResource PurpleAccentBrush}"
                                            Stretch="Uniform" />
                                    </Grid>
                                    <StackPanel Spacing="2">
                                        <TextBlock
                                            FontSize="22"
                                            FontWeight="Bold"
                                            Foreground="{DynamicResource TitleForegroundBrush}"
                                            Text="{Binding PullRequestCount}" />
                                        <TextBlock Classes="subtle" Text="Open Pull Requests" />
                                    </StackPanel>
                                </StackPanel>
                            </Button>
                            <Button
                                Grid.Column="2"
                                Margin="0,0,10,0"
                                Classes="ov-card-btn"
                                Command="{Binding ToggleIssuesTabCommand}"
                                IsVisible="{Binding IsGitHubEnabled}">
                                <StackPanel Orientation="Horizontal" Spacing="12">
                                    <Grid
                                        Width="36"
                                        Height="36"
                                        VerticalAlignment="Top">
                                        <Border Background="{DynamicResource StatusActiveBrush}" Classes="stat-badge" />
                                        <Path
                                            Width="18"
                                            Height="18"
                                            HorizontalAlignment="Center"
                                            VerticalAlignment="Center"
                                            Data="{tools:SvgPath icon-issue}"
                                            Fill="{DynamicResource StatusActiveBrush}"
                                            Stretch="Uniform" />
                                    </Grid>
                                    <StackPanel Spacing="2">
                                        <TextBlock
                                            FontSize="22"
                                            FontWeight="Bold"
                                            Foreground="{DynamicResource TitleForegroundBrush}"
                                            Text="{Binding IssueCount}" />
                                        <TextBlock Classes="subtle" Text="Open Issues" />
                                    </StackPanel>
                                </StackPanel>
                            </Button>
                            <Button
                                Grid.Column="3"
                                Margin="0,0,10,0"
                                Classes="ov-card-btn"
                                Command="{Binding ToggleAzureTabCommand}"
                                IsVisible="{Binding IsAzureDevOpsEnabled}"
                                ToolTip.Tip="Open the Pipelines tab">
                                <StackPanel Orientation="Horizontal" Spacing="12">
                                    <Grid
                                        Width="36"
                                        Height="36"
                                        VerticalAlignment="Top">
                                        <Border Background="{DynamicResource InfoAccentBrush}" Classes="stat-badge" />
                                        <Path
                                            Width="18"
                                            Height="18"
                                            HorizontalAlignment="Center"
                                            VerticalAlignment="Center"
                                            Data="{tools:SvgPath icon-azure-devops}"
                                            Fill="{DynamicResource InfoAccentBrush}"
                                            Stretch="Uniform" />
                                    </Grid>
                                    <StackPanel Spacing="2">
                                        <TextBlock
                                            FontSize="14"
                                            FontWeight="SemiBold"
                                            Foreground="{DynamicResource TitleForegroundBrush}"
                                            Text="{Binding PipelineStatusText}"
                                            TextTrimming="CharacterEllipsis"
                                            ToolTip.Tip="Latest Azure DevOps pipeline results" />
                                        <TextBlock Classes="subtle" Text="Pipelines" />
                                    </StackPanel>
                                </StackPanel>
                            </Button>
                        </UniformGrid>

                        <!--
                            Same cards without the Pipelines slot (Azure DevOps off):
                            a collapsed UniformGrid child keeps its cell, so the
                            three remaining cards need their own 3-column grid.
                        -->
                        <UniformGrid
                            Grid.Row="0"
                            Columns="3"
                            IsVisible="{Binding !IsAzureDevOpsEnabled}">
                            <Button
                                Margin="0,0,10,0"
                                Classes="ov-card-btn"
                                Command="{Binding ToggleChangesTabCommand}">
                                <StackPanel Orientation="Horizontal" Spacing="12">
                                    <Grid
                                        Width="36"
                                        Height="36"
                                        VerticalAlignment="Top">
                                        <Border Background="{DynamicResource WarningAccentBrush}" Classes="stat-badge" />
                                        <Path
                                            Width="18"
                                            Height="18"
                                            HorizontalAlignment="Center"
                                            VerticalAlignment="Center"
                                            Data="{tools:SvgPath icon-source-branch}"
                                            Fill="{DynamicResource WarningAccentBrush}"
                                            Stretch="Uniform" />
                                    </Grid>
                                    <StackPanel Spacing="2">
                                        <TextBlock
                                            FontSize="22"
                                            FontWeight="Bold"
                                            Foreground="{DynamicResource TitleForegroundBrush}"
                                            Text="{Binding ChangesCount}" />
                                        <TextBlock Classes="subtle" Text="Local Changes" />
                                    </StackPanel>
                                </StackPanel>
                            </Button>
                            <Button
                                Margin="0,0,10,0"
                                Classes="ov-card-btn"
                                Command="{Binding TogglePullRequestsTabCommand}"
                                IsVisible="{Binding IsGitHubEnabled}">
                                <StackPanel Orientation="Horizontal" Spacing="12">
                                    <Grid
                                        Width="36"
                                        Height="36"
                                        VerticalAlignment="Top">
                                        <Border Background="{DynamicResource PurpleAccentBrush}" Classes="stat-badge" />
                                        <Path
                                            Width="18"
                                            Height="18"
                                            HorizontalAlignment="Center"
                                            VerticalAlignment="Center"
                                            Data="{tools:SvgPath icon-git-pull-request}"
                                            Fill="{DynamicResource PurpleAccentBrush}"
                                            Stretch="Uniform" />
                                    </Grid>
                                    <StackPanel Spacing="2">
                                        <TextBlock
                                            FontSize="22"
                                            FontWeight="Bold"
                                            Foreground="{DynamicResource TitleForegroundBrush}"
                                            Text="{Binding PullRequestCount}" />
                                        <TextBlock Classes="subtle" Text="Open Pull Requests" />
                                    </StackPanel>
                                </StackPanel>
                            </Button>
                            <Button
                                Margin="0,0,10,0"
                                Classes="ov-card-btn"
                                Command="{Binding ToggleIssuesTabCommand}"
                                IsVisible="{Binding IsGitHubEnabled}">
                                <StackPanel Orientation="Horizontal" Spacing="12">
                                    <Grid
                                        Width="36"
                                        Height="36"
                                        VerticalAlignment="Top">
                                        <Border Background="{DynamicResource StatusActiveBrush}" Classes="stat-badge" />
                                        <Path
                                            Width="18"
                                            Height="18"
                                            HorizontalAlignment="Center"
                                            VerticalAlignment="Center"
                                            Data="{tools:SvgPath icon-issue}"
                                            Fill="{DynamicResource StatusActiveBrush}"
                                            Stretch="Uniform" />
                                    </Grid>
                                    <StackPanel Spacing="2">
                                        <TextBlock
                                            FontSize="22"
                                            FontWeight="Bold"
                                            Foreground="{DynamicResource TitleForegroundBrush}"
                                            Text="{Binding IssueCount}" />
                                        <TextBlock Classes="subtle" Text="Open Issues" />
                                    </StackPanel>
                                </StackPanel>
                            </Button>
                        </UniformGrid>

                        <!--  Activity lists  -->
                        <Grid
                            Grid.Row="1"
                            ColumnDefinitions="3*,3*,3*"
                            ColumnSpacing="10">

                            <!--  Local Changes  -->
                            <Button
                                Grid.Column="0"
                                Classes="ov-card-btn"
                                Command="{Binding ToggleChangesTabCommand}">
                                <DockPanel>
                                    <TextBlock
                                        Margin="0,0,0,4"
                                        Classes="ov-card-title"
                                        DockPanel.Dock="Top"
                                        Text="Local Changes" />
                                    <TextBlock
                                        Margin="0,4,0,0"
                                        Classes="subtle"
                                        DockPanel.Dock="Bottom"
                                        IsVisible="{Binding ShowChangesBadge}"
                                        Text="{Binding ChangesCount, StringFormat='{}{0} changed files'}" />
                                    <ScrollViewer HorizontalScrollBarVisibility="Disabled">
                                        <StackPanel Spacing="10">
                                            <TextBlock
                                                Margin="0,16"
                                                HorizontalAlignment="Center"
                                                Classes="subtle"
                                                IsVisible="{Binding ShowChangesEmpty}"
                                                Text="Working tree is clean" />
                                            <ItemsControl ItemsSource="{Binding ChangedFilesPreview}">
                                                <ItemsControl.ItemTemplate>
                                                    <DataTemplate x:DataType="entities:GitChangedFile">
                                                        <Grid ColumnDefinitions="Auto,*,Auto" ColumnSpacing="8">
                                                            <Border
                                                                Grid.Column="0"
                                                                Width="24"
                                                                Padding="0,1"
                                                                VerticalAlignment="Center"
                                                                Background="{DynamicResource CardBackgroundBrush}"
                                                                BorderBrush="{DynamicResource HairlineBrush}"
                                                                BorderThickness="1"
                                                                CornerRadius="{DynamicResource ChipRadius}">
                                                                <TextBlock
                                                                    HorizontalAlignment="Center"
                                                                    Classes="mono"
                                                                    Foreground="{Binding StatusCode, Converter={StaticResource GitStatusBrushConverter}}"
                                                                    Text="{Binding StatusCode}" />
                                                            </Border>
                                                            <TextBlock
                                                                Grid.Column="1"
                                                                VerticalAlignment="Center"
                                                                Classes="mono"
                                                                Foreground="{DynamicResource BodyForegroundBrush}"
                                                                Text="{Binding Path}"
                                                                TextTrimming="CharacterEllipsis" />
                                                            <TextBlock
                                                                Grid.Column="2"
                                                                VerticalAlignment="Center"
                                                                Classes="mono"
                                                                Foreground="{DynamicResource MutedForegroundBrush}"
                                                                IsVisible="{Binding HasCounts}"
                                                                Text="{Binding DeltaText}" />
                                                        </Grid>
                                                    </DataTemplate>
                                                </ItemsControl.ItemTemplate>
                                            </ItemsControl>
                                        </StackPanel>
                                    </ScrollViewer>
                                </DockPanel>
                            </Button>

                            <!--  Recent Pull Requests  -->
                            <Button
                                Grid.Column="1"
                                Classes="ov-card-btn"
                                Command="{Binding TogglePullRequestsTabCommand}">
                                <DockPanel>
                                    <TextBlock
                                        Margin="0,0,0,4"
                                        Classes="ov-card-title"
                                        DockPanel.Dock="Top"
                                        Text="Recent Pull Requests" />
                                    <ScrollViewer HorizontalScrollBarVisibility="Disabled">
                                        <StackPanel Spacing="10">
                                            <TextBlock
                                                Margin="0,16"
                                                HorizontalAlignment="Center"
                                                Classes="subtle"
                                                IsVisible="{Binding ShowPullRequestsEmpty}"
                                                Text="No open pull requests" />
                                            <ItemsControl ItemsSource="{Binding GitHubPullRequestsPreview}">
                                                <ItemsControl.ItemTemplate>
                                                    <DataTemplate x:DataType="entities:GitHubItem">
                                                        <Button
                                                            Padding="4,5"
                                                            Classes="bar-item"
                                                            Command="{Binding $parent[UserControl].((vm:BottomBarViewModel)DataContext).OpenGitHubItemCommand}"
                                                            CommandParameter="{Binding}"
                                                            ToolTip.Tip="{Binding Url}">
                                                            <Grid ColumnDefinitions="*,Auto,Auto,Auto" ColumnSpacing="8">
                                                                <StackPanel Grid.Column="0" Spacing="1">
                                                                    <!--  Star cell constrains the title so it trims
                                                                          instead of painting over the trailing
                                                                          author/age columns.  -->
                                                                    <Grid ColumnDefinitions="Auto,*" ColumnSpacing="6">
                                                                        <TextBlock
                                                                            FontWeight="SemiBold"
                                                                            Foreground="{DynamicResource TitleForegroundBrush}"
                                                                            Text="{Binding Number, StringFormat='#{0}'}" />
                                                                        <TextBlock
                                                                            Grid.Column="1"
                                                                            Foreground="{DynamicResource TitleForegroundBrush}"
                                                                            Text="{Binding Title}"
                                                                            TextTrimming="CharacterEllipsis" />
                                                                    </Grid>
                                                                    <StackPanel
                                                                        Orientation="Horizontal"
                                                                        Spacing="6"
                                                                        IsVisible="{Binding BranchSummary, Converter={StaticResource StringNullOrEmptyToVisibilityConverter}}">
                                                                        <TextBlock
                                                                            Classes="mono"
                                                                            Foreground="{DynamicResource MutedForegroundBrush}"
                                                                            Text="{Binding HeadRef}" />
                                                                        <TextBlock
                                                                            Classes="mono"
                                                                            Foreground="{DynamicResource AccentPrimaryBrush}"
                                                                            Text="→" />
                                                                        <TextBlock
                                                                            Classes="mono"
                                                                            Foreground="{DynamicResource MutedForegroundBrush}"
                                                                            Text="{Binding BaseRef, TargetNullValue=main}" />
                                                                    </StackPanel>
                                                                </StackPanel>
                                                                <TextBlock
                                                                    Grid.Column="1"
                                                                    VerticalAlignment="Center"
                                                                    Classes="subtle"
                                                                    IsVisible="{Binding Author, Converter={StaticResource StringNullOrEmptyToVisibilityConverter}}"
                                                                    Text="{Binding Author}" />
                                                                <TextBlock
                                                                    Grid.Column="2"
                                                                    VerticalAlignment="Center"
                                                                    Classes="subtle"
                                                                    Text="{Binding AgeText}" />
                                                                <Border
                                                                    Grid.Column="3"
                                                                    Background="{Binding StateChip, Converter={StaticResource GitHubStateChipBrushConverter}, ConverterParameter=bg}"
                                                                    Classes="state-chip"
                                                                    ToolTip.Tip="{Binding StateChip}">
                                                                    <TextBlock
                                                                        FontWeight="SemiBold"
                                                                        Foreground="{Binding StateChip, Converter={StaticResource GitHubStateChipBrushConverter}}"
                                                                        Text="{Binding StateChip}" />
                                                                </Border>
                                                            </Grid>
                                                        </Button>
                                                    </DataTemplate>
                                                </ItemsControl.ItemTemplate>
                                            </ItemsControl>
                                        </StackPanel>
                                    </ScrollViewer>
                                </DockPanel>
                            </Button>

                            <!--  Recent Issues  -->
                            <Button
                                Grid.Column="2"
                                Classes="ov-card-btn"
                                Command="{Binding ToggleIssuesTabCommand}">
                                <DockPanel>
                                    <TextBlock
                                        Margin="0,0,0,4"
                                        Classes="ov-card-title"
                                        DockPanel.Dock="Top"
                                        Text="Recent Issues" />
                                    <ScrollViewer HorizontalScrollBarVisibility="Disabled">
                                        <StackPanel Spacing="10">
                                            <TextBlock
                                                Margin="0,16"
                                                HorizontalAlignment="Center"
                                                Classes="subtle"
                                                IsVisible="{Binding ShowIssuesEmpty}"
                                                Text="No open issues" />
                                            <ItemsControl ItemsSource="{Binding GitHubIssuesPreview}">
                                                <ItemsControl.ItemTemplate>
                                                    <DataTemplate x:DataType="entities:GitHubItem">
                                                        <Button
                                                            Padding="4,5"
                                                            Classes="bar-item"
                                                            Command="{Binding $parent[UserControl].((vm:BottomBarViewModel)DataContext).OpenGitHubItemCommand}"
                                                            CommandParameter="{Binding}"
                                                            ToolTip.Tip="{Binding Url}">
                                                            <Grid ColumnDefinitions="*,Auto,Auto" ColumnSpacing="6">
                                                                <StackPanel Grid.Column="0" Spacing="1">
                                                                    <!--  Star cell constrains the title so it trims
                                                                          instead of painting over the trailing
                                                                          author/age columns.  -->
                                                                    <Grid ColumnDefinitions="Auto,*" ColumnSpacing="6">
                                                                        <TextBlock
                                                                            FontWeight="SemiBold"
                                                                            Foreground="{DynamicResource TitleForegroundBrush}"
                                                                            Text="{Binding Number, StringFormat='#{0}'}" />
                                                                        <TextBlock
                                                                            Grid.Column="1"
                                                                            Foreground="{DynamicResource TitleForegroundBrush}"
                                                                            Text="{Binding Title}"
                                                                            TextTrimming="CharacterEllipsis" />
                                                                    </Grid>
                                                                    <ItemsControl IsVisible="{Binding HasLabels}" ItemsSource="{Binding Labels}">
                                                                        <ItemsControl.ItemsPanel>
                                                                            <ItemsPanelTemplate>
                                                                                <WrapPanel Orientation="Horizontal" />
                                                                            </ItemsPanelTemplate>
                                                                        </ItemsControl.ItemsPanel>
                                                                        <ItemsControl.ItemTemplate>
                                                                            <DataTemplate x:DataType="x:String">
                                                                                <Border
                                                                                    Classes="label-pill"
                                                                                    Background="{Binding Converter={StaticResource GitHubLabelBrushConverter}, ConverterParameter=bg}"
                                                                                    ToolTip.Tip="{Binding}">
                                                                                    <TextBlock
                                                                                        Foreground="{Binding Converter={StaticResource GitHubLabelBrushConverter}}"
                                                                                        Text="{Binding}" />
                                                                                </Border>
                                                                            </DataTemplate>
                                                                        </ItemsControl.ItemTemplate>
                                                                    </ItemsControl>
                                                                </StackPanel>
                                                                <TextBlock
                                                                    Grid.Column="1"
                                                                    VerticalAlignment="Center"
                                                                    Classes="subtle"
                                                                    IsVisible="{Binding Author, Converter={StaticResource StringNullOrEmptyToVisibilityConverter}}"
                                                                    Text="{Binding Author}" />
                                                                <TextBlock
                                                                    Grid.Column="2"
                                                                    VerticalAlignment="Center"
                                                                    Classes="subtle"
                                                                    IsVisible="{Binding AgeText, Converter={StaticResource StringNullOrEmptyToVisibilityConverter}}"
                                                                    Text="{Binding AgeText}" />
                                                            </Grid>
                                                        </Button>
                                                    </DataTemplate>
                                                </ItemsControl.ItemTemplate>
                                            </ItemsControl>
                                        </StackPanel>
                                    </ScrollViewer>
                                </DockPanel>
                            </Button>
                        </Grid>
                    </Grid>

                    <!--  Repository Details sidebar  -->
                    <Border Grid.Column="1" Classes="ov-card">
                        <DockPanel>
                            <TextBlock
                                Margin="0,0,0,6"
                                Classes="ov-card-title"
                                DockPanel.Dock="Top"
                                Text="Repository Details" />
                            <ScrollViewer HorizontalScrollBarVisibility="Disabled">
                                <StackPanel Spacing="8">
                                    <TextBlock
                                        Classes="subtle"
                                        IsVisible="{Binding !HasRepoDetails}"
                                        Text="No GitHub data for this repository"
                                        TextWrapping="Wrap" />
                                    <Grid
                                        ColumnDefinitions="Auto,*"
                                        ColumnSpacing="10"
                                        IsVisible="{Binding HasRepoDetails}">
                                        <Grid.Styles>
                                            <Style Selector="TextBlock.detail-key">
                                                <Setter Property="Foreground" Value="{DynamicResource MutedForegroundBrush}" />
                                            </Style>
                                            <Style Selector="TextBlock.detail-value">
                                                <Setter Property="Foreground" Value="{DynamicResource BodyForegroundBrush}" />
                                            </Style>
                                        </Grid.Styles>
                                        <StackPanel Grid.ColumnSpan="2" Spacing="6">
                                            <Grid
                                                ColumnDefinitions="110,*"
                                                ColumnSpacing="10"
                                                IsVisible="{Binding SelectedRepoDetails?.Owner, Converter={StaticResource StringNullOrEmptyToVisibilityConverter}}">
                                                <TextBlock Classes="detail-key" Text="Owner" />
                                                <TextBlock
                                                    Grid.Column="1"
                                                    Classes="detail-value"
                                                    Text="{Binding SelectedRepoDetails?.Owner}"
                                                    TextTrimming="CharacterEllipsis" />
                                            </Grid>
                                            <Grid
                                                ColumnDefinitions="110,*"
                                                ColumnSpacing="10"
                                                IsVisible="{Binding SelectedRepoDetails?.CreatedAt, Converter={StaticResource NotNullToBoolConverter}}">
                                                <TextBlock Classes="detail-key" Text="Created" />
                                                <TextBlock
                                                    Grid.Column="1"
                                                    Classes="detail-value"
                                                    Text="{Binding SelectedRepoDetails?.CreatedAt, StringFormat='d MMM yyyy'}" />
                                            </Grid>
                                            <Grid
                                                ColumnDefinitions="110,*"
                                                ColumnSpacing="10"
                                                IsVisible="{Binding SelectedRepoDetails?.Language, Converter={StaticResource StringNullOrEmptyToVisibilityConverter}}">
                                                <TextBlock Classes="detail-key" Text="Language" />
                                                <TextBlock
                                                    Grid.Column="1"
                                                    Classes="detail-value"
                                                    Text="{Binding SelectedRepoDetails?.Language}" />
                                            </Grid>
                                            <Grid
                                                ColumnDefinitions="110,*"
                                                ColumnSpacing="10"
                                                IsVisible="{Binding SelectedRepoDetails?.License, Converter={StaticResource StringNullOrEmptyToVisibilityConverter}}">
                                                <TextBlock Classes="detail-key" Text="License" />
                                                <TextBlock
                                                    Grid.Column="1"
                                                    Classes="detail-value"
                                                    Text="{Binding SelectedRepoDetails?.License}" />
                                            </Grid>
                                            <Grid
                                                ColumnDefinitions="110,*"
                                                ColumnSpacing="10"
                                                IsVisible="{Binding SelectedRepoDetails?.DefaultBranch, Converter={StaticResource StringNullOrEmptyToVisibilityConverter}}">
                                                <TextBlock Classes="detail-key" Text="Default Branch" />
                                                <TextBlock
                                                    Grid.Column="1"
                                                    Classes="detail-value"
                                                    Text="{Binding SelectedRepoDetails?.DefaultBranch}" />
                                            </Grid>
                                        </StackPanel>
                                    </Grid>
                                    <!--  Topics chips  -->
                                    <StackPanel IsVisible="{Binding SelectedRepoDetails?.HasTopics, TargetNullValue=False}">
                                        <TextBlock Classes="detail-key" Text="Topics" />
                                        <ItemsControl Margin="0,4,0,0" ItemsSource="{Binding SelectedRepoDetails?.Topics}">
                                            <ItemsControl.ItemsPanel>
                                                <ItemsPanelTemplate>
                                                    <WrapPanel Orientation="Horizontal" />
                                                </ItemsPanelTemplate>
                                            </ItemsControl.ItemsPanel>
                                            <ItemsControl.ItemTemplate>
                                                <DataTemplate x:DataType="x:String">
                                                    <Border
                                                        Margin="0,0,6,6"
                                                        Padding="7,2"
                                                        Classes="chip">
                                                        <TextBlock Classes="subtle" Text="{Binding}" />
                                                    </Border>
                                                </DataTemplate>
                                            </ItemsControl.ItemTemplate>
                                        </ItemsControl>
                                    </StackPanel>
                                </StackPanel>
                            </ScrollViewer>
                        </DockPanel>
                    </Border>
                </Grid>

                <!--  Changes tab  -->
                <DockPanel Grid.Row="1" IsVisible="{Binding IsActiveChanges}">
                    <Grid
                        Margin="0,6,0,4"
                        ColumnDefinitions="*,Auto"
                        DockPanel.Dock="Top">
                        <TextBlock
                            Grid.Column="0"
                            VerticalAlignment="Center"
                            Classes="subtle"
                            Text="{Binding ChangedFiles.Count, StringFormat='{}{0} changed files (working tree, untracked included)'}" />
                        <TextBlock
                            Grid.Column="1"
                            VerticalAlignment="Center"
                            Classes="mono"
                            Foreground="{DynamicResource StatusActiveBrush}"
                            IsVisible="{Binding ChangesDeltaText, Converter={StaticResource StringNullOrEmptyToVisibilityConverter}}"
                            Text="{Binding ChangesDeltaText}" />
                    </Grid>
                    <ScrollViewer HorizontalScrollBarVisibility="Disabled">
                        <StackPanel Spacing="2">
                            <TextBlock
                                Margin="0,24"
                                HorizontalAlignment="Center"
                                Classes="subtle"
                                IsVisible="{Binding ShowChangesEmpty}"
                                Text="No changes — the working tree is clean" />
                            <ItemsControl ItemsSource="{Binding ChangedFiles}">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate x:DataType="entities:GitChangedFile">
                                        <Grid ColumnDefinitions="Auto,*,Auto" ColumnSpacing="10">
                                            <Border
                                                Grid.Column="0"
                                                Width="30"
                                                Padding="0,2"
                                                HorizontalAlignment="Left"
                                                VerticalAlignment="Center"
                                                Background="{DynamicResource CardSubtleBackgroundBrush}"
                                                BorderBrush="{DynamicResource HairlineBrush}"
                                                BorderThickness="1"
                                                CornerRadius="{DynamicResource ChipRadius}">
                                                <TextBlock
                                                    HorizontalAlignment="Center"
                                                    Classes="mono"
                                                    Foreground="{Binding StatusCode, Converter={StaticResource GitStatusBrushConverter}}"
                                                    Text="{Binding StatusCode}" />
                                            </Border>
                                            <TextBlock
                                                Grid.Column="1"
                                                VerticalAlignment="Center"
                                                Classes="mono"
                                                Foreground="{DynamicResource BodyForegroundBrush}"
                                                Text="{Binding Path}"
                                                TextTrimming="CharacterEllipsis" />
                                            <TextBlock
                                                Grid.Column="2"
                                                VerticalAlignment="Center"
                                                Classes="mono"
                                                Foreground="{DynamicResource MutedForegroundBrush}"
                                                IsVisible="{Binding HasCounts}"
                                                Text="{Binding DeltaText}" />
                                        </Grid>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </StackPanel>
                    </ScrollViewer>
                </DockPanel>

                <!--  Pull requests tab  -->
                <DockPanel Grid.Row="1" IsVisible="{Binding IsActivePullRequests}">
                    <Grid
                        Margin="0,6,0,4"
                        ColumnDefinitions="*,Auto,Auto"
                        ColumnSpacing="4"
                        DockPanel.Dock="Top">
                        <TextBlock
                            Grid.Column="0"
                            VerticalAlignment="Center"
                            Classes="subtle"
                            Text="{Binding GitHubPullRequests.Count, StringFormat='{}{0} open pull requests'}" />
                        <Button
                            Grid.Column="1"
                            VerticalAlignment="Center"
                            Classes="icon"
                            Command="{Binding RefreshGitHubCommand}"
                            IsEnabled="{Binding !IsGitHubRefreshing}"
                            ToolTip.Tip="Refresh">
                            <Path Classes="icon" Data="{tools:SvgPath icon-refresh}" />
                        </Button>
                        <Button
                            Grid.Column="2"
                            VerticalAlignment="Center"
                            Classes="icon"
                            Command="{Binding OpenGitHubPullsCommand}"
                            ToolTip.Tip="Open the pull requests page on GitHub">
                            <Path
                                Width="17"
                                Height="17"
                                Data="{tools:SvgPath icon-github}"
                                Fill="{DynamicResource MutedForegroundBrush}"
                                Stretch="Uniform" />
                        </Button>
                    </Grid>
                    <ScrollViewer HorizontalScrollBarVisibility="Disabled">
                        <StackPanel Spacing="2">
                            <TextBlock
                                Margin="0,24"
                                HorizontalAlignment="Center"
                                Classes="subtle"
                                IsVisible="{Binding !GitHubHasLoaded}"
                                Text="Loading…" />
                            <TextBlock
                                Margin="0,24"
                                HorizontalAlignment="Center"
                                Classes="subtle"
                                IsVisible="{Binding ShowPullRequestsEmpty}"
                                Text="No open pull requests" />
                            <TextBlock
                                Margin="0,24"
                                HorizontalAlignment="Center"
                                Classes="subtle"
                                IsVisible="{Binding ShowGitHubUnavailable}"
                                Text="No GitHub data for this repository (is it hosted on GitHub, and is gh authenticated?)" />
                            <ItemsControl ItemsSource="{Binding GitHubPullRequests}">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate x:DataType="entities:GitHubItem">
                                        <Button
                                            Classes="bar-item"
                                            Command="{Binding $parent[UserControl].((vm:BottomBarViewModel)DataContext).OpenGitHubItemCommand}"
                                            CommandParameter="{Binding}"
                                            ToolTip.Tip="{Binding Url}">
                                            <Grid ColumnDefinitions="Auto,*,Auto,Auto,Auto" ColumnSpacing="10">
                                                <Path
                                                    Grid.Column="0"
                                                    Width="15"
                                                    Height="15"
                                                    VerticalAlignment="Center"
                                                    Data="{tools:SvgPath icon-git-pull-request}"
                                                    Fill="{DynamicResource PurpleAccentBrush}"
                                                    Stretch="Uniform" />
                                                <StackPanel
                                                    Grid.Column="1"
                                                    VerticalAlignment="Center"
                                                    Orientation="Vertical"
                                                    Spacing="2">
                                                    <!--  Title line: star cell constrains the title so it
                                                          trims instead of painting over the trailing
                                                          author/age/chip columns.  -->
                                                    <Grid ColumnDefinitions="Auto,*" ColumnSpacing="6">
                                                        <TextBlock
                                                            VerticalAlignment="Center"
                                                            FontSize="13"
                                                            FontWeight="SemiBold"
                                                            Foreground="{DynamicResource TitleForegroundBrush}"
                                                            Text="{Binding Number, StringFormat='#{0}'}" />
                                                        <TextBlock
                                                            Grid.Column="1"
                                                            VerticalAlignment="Center"
                                                            FontSize="13"
                                                            Foreground="{DynamicResource TitleForegroundBrush}"
                                                            Text="{Binding Title}"
                                                            TextTrimming="CharacterEllipsis" />
                                                    </Grid>
                                                    <StackPanel
                                                        Orientation="Horizontal"
                                                        Spacing="6"
                                                        IsVisible="{Binding BranchSummary, Converter={StaticResource StringNullOrEmptyToVisibilityConverter}}">
                                                        <TextBlock
                                                            Classes="mono"
                                                            Foreground="{DynamicResource MutedForegroundBrush}"
                                                            Text="{Binding HeadRef}" />
                                                        <TextBlock
                                                            Classes="mono"
                                                            Foreground="{DynamicResource AccentPrimaryBrush}"
                                                            Text="→" />
                                                        <TextBlock
                                                            Classes="mono"
                                                            Foreground="{DynamicResource MutedForegroundBrush}"
                                                            Text="{Binding BaseRef, TargetNullValue=main}" />
                                                    </StackPanel>
                                                    <ItemsControl IsVisible="{Binding HasLabels}" ItemsSource="{Binding Labels}">
                                                        <ItemsControl.ItemsPanel>
                                                            <ItemsPanelTemplate>
                                                                <WrapPanel Orientation="Horizontal" />
                                                            </ItemsPanelTemplate>
                                                        </ItemsControl.ItemsPanel>
                                                        <ItemsControl.ItemTemplate>
                                                            <DataTemplate x:DataType="x:String">
                                                                <Border
                                                                    Classes="label-pill"
                                                                    Background="{Binding Converter={StaticResource GitHubLabelBrushConverter}, ConverterParameter=bg}"
                                                                    ToolTip.Tip="{Binding}">
                                                                    <TextBlock
                                                                        Foreground="{Binding Converter={StaticResource GitHubLabelBrushConverter}}"
                                                                        Text="{Binding}" />
                                                                </Border>
                                                            </DataTemplate>
                                                        </ItemsControl.ItemTemplate>
                                                    </ItemsControl>
                                                </StackPanel>
                                                <TextBlock
                                                    Grid.Column="2"
                                                    VerticalAlignment="Center"
                                                    Classes="subtle"
                                                    IsVisible="{Binding Author, Converter={StaticResource StringNullOrEmptyToVisibilityConverter}}"
                                                    Text="{Binding Author}" />
                                                <TextBlock
                                                    Grid.Column="3"
                                                    VerticalAlignment="Center"
                                                    Classes="subtle"
                                                    IsVisible="{Binding AgeText, Converter={StaticResource StringNullOrEmptyToVisibilityConverter}}"
                                                    Text="{Binding AgeText}" />
                                                <Border
                                                    Grid.Column="4"
                                                    Classes="state-chip"
                                                    Background="{Binding StateChip, Converter={StaticResource GitHubStateChipBrushConverter}, ConverterParameter=bg}"
                                                    ToolTip.Tip="{Binding StateChip}">
                                                    <TextBlock
                                                        FontWeight="SemiBold"
                                                        Foreground="{Binding StateChip, Converter={StaticResource GitHubStateChipBrushConverter}}"
                                                        Text="{Binding StateChip}" />
                                                </Border>
                                            </Grid>
                                        </Button>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </StackPanel>
                    </ScrollViewer>
                </DockPanel>

                <!--  Issues tab  -->
                <DockPanel Grid.Row="1" IsVisible="{Binding IsActiveIssues}">
                    <Grid
                        Margin="0,6,0,4"
                        ColumnDefinitions="*,Auto,Auto"
                        ColumnSpacing="4"
                        DockPanel.Dock="Top">
                        <TextBlock
                            Grid.Column="0"
                            VerticalAlignment="Center"
                            Classes="subtle"
                            Text="{Binding GitHubIssues.Count, StringFormat='{}{0} open issues'}" />
                        <Button
                            Grid.Column="1"
                            VerticalAlignment="Center"
                            Classes="icon"
                            Command="{Binding RefreshGitHubCommand}"
                            IsEnabled="{Binding !IsGitHubRefreshing}"
                            ToolTip.Tip="Refresh">
                            <Path Classes="icon" Data="{tools:SvgPath icon-refresh}" />
                        </Button>
                        <Button
                            Grid.Column="2"
                            VerticalAlignment="Center"
                            Classes="icon"
                            Command="{Binding OpenGitHubIssuesCommand}"
                            ToolTip.Tip="Open the issues page on GitHub">
                            <Path
                                Width="17"
                                Height="17"
                                Data="{tools:SvgPath icon-github}"
                                Fill="{DynamicResource MutedForegroundBrush}"
                                Stretch="Uniform" />
                        </Button>
                    </Grid>
                    <ScrollViewer HorizontalScrollBarVisibility="Disabled">
                        <StackPanel Spacing="2">
                            <TextBlock
                                Margin="0,24"
                                HorizontalAlignment="Center"
                                Classes="subtle"
                                IsVisible="{Binding !GitHubHasLoaded}"
                                Text="Loading…" />
                            <TextBlock
                                Margin="0,24"
                                HorizontalAlignment="Center"
                                Classes="subtle"
                                IsVisible="{Binding ShowIssuesEmpty}"
                                Text="No open issues" />
                            <TextBlock
                                Margin="0,24"
                                HorizontalAlignment="Center"
                                Classes="subtle"
                                IsVisible="{Binding ShowGitHubUnavailable}"
                                Text="No GitHub data for this repository (is it hosted on GitHub, and is gh authenticated?)" />
                                            <ItemsControl ItemsSource="{Binding GitHubIssues}">
                                                <ItemsControl.ItemTemplate>
                                                    <DataTemplate x:DataType="entities:GitHubItem">
                                                        <Button
                                                            Classes="bar-item"
                                                            Command="{Binding $parent[UserControl].((vm:BottomBarViewModel)DataContext).OpenGitHubItemCommand}"
                                                            CommandParameter="{Binding}"
                                                            ToolTip.Tip="{Binding Url}">
                                                            <Grid ColumnDefinitions="Auto,*,Auto,Auto,Auto" ColumnSpacing="10">
                                                                <Path
                                                                    Grid.Column="0"
                                                                    Width="15"
                                                                    Height="15"
                                                                    VerticalAlignment="Center"
                                                                    Data="{tools:SvgPath icon-issue}"
                                                                    Fill="{DynamicResource WarningAccentBrush}"
                                                                    Stretch="Uniform" />
                                                                <!--  One line: number + title, then the tag
                                                                      pills, the author and the relative age.
                                                                      The title lives in a star grid cell (not a
                                                                      horizontal StackPanel, which measures at
                                                                      infinite width and would never trim).  -->
                                                                <Grid
                                                                    Grid.Column="1"
                                                                    ColumnDefinitions="Auto,*"
                                                                    ColumnSpacing="6">
                                                                    <TextBlock
                                                                        VerticalAlignment="Center"
                                                                        FontSize="13"
                                                                        FontWeight="SemiBold"
                                                                        Foreground="{DynamicResource TitleForegroundBrush}"
                                                                        Text="{Binding Number, StringFormat='#{0}'}" />
                                                                    <TextBlock
                                                                        Grid.Column="1"
                                                                        VerticalAlignment="Center"
                                                                        FontSize="13"
                                                                        Foreground="{DynamicResource TitleForegroundBrush}"
                                                                        Text="{Binding Title}"
                                                                        TextTrimming="CharacterEllipsis" />
                                                                </Grid>
                                                                <ItemsControl
                                                                    Grid.Column="2"
                                                                    VerticalAlignment="Center"
                                                                    ClipToBounds="True"
                                                                    IsVisible="{Binding HasLabels}"
                                                                    ItemsSource="{Binding Labels}"
                                                                    MaxWidth="260">
                                                                    <ItemsControl.ItemsPanel>
                                                                        <ItemsPanelTemplate>
                                                                            <StackPanel Orientation="Horizontal" />
                                                                        </ItemsPanelTemplate>
                                                                    </ItemsControl.ItemsPanel>
                                                                    <ItemsControl.ItemTemplate>
                                                                        <DataTemplate x:DataType="x:String">
                                                                            <Border
                                                                                Classes="label-pill"
                                                                                Background="{Binding Converter={StaticResource GitHubLabelBrushConverter}, ConverterParameter=bg}"
                                                                                ToolTip.Tip="{Binding}">
                                                                                <TextBlock
                                                                                    Foreground="{Binding Converter={StaticResource GitHubLabelBrushConverter}}"
                                                                                    Text="{Binding}" />
                                                                            </Border>
                                                                        </DataTemplate>
                                                                    </ItemsControl.ItemTemplate>
                                                                </ItemsControl>
                                                                <TextBlock
                                                                    Grid.Column="3"
                                                                    VerticalAlignment="Center"
                                                                    Classes="subtle"
                                                                    IsVisible="{Binding Author, Converter={StaticResource StringNullOrEmptyToVisibilityConverter}}"
                                                                    Text="{Binding Author}" />
                                                                <TextBlock
                                                                    Grid.Column="4"
                                                                    VerticalAlignment="Center"
                                                                    Classes="subtle"
                                                                    IsVisible="{Binding AgeText, Converter={StaticResource StringNullOrEmptyToVisibilityConverter}}"
                                                                    Text="{Binding AgeText}" />
                                                            </Grid>
                                                        </Button>
                                                    </DataTemplate>
                                                </ItemsControl.ItemTemplate>
                                            </ItemsControl>
                                        </StackPanel>
                                    </ScrollViewer>
                                </DockPanel>

                                <!--  Azure DevOps tab: pull requests, work items, pipeline runs  -->
                <DockPanel Grid.Row="1" IsVisible="{Binding IsActiveAzure}">
                    <Grid
                        Margin="0,6,0,4"
                        ColumnDefinitions="*,Auto,Auto"
                        ColumnSpacing="4"
                        DockPanel.Dock="Top">
                        <TextBlock
                            Grid.Column="0"
                            VerticalAlignment="Center"
                            Classes="subtle"
                            Text="Active pull requests, open work items and recent pipeline runs" />
                        <Button
                            Grid.Column="1"
                            VerticalAlignment="Center"
                            Classes="icon"
                            Command="{Binding RefreshAzureCommand}"
                            IsEnabled="{Binding !IsAzureRefreshing}"
                            ToolTip.Tip="Refresh">
                            <Path Classes="icon" Data="{tools:SvgPath icon-refresh}" />
                        </Button>
                        <Button
                            Grid.Column="2"
                            VerticalAlignment="Center"
                            Classes="icon"
                            Command="{Binding OpenAzureRepoCommand}"
                            ToolTip.Tip="Open the repository in Azure DevOps">
                            <Path
                                Width="17"
                                Height="17"
                                Data="{tools:SvgPath icon-azure-devops}"
                                Fill="{DynamicResource MutedForegroundBrush}"
                                Stretch="Uniform" />
                        </Button>
                    </Grid>
                    <ScrollViewer HorizontalScrollBarVisibility="Disabled">
                        <StackPanel Spacing="2">
                            <TextBlock
                                Margin="0,24"
                                HorizontalAlignment="Center"
                                Classes="subtle"
                                IsVisible="{Binding !AzureHasLoaded}"
                                Text="Loading…" />
                            <TextBlock
                                Margin="0,24"
                                HorizontalAlignment="Center"
                                Classes="subtle"
                                IsVisible="{Binding ShowAzureEmpty}"
                                Text="Nothing open — no pull requests, work items or pipeline runs" />
                            <TextBlock
                                Margin="0,24"
                                HorizontalAlignment="Center"
                                Classes="subtle"
                                IsVisible="{Binding ShowAzureUnavailable}"
                                Text="No Azure DevOps data for this repository (is it hosted on Azure DevOps, and is a token configured?)" />

                            <!--  Pull requests section  -->
                            <StackPanel IsVisible="{Binding HasAzurePullRequests}" Spacing="2">
                                <TextBlock
                                    Margin="4,4,0,0"
                                    Classes="field-label"
                                    Text="{Binding AzurePullRequests.Count, StringFormat='Pull Requests ({0})'}" />
                                <ItemsControl ItemsSource="{Binding AzurePullRequests}">
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate x:DataType="entities:AzureDevOpsItem">
                                            <Button
                                                Classes="bar-item"
                                                Command="{Binding $parent[UserControl].((vm:BottomBarViewModel)DataContext).OpenAzureItemCommand}"
                                                CommandParameter="{Binding}"
                                                ToolTip.Tip="{Binding Url}">
                                                <Grid ColumnDefinitions="Auto,*,Auto" ColumnSpacing="10">
                                                    <Path
                                                        Grid.Column="0"
                                                        Width="15"
                                                        Height="15"
                                                        VerticalAlignment="Center"
                                                        Data="{tools:SvgPath icon-git-pull-request}"
                                                        Fill="{DynamicResource StatusActiveBrush}"
                                                        Stretch="Uniform" />
                                                    <StackPanel
                                                        Grid.Column="1"
                                                        VerticalAlignment="Center"
                                                        Orientation="Horizontal"
                                                        Spacing="6">
                                                        <TextBlock
                                                            VerticalAlignment="Center"
                                                            FontSize="13"
                                                            FontWeight="SemiBold"
                                                            Foreground="{DynamicResource TitleForegroundBrush}"
                                                            Text="{Binding Number, StringFormat='#{0}'}" />
                                                        <TextBlock
                                                            VerticalAlignment="Center"
                                                            FontSize="13"
                                                            Foreground="{DynamicResource TitleForegroundBrush}"
                                                            Text="{Binding Title}"
                                                            TextTrimming="CharacterEllipsis" />
                                                    </StackPanel>
                                                    <TextBlock
                                                        Grid.Column="2"
                                                        VerticalAlignment="Center"
                                                        Classes="subtle"
                                                        IsVisible="{Binding Author, Converter={StaticResource StringNullOrEmptyToVisibilityConverter}}"
                                                        Text="{Binding Author}" />
                                                </Grid>
                                            </Button>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                            </StackPanel>

                            <!--  Work items section  -->
                            <StackPanel IsVisible="{Binding HasAzureWorkItems}" Spacing="2">
                                <TextBlock
                                    Margin="4,8,0,0"
                                    Classes="field-label"
                                    Text="{Binding AzureWorkItems.Count, StringFormat='Work Items ({0})'}" />
                                <ItemsControl ItemsSource="{Binding AzureWorkItems}">
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate x:DataType="entities:AzureDevOpsItem">
                                            <Button
                                                Classes="bar-item"
                                                Command="{Binding $parent[UserControl].((vm:BottomBarViewModel)DataContext).OpenAzureItemCommand}"
                                                CommandParameter="{Binding}"
                                                ToolTip.Tip="{Binding Url}">
                                                <Grid ColumnDefinitions="Auto,*,Auto,Auto" ColumnSpacing="10">
                                                    <Path
                                                        Grid.Column="0"
                                                        Width="15"
                                                        Height="15"
                                                        VerticalAlignment="Center"
                                                        Data="{tools:SvgPath icon-issue}"
                                                        Fill="{DynamicResource WarningAccentBrush}"
                                                        Stretch="Uniform" />
                                                    <TextBlock
                                                        Grid.Column="1"
                                                        VerticalAlignment="Center"
                                                        FontSize="13"
                                                        FontWeight="SemiBold"
                                                        Foreground="{DynamicResource TitleForegroundBrush}"
                                                        Text="{Binding Number, StringFormat='#{0}'}" />
                                                    <TextBlock
                                                        Grid.Column="2"
                                                        VerticalAlignment="Center"
                                                        FontSize="13"
                                                        Foreground="{DynamicResource TitleForegroundBrush}"
                                                        Text="{Binding Title}"
                                                        TextTrimming="CharacterEllipsis" />
                                                    <TextBlock
                                                        Grid.Column="3"
                                                        VerticalAlignment="Center"
                                                        Classes="subtle"
                                                        Text="{Binding State}" />
                                                </Grid>
                                            </Button>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                            </StackPanel>

                            <!--  Pipeline runs section  -->
                            <StackPanel IsVisible="{Binding HasAzurePipelineRuns}" Spacing="2">
                                <TextBlock
                                    Margin="4,8,0,0"
                                    Classes="field-label"
                                    Text="Pipeline Runs" />
                                <ItemsControl ItemsSource="{Binding AzurePipelineRuns}">
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate x:DataType="entities:AzureDevOpsPipelineRun">
                                            <Button
                                                Classes="bar-item"
                                                Command="{Binding $parent[UserControl].((vm:BottomBarViewModel)DataContext).OpenAzurePipelineCommand}"
                                                CommandParameter="{Binding}"
                                                ToolTip.Tip="{Binding Url}">
                                                <Grid ColumnDefinitions="Auto,*,Auto" ColumnSpacing="10">
                                                    <Path
                                                        Grid.Column="0"
                                                        Width="15"
                                                        Height="15"
                                                        VerticalAlignment="Center"
                                                        Data="{tools:SvgPath icon-play}"
                                                        Fill="{Binding IsFailed, Converter={StaticResource BoolToBrushConverter}}"
                                                        Stretch="Uniform" />
                                                    <StackPanel
                                                        Grid.Column="1"
                                                        VerticalAlignment="Center"
                                                        Orientation="Horizontal"
                                                        Spacing="6">
                                                        <TextBlock
                                                            VerticalAlignment="Center"
                                                            FontSize="13"
                                                            FontWeight="SemiBold"
                                                            Foreground="{DynamicResource TitleForegroundBrush}"
                                                            Text="{Binding BuildNumber, StringFormat='Build #{0}'}" />
                                                        <TextBlock
                                                            VerticalAlignment="Center"
                                                            FontSize="13"
                                                            Foreground="{DynamicResource TitleForegroundBrush}"
                                                            Text="{Binding DefinitionName}"
                                                            TextTrimming="CharacterEllipsis" />
                                                        <TextBlock
                                                            VerticalAlignment="Center"
                                                            Classes="subtle"
                                                            Text="{Binding DisplayBranch, StringFormat='· {0}'}" />
                                                    </StackPanel>
                                                    <TextBlock
                                                        Grid.Column="2"
                                                        VerticalAlignment="Center"
                                                        Classes="subtle"
                                                        FontWeight="SemiBold"
                                                        Foreground="{Binding IsFailed, Converter={StaticResource BoolToBrushConverter}}"
                                                        Text="{Binding Result}" />
                                                </Grid>
                                            </Button>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                            </StackPanel>
                        </StackPanel>
                    </ScrollViewer>
                </DockPanel>

                <!--  Git tab: local branches (click to check out) + recent commits  -->
                <DockPanel Grid.Row="1" IsVisible="{Binding IsActiveGit}">
                    <TextBlock
                        Margin="0,6,0,4"
                        VerticalAlignment="Center"
                        Classes="subtle"
                        DockPanel.Dock="Top"
                        Text="Local branches (click to check out) and the last 10 commits" />
                    <Grid ColumnDefinitions="Auto,17,*" ColumnSpacing="0">

                        <!--  Branches  -->
                        <ScrollViewer Grid.Column="0" Width="220">
                            <StackPanel Spacing="2">
                                <ItemsControl ItemsSource="{Binding Branches}">
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate x:DataType="x:String">
                                            <Button
                                                Padding="6,4"
                                                Classes="bar-item"
                                                Command="{Binding $parent[UserControl].((vm:BottomBarViewModel)DataContext).CheckoutBranchCommand}"
                                                CommandParameter="{Binding}"
                                                ToolTip.Tip="Check out this branch">
                                                <Grid ColumnDefinitions="Auto,*" ColumnSpacing="6">
                                                    <Path
                                                        Grid.Column="0"
                                                        Width="12"
                                                        Height="12"
                                                        VerticalAlignment="Center"
                                                        Data="{tools:SvgPath icon-source-branch}"
                                                        Fill="{Binding $parent[UserControl].((vm:BottomBarViewModel)DataContext).SelectedBranch, Converter={StaticResource BranchChipBrushConverter}, ConverterParameter=bg}"
                                                        Stretch="Uniform" />
                                                    <TextBlock
                                                        Grid.Column="1"
                                                        VerticalAlignment="Center"
                                                        Classes="mono"
                                                        Foreground="{DynamicResource BodyForegroundBrush}"
                                                        Text="{Binding}"
                                                        TextTrimming="CharacterEllipsis" />
                                                </Grid>
                                            </Button>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                            </StackPanel>
                        </ScrollViewer>

                        <Border
                            Grid.Column="1"
                            Width="1"
                            Margin="8,0"
                            Background="{DynamicResource HairlineBrush}" />

                        <!--  Recent commits  -->
                        <ScrollViewer Grid.Column="2">
                            <StackPanel Spacing="2">
                                <TextBlock
                                    Margin="0,16"
                                    HorizontalAlignment="Center"
                                    Classes="subtle"
                                    IsVisible="{Binding ShowCommitsEmpty}"
                                    Text="No commits found" />
                                <ItemsControl ItemsSource="{Binding GitCommits}">
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate x:DataType="entities:GitCommitInfo">
                                            <Grid ColumnDefinitions="Auto,*,Auto,Auto" ColumnSpacing="10">
                                                <TextBlock
                                                    Grid.Column="0"
                                                    VerticalAlignment="Center"
                                                    Classes="mono"
                                                    Foreground="{DynamicResource AccentPrimaryBrush}"
                                                    Text="{Binding ShortHash}" />
                                                <TextBlock
                                                    Grid.Column="1"
                                                    VerticalAlignment="Center"
                                                    Foreground="{DynamicResource BodyForegroundBrush}"
                                                    Text="{Binding Subject}"
                                                    TextTrimming="CharacterEllipsis" />
                                                <TextBlock
                                                    Grid.Column="2"
                                                    VerticalAlignment="Center"
                                                    Classes="subtle"
                                                    IsVisible="{Binding Author, Converter={StaticResource StringNullOrEmptyToVisibilityConverter}}"
                                                    Text="{Binding Author}" />
                                                <TextBlock
                                                    Grid.Column="3"
                                                    VerticalAlignment="Center"
                                                    Classes="subtle"
                                                    IsVisible="{Binding RelativeTime, Converter={StaticResource StringNullOrEmptyToVisibilityConverter}}"
                                                    Text="{Binding RelativeTime}" />
                                            </Grid>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                            </StackPanel>
                        </ScrollViewer>
                    </Grid>
                </DockPanel>
            </Grid>
        </Border>

        <!--  ============ Strip (git context + Fetch; hidden with the whole bar) ====
              Bottom half of the docked card: rounded bottom corners, hairline border
              on three sides, DividerBrush hairline on top separating it from the panel.
              The extra height (over the 40px it replaced) gives the branch dropdown,
              Fetch and last-fetched row breathing room — biased to the top so the row
              clears the panel's hairline above.  -->
        <Border
            Grid.Row="1"
            Height="56"
            Background="{DynamicResource CardBackgroundBrush}"
            BorderBrush="{DynamicResource DividerBrush}"
            BorderThickness="0,1,1,1"
            ClipToBounds="True"
            CornerRadius="{DynamicResource CardRadiusBottom}">
            <Grid
                Margin="12,6,12,2"
                ColumnDefinitions="Auto,Auto,*,Auto"
                ColumnSpacing="14">

                <!--
                    Branch dropdown — the strip's left edge per the mockup: outlined
                    box with a branch icon + name; picking an entry checks it out.
                -->
                <ComboBox
                    x:Name="BranchPicker"
                    Grid.Column="0"
                    Height="30"
                    MinWidth="88"
                    MaxWidth="200"
                    VerticalAlignment="Center"
                    Background="Transparent"
                    BorderBrush="{DynamicResource HairlineBrush}"
                    BorderThickness="1"
                    CornerRadius="6"
                    ItemsSource="{Binding Branches}"
                    PlaceholderText="branch"
                    SelectedItem="{Binding SelectedBranch, Mode=OneWay}"
                    SelectionChanged="OnBranchSelectionChanged"
                    ToolTip.Tip="Current branch — pick another to check it out">
                    <ComboBox.ItemTemplate>
                        <DataTemplate x:DataType="x:String">
                            <StackPanel Orientation="Horizontal" Spacing="6">
                                <Path
                                    Width="12"
                                    Height="12"
                                    Data="{tools:SvgPath icon-source-branch}"
                                    Fill="{DynamicResource MutedForegroundBrush}"
                                    Stretch="Uniform" />
                                <!--
                                    Explicit foreground: SukiUI brightens only TextBlocks that
                                    are the ComboBoxItem's DIRECT content; inside this
                                    StackPanel the inherited popup color is too dim.
                                -->
                                <TextBlock Foreground="{DynamicResource BodyForegroundBrush}" Text="{Binding}" />
                            </StackPanel>
                        </DataTemplate>
                    </ComboBox.ItemTemplate>
                </ComboBox>

                <!--  Changes label — bare orange "N changes" (mockup); opens Changes.  -->
                <Button
                    Grid.Column="1"
                    Classes="bar-chip"
                    Command="{Binding ToggleChangesTabCommand}"
                    IsVisible="{Binding ShowChangesBadge}"
                    ToolTip.Tip="Working-tree changes — click to list them">
                    <StackPanel Orientation="Horizontal" Spacing="6">
                        <Path
                            Width="12"
                            Height="12"
                            VerticalAlignment="Center"
                            Data="{tools:SvgPath icon-source-branch}"
                            Fill="{DynamicResource WarningAccentBrush}"
                            Stretch="Uniform" />
                        <TextBlock
                            VerticalAlignment="Center"
                            FontWeight="SemiBold"
                            Foreground="{DynamicResource WarningAccentBrush}"
                            Text="{Binding ChangesChipText}" />
                    </StackPanel>
                </Button>

                <!--
                    Fetch + last fetched (pinned right, mockup): outlined Fetch button
                    with a cloud-download icon, then the status dot + relative label.
                    (The tab row moved up into the RepoHeader.)
                -->
                <StackPanel
                    Grid.Column="3"
                    VerticalAlignment="Center"
                    IsVisible="{Binding HasSelectedRepo}"
                    Orientation="Horizontal"
                    Spacing="10">
                    <!--  Plain default button (Browse…-style native hover).  -->
                    <Button Command="{Binding FetchCommand}" ToolTip.Tip="git fetch --prune for the selected repository">
                        <StackPanel Orientation="Horizontal" Spacing="6">
                            <Path
                                Width="13"
                                Height="13"
                                VerticalAlignment="Center"
                                Classes="icon"
                                Data="{tools:SvgPath icon-cloud-download}" />
                            <TextBlock VerticalAlignment="Center" Text="Fetch" />
                        </StackPanel>
                    </Button>
                    <StackPanel
                        VerticalAlignment="Center"
                        Orientation="Horizontal"
                        Spacing="8">
                        <Border
                            Width="7"
                            Height="7"
                            VerticalAlignment="Center"
                            Background="{Binding HasFetched, Converter={StaticResource BoolToBrushConverter}}"
                            CornerRadius="4" />
                        <TextBlock
                            VerticalAlignment="Center"
                            Foreground="{DynamicResource BodyForegroundBrush}"
                            Text="{Binding LastFetchText, TargetNullValue='Not fetched'}" />
                    </StackPanel>
                </StackPanel>
            </Grid>
        </Border>
    </Grid>
</UserControl>
