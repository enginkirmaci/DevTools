<?xml version="1.0" encoding="utf-8" ?>
<UserControl
    x:Class="Tools.Views.Components.BottomBar"
    xmlns="https://github.com/avaloniaui"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:components="using:Tools.Views.Components"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:entities="using:Tools.Library.Entities"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:tools="using:Tools.Library.MarkupExtensions"
    xmlns:vm="using:Tools.ViewModels.Components"
    d:DesignHeight="280"
    d:DesignWidth="1200"
    x:CompileBindings="True"
    x:DataType="vm:BottomBarViewModel"
    mc:Ignorable="d">

    <!--
        Bottom bar: the expandable panel with the active tab's content (Overview,
        Changes, Pull Requests, Issues, Pipelines). The whole control stays hidden
        until a repo is selected from the table: a row press or a row chip reveals
        it (IsBarVisible); the header's X hides it again. The tab row lives in the
        RepoHeader inside the panel; the git context (branch dropdown + Fetch +
        last-fetched) lives in the Changes tab's toolbar row — the old bottom strip
        that held them is gone. Chrome matches the floating tool drawer: one docked
        card (CardBackgroundBrush surface, HairlineBrush border, CardRadius corners)
        that lives in the page layout — the table shrinks around it, nothing floats
        over the page. The bar lives on the Repositories page (it is that page's
        footer), not on every page.
    -->
    <!--
        Stretch button theme: replaces SukiUI's Button template for the bar's clickable
        surfaces (list rows + Overview cards). SukiUI's own template renders the
        content presenter content-sized even when the button stretches, so rows hug
        left and their trailing age/chip columns drift with the text length instead of
        pinning to the row's right edge, and card hovers only cover the content. This
        template stretches one Border + ContentPresenter across the whole button; the
        hover tint rides on Button.Background (TemplateBinding), so no template-part
        targeting is needed.
    -->
    <UserControl.Resources>
        <ControlTheme x:Key="StretchButtonTheme" TargetType="Button">
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="Padding" Value="10,7" />
            <Setter Property="CornerRadius" Value="6" />
            <Setter Property="HorizontalAlignment" Value="Stretch" />
            <Setter Property="HorizontalContentAlignment" Value="Stretch" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Template">
                <ControlTemplate>
                    <Border
                        Background="{TemplateBinding Background}"
                        BorderBrush="{TemplateBinding BorderBrush}"
                        BorderThickness="{TemplateBinding BorderThickness}"
                        CornerRadius="{TemplateBinding CornerRadius}">
                        <ContentPresenter
                            Margin="{TemplateBinding Padding}"
                            Content="{TemplateBinding Content}"
                            ContentTemplate="{TemplateBinding ContentTemplate}"
                            HorizontalContentAlignment="Stretch"
                            VerticalContentAlignment="{TemplateBinding VerticalContentAlignment}" />
                    </Border>
                </ControlTemplate>
            </Setter>
        </ControlTheme>
    </UserControl.Resources>

    <UserControl.Styles>
        <!--
            Panel item row: transparent full-width button with the table's hover tint;
            the template comes from StretchButtonTheme above.
        -->
        <Style Selector="Button.bar-item">
            <Setter Property="Theme" Value="{DynamicResource StretchButtonTheme}" />
        </Style>
        <Style Selector="Button.bar-item:pointerover">
            <Setter Property="Background" Value="{DynamicResource RowHoverBackgroundBrush}" />
        </Style>
        <!--  Quiet accent link (like RepoHeader's header-link): transparent, no box —
              the text plus the open-in-new glyph is the affordance.  -->
        <Style Selector="Button.detail-link">
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="Padding" Value="0" />
            <Setter Property="Cursor" Value="Hand" />
        </Style>
        <Style Selector="Button.detail-link:pointerover /template/ ContentPresenter">
            <Setter Property="Opacity" Value="0.8" />
        </Style>
        <!--
            Overview clickable card: the ov-card look on a Button using the same
            stretch template, so the WHOLE card routes to its tab and the hover tint
            covers the full card. Rows inside the recent-activity cards keep their own
            click targets — a press on an inner row button never reaches the card.
        -->
        <Style Selector="Button.ov-card-btn">
            <Setter Property="Theme" Value="{DynamicResource StretchButtonTheme}" />
            <Setter Property="Background" Value="{DynamicResource CardSubtleBackgroundBrush}" />
            <Setter Property="BorderBrush" Value="{DynamicResource HairlineBrush}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="CornerRadius" Value="8" />
            <Setter Property="Padding" Value="12,8" />
            <Setter Property="VerticalContentAlignment" Value="Stretch" />
        </Style>
        <Style Selector="Button.ov-card-btn:pointerover">
            <Setter Property="Background" Value="{DynamicResource RowHoverBackgroundBrush}" />
        </Style>
        <!--  Overview / Git list card: panel background inset card.  -->
        <Style Selector="Border.ov-card">
            <Setter Property="Background" Value="{DynamicResource CardSubtleBackgroundBrush}" />
            <Setter Property="BorderBrush" Value="{DynamicResource HairlineBrush}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="CornerRadius" Value="8" />
            <Setter Property="Padding" Value="12,8" />
        </Style>
        <Style Selector="TextBlock.ov-card-title">
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="Foreground" Value="{DynamicResource TitleForegroundBrush}" />
        </Style>
        <!--
            Overview stat-card icon badge (Border.stat-badge) lives app-wide in
            AppStyles.axaml so pages share the same vocabulary.
        -->
        <!--  Pull-request state pill (Draft / Approved / Review): fully-rounded tinted
              pill — the Border's Background comes from GitHubStateChipBrushConverter
              ("bg" param) on each row.  -->
        <Style Selector="Border.state-chip">
            <Setter Property="CornerRadius" Value="10" />
            <Setter Property="Padding" Value="8,2" />
            <Setter Property="VerticalAlignment" Value="Center" />
        </Style>
        <!--  GitHub label pill: same pill shape, tinted by GitHubLabelBrushConverter.  -->
        <Style Selector="Border.label-pill">
            <Setter Property="CornerRadius" Value="10" />
            <Setter Property="Padding" Value="8,2" />
            <Setter Property="VerticalAlignment" Value="Center" />
            <Setter Property="Margin" Value="0,0,6,0" />
        </Style>
        <!--
            Commit-message wand: a bare icon floating over the message box's corner —
            transparent so the TextBox shows through, dimming on hover like the other
            quiet buttons.
        -->
        <Style Selector="Button.wand-btn">
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="Padding" Value="4" />
            <Setter Property="Cursor" Value="Hand" />
        </Style>
        <Style Selector="Button.wand-btn:pointerover /template/ ContentPresenter">
            <Setter Property="Opacity" Value="0.8" />
        </Style>
    </UserControl.Styles>

    <!--  The bar sits inset from the page edges, aligned with the table card above.  -->
    <Grid IsVisible="{Binding IsBarVisible}" Margin="16,0,16,16" RowDefinitions="Auto,Auto">

        <!--  ============ Panel-top drag divider ====
              Three grip dots between the repo table and the bar; the WHOLE row (not just
              the dots) is the drag surface and resizes the expanded panel (the table
              above shrinks/grows to match). Visible whenever the bar is, so it always
              separates the table from the bar. The band is
              28px and the dots sit dead-center (12.5 above / 12.5 below) — the page's
              table margin no longer adds a top gap.  -->
        <Border
            Grid.Row="0"
            x:Name="PanelResizer"
            Height="28"
            Background="Transparent"
            Cursor="SizeNorthSouth">
            <StackPanel
                HorizontalAlignment="Center"
                VerticalAlignment="Center"
                Orientation="Horizontal"
                Spacing="3">
                <Ellipse Width="3" Height="3" Fill="{DynamicResource MutedForegroundBrush}" />
                <Ellipse Width="3" Height="3" Fill="{DynamicResource MutedForegroundBrush}" />
                <Ellipse Width="3" Height="3" Fill="{DynamicResource MutedForegroundBrush}" />
            </StackPanel>
        </Border>

        <!--  ============ Expandable panel (repo header + active tab's content) ====
              The whole docked card (the old strip is gone — its branch/Fetch row
              moved into the Changes tab's toolbar): full rounded corners, hairline
              border on all four sides.  -->
        <Border
            Grid.Row="1"
            Height="{Binding PanelHeight}"
            Background="{DynamicResource CardBackgroundBrush}"
            BorderBrush="{DynamicResource HairlineBrush}"
            BorderThickness="1"
            ClipToBounds="True"
            CornerRadius="{DynamicResource CardRadius}"
            IsVisible="{Binding IsPanelOpen}">
            <Grid Margin="12,8,12,12" RowDefinitions="Auto,*">

                <!--
                    Repo header (mockup): back link, repo name + star, branch / URL
                    line and the tab row — lives INSIDE the panel, above its content.
                -->
                <components:RepoHeader Grid.Row="0" />

                <!--  Overview tab: stat cards, three activity lists, repository details  -->
                <Grid
                    Grid.Row="1"
                    ColumnDefinitions="*,290"
                    ColumnSpacing="10"
                    IsVisible="{Binding IsActiveOverview}">

                    <Grid
                        Grid.Column="0"
                        RowDefinitions="Auto,*"
                        RowSpacing="10">

                        <!--  Stat cards (whole card opens its tab)  -->
                        <UniformGrid
                            Grid.Row="0"
                            Columns="4"
                            IsVisible="{Binding IsAzureDevOpsEnabled}">
                            <Button
                                Grid.Column="0"
                                Margin="0,0,10,0"
                                Classes="ov-card-btn"
                                Command="{Binding ToggleChangesTabCommand}">
                                <StackPanel Orientation="Horizontal" Spacing="12">
                                    <Grid
                                        Width="36"
                                        Height="36"
                                        VerticalAlignment="Top">
                                        <Border Background="{DynamicResource WarningAccentBrush}" Classes="stat-badge" />
                                        <Path
                                            Width="18"
                                            Height="18"
                                            HorizontalAlignment="Center"
                                            VerticalAlignment="Center"
                                            Data="{tools:SvgPath icon-source-branch}"
                                            Fill="{DynamicResource WarningAccentBrush}"
                                            Stretch="Uniform" />
                                    </Grid>
                                    <StackPanel Spacing="2">
                                        <TextBlock
                                            FontSize="22"
                                            FontWeight="Bold"
                                            Foreground="{DynamicResource TitleForegroundBrush}"
                                            Text="{Binding ChangesCount}" />
                                        <TextBlock Classes="subtle" Text="Local Changes" />
                                    </StackPanel>
                                </StackPanel>
                            </Button>
                            <Button
                                Grid.Column="1"
                                Margin="0,0,10,0"
                                Classes="ov-card-btn"
                                Command="{Binding TogglePullRequestsTabCommand}"
                                IsVisible="{Binding IsGitHubEnabled}">
                                <StackPanel Orientation="Horizontal" Spacing="12">
                                    <Grid
                                        Width="36"
                                        Height="36"
                                        VerticalAlignment="Top">
                                        <Border Background="{DynamicResource PurpleAccentBrush}" Classes="stat-badge" />
                                        <Path
                                            Width="18"
                                            Height="18"
                                            HorizontalAlignment="Center"
                                            VerticalAlignment="Center"
                                            Data="{tools:SvgPath icon-git-pull-request}"
                                            Fill="{DynamicResource PurpleAccentBrush}"
                                            Stretch="Uniform" />
                                    </Grid>
                                    <StackPanel Spacing="2">
                                        <TextBlock
                                            FontSize="22"
                                            FontWeight="Bold"
                                            Foreground="{DynamicResource TitleForegroundBrush}"
                                            Text="{Binding PullRequestCount}" />
                                        <TextBlock Classes="subtle" Text="Open Pull Requests" />
                                    </StackPanel>
                                </StackPanel>
                            </Button>
                            <Button
                                Grid.Column="2"
                                Margin="0,0,10,0"
                                Classes="ov-card-btn"
                                Command="{Binding ToggleIssuesTabCommand}"
                                IsVisible="{Binding IsGitHubEnabled}">
                                <StackPanel Orientation="Horizontal" Spacing="12">
                                    <Grid
                                        Width="36"
                                        Height="36"
                                        VerticalAlignment="Top">
                                        <Border Background="{DynamicResource StatusActiveBrush}" Classes="stat-badge" />
                                        <Path
                                            Width="18"
                                            Height="18"
                                            HorizontalAlignment="Center"
                                            VerticalAlignment="Center"
                                            Data="{tools:SvgPath icon-issue}"
                                            Fill="{DynamicResource StatusActiveBrush}"
                                            Stretch="Uniform" />
                                    </Grid>
                                    <StackPanel Spacing="2">
                                        <TextBlock
                                            FontSize="22"
                                            FontWeight="Bold"
                                            Foreground="{DynamicResource TitleForegroundBrush}"
                                            Text="{Binding IssueCount}" />
                                        <TextBlock Classes="subtle" Text="Open Issues" />
                                    </StackPanel>
                                </StackPanel>
                            </Button>
                            <Button
                                Grid.Column="3"
                                Margin="0,0,10,0"
                                Classes="ov-card-btn"
                                Command="{Binding ToggleAzureTabCommand}"
                                IsVisible="{Binding IsAzureDevOpsEnabled}"
                                ToolTip.Tip="Open the Pipelines tab">
                                <StackPanel Orientation="Horizontal" Spacing="12">
                                    <Grid
                                        Width="36"
                                        Height="36"
                                        VerticalAlignment="Top">
                                        <Border Background="{DynamicResource InfoAccentBrush}" Classes="stat-badge" />
                                        <Path
                                            Width="18"
                                            Height="18"
                                            HorizontalAlignment="Center"
                                            VerticalAlignment="Center"
                                            Data="{tools:SvgPath icon-azure-devops}"
                                            Fill="{DynamicResource InfoAccentBrush}"
                                            Stretch="Uniform" />
                                    </Grid>
                                    <StackPanel Spacing="2">
                                        <TextBlock
                                            FontSize="14"
                                            FontWeight="SemiBold"
                                            Foreground="{DynamicResource TitleForegroundBrush}"
                                            Text="{Binding PipelineStatusText}"
                                            TextTrimming="CharacterEllipsis"
                                            ToolTip.Tip="Latest Azure DevOps pipeline results" />
                                        <TextBlock Classes="subtle" Text="Pipelines" />
                                    </StackPanel>
                                </StackPanel>
                            </Button>
                        </UniformGrid>

                        <!--
                            Same cards without the Pipelines slot (Azure DevOps off):
                            a collapsed UniformGrid child keeps its cell, so the
                            three remaining cards need their own 3-column grid.
                        -->
                        <UniformGrid
                            Grid.Row="0"
                            Columns="3"
                            IsVisible="{Binding !IsAzureDevOpsEnabled}">
                            <Button
                                Margin="0,0,10,0"
                                Classes="ov-card-btn"
                                Command="{Binding ToggleChangesTabCommand}">
                                <StackPanel Orientation="Horizontal" Spacing="12">
                                    <Grid
                                        Width="36"
                                        Height="36"
                                        VerticalAlignment="Top">
                                        <Border Background="{DynamicResource WarningAccentBrush}" Classes="stat-badge" />
                                        <Path
                                            Width="18"
                                            Height="18"
                                            HorizontalAlignment="Center"
                                            VerticalAlignment="Center"
                                            Data="{tools:SvgPath icon-source-branch}"
                                            Fill="{DynamicResource WarningAccentBrush}"
                                            Stretch="Uniform" />
                                    </Grid>
                                    <StackPanel Spacing="2">
                                        <TextBlock
                                            FontSize="22"
                                            FontWeight="Bold"
                                            Foreground="{DynamicResource TitleForegroundBrush}"
                                            Text="{Binding ChangesCount}" />
                                        <TextBlock Classes="subtle" Text="Local Changes" />
                                    </StackPanel>
                                </StackPanel>
                            </Button>
                            <Button
                                Margin="0,0,10,0"
                                Classes="ov-card-btn"
                                Command="{Binding TogglePullRequestsTabCommand}"
                                IsVisible="{Binding IsGitHubEnabled}">
                                <StackPanel Orientation="Horizontal" Spacing="12">
                                    <Grid
                                        Width="36"
                                        Height="36"
                                        VerticalAlignment="Top">
                                        <Border Background="{DynamicResource PurpleAccentBrush}" Classes="stat-badge" />
                                        <Path
                                            Width="18"
                                            Height="18"
                                            HorizontalAlignment="Center"
                                            VerticalAlignment="Center"
                                            Data="{tools:SvgPath icon-git-pull-request}"
                                            Fill="{DynamicResource PurpleAccentBrush}"
                                            Stretch="Uniform" />
                                    </Grid>
                                    <StackPanel Spacing="2">
                                        <TextBlock
                                            FontSize="22"
                                            FontWeight="Bold"
                                            Foreground="{DynamicResource TitleForegroundBrush}"
                                            Text="{Binding PullRequestCount}" />
                                        <TextBlock Classes="subtle" Text="Open Pull Requests" />
                                    </StackPanel>
                                </StackPanel>
                            </Button>
                            <Button
                                Margin="0,0,10,0"
                                Classes="ov-card-btn"
                                Command="{Binding ToggleIssuesTabCommand}"
                                IsVisible="{Binding IsGitHubEnabled}">
                                <StackPanel Orientation="Horizontal" Spacing="12">
                                    <Grid
                                        Width="36"
                                        Height="36"
                                        VerticalAlignment="Top">
                                        <Border Background="{DynamicResource StatusActiveBrush}" Classes="stat-badge" />
                                        <Path
                                            Width="18"
                                            Height="18"
                                            HorizontalAlignment="Center"
                                            VerticalAlignment="Center"
                                            Data="{tools:SvgPath icon-issue}"
                                            Fill="{DynamicResource StatusActiveBrush}"
                                            Stretch="Uniform" />
                                    </Grid>
                                    <StackPanel Spacing="2">
                                        <TextBlock
                                            FontSize="22"
                                            FontWeight="Bold"
                                            Foreground="{DynamicResource TitleForegroundBrush}"
                                            Text="{Binding IssueCount}" />
                                        <TextBlock Classes="subtle" Text="Open Issues" />
                                    </StackPanel>
                                </StackPanel>
                            </Button>
                        </UniformGrid>

                        <!--  Activity lists  -->
                        <Grid
                            Grid.Row="1"
                            ColumnDefinitions="3*,3*,3*"
                            ColumnSpacing="10">

                            <!--  Local Changes  -->
                            <Button
                                Grid.Column="0"
                                Classes="ov-card-btn"
                                Command="{Binding ToggleChangesTabCommand}">
                                <DockPanel>
                                    <TextBlock
                                        Margin="0,0,0,4"
                                        Classes="ov-card-title"
                                        DockPanel.Dock="Top"
                                        Text="Local Changes" />
                                    <TextBlock
                                        Margin="0,4,0,0"
                                        Classes="subtle"
                                        DockPanel.Dock="Bottom"
                                        IsVisible="{Binding ShowChangesBadge}"
                                        Text="{Binding ChangesCount, StringFormat='{}{0} changed files'}" />
                                    <ScrollViewer HorizontalScrollBarVisibility="Disabled">
                                        <StackPanel Spacing="10">
                                            <TextBlock
                                                Margin="0,16"
                                                HorizontalAlignment="Center"
                                                Classes="subtle"
                                                IsVisible="{Binding ShowChangesEmpty}"
                                                Text="Working tree is clean" />
                                            <ItemsControl ItemsSource="{Binding ChangedFilesPreview}">
                                                <ItemsControl.ItemTemplate>
                                                    <DataTemplate x:DataType="entities:GitChangedFile">
                                                        <Grid ColumnDefinitions="Auto,*,Auto" ColumnSpacing="8">
                                                            <Border
                                                                Grid.Column="0"
                                                                Width="24"
                                                                Padding="0,1"
                                                                VerticalAlignment="Center"
                                                                Background="{DynamicResource CardBackgroundBrush}"
                                                                BorderBrush="{DynamicResource HairlineBrush}"
                                                                BorderThickness="1"
                                                                CornerRadius="{DynamicResource ChipRadius}">
                                                                <TextBlock
                                                                    HorizontalAlignment="Center"
                                                                    Classes="mono"
                                                                    Foreground="{Binding StatusCode, Converter={StaticResource GitStatusBrushConverter}}"
                                                                    Text="{Binding DisplayStatusCode}" />
                                                            </Border>
                                                            <TextBlock
                                                                Grid.Column="1"
                                                                VerticalAlignment="Center"
                                                                Classes="mono"
                                                                Foreground="{DynamicResource BodyForegroundBrush}"
                                                                Text="{Binding Path}"
                                                                TextTrimming="CharacterEllipsis" />
                                                            <StackPanel
                                                                Grid.Column="2"
                                                                HorizontalAlignment="Right"
                                                                VerticalAlignment="Center"
                                                                IsVisible="{Binding HasCounts}"
                                                                Orientation="Horizontal"
                                                                Spacing="4">
                                                                <!--  Additions pill (green) — hidden for binary/untracked (no counts)  -->
                                                                <Border
                                                                    Padding="6,1"
                                                                    VerticalAlignment="Center"
                                                                    Background="{DynamicResource AddedCountChipBrush}"
                                                                    CornerRadius="{DynamicResource ChipRadius}"
                                                                    IsVisible="{Binding AddedText, Converter={StaticResource StringNullOrEmptyToVisibilityConverter}}">
                                                                    <TextBlock
                                                                        Classes="mono"
                                                                        Foreground="{DynamicResource AddedCountBrush}"
                                                                        Text="{Binding AddedText}" />
                                                                </Border>
                                                                <!--  Deletions pill (light red)  -->
                                                                <Border
                                                                    Padding="6,1"
                                                                    VerticalAlignment="Center"
                                                                    Background="{DynamicResource RemovedCountChipBrush}"
                                                                    CornerRadius="{DynamicResource ChipRadius}"
                                                                    IsVisible="{Binding RemovedText, Converter={StaticResource StringNullOrEmptyToVisibilityConverter}}">
                                                                    <TextBlock
                                                                        Classes="mono"
                                                                        Foreground="{DynamicResource RemovedCountBrush}"
                                                                        Text="{Binding RemovedText}" />
                                                                </Border>
                                                            </StackPanel>
                                                        </Grid>
                                                    </DataTemplate>
                                                </ItemsControl.ItemTemplate>
                                            </ItemsControl>
                                        </StackPanel>
                                    </ScrollViewer>
                                </DockPanel>
                            </Button>

                            <!--  Recent Pull Requests  -->
                            <Button
                                Grid.Column="1"
                                Classes="ov-card-btn"
                                Command="{Binding TogglePullRequestsTabCommand}">
                                <DockPanel>
                                    <TextBlock
                                        Margin="0,0,0,4"
                                        Classes="ov-card-title"
                                        DockPanel.Dock="Top"
                                        Text="Recent Pull Requests" />
                                    <ScrollViewer HorizontalScrollBarVisibility="Disabled">
                                        <StackPanel Spacing="10">
                                            <TextBlock
                                                Margin="0,16"
                                                HorizontalAlignment="Center"
                                                Classes="subtle"
                                                IsVisible="{Binding ShowPullRequestsEmpty}"
                                                Text="No open pull requests" />
                                            <ItemsControl ItemsSource="{Binding GitHubPullRequestsPreview}">
                                                <ItemsControl.ItemTemplate>
                                                    <DataTemplate x:DataType="entities:GitHubItem">
                                                        <Button
                                                            Padding="4,5"
                                                            Classes="bar-item"
                                                            Command="{Binding $parent[UserControl].((vm:BottomBarViewModel)DataContext).OpenGitHubItemCommand}"
                                                            CommandParameter="{Binding}"
                                                            ToolTip.Tip="{Binding Url}">
                                                            <Grid ColumnDefinitions="*,Auto,Auto,Auto" ColumnSpacing="8">
                                                                <StackPanel Grid.Column="0" Spacing="1">
                                                                    <!--  Star cell constrains the title so it trims
                                                                          instead of painting over the trailing
                                                                          author/age columns.  -->
                                                                    <Grid ColumnDefinitions="Auto,*" ColumnSpacing="6">
                                                                        <TextBlock
                                                                            FontWeight="SemiBold"
                                                                            Foreground="{DynamicResource TitleForegroundBrush}"
                                                                            Text="{Binding Number, StringFormat='#{0}'}" />
                                                                        <TextBlock
                                                                            Grid.Column="1"
                                                                            Foreground="{DynamicResource TitleForegroundBrush}"
                                                                            Text="{Binding Title}"
                                                                            TextTrimming="CharacterEllipsis" />
                                                                    </Grid>
                                                                    <StackPanel
                                                                        Orientation="Horizontal"
                                                                        Spacing="6"
                                                                        IsVisible="{Binding BranchSummary, Converter={StaticResource StringNullOrEmptyToVisibilityConverter}}">
                                                                        <TextBlock
                                                                            Classes="mono"
                                                                            Foreground="{DynamicResource MutedForegroundBrush}"
                                                                            Text="{Binding HeadRef}" />
                                                                        <TextBlock
                                                                            Classes="mono"
                                                                            Foreground="{DynamicResource AccentPrimaryBrush}"
                                                                            Text="→" />
                                                                        <TextBlock
                                                                            Classes="mono"
                                                                            Foreground="{DynamicResource MutedForegroundBrush}"
                                                                            Text="{Binding BaseRef, TargetNullValue=main}" />
                                                                    </StackPanel>
                                                                </StackPanel>
                                                                <TextBlock
                                                                    Grid.Column="1"
                                                                    VerticalAlignment="Center"
                                                                    Classes="subtle"
                                                                    IsVisible="{Binding Author, Converter={StaticResource StringNullOrEmptyToVisibilityConverter}}"
                                                                    Text="{Binding Author}" />
                                                                <TextBlock
                                                                    Grid.Column="2"
                                                                    VerticalAlignment="Center"
                                                                    Classes="subtle"
                                                                    Text="{Binding AgeText}" />
                                                                <Border
                                                                    Grid.Column="3"
                                                                    Background="{Binding StateChip, Converter={StaticResource GitHubStateChipBrushConverter}, ConverterParameter=bg}"
                                                                    Classes="state-chip"
                                                                    ToolTip.Tip="{Binding StateChip}">
                                                                    <TextBlock
                                                                        FontWeight="SemiBold"
                                                                        Foreground="{Binding StateChip, Converter={StaticResource GitHubStateChipBrushConverter}}"
                                                                        Text="{Binding StateChip}" />
                                                                </Border>
                                                            </Grid>
                                                        </Button>
                                                    </DataTemplate>
                                                </ItemsControl.ItemTemplate>
                                            </ItemsControl>
                                        </StackPanel>
                                    </ScrollViewer>
                                </DockPanel>
                            </Button>

                            <!--  Recent Issues  -->
                            <Button
                                Grid.Column="2"
                                Classes="ov-card-btn"
                                Command="{Binding ToggleIssuesTabCommand}">
                                <DockPanel>
                                    <TextBlock
                                        Margin="0,0,0,4"
                                        Classes="ov-card-title"
                                        DockPanel.Dock="Top"
                                        Text="Recent Issues" />
                                    <ScrollViewer HorizontalScrollBarVisibility="Disabled">
                                        <StackPanel Spacing="10">
                                            <TextBlock
                                                Margin="0,16"
                                                HorizontalAlignment="Center"
                                                Classes="subtle"
                                                IsVisible="{Binding ShowIssuesEmpty}"
                                                Text="No open issues" />
                                            <ItemsControl ItemsSource="{Binding GitHubIssuesPreview}">
                                                <ItemsControl.ItemTemplate>
                                                    <DataTemplate x:DataType="entities:GitHubItem">
                                                        <Button
                                                            Padding="4,5"
                                                            Classes="bar-item"
                                                            Command="{Binding $parent[UserControl].((vm:BottomBarViewModel)DataContext).OpenGitHubItemCommand}"
                                                            CommandParameter="{Binding}"
                                                            ToolTip.Tip="{Binding Url}">
                                                            <Grid ColumnDefinitions="*,Auto,Auto" ColumnSpacing="6">
                                                                <StackPanel Grid.Column="0" Spacing="1">
                                                                    <!--  Star cell constrains the title so it trims
                                                                          instead of painting over the trailing
                                                                          author/age columns.  -->
                                                                    <Grid ColumnDefinitions="Auto,*" ColumnSpacing="6">
                                                                        <TextBlock
                                                                            FontWeight="SemiBold"
                                                                            Foreground="{DynamicResource TitleForegroundBrush}"
                                                                            Text="{Binding Number, StringFormat='#{0}'}" />
                                                                        <TextBlock
                                                                            Grid.Column="1"
                                                                            Foreground="{DynamicResource TitleForegroundBrush}"
                                                                            Text="{Binding Title}"
                                                                            TextTrimming="CharacterEllipsis" />
                                                                    </Grid>
                                                                    <ItemsControl IsVisible="{Binding HasLabels}" ItemsSource="{Binding Labels}">
                                                                        <ItemsControl.ItemsPanel>
                                                                            <ItemsPanelTemplate>
                                                                                <WrapPanel Orientation="Horizontal" />
                                                                            </ItemsPanelTemplate>
                                                                        </ItemsControl.ItemsPanel>
                                                                        <ItemsControl.ItemTemplate>
                                                                            <DataTemplate x:DataType="x:String">
                                                                                <Border
                                                                                    Classes="label-pill"
                                                                                    Background="{Binding Converter={StaticResource GitHubLabelBrushConverter}, ConverterParameter=bg}"
                                                                                    ToolTip.Tip="{Binding}">
                                                                                    <TextBlock
                                                                                        Foreground="{Binding Converter={StaticResource GitHubLabelBrushConverter}}"
                                                                                        Text="{Binding}" />
                                                                                </Border>
                                                                            </DataTemplate>
                                                                        </ItemsControl.ItemTemplate>
                                                                    </ItemsControl>
                                                                </StackPanel>
                                                                <TextBlock
                                                                    Grid.Column="1"
                                                                    VerticalAlignment="Center"
                                                                    Classes="subtle"
                                                                    IsVisible="{Binding Author, Converter={StaticResource StringNullOrEmptyToVisibilityConverter}}"
                                                                    Text="{Binding Author}" />
                                                                <TextBlock
                                                                    Grid.Column="2"
                                                                    VerticalAlignment="Center"
                                                                    Classes="subtle"
                                                                    IsVisible="{Binding AgeText, Converter={StaticResource StringNullOrEmptyToVisibilityConverter}}"
                                                                    Text="{Binding AgeText}" />
                                                            </Grid>
                                                        </Button>
                                                    </DataTemplate>
                                                </ItemsControl.ItemTemplate>
                                            </ItemsControl>
                                        </StackPanel>
                                    </ScrollViewer>
                                </DockPanel>
                            </Button>
                        </Grid>
                    </Grid>

                    <!--  Repository Details sidebar  -->
                    <Border Grid.Column="1" Classes="ov-card">
                        <DockPanel>
                            <TextBlock
                                Margin="0,0,0,6"
                                Classes="ov-card-title"
                                DockPanel.Dock="Top"
                                Text="Repository Details" />
                            <ScrollViewer HorizontalScrollBarVisibility="Disabled">
                                <StackPanel Spacing="8">
                                    <StackPanel.Styles>
                                        <Style Selector="TextBlock.detail-key">
                                            <Setter Property="Foreground" Value="{DynamicResource MutedForegroundBrush}" />
                                        </Style>
                                        <Style Selector="TextBlock.detail-value">
                                            <Setter Property="Foreground" Value="{DynamicResource BodyForegroundBrush}" />
                                        </Style>
                                    </StackPanel.Styles>
                                    <TextBlock
                                        Classes="subtle"
                                        IsVisible="{Binding !HasRepoDetails}"
                                        Text="No GitHub data for this repository"
                                        TextWrapping="Wrap" />
                                    <!--
                                        GitHub link row: the repo's page as a clickable
                                        display URL. Sits OUTSIDE the details gate so it
                                        shows whenever the repo has a GitHub remote — even
                                        while the gh details are still loading (or absent).
                                    -->
                                    <Grid
                                        ColumnDefinitions="110,*"
                                        ColumnSpacing="10"
                                        IsVisible="{Binding HasSelectedRepoGitHubUrl}">
                                        <TextBlock Classes="detail-key" Text="GitHub" />
                                        <Button
                                            Grid.Column="1"
                                            Classes="detail-link"
                                            Command="{Binding OpenGitHubRepoCommand}"
                                            HorizontalAlignment="Left"
                                            ToolTip.Tip="Open the repository's GitHub page">
                                            <StackPanel Orientation="Horizontal" Spacing="6">
                                                <!--  The details sidebar is a fixed 290px column, so
                                                      after the 110px key + paddings the value cell
                                                      has ~130px: cap the URL explicitly (desired-
                                                      sized presenter would otherwise overflow the
                                                      card) and let the ellipsis take the rest.  -->
                                                <TextBlock
                                                    MaxWidth="126"
                                                    VerticalAlignment="Center"
                                                    Classes="detail-value"
                                                    Text="{Binding SelectedRepoGitHubDisplayUrl}"
                                                    TextTrimming="CharacterEllipsis" />
                                                <Path
                                                    Width="12"
                                                    Height="12"
                                                    VerticalAlignment="Center"
                                                    Data="{tools:SvgPath icon-open-in-new}"
                                                    Fill="{DynamicResource MutedForegroundBrush}"
                                                    Stretch="Uniform" />
                                            </StackPanel>
                                        </Button>
                                    </Grid>
                                    <Grid
                                        ColumnDefinitions="Auto,*"
                                        ColumnSpacing="10"
                                        IsVisible="{Binding HasRepoDetails}">
                                        <StackPanel Grid.ColumnSpan="2" Spacing="6">
                                            <Grid
                                                ColumnDefinitions="110,*"
                                                ColumnSpacing="10"
                                                IsVisible="{Binding SelectedRepoDetails?.Owner, Converter={StaticResource StringNullOrEmptyToVisibilityConverter}}">
                                                <TextBlock Classes="detail-key" Text="Owner" />
                                                <TextBlock
                                                    Grid.Column="1"
                                                    Classes="detail-value"
                                                    Text="{Binding SelectedRepoDetails?.Owner}"
                                                    TextTrimming="CharacterEllipsis" />
                                            </Grid>
                                            <Grid
                                                ColumnDefinitions="110,*"
                                                ColumnSpacing="10"
                                                IsVisible="{Binding SelectedRepoDetails?.CreatedAt, Converter={StaticResource NotNullToBoolConverter}}">
                                                <TextBlock Classes="detail-key" Text="Created" />
                                                <TextBlock
                                                    Grid.Column="1"
                                                    Classes="detail-value"
                                                    Text="{Binding SelectedRepoDetails?.CreatedAt, StringFormat='d MMM yyyy'}" />
                                            </Grid>
                                            <Grid
                                                ColumnDefinitions="110,*"
                                                ColumnSpacing="10"
                                                IsVisible="{Binding SelectedRepoDetails?.Language, Converter={StaticResource StringNullOrEmptyToVisibilityConverter}}">
                                                <TextBlock Classes="detail-key" Text="Language" />
                                                <TextBlock
                                                    Grid.Column="1"
                                                    Classes="detail-value"
                                                    Text="{Binding SelectedRepoDetails?.Language}" />
                                            </Grid>
                                            <Grid
                                                ColumnDefinitions="110,*"
                                                ColumnSpacing="10"
                                                IsVisible="{Binding SelectedRepoDetails?.License, Converter={StaticResource StringNullOrEmptyToVisibilityConverter}}">
                                                <TextBlock Classes="detail-key" Text="License" />
                                                <TextBlock
                                                    Grid.Column="1"
                                                    Classes="detail-value"
                                                    Text="{Binding SelectedRepoDetails?.License}" />
                                            </Grid>
                                            <Grid
                                                ColumnDefinitions="110,*"
                                                ColumnSpacing="10"
                                                IsVisible="{Binding SelectedRepoDetails?.DefaultBranch, Converter={StaticResource StringNullOrEmptyToVisibilityConverter}}">
                                                <TextBlock Classes="detail-key" Text="Default Branch" />
                                                <TextBlock
                                                    Grid.Column="1"
                                                    Classes="detail-value"
                                                    Text="{Binding SelectedRepoDetails?.DefaultBranch}" />
                                            </Grid>
                                        </StackPanel>
                                    </Grid>
                                    <!--  Topics chips  -->
                                    <StackPanel IsVisible="{Binding SelectedRepoDetails?.HasTopics, TargetNullValue=False}">
                                        <TextBlock Classes="detail-key" Text="Topics" />
                                        <ItemsControl Margin="0,4,0,0" ItemsSource="{Binding SelectedRepoDetails?.Topics}">
                                            <ItemsControl.ItemsPanel>
                                                <ItemsPanelTemplate>
                                                    <WrapPanel Orientation="Horizontal" />
                                                </ItemsPanelTemplate>
                                            </ItemsControl.ItemsPanel>
                                            <ItemsControl.ItemTemplate>
                                                <DataTemplate x:DataType="x:String">
                                                    <Border
                                                        Margin="0,0,6,6"
                                                        Padding="7,2"
                                                        Classes="chip">
                                                        <TextBlock Classes="subtle" Text="{Binding}" />
                                                    </Border>
                                                </DataTemplate>
                                            </ItemsControl.ItemTemplate>
                                        </ItemsControl>
                                    </StackPanel>
                                </StackPanel>
                            </ScrollViewer>
                        </DockPanel>
                    </Border>
                </Grid>

                <!--
                    Changes tab (commit workspace, mockup): TOP — the branch dropdown +
                    Fetch/last-fetched row (moved up from the old strip); LEFT — the
                    staged/unstaged tree as two sections, each with its own header (icon
                    + name + count + Stage All / Unstage All) and one row per file with
                    a status chip, per-side numstat and a + / − button; RIGHT — the
                    commit message box with the wand button and Commit; BOTTOM — the
                    repo's recent commits, collapsed by default behind a header toggle.
                -->
                <DockPanel Grid.Row="1" IsVisible="{Binding IsActiveChanges}">

                    <!--  Top toolbar: branch dropdown (pick to check out) + Fetch and
                          last-fetched — moved up from the old bottom strip, which held
                          nothing else and was removed with it.  -->
                    <Grid
                        DockPanel.Dock="Top"
                        Margin="0,0,0,8"
                        ColumnDefinitions="Auto,*,Auto"
                        ColumnSpacing="14">

                        <!--
                            Branch dropdown — outlined box with a branch icon + name;
                            picking an entry checks it out.
                        -->
                        <ComboBox
                            x:Name="BranchPicker"
                            Grid.Column="0"
                            Height="30"
                            MinWidth="88"
                            MaxWidth="200"
                            VerticalAlignment="Center"
                            Background="Transparent"
                            BorderBrush="{DynamicResource HairlineBrush}"
                            BorderThickness="1"
                            CornerRadius="6"
                            ItemsSource="{Binding Branches}"
                            PlaceholderText="branch"
                            SelectedItem="{Binding SelectedBranch, Mode=OneWay}"
                            SelectionChanged="OnBranchSelectionChanged"
                            ToolTip.Tip="Current branch — pick another to check it out">
                            <ComboBox.ItemTemplate>
                                <DataTemplate x:DataType="x:String">
                                    <StackPanel Orientation="Horizontal" Spacing="6">
                                        <Path
                                            Width="12"
                                            Height="12"
                                            Data="{tools:SvgPath icon-source-branch}"
                                            Fill="{DynamicResource MutedForegroundBrush}"
                                            Stretch="Uniform" />
                                        <!--
                                            Explicit foreground: SukiUI brightens only TextBlocks that
                                            are the ComboBoxItem's DIRECT content; inside this
                                            StackPanel the inherited popup color is too dim.
                                        -->
                                        <TextBlock Foreground="{DynamicResource BodyForegroundBrush}" Text="{Binding}" />
                                    </StackPanel>
                                </DataTemplate>
                            </ComboBox.ItemTemplate>
                        </ComboBox>

                        <!--  Fetch + last fetched (pinned right): outlined Fetch button
                              with a cloud-download icon, then the status dot + relative
                              label.  -->
                        <StackPanel
                            Grid.Column="2"
                            VerticalAlignment="Center"
                            IsVisible="{Binding HasSelectedRepo}"
                            Orientation="Horizontal"
                            Spacing="10">
                            <!--  Plain default button (Browse…-style native hover).  -->
                            <Button Command="{Binding FetchCommand}" ToolTip.Tip="git fetch --prune for the selected repository">
                                <StackPanel Orientation="Horizontal" Spacing="6">
                                    <Path
                                        Width="13"
                                        Height="13"
                                        VerticalAlignment="Center"
                                        Classes="icon"
                                        Data="{tools:SvgPath icon-cloud-download}" />
                                    <TextBlock VerticalAlignment="Center" Text="Fetch" />
                                </StackPanel>
                            </Button>
                            <StackPanel
                                VerticalAlignment="Center"
                                Orientation="Horizontal"
                                Spacing="8">
                                <Border
                                    Width="7"
                                    Height="7"
                                    VerticalAlignment="Center"
                                    Background="{Binding HasFetched, Converter={StaticResource BoolToBrushConverter}}"
                                    CornerRadius="4" />
                                <TextBlock
                                    VerticalAlignment="Center"
                                    Foreground="{DynamicResource BodyForegroundBrush}"
                                    Text="{Binding LastFetchText, TargetNullValue='Not fetched'}" />
                            </StackPanel>
                        </StackPanel>
                    </Grid>

                    <!--  Bottom part: Recent Commits — collapsed by default; the header
                          row is the toggle (chevron flips, hairline + list hide), and
                          the history loads on first expand.  -->
                    <StackPanel DockPanel.Dock="Bottom" Margin="0,10,0,0" Spacing="2">
                        <Border
                            Height="1"
                            Margin="0,2,0,6"
                            Background="{DynamicResource HairlineBrush}"
                            IsVisible="{Binding ShowRecentCommits}" />
                        <Button
                            Padding="2,2,6,2"
                            Classes="bar-item"
                            Command="{Binding ToggleRecentCommitsCommand}"
                            ToolTip.Tip="Show / hide this repository's recent commits">
                            <Grid ColumnDefinitions="Auto,Auto,Auto,*,Auto" ColumnSpacing="6">
                                <Path
                                    Grid.Column="0"
                                    Width="13"
                                    Height="13"
                                    VerticalAlignment="Center"
                                    Data="{tools:SvgPath icon-clock}"
                                    Fill="{DynamicResource MutedForegroundBrush}"
                                    Stretch="Uniform" />
                                <TextBlock
                                    Grid.Column="1"
                                    VerticalAlignment="Center"
                                    Classes="ov-card-title"
                                    Text="Recent Commits" />
                                <!--  count only when expanded: collapsed, the list isn't
                                      loaded and "(0)" would read as "no commits"  -->
                                <TextBlock
                                    Grid.Column="2"
                                    VerticalAlignment="Center"
                                    Classes="subtle"
                                    IsVisible="{Binding ShowRecentCommits}"
                                    Text="{Binding GitCommits.Count, StringFormat='({0})'}" />
                                <!--  box sized to the chevron's ink aspect (12x7.4): a square
                                      box under Stretch=Uniform rides the ink high  -->
                                <Path
                                    Grid.Column="4"
                                    Width="12"
                                    Height="8"
                                    VerticalAlignment="Center"
                                    IsVisible="{Binding ShowRecentCommits}"
                                    Data="{tools:SvgPath icon-chevron-down}"
                                    Fill="{DynamicResource MutedForegroundBrush}"
                                    Stretch="Uniform" />
                                <Path
                                    Grid.Column="4"
                                    Width="12"
                                    Height="8"
                                    VerticalAlignment="Center"
                                    IsVisible="{Binding !ShowRecentCommits}"
                                    Data="{tools:SvgPath icon-chevron-right}"
                                    Fill="{DynamicResource MutedForegroundBrush}"
                                    Stretch="Uniform" />
                            </Grid>
                        </Button>
                        <ScrollViewer
                            MaxHeight="132"
                            HorizontalScrollBarVisibility="Disabled"
                            VerticalScrollBarVisibility="Auto"
                            IsVisible="{Binding ShowRecentCommits}">
                            <!--  Fixed hash/author columns: the rows are independent Grids,
                                  so Auto columns would size per-row and author/time would
                                  drift. Fixed widths (repo-table pattern) keep every row's
                                  columns aligned; the subject star absorbs the slack.  -->
                            <StackPanel Spacing="2" Margin="2,0,0,0">
                                <TextBlock
                                    Margin="0,10"
                                    HorizontalAlignment="Center"
                                    Classes="subtle"
                                    IsVisible="{Binding ShowCommitsEmpty}"
                                    Text="No commits yet" />
                                <ItemsControl ItemsSource="{Binding GitCommits}">
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate x:DataType="entities:GitCommitInfo">
                                            <Grid ColumnSpacing="10">
                                                <Grid.ColumnDefinitions>
                                                    <!--  56: seven hex chars of the mono ShortHash  -->
                                                    <ColumnDefinition Width="56" />
                                                    <ColumnDefinition Width="*" />
                                                    <!--  130: caps long author names; left-aligned so the
                                                          name reads as its own column, apart from the
                                                          time at the row's right edge  -->
                                                    <ColumnDefinition Width="130" />
                                                    <!--  64 fixed: an Auto column here drifts per row (the
                                                          rows are independent Grids — each sizes its own
                                                          Auto to its own time), so the times' edges
                                                          misalign; fixed width + right-aligned text keeps
                                                          every row's time flush to the row's right edge  -->
                                                    <ColumnDefinition Width="64" />
                                                </Grid.ColumnDefinitions>
                                                <!--  the hash is a quiet link: click copies the full SHA.
                                                      Left-pinned in its column — the button template would
                                                      otherwise center the text in the 56px cell  -->
                                                <Button
                                                    Grid.Column="0"
                                                    HorizontalAlignment="Left"
                                                    VerticalAlignment="Center"
                                                    Classes="detail-link"
                                                    Command="{Binding $parent[UserControl].((vm:BottomBarViewModel)DataContext).CopyCommitHashCommand}"
                                                    CommandParameter="{Binding}"
                                                    ToolTip.Tip="Copy commit hash">
                                                    <TextBlock
                                                        Classes="mono"
                                                        Foreground="{DynamicResource AccentPrimaryBrush}"
                                                        Text="{Binding ShortHash}" />
                                                </Button>
                                                <TextBlock
                                                    Grid.Column="1"
                                                    VerticalAlignment="Center"
                                                    Foreground="{DynamicResource BodyForegroundBrush}"
                                                    Text="{Binding Subject}"
                                                    TextTrimming="CharacterEllipsis" />
                                                <TextBlock
                                                    Grid.Column="2"
                                                    VerticalAlignment="Center"
                                                    Classes="subtle"
                                                    TextTrimming="CharacterEllipsis"
                                                    IsVisible="{Binding Author, Converter={StaticResource StringNullOrEmptyToVisibilityConverter}}"
                                                    Text="{Binding Author}" />
                                                <TextBlock
                                                    Grid.Column="3"
                                                    VerticalAlignment="Center"
                                                    TextAlignment="Right"
                                                    Classes="subtle"
                                                    Text="{Binding RelativeTime}" />
                                            </Grid>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                            </StackPanel>
                        </ScrollViewer>
                    </StackPanel>

                    <!--  Main row: staged/unstaged tree (left) + commit workspace (right)  -->
                    <Grid ColumnDefinitions="58*,42*" ColumnSpacing="10">

                        <!--  LEFT: the staged/unstaged tree  -->
                        <Border Grid.Column="0" Classes="ov-card">
                            <ScrollViewer HorizontalScrollBarVisibility="Disabled">
                                <StackPanel Spacing="2" Margin="4,4,4,4">
                                    <TextBlock
                                        Margin="0,20"
                                        HorizontalAlignment="Center"
                                        Classes="subtle"
                                        IsVisible="{Binding ShowChangesTabEmpty}"
                                        Text="No changes — the working tree is clean" />

                                    <!--  Unstaged section  -->
                                    <Grid
                                        ColumnDefinitions="*,Auto"
                                        Margin="2,2,2,2"
                                        IsVisible="{Binding ShowUnstagedSection}">
                                        <StackPanel
                                            Grid.Column="0"
                                            VerticalAlignment="Center"
                                            Orientation="Horizontal"
                                            Spacing="6">
                                            <Path
                                                Width="13"
                                                Height="13"
                                                VerticalAlignment="Center"
                                                Data="{tools:SvgPath icon-source-branch}"
                                                Fill="{DynamicResource WarningAccentBrush}"
                                                Stretch="Uniform" />
                                            <TextBlock Classes="ov-card-title" Text="Unstaged Changes" />
                                            <TextBlock
                                                VerticalAlignment="Center"
                                                Classes="subtle"
                                                Text="{Binding UnstagedCount, StringFormat='({0})'}" />
                                        </StackPanel>
                                        <Button
                                            Grid.Column="1"
                                            VerticalAlignment="Center"
                                            Classes="icon"
                                            Command="{Binding StageAllCommand}"
                                            ToolTip.Tip="Stage all unstaged changes (untracked files included)">
                                            <Path
                                                Width="14"
                                                Height="14"
                                                Data="{tools:SvgPath icon-plus}"
                                                Fill="{DynamicResource MutedForegroundBrush}"
                                                Stretch="Uniform" />
                                        </Button>
                                    </Grid>
                                    <ItemsControl IsVisible="{Binding ShowUnstagedSection}" ItemsSource="{Binding UnstagedFiles}">
                                        <ItemsControl.ItemTemplate>
                                            <DataTemplate x:DataType="entities:GitChangedFile">
                                                <Grid ColumnDefinitions="Auto,*,Auto,Auto" ColumnSpacing="8">
                                                    <Border
                                                        Grid.Column="0"
                                                        Width="30"
                                                        Padding="0,2"
                                                        VerticalAlignment="Center"
                                                        Background="{DynamicResource CardSubtleBackgroundBrush}"
                                                        BorderBrush="{DynamicResource HairlineBrush}"
                                                        BorderThickness="1"
                                                        CornerRadius="{DynamicResource ChipRadius}">
                                                        <TextBlock
                                                            HorizontalAlignment="Center"
                                                            Classes="mono"
                                                            Foreground="{Binding StatusCode, Converter={StaticResource GitStatusBrushConverter}}"
                                                            Text="{Binding DisplayStatusCode}" />
                                                    </Border>
                                                    <TextBlock
                                                        Grid.Column="1"
                                                        VerticalAlignment="Center"
                                                        Classes="mono"
                                                        Foreground="{DynamicResource BodyForegroundBrush}"
                                                        Text="{Binding Path}"
                                                        TextTrimming="CharacterEllipsis" />
                                                    <StackPanel
                                                        Grid.Column="2"
                                                        HorizontalAlignment="Right"
                                                        VerticalAlignment="Center"
                                                        IsVisible="{Binding HasCounts}"
                                                        Orientation="Horizontal"
                                                        Spacing="4">
                                                        <!--  Additions pill (green) — hidden for binary/untracked (no counts)  -->
                                                        <Border
                                                            Padding="6,1"
                                                            VerticalAlignment="Center"
                                                            Background="{DynamicResource AddedCountChipBrush}"
                                                            CornerRadius="{DynamicResource ChipRadius}"
                                                            IsVisible="{Binding AddedText, Converter={StaticResource StringNullOrEmptyToVisibilityConverter}}">
                                                            <TextBlock
                                                                Classes="mono"
                                                                Foreground="{DynamicResource AddedCountBrush}"
                                                                Text="{Binding AddedText}" />
                                                        </Border>
                                                        <!--  Deletions pill (light red)  -->
                                                        <Border
                                                            Padding="6,1"
                                                            VerticalAlignment="Center"
                                                            Background="{DynamicResource RemovedCountChipBrush}"
                                                            CornerRadius="{DynamicResource ChipRadius}"
                                                            IsVisible="{Binding RemovedText, Converter={StaticResource StringNullOrEmptyToVisibilityConverter}}">
                                                            <TextBlock
                                                                Classes="mono"
                                                                Foreground="{DynamicResource RemovedCountBrush}"
                                                                Text="{Binding RemovedText}" />
                                                        </Border>
                                                    </StackPanel>
                                                    <Button
                                                        Grid.Column="3"
                                                        VerticalAlignment="Center"
                                                        Classes="icon"
                                                        Command="{Binding $parent[UserControl].((vm:BottomBarViewModel)DataContext).StageFileCommand}"
                                                        CommandParameter="{Binding}"
                                                        ToolTip.Tip="Stage this file">
                                                        <Path
                                                            Width="14"
                                                            Height="14"
                                                            Data="{tools:SvgPath icon-plus}"
                                                            Fill="{DynamicResource MutedForegroundBrush}"
                                                            Stretch="Uniform" />
                                                    </Button>
                                                </Grid>
                                            </DataTemplate>
                                        </ItemsControl.ItemTemplate>
                                    </ItemsControl>

                                    <!--  Staged section  -->
                                    <Grid
                                        ColumnDefinitions="*,Auto"
                                        Margin="2,8,2,2"
                                        IsVisible="{Binding ShowStagedSection}">
                                        <StackPanel
                                            Grid.Column="0"
                                            VerticalAlignment="Center"
                                            Orientation="Horizontal"
                                            Spacing="6">
                                            <Path
                                                Width="13"
                                                Height="13"
                                                VerticalAlignment="Center"
                                                Data="{tools:SvgPath icon-check}"
                                                Fill="{DynamicResource StatusActiveBrush}"
                                                Stretch="Uniform" />
                                            <TextBlock Classes="ov-card-title" Text="Staged Changes" />
                                            <TextBlock
                                                VerticalAlignment="Center"
                                                Classes="subtle"
                                                Text="{Binding StagedCount, StringFormat='({0})'}" />
                                        </StackPanel>
                                        <Button
                                            Grid.Column="1"
                                            VerticalAlignment="Center"
                                            Classes="icon"
                                            Command="{Binding UnstageAllCommand}"
                                            ToolTip.Tip="Unstage everything — the working tree keeps the changes">
                                            <Path
                                                Width="14"
                                                Height="14"
                                                Data="{tools:SvgPath icon-minus}"
                                                Fill="{DynamicResource MutedForegroundBrush}"
                                                Stretch="Uniform" />
                                        </Button>
                                    </Grid>
                                    <ItemsControl IsVisible="{Binding ShowStagedSection}" ItemsSource="{Binding StagedFiles}">
                                        <ItemsControl.ItemTemplate>
                                            <DataTemplate x:DataType="entities:GitChangedFile">
                                                <Grid ColumnDefinitions="Auto,*,Auto,Auto" ColumnSpacing="8">
                                                    <Border
                                                        Grid.Column="0"
                                                        Width="30"
                                                        Padding="0,2"
                                                        VerticalAlignment="Center"
                                                        Background="{DynamicResource CardSubtleBackgroundBrush}"
                                                        BorderBrush="{DynamicResource HairlineBrush}"
                                                        BorderThickness="1"
                                                        CornerRadius="{DynamicResource ChipRadius}">
                                                        <TextBlock
                                                            HorizontalAlignment="Center"
                                                            Classes="mono"
                                                            Foreground="{Binding StatusCode, Converter={StaticResource GitStatusBrushConverter}}"
                                                            Text="{Binding DisplayStatusCode}" />
                                                    </Border>
                                                    <TextBlock
                                                        Grid.Column="1"
                                                        VerticalAlignment="Center"
                                                        Classes="mono"
                                                        Foreground="{DynamicResource BodyForegroundBrush}"
                                                        Text="{Binding Path}"
                                                        TextTrimming="CharacterEllipsis" />
                                                    <StackPanel
                                                        Grid.Column="2"
                                                        HorizontalAlignment="Right"
                                                        VerticalAlignment="Center"
                                                        IsVisible="{Binding HasCounts}"
                                                        Orientation="Horizontal"
                                                        Spacing="4">
                                                        <!--  Additions pill (green) — hidden for binary/untracked (no counts)  -->
                                                        <Border
                                                            Padding="6,1"
                                                            VerticalAlignment="Center"
                                                            Background="{DynamicResource AddedCountChipBrush}"
                                                            CornerRadius="{DynamicResource ChipRadius}"
                                                            IsVisible="{Binding AddedText, Converter={StaticResource StringNullOrEmptyToVisibilityConverter}}">
                                                            <TextBlock
                                                                Classes="mono"
                                                                Foreground="{DynamicResource AddedCountBrush}"
                                                                Text="{Binding AddedText}" />
                                                        </Border>
                                                        <!--  Deletions pill (light red)  -->
                                                        <Border
                                                            Padding="6,1"
                                                            VerticalAlignment="Center"
                                                            Background="{DynamicResource RemovedCountChipBrush}"
                                                            CornerRadius="{DynamicResource ChipRadius}"
                                                            IsVisible="{Binding RemovedText, Converter={StaticResource StringNullOrEmptyToVisibilityConverter}}">
                                                            <TextBlock
                                                                Classes="mono"
                                                                Foreground="{DynamicResource RemovedCountBrush}"
                                                                Text="{Binding RemovedText}" />
                                                        </Border>
                                                    </StackPanel>
                                                    <Button
                                                        Grid.Column="3"
                                                        VerticalAlignment="Center"
                                                        Classes="icon"
                                                        Command="{Binding $parent[UserControl].((vm:BottomBarViewModel)DataContext).UnstageFileCommand}"
                                                        CommandParameter="{Binding}"
                                                        ToolTip.Tip="Unstage this file — the working tree keeps the change">
                                                        <Path
                                                            Width="14"
                                                            Height="14"
                                                            Data="{tools:SvgPath icon-minus}"
                                                            Fill="{DynamicResource MutedForegroundBrush}"
                                                            Stretch="Uniform" />
                                                    </Button>
                                                </Grid>
                                            </DataTemplate>
                                        </ItemsControl.ItemTemplate>
                                    </ItemsControl>
                                </StackPanel>
                            </ScrollViewer>
                        </Border>

                        <!--  RIGHT: the commit workspace  -->
                        <Border Grid.Column="1" Classes="ov-card">
                            <DockPanel>

                                <TextBlock
                                    Margin="0,0,0,6"
                                    Classes="ov-card-title"
                                    DockPanel.Dock="Top"
                                    Text="Commit message" />


                                <!--  Commit button: an empty message box turns it into "Generate & Commit" —
                                      the press then writes the message first (the wand's run) and commits  -->
                                <Button
                                    Margin="0,8,0,0"
                                    HorizontalAlignment="Left"
                                    Classes="Outlined"
                                    Command="{Binding CommitCommand}"
                                    DockPanel.Dock="Bottom"
                                    ToolTip.Tip="Commit staged changes; empty message auto-generates (opencode)">
                                    <StackPanel Orientation="Horizontal" Spacing="6">
                                        <!--  wand while the box is empty, check once a message is typed;
                                              both give way to the spinning ring while the commit runs;
                                              Fill/Stroke track the button's Foreground so hover turns it white with the text  -->
                                        <Path
                                            Width="13"
                                            Height="13"
                                            VerticalAlignment="Center"
                                            IsVisible="{Binding CommitShowsWand}"
                                            Data="{tools:SvgPath icon-wand}"
                                            Fill="{Binding $parent[Button].Foreground}"
                                            Stretch="Uniform" />
                                        <Path
                                            Width="13"
                                            Height="13"
                                            VerticalAlignment="Center"
                                            IsVisible="{Binding CommitShowsCheck}"
                                            Data="{tools:SvgPath icon-check}"
                                            Fill="{Binding $parent[Button].Foreground}"
                                            Stretch="Uniform" />
                                        <!--  same ring recipe as the wand button: element-space arc,
                                              no Stretch, so the circle's center is exactly the
                                              RenderTransformOrigin the rotation pivots on  -->
                                        <Path
                                            Width="13"
                                            Height="13"
                                            VerticalAlignment="Center"
                                            IsVisible="{Binding IsCommitting}"
                                            RenderTransformOrigin="50%,50%"
                                            Data="M 6.5 1 A 5.5 5.5 0 1 1 1 6.5"
                                            Stroke="{Binding $parent[Button].Foreground}"
                                            StrokeThickness="2">
                                            <Path.RenderTransform>
                                                <RotateTransform />
                                            </Path.RenderTransform>
                                            <Path.Styles>
                                                <Style Selector="Path">
                                                    <Style.Animations>
                                                        <Animation Duration="0:0:0.9" IterationCount="Infinite">
                                                            <KeyFrame Cue="0%">
                                                                <Setter Property="RotateTransform.Angle" Value="0" />
                                                            </KeyFrame>
                                                            <KeyFrame Cue="100%">
                                                                <Setter Property="RotateTransform.Angle" Value="360" />
                                                            </KeyFrame>
                                                        </Animation>
                                                    </Style.Animations>
                                                </Style>
                                            </Path.Styles>
                                        </Path>
                                        <TextBlock VerticalAlignment="Center" Text="{Binding CommitButtonText}" />
                                    </StackPanel>
                                </Button>

                                <!--  Message box; the wand sits over its bottom-right corner  -->
                                <Grid>
                                    <TextBox
                                        AcceptsReturn="True"
                                        VerticalContentAlignment="Top"
                                        Text="{Binding CommitMessage}"
                                        TextWrapping="Wrap"
                                        Watermark="Commit message (empty = auto-generate)" />
                                    <Button
                                        Margin="0,0,4,4"
                                        HorizontalAlignment="Right"
                                        VerticalAlignment="Bottom"
                                        Classes="wand-btn"
                                        Command="{Binding GenerateCommitMessageCommand}"
                                        ToolTip.Tip="Generate a commit message from the staged diff (opencode)">
                                            <Grid>
                                                <!--  spinning arc while the generation runs; drawn at final size
                                                      in element coordinates (no Stretch) so the circle's center
                                                      is exactly the RenderTransformOrigin the rotation pivots on  -->
                                                <Path
                                                    Width="16"
                                                    Height="16"
                                                    IsVisible="{Binding IsGeneratingMessage}"
                                                    RenderTransformOrigin="50%,50%"
                                                    Data="M 8 1 A 7 7 0 1 1 1 8"
                                                    Stroke="{DynamicResource AccentPrimaryBrush}"
                                                    StrokeThickness="2">
                                                    <Path.RenderTransform>
                                                        <RotateTransform />
                                                    </Path.RenderTransform>
                                                    <Path.Styles>
                                                        <Style Selector="Path">
                                                            <Style.Animations>
                                                                <Animation Duration="0:0:0.9" IterationCount="Infinite">
                                                                    <KeyFrame Cue="0%">
                                                                        <Setter Property="RotateTransform.Angle" Value="0" />
                                                                    </KeyFrame>
                                                                    <KeyFrame Cue="100%">
                                                                        <Setter Property="RotateTransform.Angle" Value="360" />
                                                                    </KeyFrame>
                                                                </Animation>
                                                            </Style.Animations>
                                                        </Style>
                                                    </Path.Styles>
                                                </Path>
                                            <Path
                                                Width="16"
                                                Height="16"
                                                IsVisible="{Binding !IsGeneratingMessage}"
                                                Data="{tools:SvgPath icon-wand}"
                                                Fill="{DynamicResource MutedForegroundBrush}"
                                                Stretch="Uniform" />
                                        </Grid>
                                    </Button>
                                </Grid>
                            </DockPanel>
                        </Border>
                    </Grid>
                </DockPanel>

                <!--  Pull requests tab  -->
                <DockPanel Grid.Row="1" IsVisible="{Binding IsActivePullRequests}">
                    <Grid
                        Margin="0,6,0,4"
                        ColumnDefinitions="*,Auto,Auto"
                        ColumnSpacing="4"
                        DockPanel.Dock="Top">
                        <TextBlock
                            Grid.Column="0"
                            VerticalAlignment="Center"
                            Classes="subtle"
                            Text="{Binding GitHubPullRequests.Count, StringFormat='{}{0} open pull requests'}" />
                        <Button
                            Grid.Column="1"
                            VerticalAlignment="Center"
                            Classes="icon"
                            Command="{Binding RefreshGitHubCommand}"
                            IsEnabled="{Binding !IsGitHubRefreshing}"
                            ToolTip.Tip="Refresh">
                            <Path Classes="icon" Data="{tools:SvgPath icon-refresh}" />
                        </Button>
                        <Button
                            Grid.Column="2"
                            VerticalAlignment="Center"
                            Classes="icon"
                            Command="{Binding OpenGitHubPullsCommand}"
                            ToolTip.Tip="Open the pull requests page on GitHub">
                            <Path
                                Width="17"
                                Height="17"
                                Data="{tools:SvgPath icon-github}"
                                Fill="{DynamicResource MutedForegroundBrush}"
                                Stretch="Uniform" />
                        </Button>
                    </Grid>
                    <ScrollViewer HorizontalScrollBarVisibility="Disabled">
                        <StackPanel Spacing="2">
                            <TextBlock
                                Margin="0,24"
                                HorizontalAlignment="Center"
                                Classes="subtle"
                                IsVisible="{Binding !GitHubHasLoaded}"
                                Text="Loading…" />
                            <TextBlock
                                Margin="0,24"
                                HorizontalAlignment="Center"
                                Classes="subtle"
                                IsVisible="{Binding ShowPullRequestsEmpty}"
                                Text="No open pull requests" />
                            <TextBlock
                                Margin="0,24"
                                HorizontalAlignment="Center"
                                Classes="subtle"
                                IsVisible="{Binding ShowGitHubUnavailable}"
                                Text="No GitHub data for this repository (is it hosted on GitHub, and is gh authenticated?)" />
                            <ItemsControl ItemsSource="{Binding GitHubPullRequests}">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate x:DataType="entities:GitHubItem">
                                        <Button
                                            Classes="bar-item"
                                            Command="{Binding $parent[UserControl].((vm:BottomBarViewModel)DataContext).OpenGitHubItemCommand}"
                                            CommandParameter="{Binding}"
                                            ToolTip.Tip="{Binding Url}">
                                            <Grid ColumnDefinitions="Auto,*,Auto,Auto,Auto" ColumnSpacing="10">
                                                <Path
                                                    Grid.Column="0"
                                                    Width="15"
                                                    Height="15"
                                                    VerticalAlignment="Center"
                                                    Data="{tools:SvgPath icon-git-pull-request}"
                                                    Fill="{DynamicResource PurpleAccentBrush}"
                                                    Stretch="Uniform" />
                                                <StackPanel
                                                    Grid.Column="1"
                                                    VerticalAlignment="Center"
                                                    Orientation="Vertical"
                                                    Spacing="2">
                                                    <!--  Title line: star cell constrains the title so it
                                                          trims instead of painting over the trailing
                                                          author/age/chip columns.  -->
                                                    <Grid ColumnDefinitions="Auto,*" ColumnSpacing="6">
                                                        <TextBlock
                                                            VerticalAlignment="Center"
                                                            FontSize="13"
                                                            FontWeight="SemiBold"
                                                            Foreground="{DynamicResource TitleForegroundBrush}"
                                                            Text="{Binding Number, StringFormat='#{0}'}" />
                                                        <TextBlock
                                                            Grid.Column="1"
                                                            VerticalAlignment="Center"
                                                            FontSize="13"
                                                            Foreground="{DynamicResource TitleForegroundBrush}"
                                                            Text="{Binding Title}"
                                                            TextTrimming="CharacterEllipsis" />
                                                    </Grid>
                                                    <StackPanel
                                                        Orientation="Horizontal"
                                                        Spacing="6"
                                                        IsVisible="{Binding BranchSummary, Converter={StaticResource StringNullOrEmptyToVisibilityConverter}}">
                                                        <TextBlock
                                                            Classes="mono"
                                                            Foreground="{DynamicResource MutedForegroundBrush}"
                                                            Text="{Binding HeadRef}" />
                                                        <TextBlock
                                                            Classes="mono"
                                                            Foreground="{DynamicResource AccentPrimaryBrush}"
                                                            Text="→" />
                                                        <TextBlock
                                                            Classes="mono"
                                                            Foreground="{DynamicResource MutedForegroundBrush}"
                                                            Text="{Binding BaseRef, TargetNullValue=main}" />
                                                    </StackPanel>
                                                    <ItemsControl IsVisible="{Binding HasLabels}" ItemsSource="{Binding Labels}">
                                                        <ItemsControl.ItemsPanel>
                                                            <ItemsPanelTemplate>
                                                                <WrapPanel Orientation="Horizontal" />
                                                            </ItemsPanelTemplate>
                                                        </ItemsControl.ItemsPanel>
                                                        <ItemsControl.ItemTemplate>
                                                            <DataTemplate x:DataType="x:String">
                                                                <Border
                                                                    Classes="label-pill"
                                                                    Background="{Binding Converter={StaticResource GitHubLabelBrushConverter}, ConverterParameter=bg}"
                                                                    ToolTip.Tip="{Binding}">
                                                                    <TextBlock
                                                                        Foreground="{Binding Converter={StaticResource GitHubLabelBrushConverter}}"
                                                                        Text="{Binding}" />
                                                                </Border>
                                                            </DataTemplate>
                                                        </ItemsControl.ItemTemplate>
                                                    </ItemsControl>
                                                </StackPanel>
                                                <TextBlock
                                                    Grid.Column="2"
                                                    VerticalAlignment="Center"
                                                    Classes="subtle"
                                                    IsVisible="{Binding Author, Converter={StaticResource StringNullOrEmptyToVisibilityConverter}}"
                                                    Text="{Binding Author}" />
                                                <TextBlock
                                                    Grid.Column="3"
                                                    VerticalAlignment="Center"
                                                    Classes="subtle"
                                                    IsVisible="{Binding AgeText, Converter={StaticResource StringNullOrEmptyToVisibilityConverter}}"
                                                    Text="{Binding AgeText}" />
                                                <Border
                                                    Grid.Column="4"
                                                    Classes="state-chip"
                                                    Background="{Binding StateChip, Converter={StaticResource GitHubStateChipBrushConverter}, ConverterParameter=bg}"
                                                    ToolTip.Tip="{Binding StateChip}">
                                                    <TextBlock
                                                        FontWeight="SemiBold"
                                                        Foreground="{Binding StateChip, Converter={StaticResource GitHubStateChipBrushConverter}}"
                                                        Text="{Binding StateChip}" />
                                                </Border>
                                            </Grid>
                                        </Button>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </StackPanel>
                    </ScrollViewer>
                </DockPanel>

                <!--  Issues tab  -->
                <DockPanel Grid.Row="1" IsVisible="{Binding IsActiveIssues}">
                    <Grid
                        Margin="0,6,0,4"
                        ColumnDefinitions="*,Auto,Auto"
                        ColumnSpacing="4"
                        DockPanel.Dock="Top">
                        <TextBlock
                            Grid.Column="0"
                            VerticalAlignment="Center"
                            Classes="subtle"
                            Text="{Binding GitHubIssues.Count, StringFormat='{}{0} open issues'}" />
                        <Button
                            Grid.Column="1"
                            VerticalAlignment="Center"
                            Classes="icon"
                            Command="{Binding RefreshGitHubCommand}"
                            IsEnabled="{Binding !IsGitHubRefreshing}"
                            ToolTip.Tip="Refresh">
                            <Path Classes="icon" Data="{tools:SvgPath icon-refresh}" />
                        </Button>
                        <Button
                            Grid.Column="2"
                            VerticalAlignment="Center"
                            Classes="icon"
                            Command="{Binding OpenGitHubIssuesCommand}"
                            ToolTip.Tip="Open the issues page on GitHub">
                            <Path
                                Width="17"
                                Height="17"
                                Data="{tools:SvgPath icon-github}"
                                Fill="{DynamicResource MutedForegroundBrush}"
                                Stretch="Uniform" />
                        </Button>
                    </Grid>
                    <ScrollViewer HorizontalScrollBarVisibility="Disabled">
                        <StackPanel Spacing="2">
                            <TextBlock
                                Margin="0,24"
                                HorizontalAlignment="Center"
                                Classes="subtle"
                                IsVisible="{Binding !GitHubHasLoaded}"
                                Text="Loading…" />
                            <TextBlock
                                Margin="0,24"
                                HorizontalAlignment="Center"
                                Classes="subtle"
                                IsVisible="{Binding ShowIssuesEmpty}"
                                Text="No open issues" />
                            <TextBlock
                                Margin="0,24"
                                HorizontalAlignment="Center"
                                Classes="subtle"
                                IsVisible="{Binding ShowGitHubUnavailable}"
                                Text="No GitHub data for this repository (is it hosted on GitHub, and is gh authenticated?)" />
                                            <ItemsControl ItemsSource="{Binding GitHubIssues}">
                                                <ItemsControl.ItemTemplate>
                                                    <DataTemplate x:DataType="entities:GitHubItem">
                                                        <Button
                                                            Classes="bar-item"
                                                            Command="{Binding $parent[UserControl].((vm:BottomBarViewModel)DataContext).OpenGitHubItemCommand}"
                                                            CommandParameter="{Binding}"
                                                            ToolTip.Tip="{Binding Url}">
                                                            <Grid ColumnDefinitions="Auto,*,Auto,Auto,Auto" ColumnSpacing="10">
                                                                <Path
                                                                    Grid.Column="0"
                                                                    Width="15"
                                                                    Height="15"
                                                                    VerticalAlignment="Center"
                                                                    Data="{tools:SvgPath icon-issue}"
                                                                    Fill="{DynamicResource StatusActiveBrush}"
                                                                    Stretch="Uniform" />
                                                                <!--  One line: number + title, then the tag
                                                                      pills, the author and the relative age.
                                                                      The title lives in a star grid cell (not a
                                                                      horizontal StackPanel, which measures at
                                                                      infinite width and would never trim).  -->
                                                                <Grid
                                                                    Grid.Column="1"
                                                                    ColumnDefinitions="Auto,*"
                                                                    ColumnSpacing="6">
                                                                    <TextBlock
                                                                        VerticalAlignment="Center"
                                                                        FontSize="13"
                                                                        FontWeight="SemiBold"
                                                                        Foreground="{DynamicResource TitleForegroundBrush}"
                                                                        Text="{Binding Number, StringFormat='#{0}'}" />
                                                                    <TextBlock
                                                                        Grid.Column="1"
                                                                        VerticalAlignment="Center"
                                                                        FontSize="13"
                                                                        Foreground="{DynamicResource TitleForegroundBrush}"
                                                                        Text="{Binding Title}"
                                                                        TextTrimming="CharacterEllipsis" />
                                                                </Grid>
                                                                <ItemsControl
                                                                    Grid.Column="2"
                                                                    VerticalAlignment="Center"
                                                                    ClipToBounds="True"
                                                                    IsVisible="{Binding HasLabels}"
                                                                    ItemsSource="{Binding Labels}"
                                                                    MaxWidth="260">
                                                                    <ItemsControl.ItemsPanel>
                                                                        <ItemsPanelTemplate>
                                                                            <StackPanel Orientation="Horizontal" />
                                                                        </ItemsPanelTemplate>
                                                                    </ItemsControl.ItemsPanel>
                                                                    <ItemsControl.ItemTemplate>
                                                                        <DataTemplate x:DataType="x:String">
                                                                            <Border
                                                                                Classes="label-pill"
                                                                                Background="{Binding Converter={StaticResource GitHubLabelBrushConverter}, ConverterParameter=bg}"
                                                                                ToolTip.Tip="{Binding}">
                                                                                <TextBlock
                                                                                    Foreground="{Binding Converter={StaticResource GitHubLabelBrushConverter}}"
                                                                                    Text="{Binding}" />
                                                                            </Border>
                                                                        </DataTemplate>
                                                                    </ItemsControl.ItemTemplate>
                                                                </ItemsControl>
                                                                <TextBlock
                                                                    Grid.Column="3"
                                                                    VerticalAlignment="Center"
                                                                    Classes="subtle"
                                                                    IsVisible="{Binding Author, Converter={StaticResource StringNullOrEmptyToVisibilityConverter}}"
                                                                    Text="{Binding Author}" />
                                                                <TextBlock
                                                                    Grid.Column="4"
                                                                    VerticalAlignment="Center"
                                                                    Classes="subtle"
                                                                    IsVisible="{Binding AgeText, Converter={StaticResource StringNullOrEmptyToVisibilityConverter}}"
                                                                    Text="{Binding AgeText}" />
                                                            </Grid>
                                                        </Button>
                                                    </DataTemplate>
                                                </ItemsControl.ItemTemplate>
                                            </ItemsControl>
                                        </StackPanel>
                                    </ScrollViewer>
                                </DockPanel>

                                <!--  Azure DevOps tab: pull requests, work items, pipeline runs  -->
                <DockPanel Grid.Row="1" IsVisible="{Binding IsActiveAzure}">
                    <Grid
                        Margin="0,6,0,4"
                        ColumnDefinitions="*,Auto,Auto"
                        ColumnSpacing="4"
                        DockPanel.Dock="Top">
                        <TextBlock
                            Grid.Column="0"
                            VerticalAlignment="Center"
                            Classes="subtle"
                            Text="Active pull requests, open work items and recent pipeline runs" />
                        <Button
                            Grid.Column="1"
                            VerticalAlignment="Center"
                            Classes="icon"
                            Command="{Binding RefreshAzureCommand}"
                            IsEnabled="{Binding !IsAzureRefreshing}"
                            ToolTip.Tip="Refresh">
                            <Path Classes="icon" Data="{tools:SvgPath icon-refresh}" />
                        </Button>
                        <Button
                            Grid.Column="2"
                            VerticalAlignment="Center"
                            Classes="icon"
                            Command="{Binding OpenAzureRepoCommand}"
                            ToolTip.Tip="Open the repository in Azure DevOps">
                            <Path
                                Width="17"
                                Height="17"
                                Data="{tools:SvgPath icon-azure-devops}"
                                Fill="{DynamicResource MutedForegroundBrush}"
                                Stretch="Uniform" />
                        </Button>
                    </Grid>
                    <ScrollViewer HorizontalScrollBarVisibility="Disabled">
                        <StackPanel Spacing="2">
                            <TextBlock
                                Margin="0,24"
                                HorizontalAlignment="Center"
                                Classes="subtle"
                                IsVisible="{Binding !AzureHasLoaded}"
                                Text="Loading…" />
                            <TextBlock
                                Margin="0,24"
                                HorizontalAlignment="Center"
                                Classes="subtle"
                                IsVisible="{Binding ShowAzureEmpty}"
                                Text="Nothing open — no pull requests, work items or pipeline runs" />
                            <TextBlock
                                Margin="0,24"
                                HorizontalAlignment="Center"
                                Classes="subtle"
                                IsVisible="{Binding ShowAzureUnavailable}"
                                Text="No Azure DevOps data for this repository (is it hosted on Azure DevOps, and is a token configured?)" />

                            <!--  Pull requests section  -->
                            <StackPanel IsVisible="{Binding HasAzurePullRequests}" Spacing="2">
                                <TextBlock
                                    Margin="4,4,0,0"
                                    Classes="field-label"
                                    Text="{Binding AzurePullRequests.Count, StringFormat='Pull Requests ({0})'}" />
                                <ItemsControl ItemsSource="{Binding AzurePullRequests}">
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate x:DataType="entities:AzureDevOpsItem">
                                            <Button
                                                Classes="bar-item"
                                                Command="{Binding $parent[UserControl].((vm:BottomBarViewModel)DataContext).OpenAzureItemCommand}"
                                                CommandParameter="{Binding}"
                                                ToolTip.Tip="{Binding Url}">
                                                <Grid ColumnDefinitions="Auto,*,Auto" ColumnSpacing="10">
                                                    <Path
                                                        Grid.Column="0"
                                                        Width="15"
                                                        Height="15"
                                                        VerticalAlignment="Center"
                                                        Data="{tools:SvgPath icon-git-pull-request}"
                                                        Fill="{DynamicResource PurpleAccentBrush}"
                                                        Stretch="Uniform" />
                                                    <StackPanel
                                                        Grid.Column="1"
                                                        VerticalAlignment="Center"
                                                        Orientation="Horizontal"
                                                        Spacing="6">
                                                        <TextBlock
                                                            VerticalAlignment="Center"
                                                            FontSize="13"
                                                            FontWeight="SemiBold"
                                                            Foreground="{DynamicResource TitleForegroundBrush}"
                                                            Text="{Binding Number, StringFormat='#{0}'}" />
                                                        <TextBlock
                                                            VerticalAlignment="Center"
                                                            FontSize="13"
                                                            Foreground="{DynamicResource TitleForegroundBrush}"
                                                            Text="{Binding Title}"
                                                            TextTrimming="CharacterEllipsis" />
                                                    </StackPanel>
                                                    <TextBlock
                                                        Grid.Column="2"
                                                        VerticalAlignment="Center"
                                                        Classes="subtle"
                                                        IsVisible="{Binding Author, Converter={StaticResource StringNullOrEmptyToVisibilityConverter}}"
                                                        Text="{Binding Author}" />
                                                </Grid>
                                            </Button>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                            </StackPanel>

                            <!--  Work items section  -->
                            <StackPanel IsVisible="{Binding HasAzureWorkItems}" Spacing="2">
                                <TextBlock
                                    Margin="4,8,0,0"
                                    Classes="field-label"
                                    Text="{Binding AzureWorkItems.Count, StringFormat='Work Items ({0})'}" />
                                <ItemsControl ItemsSource="{Binding AzureWorkItems}">
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate x:DataType="entities:AzureDevOpsItem">
                                            <Button
                                                Classes="bar-item"
                                                Command="{Binding $parent[UserControl].((vm:BottomBarViewModel)DataContext).OpenAzureItemCommand}"
                                                CommandParameter="{Binding}"
                                                ToolTip.Tip="{Binding Url}">
                                                <Grid ColumnDefinitions="Auto,*,Auto,Auto" ColumnSpacing="10">
                                                    <Path
                                                        Grid.Column="0"
                                                        Width="15"
                                                        Height="15"
                                                        VerticalAlignment="Center"
                                                        Data="{tools:SvgPath icon-issue}"
                                                        Fill="{DynamicResource StatusActiveBrush}"
                                                        Stretch="Uniform" />
                                                    <TextBlock
                                                        Grid.Column="1"
                                                        VerticalAlignment="Center"
                                                        FontSize="13"
                                                        FontWeight="SemiBold"
                                                        Foreground="{DynamicResource TitleForegroundBrush}"
                                                        Text="{Binding Number, StringFormat='#{0}'}" />
                                                    <TextBlock
                                                        Grid.Column="2"
                                                        VerticalAlignment="Center"
                                                        FontSize="13"
                                                        Foreground="{DynamicResource TitleForegroundBrush}"
                                                        Text="{Binding Title}"
                                                        TextTrimming="CharacterEllipsis" />
                                                    <TextBlock
                                                        Grid.Column="3"
                                                        VerticalAlignment="Center"
                                                        Classes="subtle"
                                                        Text="{Binding State}" />
                                                </Grid>
                                            </Button>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                            </StackPanel>

                            <!--  Pipeline runs section  -->
                            <StackPanel IsVisible="{Binding HasAzurePipelineRuns}" Spacing="2">
                                <TextBlock
                                    Margin="4,8,0,0"
                                    Classes="field-label"
                                    Text="Pipeline Runs" />
                                <ItemsControl ItemsSource="{Binding AzurePipelineRuns}">
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate x:DataType="entities:AzureDevOpsPipelineRun">
                                            <Button
                                                Classes="bar-item"
                                                Command="{Binding $parent[UserControl].((vm:BottomBarViewModel)DataContext).OpenAzurePipelineCommand}"
                                                CommandParameter="{Binding}"
                                                ToolTip.Tip="{Binding Url}">
                                                <Grid ColumnDefinitions="Auto,*,Auto" ColumnSpacing="10">
                                                    <Path
                                                        Grid.Column="0"
                                                        Width="15"
                                                        Height="15"
                                                        VerticalAlignment="Center"
                                                        Data="{tools:SvgPath icon-play}"
                                                        Fill="{Binding IsFailed, Converter={StaticResource BoolToBrushConverter}}"
                                                        Stretch="Uniform" />
                                                    <StackPanel
                                                        Grid.Column="1"
                                                        VerticalAlignment="Center"
                                                        Orientation="Horizontal"
                                                        Spacing="6">
                                                        <TextBlock
                                                            VerticalAlignment="Center"
                                                            FontSize="13"
                                                            FontWeight="SemiBold"
                                                            Foreground="{DynamicResource TitleForegroundBrush}"
                                                            Text="{Binding BuildNumber, StringFormat='Build #{0}'}" />
                                                        <TextBlock
                                                            VerticalAlignment="Center"
                                                            FontSize="13"
                                                            Foreground="{DynamicResource TitleForegroundBrush}"
                                                            Text="{Binding DefinitionName}"
                                                            TextTrimming="CharacterEllipsis" />
                                                        <TextBlock
                                                            VerticalAlignment="Center"
                                                            Classes="subtle"
                                                            Text="{Binding DisplayBranch, StringFormat='· {0}'}" />
                                                    </StackPanel>
                                                    <TextBlock
                                                        Grid.Column="2"
                                                        VerticalAlignment="Center"
                                                        Classes="subtle"
                                                        FontWeight="SemiBold"
                                                        Foreground="{Binding IsFailed, Converter={StaticResource BoolToBrushConverter}}"
                                                        Text="{Binding Result}" />
                                                </Grid>
                                            </Button>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                            </StackPanel>
                        </StackPanel>
                    </ScrollViewer>
                </DockPanel>
            </Grid>
        </Border>

    </Grid>
</UserControl>
