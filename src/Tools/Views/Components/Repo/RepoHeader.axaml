<?xml version="1.0" encoding="utf-8" ?>
<UserControl
    x:Class="Tools.Views.Components.Repo.RepoHeader"
    xmlns="https://github.com/avaloniaui"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:entities="using:Tools.Library.Entities"
    xmlns:lib="using:Tools.Library.Controls"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:tools="using:Tools.Library.MarkupExtensions"
    xmlns:vm="using:Tools.ViewModels.Components.BottomBar"
    d:DesignHeight="150"
    d:DesignWidth="1200"
    x:CompileBindings="True"
    x:DataType="vm:BottomBarViewModel"
    mc:Ignorable="d">

    <!--
            Repo detail header (per the mockup): one top row with the favorite star,
            the repo name and the current branch as a pill (click copies the branch
            name), the actions (kebab, X) right-aligned on the same line, then the
            tag chip row (every tag, removable, plus the add-tag flyout), then the
            tab row. The folder path lives in the Overview tab's Repository Details
            card; the GitHub link lives in the kebab menu only. Lives INSIDE the
            bottom bar's expandable panel, above the active tab's content; the tabs
            drive that panel. The X button (far right) closes the whole bar until
            another row is picked from the table.
    -->
    <UserControl.Styles>
        <!--  Quiet accent links (the branch-line folder link) use the app-wide
              Button.detail-link class from AppStyles.axaml — transparent, no box,
              the accent text IS the affordance, dimming slightly on hover.  -->
        <!--  Action buttons are plain default SukiUI buttons (like the Add-Repository
              dialog's Browse…) — the native theme hover highlights the whole surface,
              so no custom hover styles here.  -->
        <!--  Tag chip's remove ×: transparent icon button, muted glyph that brightens
              on hover. Base values live here — a local Background would beat them.  -->
        <Style Selector="Button.tag-remove">
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="Padding" Value="2" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="VerticalAlignment" Value="Center" />
        </Style>
        <Style Selector="Button.tag-remove Path">
            <Setter Property="Fill" Value="{DynamicResource MutedForegroundBrush}" />
        </Style>
        <Style Selector="Button.tag-remove:pointerover Path">
            <Setter Property="Fill" Value="{DynamicResource TitleForegroundBrush}" />
        </Style>
    </UserControl.Styles>

    <StackPanel Spacing="2">

        <!--  Top row: favorite star, repo name, then the current branch as a pill
              (click copies the branch name). The folder path moved to the Overview
              tab's Repository Details card; actions (kebab, panel close) sit
              right-aligned on the same line.  -->
        <Grid ColumnDefinitions="*,Auto" ColumnSpacing="12">
            <Grid Grid.Column="0" ColumnDefinitions="Auto,Auto,Auto,Auto" ColumnSpacing="10">
                <Button
                    Grid.Column="0"
                    VerticalAlignment="Center"
                    Classes="icon"
                    Command="{Binding ToggleSelectedRepoFavoriteCommand}"
                    ToolTip.Tip="Toggle favorite">
                    <Path
                        Width="18"
                        Height="18"
                        Data="{tools:SvgPath icon-star}"
                        Fill="{Binding SelectedRepo?.IsFavorite, Converter={StaticResource FavoriteStarBrushConverter}}"
                        Stretch="Uniform" />
                </Button>
                <TextBlock
                    Grid.Column="1"
                    VerticalAlignment="Center"
                    FontSize="22"
                    FontWeight="Bold"
                    Foreground="{DynamicResource TitleForegroundBrush}"
                    Text="{Binding SelectedRepoName}"
                    TextTrimming="CharacterEllipsis" />
                <!--  Vertical hairline between the name and the branch pill —
                      same divider language as the toolbar, sized to the title
                      row (full row height would reach into the star button).  -->
                <Border
                    Grid.Column="2"
                    Height="16"
                    Classes="vertical-divider" />
                <!--  Branch pill: the repo's current branch, colorized by the same
                      BranchChipBrushConverter as the repos table's branch pills
                      (main green / develop blue / release amber / master purple /
                      else muted gray — text and glyph in the solid accent, pill in
                      its translucent tint). Click copies the name; the tooltip
                      doubles as the affordance label. Hidden until the status
                      probe has produced a branch.  -->
                <Button
                    Grid.Column="3"
                    VerticalAlignment="Center"
                    Classes="detail-link"
                    Command="{Binding CopyBranchNameCommand}"
                    ToolTip.Tip="Copy branch name"
                    IsVisible="{Binding HasSelectedRepoBranchName}">
                    <Border
                        Background="{Binding SelectedRepoBranchName, Converter={StaticResource BranchChipBrushConverter}, ConverterParameter=bg}"
                        CornerRadius="{DynamicResource ChipRadius}"
                        Padding="8,3">
                        <StackPanel Orientation="Horizontal" Spacing="6">
                            <Path
                                Width="11"
                                Height="11"
                                VerticalAlignment="Center"
                                Data="{tools:SvgPath icon-source-branch}"
                                Fill="{Binding SelectedRepoBranchName, Converter={StaticResource BranchChipBrushConverter}}"
                                Stretch="Uniform" />
                            <!--  Same tail-trim as the repos table's branch
                                  pills: an over-long branch keeps its tail
                                  ("..name") instead of losing it to end
                                  ellipsis. Foreground set directly — the
                                  TextBlock-scoped class styles can't match
                                  this subclass.  -->
                            <lib:TailTrimmingTextBlock
                                MaxWidth="200"
                                VerticalAlignment="Center"
                                FontSize="13"
                                FontWeight="SemiBold"
                                Foreground="{Binding SelectedRepoBranchName, Converter={StaticResource BranchChipBrushConverter}}"
                                FullText="{Binding SelectedRepoBranchName}" />
                        </StackPanel>
                    </Border>
                </Button>
            </Grid>
            <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
                <!--  Refresh: reloads the open panel's data. The icon swaps to the
                      spinning ring while the reload runs (the command's CanExecute
                      click-locks the button; the ring is the app-wide Path.spinner).  -->
                <Button Command="{Binding RefreshPanelCommand}" ToolTip.Tip="Refresh panel">
                    <Panel>
                        <Path
                            Width="14"
                            Height="14"
                            Data="{tools:SvgPath icon-refresh}"
                            Fill="{DynamicResource BodyForegroundBrush}"
                            IsVisible="{Binding !IsPanelRefreshing}"
                            Stretch="Uniform" />
                        <Path
                            Width="13"
                            Height="13"
                            Classes="spinner"
                            Data="{tools:SvgPath icon-spinner, Center=False}"
                            IsVisible="{Binding IsPanelRefreshing}"
                            RenderTransformOrigin="50%,50%"
                            Stroke="{DynamicResource MutedForegroundBrush}"
                            StrokeThickness="2">
                            <Path.RenderTransform>
                                <RotateTransform />
                            </Path.RenderTransform>
                        </Path>
                    </Panel>
                </Button>
                <!--  Plain default buttons (like the Add-Repository dialog's Browse…):
                      the native theme hover highlights the whole surface. The kebab
                      carries the repo's GitHub entries; the Overview tab's Repository
                      Details card also links the GitHub page.  -->
                <Button ToolTip.Tip="More actions">
                    <Path
                        Width="14"
                        Height="14"
                        Data="{tools:SvgPath icon-ellipsis-vertical}"
                        Fill="{DynamicResource BodyForegroundBrush}"
                        Stretch="Uniform" />
                    <Button.Flyout>
                        <MenuFlyout Placement="BottomEdgeAlignedRight">
                            <MenuItem
                                Command="{Binding OpenGitHubRepoCommand}"
                                Header="Open in GitHub"
                                IsVisible="{Binding HasSelectedRepoGitHubUrl}" />
                            <MenuItem
                                Command="{Binding CopyGitHubUrlCommand}"
                                Header="Copy GitHub URL"
                                IsVisible="{Binding HasSelectedRepoGitHubUrl}" />
                            <MenuItem
                                Command="{Binding CopyRepoPathCommand}"
                                Header="Copy folder path"
                                IsVisible="{Binding HasSelectedRepo}" />
                        </MenuFlyout>
                    </Button.Flyout>
                </Button>
                <!--  Same compact icon button as the tool drawer's close (26x26,
                      Padding 0, muted 13px glyph) so both panels close alike.  -->
                <Button
                    Width="26"
                    Height="26"
                    Padding="0"
                    Classes="icon"
                    Command="{Binding CloseCommand}"
                    ToolTip.Tip="Close panel">
                    <Path
                        Width="13"
                        Height="13"
                        Data="{tools:SvgPath icon-close}"
                        Fill="{DynamicResource MutedForegroundBrush}"
                        Stretch="Uniform" />
                </Button>
            </StackPanel>
        </Grid>

        <!--  Tags row: every tag of the selected repo as a removable tint chip (the
              × inside a chip removes it; colors come from TagChipBrushConverter /
              ChipBrushes), plus the "Add tag" chip whose flyout takes the new name.
              The chips bind the shell's SelectedRepoTags mirror — rebuilt on repo
              switch and on the repo service's TagsChanged — and each × hands the
              chip's RepoTag (which carries its owner) straight to the remove command.
              A WrapPanel, so a long tag list wraps instead of clipping.  -->
        <StackPanel
            Margin="0,2,0,2"
            Orientation="Horizontal"
            IsVisible="{Binding HasSelectedRepo}">
            <ItemsControl VerticalAlignment="Center" ItemsSource="{Binding SelectedRepoTags}">
                <ItemsControl.ItemsPanel>
                    <ItemsPanelTemplate>
                        <WrapPanel />
                    </ItemsPanelTemplate>
                </ItemsControl.ItemsPanel>
                <ItemsControl.ItemTemplate>
                    <DataTemplate x:DataType="entities:RepoTag">
                        <Border
                            Classes="tint-chip"
                            Margin="0,2,6,2"
                            Background="{Binding Name, Converter={StaticResource TagChipBrushConverter}, ConverterParameter=bg}"
                            ToolTip.Tip="{Binding Name}">
                            <StackPanel Orientation="Horizontal" Spacing="5">
                                <TextBlock
                                    VerticalAlignment="Center"
                                    FontSize="12"
                                    FontWeight="SemiBold"
                                    Foreground="{Binding Name, Converter={StaticResource TagChipBrushConverter}}"
                                    Text="{Binding Name}" />
                                <Button
                                    Classes="tag-remove"
                                    Command="{Binding $parent[UserControl].((vm:BottomBarViewModel)DataContext).RemoveRepoTagCommand}"
                                    CommandParameter="{Binding}"
                                    ToolTip.Tip="Remove tag">
                                    <Path
                                        Width="8"
                                        Height="8"
                                        Data="{tools:SvgPath icon-close}"
                                        Stretch="Uniform" />
                                </Button>
                            </StackPanel>
                        </Border>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>
            <Button
                x:Name="AddTagButton"
                Classes="tint-chip"
                VerticalAlignment="Center"
                Background="{DynamicResource CardSubtleBackgroundBrush}"
                Cursor="Hand"
                ToolTip.Tip="Add a tag">
                <StackPanel Orientation="Horizontal" Spacing="5">
                    <Path
                        Width="10"
                        Height="10"
                        VerticalAlignment="Center"
                        Data="{tools:SvgPath icon-plus}"
                        Fill="{DynamicResource MutedForegroundBrush}"
                        Stretch="Uniform" />
                    <TextBlock
                        VerticalAlignment="Center"
                        FontSize="12"
                        Foreground="{DynamicResource MutedForegroundBrush}"
                        Text="Add tag" />
                </StackPanel>
                <Button.Flyout>
                    <Flyout Placement="BottomEdgeAlignedLeft" Opened="AddTagFlyout_OnOpened">
                        <StackPanel Spacing="10">
                            <StackPanel Orientation="Horizontal" Spacing="8">
                                <TextBox
                                    x:Name="NewTagInput"
                                    Width="170"
                                    Watermark="New tag name"
                                    KeyDown="NewTagInput_OnKeyDown" />
                                <Button
                                    x:Name="AddTagConfirmButton"
                                    Click="AddTagConfirm_OnClick"
                                    Content="Add"
                                    ToolTip.Tip="Add the tag to this repository" />
                                <Button
                                    Classes="icon"
                                    Click="AddTagClose_OnClick"
                                    ToolTip.Tip="Close">
                                    <Path
                                        Width="10"
                                        Height="10"
                                        Data="{tools:SvgPath icon-close}"
                                        Fill="{DynamicResource MutedForegroundBrush}"
                                        Stretch="Uniform" />
                                </Button>
                            </StackPanel>
                            <!--  The picker: every tag known across the repos that this
                                  repo does not carry yet, one clickable chip each (same
                                  family coloring as the row's chips). Rebuilt on every
                                  open and after each landed tag; hidden while empty.  -->
                            <StackPanel x:Name="AvailableTagsSection" Spacing="6" IsVisible="False">
                                <Border Height="1" Background="{DynamicResource HairlineBrush}" />
                                <TextBlock
                                    FontSize="11"
                                    Foreground="{DynamicResource MutedForegroundBrush}"
                                    Text="Existing tags" />
                                <ItemsControl x:Name="AvailableTagsList" MaxWidth="286">
                                    <ItemsControl.ItemsPanel>
                                        <ItemsPanelTemplate>
                                            <WrapPanel />
                                        </ItemsPanelTemplate>
                                    </ItemsControl.ItemsPanel>
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate x:DataType="x:String">
                                            <Border
                                                Classes="tint-chip"
                                                Margin="0,0,6,2"
                                                Background="{Binding Converter={StaticResource TagChipBrushConverter}, ConverterParameter=bg}"
                                                Cursor="Hand"
                                                Tapped="AvailableTag_OnTapped"
                                                ToolTip.Tip="Add this tag to the repository">
                                                <TextBlock
                                                    FontSize="12"
                                                    FontWeight="SemiBold"
                                                    Foreground="{Binding Converter={StaticResource TagChipBrushConverter}}"
                                                    Text="{Binding}" />
                                            </Border>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                            </StackPanel>
                        </StackPanel>
                    </Flyout>
                </Button.Flyout>
            </Button>
        </StackPanel>

    </StackPanel>
</UserControl>
