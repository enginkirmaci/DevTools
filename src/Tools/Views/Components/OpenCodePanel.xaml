<?xml version="1.0" encoding="utf-8" ?>
<UserControl
    x:Class="Tools.Views.Components.OpenCodePanel"
    xmlns="https://github.com/avaloniaui"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:components="using:Tools.Views.Components"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:tools="using:Tools.Library.MarkupExtensions"
    xmlns:vm="using:Tools.ViewModels.Components"
    d:DesignHeight="440"
    d:DesignWidth="1200"
    x:CompileBindings="True"
    x:DataType="vm:BottomBarViewModel"
    mc:Ignorable="d">

    <!--
        OpenCode bottom panel: the full-panel surface the repo row's options icon opens —
        the same docked card as the bottom bar's expandable panel (bar chrome, same
        height), but with a simple header instead of the tab row and no git strip.
        Opening it hides the bar and takes the page's bottom slot; the header's X
        (CloseCommand) closes it and drops the selection, exactly like the bar's X. The
        DataContext is the singleton BottomBarViewModel, attached by ReposPage (the same
        instance the bar binds — the launch targets the selected repo).
    -->
    <Grid IsVisible="{Binding IsOpenCodePanelVisible}" Margin="16,0,16,16">
        <Border
            Height="{Binding PanelHeight}"
            Background="{DynamicResource CardBackgroundBrush}"
            BorderBrush="{DynamicResource HairlineBrush}"
            BorderThickness="1"
            ClipToBounds="True"
            CornerRadius="{DynamicResource CardRadius}">
            <Grid Margin="12,8,12,12" RowDefinitions="Auto,*">

                <!--  Header: accent glyph, title + target repo (drawer-header vocabulary),
                      and the drawer-style ✕ on the right  -->
                <Grid Grid.Row="0" ColumnDefinitions="Auto,Auto,Auto,*,Auto" Margin="0,0,0,2">
                    <Path
                        Grid.Column="0"
                        Width="18"
                        Height="18"
                        VerticalAlignment="Center"
                        Data="{tools:SvgPath icon-opencode}"
                        Fill="{DynamicResource AccentPrimaryBrush}"
                        Stretch="Uniform" />
                    <TextBlock
                        Grid.Column="1"
                        Margin="10,0,0,0"
                        VerticalAlignment="Center"
                        FontSize="16"
                        FontWeight="SemiBold"
                        Foreground="{DynamicResource TitleForegroundBrush}"
                        Text="OpenCode" />
                    <TextBlock
                        Grid.Column="2"
                        Margin="12,0,0,0"
                        VerticalAlignment="Center"
                        FontSize="13"
                        Foreground="{DynamicResource MutedForegroundBrush}"
                        Text="{Binding SelectedRepoName}" />
                    <Button
                        Grid.Column="4"
                        Width="26"
                        Height="26"
                        Padding="0"
                        VerticalAlignment="Center"
                        Classes="icon"
                        Command="{Binding CloseCommand}"
                        ToolTip.Tip="Close panel">
                        <Path
                            Width="13"
                            Height="13"
                            Data="{tools:SvgPath icon-close}"
                            Fill="{DynamicResource MutedForegroundBrush}"
                            Stretch="Uniform" />
                    </Button>
                </Grid>

                <components:OpenCodeComponent Grid.Row="1" />
            </Grid>
        </Border>
    </Grid>
</UserControl>
