<?xml version="1.0" encoding="utf-8" ?>
<!--  Azure DevOps tab: pull requests, work items, pipeline runs  -->
<UserControl
    x:Class="Tools.Views.Components.BottomBar.Tabs.AzureTab"
    xmlns="https://github.com/avaloniaui"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:entities="using:Tools.Library.Entities"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:tools="using:Tools.Library.MarkupExtensions"
    xmlns:vm="using:Tools.ViewModels.Components"
    d:DesignHeight="600"
    d:DesignWidth="1200"
    x:CompileBindings="True"
    x:DataType="vm:BottomBarViewModel"
    mc:Ignorable="d">
    <UserControl.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceInclude Source="avares://Tools/Views/Components/BottomBar/BottomBarResources.axaml" />
            </ResourceDictionary.MergedDictionaries>
        </ResourceDictionary>
    </UserControl.Resources>
    <UserControl.Styles>
        <StyleInclude Source="avares://Tools/Views/Components/BottomBar/BottomBarStyles.axaml" />
    </UserControl.Styles>

    <DockPanel>
        <Grid
            Margin="0,6,0,4"
            ColumnDefinitions="*,Auto,Auto"
            ColumnSpacing="4"
            DockPanel.Dock="Top">
            <TextBlock
                Grid.Column="0"
                VerticalAlignment="Center"
                Classes="subtle"
                Text="Active pull requests, open work items and recent pipeline runs" />
            <Button
                Grid.Column="1"
                VerticalAlignment="Center"
                Classes="icon"
                Command="{Binding RefreshAzureCommand}"
                IsEnabled="{Binding !IsAzureRefreshing}"
                ToolTip.Tip="Refresh">
                <Panel>
                    <Path
                        Classes="icon"
                        Data="{tools:SvgPath icon-refresh}"
                        IsVisible="{Binding !IsAzureRefreshing}" />
                    <Path
                        Width="13"
                        Height="13"
                        Classes="spinner"
                        Data="{tools:SvgPath icon-spinner, Center=False}"
                        IsVisible="{Binding IsAzureRefreshing}"
                        RenderTransformOrigin="50%,50%"
                        Stroke="{DynamicResource MutedForegroundBrush}"
                        StrokeThickness="2">
                        <Path.RenderTransform>
                            <RotateTransform />
                        </Path.RenderTransform>
                    </Path>
                </Panel>
            </Button>
            <Button
                Grid.Column="2"
                VerticalAlignment="Center"
                Classes="icon"
                Command="{Binding OpenAzureRepoCommand}"
                ToolTip.Tip="Open the repository in Azure DevOps">
                <Path
                    Width="17"
                    Height="17"
                    Data="{tools:SvgPath icon-azure-devops}"
                    Fill="{DynamicResource MutedForegroundBrush}"
                    Stretch="Uniform" />
            </Button>
        </Grid>
        <ScrollViewer HorizontalScrollBarVisibility="Disabled">
            <StackPanel Spacing="2">
                <TextBlock
                    Classes="list-note subtle"
                    IsVisible="{Binding !AzureHasLoaded}"
                    Text="Loading…" />
                <TextBlock
                    Classes="list-note subtle"
                    IsVisible="{Binding ShowAzureEmpty}"
                    Text="Nothing open — no pull requests, work items or pipeline runs" />
                <TextBlock
                    Classes="list-note subtle"
                    IsVisible="{Binding ShowAzureUnavailable}"
                    Text="No Azure DevOps data for this repository (is it hosted on Azure DevOps, and is a token configured?)" />

                <!--  Pull requests section  -->
                <StackPanel IsVisible="{Binding HasAzurePullRequests}" Spacing="2">
                    <TextBlock
                        Margin="4,4,0,0"
                        Classes="field-label"
                        Text="{Binding AzurePullRequests.Count, StringFormat='Pull Requests ({0})'}" />
                    <ItemsControl ItemsSource="{Binding AzurePullRequests}">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate x:DataType="entities:AzureDevOpsItem">
                                <Button
                                    Classes="bar-item"
                                    Command="{Binding $parent[UserControl].((vm:BottomBarViewModel)DataContext).OpenAzureItemCommand}"
                                    CommandParameter="{Binding}"
                                    ToolTip.Tip="{Binding Url}">
                                    <Grid ColumnDefinitions="Auto,*,Auto" ColumnSpacing="10">
                                        <Path
                                            Grid.Column="0"
                                            Width="15"
                                            Height="15"
                                            VerticalAlignment="Center"
                                            Data="{tools:SvgPath icon-git-pull-request}"
                                            Fill="{DynamicResource PurpleAccentBrush}"
                                            Stretch="Uniform" />
                                        <ContentPresenter
                                            Grid.Column="1"
                                            VerticalAlignment="Center"
                                            Content="{Binding}"
                                            ContentTemplate="{StaticResource AzureTitleLine13}" />
                                        <TextBlock
                                            Grid.Column="2"
                                            VerticalAlignment="Center"
                                            Classes="subtle"
                                            IsVisible="{Binding Author, Converter={StaticResource StringNullOrEmptyToVisibilityConverter}}"
                                            Text="{Binding Author}" />
                                    </Grid>
                                </Button>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </StackPanel>

                <!--  Work items section  -->
                <StackPanel IsVisible="{Binding HasAzureWorkItems}" Spacing="2">
                    <TextBlock
                        Margin="4,8,0,0"
                        Classes="field-label"
                        Text="{Binding AzureWorkItems.Count, StringFormat='Work Items ({0})'}" />
                    <ItemsControl ItemsSource="{Binding AzureWorkItems}">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate x:DataType="entities:AzureDevOpsItem">
                                <Button
                                    Classes="bar-item"
                                    Command="{Binding $parent[UserControl].((vm:BottomBarViewModel)DataContext).OpenAzureItemCommand}"
                                    CommandParameter="{Binding}"
                                    ToolTip.Tip="{Binding Url}">
                                    <Grid ColumnDefinitions="Auto,*,Auto" ColumnSpacing="10">
                                        <Path
                                            Grid.Column="0"
                                            Width="15"
                                            Height="15"
                                            VerticalAlignment="Center"
                                            Data="{tools:SvgPath icon-issue}"
                                            Fill="{DynamicResource StatusActiveBrush}"
                                            Stretch="Uniform" />
                                        <ContentPresenter
                                            Grid.Column="1"
                                            VerticalAlignment="Center"
                                            Content="{Binding}"
                                            ContentTemplate="{StaticResource AzureTitleLine13}" />
                                        <TextBlock
                                            Grid.Column="2"
                                            VerticalAlignment="Center"
                                            Classes="subtle"
                                            Text="{Binding State}" />
                                    </Grid>
                                </Button>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </StackPanel>

                <!--  Pipeline runs section  -->
                <StackPanel IsVisible="{Binding HasAzurePipelineRuns}" Spacing="2">
                    <TextBlock
                        Margin="4,8,0,0"
                        Classes="field-label"
                        Text="Pipeline Runs" />
                    <ItemsControl ItemsSource="{Binding AzurePipelineRuns}">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate x:DataType="entities:AzureDevOpsPipelineRun">
                                <Button
                                    Classes="bar-item"
                                    Command="{Binding $parent[UserControl].((vm:BottomBarViewModel)DataContext).OpenAzurePipelineCommand}"
                                    CommandParameter="{Binding}"
                                    ToolTip.Tip="{Binding Url}">
                                    <Grid ColumnDefinitions="Auto,*,Auto" ColumnSpacing="10">
                                        <Path
                                            Grid.Column="0"
                                            Width="15"
                                            Height="15"
                                            VerticalAlignment="Center"
                                            Data="{tools:SvgPath icon-play}"
                                            Fill="{Binding IsFailed, Converter={StaticResource BoolToBrushConverter}}"
                                            Stretch="Uniform" />
                                        <StackPanel
                                            Grid.Column="1"
                                            VerticalAlignment="Center"
                                            Orientation="Horizontal"
                                            Spacing="6">
                                            <TextBlock
                                                VerticalAlignment="Center"
                                                FontSize="13"
                                                FontWeight="SemiBold"
                                                Foreground="{DynamicResource TitleForegroundBrush}"
                                                Text="{Binding BuildNumber, StringFormat='Build #{0}'}" />
                                            <TextBlock
                                                VerticalAlignment="Center"
                                                FontSize="13"
                                                Foreground="{DynamicResource TitleForegroundBrush}"
                                                Text="{Binding DefinitionName}"
                                                TextTrimming="CharacterEllipsis" />
                                            <TextBlock
                                                VerticalAlignment="Center"
                                                Classes="subtle"
                                                Text="{Binding DisplayBranch, StringFormat='· {0}'}" />
                                        </StackPanel>
                                        <TextBlock
                                            Grid.Column="2"
                                            VerticalAlignment="Center"
                                            Classes="subtle"
                                            FontWeight="SemiBold"
                                            Foreground="{Binding IsFailed, Converter={StaticResource BoolToBrushConverter}}"
                                            Text="{Binding Result}" />
                                    </Grid>
                                </Button>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </StackPanel>
            </StackPanel>
        </ScrollViewer>
    </DockPanel>
</UserControl>
