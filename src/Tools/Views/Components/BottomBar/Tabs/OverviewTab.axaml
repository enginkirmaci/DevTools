<?xml version="1.0" encoding="utf-8" ?>
<!--
    Overview tab: the selected repo's README pane (fill) beside a sidebar of
    the three count tiles over the Repository Details card. The shared
    row/card templates and styles come from BottomBarResources.axaml.
-->
<UserControl
    x:Class="Tools.Views.Components.BottomBar.Tabs.OverviewTab"
    xmlns="https://github.com/avaloniaui"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:entities="using:Tools.Library.Entities"
    xmlns:lib="using:Tools.Library.Controls"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:mk="using:MarkdownViewerKit"
    xmlns:tools="using:Tools.Library.MarkupExtensions"
    xmlns:vm="using:Tools.ViewModels.Components.BottomBar"
    d:DesignHeight="600"
    d:DesignWidth="1200"
    x:CompileBindings="True"
    x:DataType="vm:BottomBarViewModel"
    mc:Ignorable="d">
    <UserControl.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceInclude Source="avares://Tools/Views/Components/BottomBar/BottomBarResources.axaml" />
            </ResourceDictionary.MergedDictionaries>
        </ResourceDictionary>
    </UserControl.Resources>
    <UserControl.Styles>
        <StyleInclude Source="avares://Tools/Views/Components/BottomBar/BottomBarStyles.axaml" />
    </UserControl.Styles>

    <Grid ColumnDefinitions="6*,4*" ColumnSpacing="10">
        <!--  Sidebar: the three count tiles in a row over the Repository
              Details card. Spacing comes from the buttons' top margins —
              Grid row spacing survives collapsed rows, so GitHub-off would
              leave phantom gaps above the hidden PR/Issues cards. The grid
              gives it a 4* share — the README pane takes the other six —
              so no fixed column exists to push a border out when space
              runs short.  -->
        <Grid
            Grid.Column="1"
            RowDefinitions="Auto,*">
            <!--  The three count tiles sit above the details card, three
                  across; side margins instead of UniformGrid spacing (which
                  has none) and no row gaps to leak through collapsed
                  GitHub-off cells.  -->
            <UniformGrid
                Grid.Row="0"
                Columns="3"
                Margin="0,0,0,10"
                IsVisible="{Binding !DailySummary.IsOpen}">
                <Button
                    Margin="0,0,5,0"
                    Classes="ov-card-btn"
                    Command="{Binding ToggleChangesTabCommand}"
                    Content="{Binding}"
                    ContentTemplate="{StaticResource StatCardChanges}"
                    ToolTip.Tip="Open the Changes tab" />
                <Button
                    Margin="5,0"
                    Classes="ov-card-btn"
                    Command="{Binding TogglePullRequestsTabCommand}"
                    Content="{Binding}"
                    ContentTemplate="{StaticResource StatCardPullRequests}"
                    IsVisible="{Binding IsGitHubEnabled}"
                    ToolTip.Tip="Open the Pull Requests tab" />
                <Button
                    Margin="5,0,0,0"
                    Classes="ov-card-btn"
                    Command="{Binding ToggleIssuesTabCommand}"
                    Content="{Binding}"
                    ContentTemplate="{StaticResource StatCardIssues}"
                    IsVisible="{Binding IsGitHubEnabled}"
                    ToolTip.Tip="Open the Issues tab" />
            </UniformGrid>
            <Border
                Grid.Row="1"
                Classes="ov-card"
                IsVisible="{Binding !DailySummary.IsOpen}">
            <DockPanel>
                <TextBlock
                    Margin="0,0,0,6"
                    Classes="ov-card-title"
                    DockPanel.Dock="Top"
                    Text="Repository Details" />
                <ScrollViewer HorizontalScrollBarVisibility="Disabled">
                    <StackPanel Spacing="8">
                        <StackPanel.Styles>
                            <Style Selector="TextBlock.detail-key">
                                <Setter Property="Foreground" Value="{DynamicResource MutedForegroundBrush}" />
                            </Style>
                            <Style Selector="TextBlock.detail-value">
                                <Setter Property="Foreground" Value="{DynamicResource BodyForegroundBrush}" />
                            </Style>
                        </StackPanel.Styles>
                        <TextBlock
                            Classes="subtle"
                            IsVisible="{Binding !HasRepoDetails}"
                            Text="No GitHub data for this repository"
                            TextWrapping="Wrap" />
                        <!--
                            GitHub link row: the repo's page as a clickable
                            display URL. Sits OUTSIDE the details gate so it
                            shows whenever the repo has a GitHub remote — even
                            while the gh details are still loading (or absent).
                        -->
                        <Grid
                            ColumnDefinitions="110,*"
                            ColumnSpacing="10"
                            IsVisible="{Binding HasSelectedRepoGitHubUrl}">
                            <TextBlock Classes="detail-key" Text="GitHub" />
                            <Button
                                Grid.Column="1"
                                Classes="detail-link"
                                Command="{Binding OpenGitHubRepoCommand}"
                                HorizontalContentAlignment="Left"
                                ToolTip.Tip="Open the repository's GitHub page">
                                <!--  *,Auto grid instead of a hugging StackPanel: the text cell gets finite
                                      measure, so TailTrimmingTextBlock trims to whatever the sidebar
                                      actually offers — a fixed cap would over-trim when the column
                                      widens. The control is a TextBlock subclass, so the
                                      TextBlock.detail-value class style never matches it — set the
                                      foreground directly.  -->
                                <Grid ColumnDefinitions="*,Auto" HorizontalAlignment="Left">
                                    <lib:TailTrimmingTextBlock
                                        VerticalAlignment="Center"
                                        Foreground="{DynamicResource BodyForegroundBrush}"
                                        FullText="{Binding SelectedRepoGitHubDisplayUrl}"
                                        ToolTip.Tip="{Binding SelectedRepoGitHubDisplayUrl, TargetNullValue=''}" />
                                    <Path
                                        Grid.Column="1"
                                        Width="12"
                                        Height="12"
                                        VerticalAlignment="Center"
                                        Data="{tools:SvgPath icon-open-in-new}"
                                        Fill="{DynamicResource MutedForegroundBrush}"
                                        Stretch="Uniform" />
                                </Grid>
                            </Button>
                        </Grid>
                        <!--
                            Folder row: the repo's local path, moved here from the
                            header's name row. Clickable to open the file manager,
                            like the GitHub row; also outside the details gate —
                            the path exists with or without gh data.
                        -->
                        <Grid
                            ColumnDefinitions="110,*"
                            ColumnSpacing="10"
                            IsVisible="{Binding HasSelectedRepo}">
                            <TextBlock Classes="detail-key" Text="Folder" />
                            <Button
                                Grid.Column="1"
                                Classes="detail-link"
                                Command="{Binding OpenRepoFolderCommand}"
                                HorizontalContentAlignment="Left"
                                ToolTip.Tip="Open the repository folder">
                                <!--  Same *,Auto cell: the folder path trims to the offered width (tail
                                      visible) and the button stretches with the sidebar.  -->
                                <Grid ColumnDefinitions="*,Auto" HorizontalAlignment="Left">
                                    <lib:TailTrimmingTextBlock
                                        VerticalAlignment="Center"
                                        Foreground="{DynamicResource BodyForegroundBrush}"
                                        FullText="{Binding SelectedRepoFolderPath}"
                                        ToolTip.Tip="{Binding SelectedRepoFolderPath, TargetNullValue=''}" />
                                    <Path
                                        Grid.Column="1"
                                        Width="12"
                                        Height="12"
                                        VerticalAlignment="Center"
                                        Data="{tools:SvgPath icon-open-in-new}"
                                        Fill="{DynamicResource MutedForegroundBrush}"
                                        Stretch="Uniform" />
                                </Grid>
                            </Button>
                        </Grid>
                        <Grid
                            ColumnDefinitions="Auto,*"
                            ColumnSpacing="10"
                            IsVisible="{Binding HasRepoDetails}">
                            <StackPanel Grid.ColumnSpan="2" Spacing="6">
                                <Grid
                                    ColumnDefinitions="110,*"
                                    ColumnSpacing="10"
                                    IsVisible="{Binding SelectedRepoDetails?.Owner, Converter={StaticResource StringNullOrEmptyToVisibilityConverter}}">
                                    <TextBlock Classes="detail-key" Text="Owner" />
                                    <TextBlock
                                        Grid.Column="1"
                                        Classes="detail-value"
                                        Text="{Binding SelectedRepoDetails?.Owner}"
                                        ToolTip.Tip="{Binding SelectedRepoDetails?.Owner, TargetNullValue=''}"
                                        TextTrimming="CharacterEllipsis" />
                                </Grid>
                                <Grid
                                    ColumnDefinitions="110,*"
                                    ColumnSpacing="10"
                                    IsVisible="{Binding SelectedRepoDetails?.CreatedAt, Converter={StaticResource NotNullToBoolConverter}}">
                                    <TextBlock Classes="detail-key" Text="Created" />
                                    <TextBlock
                                        Grid.Column="1"
                                        Classes="detail-value"
                                        Text="{Binding SelectedRepoDetails?.CreatedAt, StringFormat='d MMM yyyy'}" />
                                </Grid>
                                <Grid
                                    ColumnDefinitions="110,*"
                                    ColumnSpacing="10"
                                    IsVisible="{Binding SelectedRepoDetails?.Language, Converter={StaticResource StringNullOrEmptyToVisibilityConverter}}">
                                    <TextBlock Classes="detail-key" Text="Language" />
                                    <TextBlock
                                        Grid.Column="1"
                                        Classes="detail-value"
                                        Text="{Binding SelectedRepoDetails?.Language}" />
                                </Grid>
                                <Grid
                                    ColumnDefinitions="110,*"
                                    ColumnSpacing="10"
                                    IsVisible="{Binding SelectedRepoDetails?.License, Converter={StaticResource StringNullOrEmptyToVisibilityConverter}}">
                                    <TextBlock Classes="detail-key" Text="License" />
                                    <TextBlock
                                        Grid.Column="1"
                                        Classes="detail-value"
                                        Text="{Binding SelectedRepoDetails?.License}" />
                                </Grid>
                                <Grid
                                    ColumnDefinitions="110,*"
                                    ColumnSpacing="10"
                                    IsVisible="{Binding SelectedRepoDetails?.DefaultBranch, Converter={StaticResource StringNullOrEmptyToVisibilityConverter}}">
                                    <TextBlock Classes="detail-key" Text="Default Branch" />
                                    <TextBlock
                                        Grid.Column="1"
                                        Classes="detail-value"
                                        Text="{Binding SelectedRepoDetails?.DefaultBranch}" />
                                </Grid>
                            </StackPanel>
                        </Grid>
                        <!--  Topics chips  -->
                        <StackPanel IsVisible="{Binding SelectedRepoDetails?.HasTopics, TargetNullValue=False}">
                            <TextBlock Classes="detail-key" Text="Topics" />
                            <ItemsControl Margin="0,4,0,0" ItemsSource="{Binding SelectedRepoDetails?.Topics}">
                                <ItemsControl.ItemsPanel>
                                    <ItemsPanelTemplate>
                                        <WrapPanel Orientation="Horizontal" />
                                    </ItemsPanelTemplate>
                                </ItemsControl.ItemsPanel>
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate x:DataType="x:String">
                                        <Border
                                            Margin="0,0,6,6"
                                            Padding="7,2"
                                            Classes="chip">
                                            <TextBlock Classes="subtle" Text="{Binding}" />
                                        </Border>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </StackPanel>
                    </StackPanel>
                </ScrollViewer>
            </DockPanel>
        </Border>

            <!--  Daily summary card: opencode's report of the repo's previous local
                  day (commits + uncommitted changes), opened from the title-bar
                  sparkle and persisted next to the repo's notes. Covers the whole
                  sidebar — tiles and details hide while it is open.  -->
            <Border
                Grid.Row="0"
                Grid.RowSpan="2"
                Classes="ov-card"
                IsVisible="{Binding DailySummary.IsOpen}">
                <DockPanel>
                    <Grid
                        ColumnDefinitions="*,Auto,Auto"
                        Margin="0,0,0,6"
                        DockPanel.Dock="Top">
                        <StackPanel Grid.Column="0" VerticalAlignment="Center">
                            <TextBlock Classes="ov-card-title" Text="Yesterday" />
                            <TextBlock
                                Classes="subtle"
                                Text="{Binding DailySummary.SummaryDateLabel}" />
                        </StackPanel>
                        <!--  Regenerate: same ring recipe as the README wand  -->
                        <Button
                            Grid.Column="1"
                            Classes="detail-link"
                            Padding="4"
                            VerticalAlignment="Center"
                            IsVisible="{Binding DailySummary.CanGenerate}"
                            Command="{Binding DailySummary.GenerateCommand}"
                            ToolTip.Tip="Regenerate yesterday's summary">
                            <Grid>
                                <Path
                                    Width="16"
                                    Height="16"
                                    IsVisible="{Binding DailySummary.IsGenerating}"
                                    Classes="spinner"
                                    RenderTransformOrigin="50%,50%"
                                    Data="M 8 1 A 7 7 0 1 1 1 8"
                                    Stroke="{DynamicResource AccentPrimaryBrush}"
                                    StrokeThickness="2">
                                    <Path.RenderTransform>
                                        <RotateTransform />
                                    </Path.RenderTransform>
                                </Path>
                                <Path
                                    Width="16"
                                    Height="16"
                                    IsVisible="{Binding !DailySummary.IsGenerating}"
                                    Data="{tools:SvgPath icon-wand}"
                                    Fill="{DynamicResource MutedForegroundBrush}"
                                    Stretch="Uniform" />
                            </Grid>
                        </Button>
                        <Button
                            Grid.Column="2"
                            Width="26"
                            Height="26"
                            Margin="6,0,0,0"
                            Padding="0"
                            Classes="icon"
                            VerticalAlignment="Center"
                            Command="{Binding DailySummary.CloseCommand}"
                            ToolTip.Tip="Back to details">
                            <Path
                                Width="13"
                                Height="13"
                                Data="{tools:SvgPath icon-close}"
                                Fill="{DynamicResource MutedForegroundBrush}"
                                Stretch="Uniform" />
                        </Button>
                    </Grid>
                    <Grid>
                        <mk:MarkdownViewer
                            IsVisible="{Binding DailySummary.HasSummary}"
                            Markdown="{Binding DailySummary.SummaryMarkdown, Mode=OneWay}" />
                        <StackPanel
                            HorizontalAlignment="Center"
                            VerticalAlignment="Center"
                            Spacing="10"
                            IsVisible="{Binding DailySummary.IsGenerating}">
                            <Path
                                Width="22"
                                Height="22"
                                HorizontalAlignment="Center"
                                Classes="spinner"
                                RenderTransformOrigin="50%,50%"
                                Data="M 11 1.5 A 9.5 9.5 0 1 1 1.5 11"
                                Stroke="{DynamicResource AccentPrimaryBrush}"
                                StrokeThickness="2">
                                <Path.RenderTransform>
                                    <RotateTransform />
                                </Path.RenderTransform>
                            </Path>
                            <TextBlock
                                Classes="subtle"
                                HorizontalAlignment="Center"
                                Text="Generating yesterday's summary…" />
                        </StackPanel>
                        <TextBlock
                            Classes="subtle"
                            HorizontalAlignment="Center"
                            TextAlignment="Center"
                            TextWrapping="Wrap"
                            IsVisible="{Binding DailySummary.ShowEmptyState}"
                            Text="{Binding DailySummary.EmptyStateText}" />
                    </Grid>
                </DockPanel>
            </Border>
        </Grid>

        <!--  README pane: the selected repo's README.md — generated in place with the
              wand (opencode) when missing, saved back with the Save button once the
              content is generated or ahead of disk. The pane itself stays up whether
              or not the repo has a readme, so the area never reflows; it fills the
              6* column of the root grid — a 60/40 split with the sidebar.  -->
        <Border
            Grid.Column="0"
            Classes="ov-card"
            MinHeight="140"
            IsVisible="{Binding HasSelectedRepo}">
            <DockPanel>
                <Grid ColumnDefinitions="*,Auto" Margin="0,0,0,6" DockPanel.Dock="Top">
                    <TextBlock Classes="ov-card-title" Text="README.md" />
                    <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
                        <Button
                            Classes="detail-link"
                            Padding="6,2"
                            IsVisible="{Binding ReadmeDirty}"
                            Command="{Binding SaveReadmeCommand}"
                            ToolTip.Tip="Save README.md to the repository folder">
                            <StackPanel Orientation="Horizontal" Spacing="5">
                                <Path
                                    Width="12"
                                    Height="12"
                                    VerticalAlignment="Center"
                                    Data="{tools:SvgPath icon-save}"
                                    Fill="{Binding $parent[Button].Foreground}"
                                    Stretch="Uniform" />
                                <TextBlock Text="Save" />
                            </StackPanel>
                        </Button>
                        <Button
                            Classes="detail-link"
                            Padding="4"
                            IsVisible="{Binding ShowReadmeWand}"
                            Command="{Binding GenerateReadmeCommand}"
                            ToolTip.Tip="{Binding ReadmeWandToolTip}">
                            <!--  same ring recipe as the commit wand: element-space arc,
                                  no Stretch, rotation pivoting on the center  -->
                            <Grid>
                                <Path
                                    Width="16"
                                    Height="16"
                                    IsVisible="{Binding IsGeneratingReadme}"
                                    Classes="spinner"
                                    RenderTransformOrigin="50%,50%"
                                    Data="M 8 1 A 7 7 0 1 1 1 8"
                                    Stroke="{DynamicResource AccentPrimaryBrush}"
                                    StrokeThickness="2">
                                    <Path.RenderTransform>
                                        <RotateTransform />
                                    </Path.RenderTransform>
                                </Path>
                                <Path
                                    Width="16"
                                    Height="16"
                                    IsVisible="{Binding !IsGeneratingReadme}"
                                    Data="{tools:SvgPath icon-wand}"
                                    Fill="{DynamicResource MutedForegroundBrush}"
                                    Stretch="Uniform" />
                            </Grid>
                        </Button>
                    </StackPanel>
                </Grid>
                <Grid>
                    <mk:MarkdownViewer IsVisible="{Binding HasReadme}" Markdown="{Binding ReadmeText, Mode=OneWay}" />
                    <StackPanel
                        HorizontalAlignment="Center"
                        VerticalAlignment="Center"
                        Spacing="10"
                        IsVisible="{Binding !HasReadme}">
                        <Button
                            HorizontalAlignment="Center"
                            Classes="detail-link"
                            Padding="10"
                            IsVisible="{Binding HasOpenCode}"
                            Command="{Binding GenerateReadmeCommand}"
                            ToolTip.Tip="{Binding ReadmeWandToolTip}">
                            <Path
                                Width="22"
                                Height="22"
                                Data="{tools:SvgPath icon-wand}"
                                Fill="{DynamicResource MutedForegroundBrush}"
                                Stretch="Uniform" />
                        </Button>
                        <TextBlock
                            Classes="subtle"
                            HorizontalAlignment="Center"
                            Text="No README.md yet — generate one for this project" />
                    </StackPanel>
                </Grid>
            </DockPanel>
        </Border>
    </Grid>
</UserControl>
