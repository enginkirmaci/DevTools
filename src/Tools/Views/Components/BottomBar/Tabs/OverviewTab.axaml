<?xml version="1.0" encoding="utf-8" ?>
<!--
    Overview tab: the selected repo's README pane (fill) beside a sidebar of
    the three count tiles over the Repository Details card. The shared
    row/card templates and styles come from BottomBarResources.axaml.
-->
<UserControl
    x:Class="Tools.Views.Components.BottomBar.Tabs.OverviewTab"
    xmlns="https://github.com/avaloniaui"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:entities="using:Tools.Library.Entities"
    xmlns:lib="using:Tools.Library.Controls"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:tools="using:Tools.Library.MarkupExtensions"
    xmlns:vm="using:Tools.ViewModels.Components.BottomBar"
    d:DesignHeight="600"
    d:DesignWidth="1200"
    x:CompileBindings="True"
    x:DataType="vm:BottomBarViewModel"
    mc:Ignorable="d">
    <UserControl.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceInclude Source="avares://Tools/Views/Components/BottomBar/BottomBarResources.axaml" />
            </ResourceDictionary.MergedDictionaries>
        </ResourceDictionary>
    </UserControl.Resources>
    <UserControl.Styles>
        <StyleInclude Source="avares://Tools/Views/Components/BottomBar/BottomBarStyles.axaml" />
    </UserControl.Styles>

    <DockPanel>
        <!--  Sidebar: the three count tiles in a row over the Repository
              Details card. Spacing comes from the buttons' top margins —
              Grid row spacing survives collapsed rows, so GitHub-off would
              leave phantom gaps above the hidden PR/Issues cards. Docked
              Right at a fixed width BEFORE the fill child: when space runs
              short the README pane clips its content instead of pushing the
              sidebar's border out of the panel.  -->
        <Grid
            DockPanel.Dock="Right"
            Width="380"
            Margin="10,0,0,0"
            RowDefinitions="Auto,*">
            <!--  The three count tiles sit above the details card, three
                  across; side margins instead of UniformGrid spacing (which
                  has none) and no row gaps to leak through collapsed
                  GitHub-off cells.  -->
            <UniformGrid
                Grid.Row="0"
                Columns="3"
                Margin="0,0,0,10">
                <Button
                    Margin="0,0,5,0"
                    Classes="ov-card-btn"
                    Command="{Binding ToggleChangesTabCommand}"
                    Content="{Binding}"
                    ContentTemplate="{StaticResource StatCardChanges}"
                    ToolTip.Tip="Open the Changes tab" />
                <Button
                    Margin="5,0"
                    Classes="ov-card-btn"
                    Command="{Binding TogglePullRequestsTabCommand}"
                    Content="{Binding}"
                    ContentTemplate="{StaticResource StatCardPullRequests}"
                    IsVisible="{Binding IsGitHubEnabled}"
                    ToolTip.Tip="Open the Pull Requests tab" />
                <Button
                    Margin="5,0,0,0"
                    Classes="ov-card-btn"
                    Command="{Binding ToggleIssuesTabCommand}"
                    Content="{Binding}"
                    ContentTemplate="{StaticResource StatCardIssues}"
                    IsVisible="{Binding IsGitHubEnabled}"
                    ToolTip.Tip="Open the Issues tab" />
            </UniformGrid>
            <Border Grid.Row="1" Classes="ov-card">
            <DockPanel>
                <TextBlock
                    Margin="0,0,0,6"
                    Classes="ov-card-title"
                    DockPanel.Dock="Top"
                    Text="Repository Details" />
                <ScrollViewer HorizontalScrollBarVisibility="Disabled">
                    <StackPanel Spacing="8">
                        <StackPanel.Styles>
                            <Style Selector="TextBlock.detail-key">
                                <Setter Property="Foreground" Value="{DynamicResource MutedForegroundBrush}" />
                            </Style>
                            <Style Selector="TextBlock.detail-value">
                                <Setter Property="Foreground" Value="{DynamicResource BodyForegroundBrush}" />
                            </Style>
                        </StackPanel.Styles>
                        <TextBlock
                            Classes="subtle"
                            IsVisible="{Binding !HasRepoDetails}"
                            Text="No GitHub data for this repository"
                            TextWrapping="Wrap" />
                        <!--
                            GitHub link row: the repo's page as a clickable
                            display URL. Sits OUTSIDE the details gate so it
                            shows whenever the repo has a GitHub remote — even
                            while the gh details are still loading (or absent).
                        -->
                        <Grid
                            ColumnDefinitions="110,*"
                            ColumnSpacing="10"
                            IsVisible="{Binding HasSelectedRepoGitHubUrl}">
                            <TextBlock Classes="detail-key" Text="GitHub" />
                            <Button
                                Grid.Column="1"
                                Classes="detail-link"
                                Command="{Binding OpenGitHubRepoCommand}"
                                HorizontalAlignment="Left"
                                ToolTip.Tip="Open the repository's GitHub page">
                                <StackPanel Orientation="Horizontal" Spacing="6">
                                    <!--  The cap is a named resource (GitHubUrlMaxWidth in
                                          BottomBarResources): the sidebar is a fixed 380px
                                          column, so after the 110px key + paddings the value
                                          cell has ~234px and the cap keeps ~24px slack —
                                          the URL must be capped explicitly because the
                                          button's content presenter hugs (SukiUI) and
                                          TextTrimming never fires under infinite measure.  -->
                                    <!--  Tail-trim like the repos table's branch
                                          pills (the tail tells owner/repo apart);
                                          TailTrimmingTextBlock is a TextBlock
                                          subclass, so the TextBlock.detail-value
                                          class style never matches it — set the
                                          foreground directly.  -->
                                    <lib:TailTrimmingTextBlock
                                        MaxWidth="{StaticResource GitHubUrlMaxWidth}"
                                        VerticalAlignment="Center"
                                        Foreground="{DynamicResource BodyForegroundBrush}"
                                        FullText="{Binding SelectedRepoGitHubDisplayUrl}" />
                                    <Path
                                        Width="12"
                                        Height="12"
                                        VerticalAlignment="Center"
                                        Data="{tools:SvgPath icon-open-in-new}"
                                        Fill="{DynamicResource MutedForegroundBrush}"
                                        Stretch="Uniform" />
                                </StackPanel>
                            </Button>
                        </Grid>
                        <!--
                            Folder row: the repo's local path, moved here from the
                            header's name row. Clickable to open the file manager,
                            like the GitHub row; also outside the details gate —
                            the path exists with or without gh data.
                        -->
                        <Grid
                            ColumnDefinitions="110,*"
                            ColumnSpacing="10"
                            IsVisible="{Binding HasSelectedRepo}">
                            <TextBlock Classes="detail-key" Text="Folder" />
                            <Button
                                Grid.Column="1"
                                Classes="detail-link"
                                Command="{Binding OpenRepoFolderCommand}"
                                HorizontalAlignment="Left"
                                ToolTip.Tip="Open the repository folder">
                                <StackPanel Orientation="Horizontal" Spacing="6">
                                    <!--  Same tail-trim: a truncated folder path
                                          keeps its repo-name end; the full path
                                          stays on the tooltip.  -->
                                    <lib:TailTrimmingTextBlock
                                        MaxWidth="{StaticResource GitHubUrlMaxWidth}"
                                        VerticalAlignment="Center"
                                        Foreground="{DynamicResource BodyForegroundBrush}"
                                        FullText="{Binding SelectedRepoFolderPath}"
                                        ToolTip.Tip="{Binding SelectedRepoFolderPath, TargetNullValue=''}" />
                                    <Path
                                        Width="12"
                                        Height="12"
                                        VerticalAlignment="Center"
                                        Data="{tools:SvgPath icon-open-in-new}"
                                        Fill="{DynamicResource MutedForegroundBrush}"
                                        Stretch="Uniform" />
                                </StackPanel>
                            </Button>
                        </Grid>
                        <Grid
                            ColumnDefinitions="Auto,*"
                            ColumnSpacing="10"
                            IsVisible="{Binding HasRepoDetails}">
                            <StackPanel Grid.ColumnSpan="2" Spacing="6">
                                <Grid
                                    ColumnDefinitions="110,*"
                                    ColumnSpacing="10"
                                    IsVisible="{Binding SelectedRepoDetails?.Owner, Converter={StaticResource StringNullOrEmptyToVisibilityConverter}}">
                                    <TextBlock Classes="detail-key" Text="Owner" />
                                    <TextBlock
                                        Grid.Column="1"
                                        Classes="detail-value"
                                        Text="{Binding SelectedRepoDetails?.Owner}"
                                        TextTrimming="CharacterEllipsis" />
                                </Grid>
                                <Grid
                                    ColumnDefinitions="110,*"
                                    ColumnSpacing="10"
                                    IsVisible="{Binding SelectedRepoDetails?.CreatedAt, Converter={StaticResource NotNullToBoolConverter}}">
                                    <TextBlock Classes="detail-key" Text="Created" />
                                    <TextBlock
                                        Grid.Column="1"
                                        Classes="detail-value"
                                        Text="{Binding SelectedRepoDetails?.CreatedAt, StringFormat='d MMM yyyy'}" />
                                </Grid>
                                <Grid
                                    ColumnDefinitions="110,*"
                                    ColumnSpacing="10"
                                    IsVisible="{Binding SelectedRepoDetails?.Language, Converter={StaticResource StringNullOrEmptyToVisibilityConverter}}">
                                    <TextBlock Classes="detail-key" Text="Language" />
                                    <TextBlock
                                        Grid.Column="1"
                                        Classes="detail-value"
                                        Text="{Binding SelectedRepoDetails?.Language}" />
                                </Grid>
                                <Grid
                                    ColumnDefinitions="110,*"
                                    ColumnSpacing="10"
                                    IsVisible="{Binding SelectedRepoDetails?.License, Converter={StaticResource StringNullOrEmptyToVisibilityConverter}}">
                                    <TextBlock Classes="detail-key" Text="License" />
                                    <TextBlock
                                        Grid.Column="1"
                                        Classes="detail-value"
                                        Text="{Binding SelectedRepoDetails?.License}" />
                                </Grid>
                                <Grid
                                    ColumnDefinitions="110,*"
                                    ColumnSpacing="10"
                                    IsVisible="{Binding SelectedRepoDetails?.DefaultBranch, Converter={StaticResource StringNullOrEmptyToVisibilityConverter}}">
                                    <TextBlock Classes="detail-key" Text="Default Branch" />
                                    <TextBlock
                                        Grid.Column="1"
                                        Classes="detail-value"
                                        Text="{Binding SelectedRepoDetails?.DefaultBranch}" />
                                </Grid>
                            </StackPanel>
                        </Grid>
                        <!--  Topics chips  -->
                        <StackPanel IsVisible="{Binding SelectedRepoDetails?.HasTopics, TargetNullValue=False}">
                            <TextBlock Classes="detail-key" Text="Topics" />
                            <ItemsControl Margin="0,4,0,0" ItemsSource="{Binding SelectedRepoDetails?.Topics}">
                                <ItemsControl.ItemsPanel>
                                    <ItemsPanelTemplate>
                                        <WrapPanel Orientation="Horizontal" />
                                    </ItemsPanelTemplate>
                                </ItemsControl.ItemsPanel>
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate x:DataType="x:String">
                                        <Border
                                            Margin="0,0,6,6"
                                            Padding="7,2"
                                            Classes="chip">
                                            <TextBlock Classes="subtle" Text="{Binding}" />
                                        </Border>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </StackPanel>
                    </StackPanel>
                </ScrollViewer>
            </DockPanel>
        </Border>
        </Grid>

        <!--  README pane: the selected repo's root readme.md as wrapped plain
              text. The DockPanel's fill child, so it takes everything left of
              the sidebar and disappears entirely when the repo has no readme
              (HasReadme false) or no repo selected.  -->
        <Border Classes="ov-card" IsVisible="{Binding HasReadme}">
            <DockPanel>
                <TextBlock
                    Margin="0,0,0,6"
                    Classes="ov-card-title"
                    DockPanel.Dock="Top"
                    Text="README" />
                <ScrollViewer HorizontalScrollBarVisibility="Disabled">
                    <SelectableTextBlock
                        Foreground="{DynamicResource BodyForegroundBrush}"
                        Text="{Binding ReadmeText}"
                        TextWrapping="Wrap" />
                </ScrollViewer>
            </DockPanel>
        </Border>
    </DockPanel>
</UserControl>
