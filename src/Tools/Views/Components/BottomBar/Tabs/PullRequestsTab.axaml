<?xml version="1.0" encoding="utf-8" ?>
<!--
    Pull Requests tab: GitHub's open pull requests (title, branch line, label
    pills, author, age, state chip) followed by the Azure DevOps pull requests
    section in the same tab.
-->
<UserControl
    x:Class="Tools.Views.Components.BottomBar.Tabs.PullRequestsTab"
    xmlns="https://github.com/avaloniaui"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:entities="using:Tools.Library.Entities"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:tools="using:Tools.Library.MarkupExtensions"
    xmlns:vm="using:Tools.ViewModels.Components.BottomBar"
    d:DesignHeight="600"
    d:DesignWidth="1200"
    x:CompileBindings="True"
    x:DataType="vm:BottomBarViewModel"
    mc:Ignorable="d">
    <UserControl.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceInclude Source="avares://Tools/Views/Components/BottomBar/BottomBarResources.axaml" />
            </ResourceDictionary.MergedDictionaries>
        </ResourceDictionary>
    </UserControl.Resources>
    <UserControl.Styles>
        <StyleInclude Source="avares://Tools/Views/Components/BottomBar/BottomBarStyles.axaml" />
    </UserControl.Styles>

    <DockPanel>
        <Grid
            Margin="0,6,0,4"
            ColumnDefinitions="*,Auto,Auto"
            ColumnSpacing="4"
            DockPanel.Dock="Top">
            <TextBlock
                Grid.Column="0"
                VerticalAlignment="Center"
                Classes="subtle"
                Text="{Binding OpenPullRequestCount, StringFormat='{}{0} open pull requests'}" />
            <Button
                Grid.Column="1"
                VerticalAlignment="Center"
                Classes="icon"
                Command="{Binding GitHub.RefreshCommand}"
                IsEnabled="{Binding !GitHub.IsRefreshing}"
                ToolTip.Tip="Refresh">
                <Panel>
                    <Path
                        Classes="icon"
                        Data="{tools:SvgPath icon-refresh}"
                        IsVisible="{Binding !GitHub.IsRefreshing}" />
                    <Path
                        Width="13"
                        Height="13"
                        Classes="spinner"
                        Data="{tools:SvgPath icon-spinner, Center=False}"
                        IsVisible="{Binding GitHub.IsRefreshing}"
                        RenderTransformOrigin="50%,50%"
                        Stroke="{DynamicResource MutedForegroundBrush}"
                        StrokeThickness="2">
                        <Path.RenderTransform>
                            <RotateTransform />
                        </Path.RenderTransform>
                    </Path>
                </Panel>
            </Button>
            <Button
                Grid.Column="2"
                VerticalAlignment="Center"
                Classes="icon"
                Command="{Binding OpenGitHubPullsCommand}"
                ToolTip.Tip="Open the pull requests page on GitHub">
                <Path
                    Width="17"
                    Height="17"
                    Data="{tools:SvgPath icon-github}"
                    Fill="{DynamicResource MutedForegroundBrush}"
                    Stretch="Uniform" />
            </Button>
        </Grid>
        <ScrollViewer HorizontalScrollBarVisibility="Disabled">
            <StackPanel Spacing="2">
                <TextBlock
                    Classes="list-note subtle"
                    IsVisible="{Binding !GitHub.HasLoaded}"
                    Text="Loading…" />
                <TextBlock
                    Classes="list-note subtle"
                    IsVisible="{Binding ShowPullRequestsEmpty}"
                    Text="No open pull requests" />
                <TextBlock
                    Classes="list-note subtle"
                    IsVisible="{Binding GitHub.ShowUnavailable}"
                    Text="No GitHub data for this repository (is it hosted on GitHub, and is gh authenticated?)" />
                <ItemsControl ItemsSource="{Binding GitHub.PullRequests}">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate x:DataType="entities:GitHubItem">
                            <Button
                                Classes="bar-item"
                                Command="{Binding $parent[UserControl].((vm:BottomBarViewModel)DataContext).GitHub.OpenItemCommand}"
                                CommandParameter="{Binding}"
                                ToolTip.Tip="{Binding Url}">
                                <Grid ColumnDefinitions="Auto,*,Auto,Auto,Auto" ColumnSpacing="10">
                                    <Path
                                        Grid.Column="0"
                                        Width="15"
                                        Height="15"
                                        VerticalAlignment="Center"
                                        Data="{tools:SvgPath icon-git-pull-request}"
                                        Fill="{DynamicResource PurpleAccentBrush}"
                                        Stretch="Uniform" />
                                    <StackPanel
                                        Grid.Column="1"
                                        VerticalAlignment="Center"
                                        Orientation="Vertical"
                                        Spacing="2">
                                        <!--  Title / branch / label lines are shared templates;
                                              the star cell constrains the title so it trims
                                              instead of painting over the trailing
                                              author/age/chip columns.  -->
                                        <ContentControl
                                            Content="{Binding}"
                                            ContentTemplate="{StaticResource GitHubTitleLine13}" />
                                        <ContentControl
                                            Content="{Binding}"
                                            ContentTemplate="{StaticResource BranchSummaryTemplate}" />
                                        <ContentControl
                                            Content="{Binding}"
                                            ContentTemplate="{StaticResource GitHubLabelsFlow}" />
                                    </StackPanel>
                                    <TextBlock
                                        Grid.Column="2"
                                        VerticalAlignment="Center"
                                        Classes="subtle"
                                        IsVisible="{Binding Author, Converter={StaticResource StringNullOrEmptyToVisibilityConverter}}"
                                        Text="{Binding Author}" />
                                    <TextBlock
                                        Grid.Column="3"
                                        VerticalAlignment="Center"
                                        Classes="subtle"
                                        IsVisible="{Binding AgeText, Converter={StaticResource StringNullOrEmptyToVisibilityConverter}}"
                                        Text="{Binding AgeText}" />
                                    <ContentControl
                                        Grid.Column="4"
                                        Content="{Binding}"
                                        ContentTemplate="{StaticResource StateChipTemplate}" />
                                </Grid>
                            </Button>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>

                <!--  Azure DevOps pull requests, in the same tab as the GitHub list  -->
                <StackPanel IsVisible="{Binding Azure.HasAzurePullRequests}" Spacing="2">
                    <TextBlock
                        Margin="0,10,0,0"
                        Classes="field-label"
                        Text="{Binding Azure.AzurePullRequests.Count, StringFormat='Azure DevOps Pull Requests ({0})'}" />
                    <ItemsControl ItemsSource="{Binding Azure.AzurePullRequests}">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate x:DataType="entities:AzureDevOpsItem">
                                <Button
                                    Classes="bar-item"
                                    Command="{Binding $parent[UserControl].((vm:BottomBarViewModel)DataContext).Azure.OpenAzureItemCommand}"
                                    CommandParameter="{Binding}"
                                    ToolTip.Tip="{Binding Url}">
                                    <Grid ColumnDefinitions="Auto,*,Auto" ColumnSpacing="10">
                                        <Path
                                            Grid.Column="0"
                                            Width="15"
                                            Height="15"
                                            VerticalAlignment="Center"
                                            Data="{tools:SvgPath icon-git-pull-request}"
                                            Fill="{DynamicResource PurpleAccentBrush}"
                                            Stretch="Uniform" />
                                        <ContentControl
                                            Grid.Column="1"
                                            Content="{Binding}"
                                            ContentTemplate="{StaticResource AzureTitleLine13}" />
                                        <TextBlock
                                            Grid.Column="2"
                                            VerticalAlignment="Center"
                                            Classes="subtle"
                                            IsVisible="{Binding Author, Converter={StaticResource StringNullOrEmptyToVisibilityConverter}}"
                                            Text="{Binding Author}" />
                                    </Grid>
                                </Button>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </StackPanel>
            </StackPanel>
        </ScrollViewer>
    </DockPanel>
</UserControl>
