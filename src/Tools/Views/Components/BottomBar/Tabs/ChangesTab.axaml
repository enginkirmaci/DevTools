<?xml version="1.0" encoding="utf-8" ?>
<!--
    Changes tab (commit workspace): LEFT — the staged/unstaged tree as two
    sections, each with its own header (icon + name + count + Stage All /
    Unstage All) and one row per file with a status chip, per-side numstat and
    a + / − button; RIGHT — the commit message box with the wand button and
    Commit, and beside the message a narrow git rail: the branch dropdown
    (pick to check out) over a menu of git actions — Fetch, Pull, Push,
    Sync (pull then push), Discard all changes (a hard reset plus untracked
    cleanup), the History toggle — with the last-fetched dot + label and the
    fetch refresh button pinned to the bottom edge. Toggling History swaps
    the whole tab body (cards AND the tab row) for a full-width History view
    hosted by the bar shell (back link "<- Changes" in its top-left, same
    pattern as the History drawer).
    Handlers (branch pick, history rows, Ctrl+Enter commit) live in this tab's
    code-behind.
-->
<UserControl
    x:Class="Tools.Views.Components.BottomBar.Tabs.ChangesTab"
    xmlns="https://github.com/avaloniaui"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:entities="using:Tools.Library.Entities"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:tools="using:Tools.Library.MarkupExtensions"
    xmlns:vm="using:Tools.ViewModels.Components.BottomBar"
    d:DesignHeight="600"
    d:DesignWidth="1200"
    x:CompileBindings="True"
    x:DataType="vm:ChangesTabViewModel"
    mc:Ignorable="d">
    <UserControl.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceInclude Source="avares://Tools/Views/Components/BottomBar/BottomBarResources.axaml" />
            </ResourceDictionary.MergedDictionaries>
        </ResourceDictionary>
    </UserControl.Resources>
    <UserControl.Styles>
        <StyleInclude Source="avares://Tools/Views/Components/BottomBar/BottomBarStyles.axaml" />
        <!--  Git rail group: a bordered, subtly tinted box that turns each
              action group into its own section (hover tints stay inside).  -->
        <Style Selector="Border.rail-group">
            <Setter Property="Background" Value="{DynamicResource CardSubtleBackgroundBrush}" />
            <Setter Property="BorderBrush" Value="{DynamicResource HairlineBrush}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="CornerRadius" Value="{DynamicResource ChipRadius}" />
            <Setter Property="Padding" Value="3" />
        </Style>
    </UserControl.Styles>

    <!--  Two views share the tab body: the commit workspace (changes tree +
          commit message + git rail), and — while the rail's History row is
          toggled — the full-width History view with a back link, mirroring the
          History drawer's back pattern.  -->
    <!--  Main row: staged/unstaged tree (left) + commit workspace (right);
          while the rail's History row is toggled, the shell hosts the
          full-width History view over the whole tab body instead.  -->
    <Grid ColumnDefinitions="58*,42*" ColumnSpacing="10">

        <!--  LEFT: the staged/unstaged tree. ONE virtualized list holds
              both sections (each opens with its own header row,
              unstaged first), so the tab keeps its single scrolling
              surface while only viewport rows are realized — the list
              can hold thousands of untracked files, and realizing
              them all was the bar's biggest RAM cost. Header rows
              carry the Stage All / Unstage All buttons; file rows
              branch their +/− action on GitChangedFile.IsStaged.  -->
        <Border Grid.Column="0" Classes="ov-card" IsVisible="{Binding !ShowHistoryView}">
            <Grid Margin="4" RowDefinitions="Auto,*">
                <StackPanel Grid.Row="0" Spacing="2">
                    <TextBlock
                        Margin="0,20"
                        Classes="list-note subtle"
                        IsVisible="{Binding ShowChangesTabEmpty}"
                        Text="No changes — the working tree is clean" />
                    <TextBlock
                        Margin="0,20"
                        Classes="list-note subtle"
                        IsVisible="{Binding IsChangesTabLoading}"
                        Text="Loading changes…" />
                </StackPanel>
                <ListBox
                    Grid.Row="1"
                    Classes="plain-list"
                    ItemsSource="{Binding ChangeRows}">
                    <ListBox.DataTemplates>
                        <!--  Section header: icon + title + count on the
                              left, the side's all-button on the right
                              (icon and command branch on the side).  -->
                        <DataTemplate x:DataType="vm:ChangeSectionRow">
                            <Grid ColumnDefinitions="*,Auto" Margin="2,8,2,2">
                                <StackPanel
                                    Grid.Column="0"
                                    VerticalAlignment="Center"
                                    Orientation="Horizontal"
                                    Spacing="6">
                                    <Panel Width="13" Height="13" VerticalAlignment="Center">
                                        <Path
                                            Width="13"
                                            Height="13"
                                            Data="{tools:SvgPath icon-source-branch}"
                                            Fill="{DynamicResource WarningAccentBrush}"
                                            IsVisible="{Binding IsUnstaged}"
                                            Stretch="Uniform" />
                                        <Path
                                            Width="13"
                                            Height="13"
                                            Data="{tools:SvgPath icon-check}"
                                            Fill="{DynamicResource StatusActiveBrush}"
                                            IsVisible="{Binding !IsUnstaged}"
                                            Stretch="Uniform" />
                                    </Panel>
                                    <TextBlock Classes="ov-card-title" Text="{Binding Title}" />
                                    <TextBlock
                                        VerticalAlignment="Center"
                                        Classes="subtle"
                                        Text="{Binding Count, StringFormat='({0})'}" />
                                </StackPanel>
                                <!--  Header actions: Discard (section-wide, no
                                      undo) beside the side's Stage All /
                                      Unstage All.  -->
                                <StackPanel
                                    Grid.Column="1"
                                    VerticalAlignment="Center"
                                    Orientation="Horizontal"
                                    Spacing="10">
                                    <Button
                                        VerticalAlignment="Center"
                                        Classes="text-subtle"
                                        Command="{Binding $parent[UserControl].((vm:ChangesTabViewModel)DataContext).DiscardSectionCommand}"
                                        CommandParameter="{Binding}"
                                        ToolTip.Tip="Discard every change in this section — no undo"
                                        Content="Discard" />
                                    <Button
                                        VerticalAlignment="Center"
                                        Classes="text-subtle"
                                        Command="{Binding $parent[UserControl].((vm:ChangesTabViewModel)DataContext).StageAllCommand}"
                                        Content="Stage All"
                                        IsVisible="{Binding IsUnstaged}"
                                        ToolTip.Tip="Stage all unstaged files" />
                                    <Button
                                        VerticalAlignment="Center"
                                        Classes="text-subtle"
                                        Command="{Binding $parent[UserControl].((vm:ChangesTabViewModel)DataContext).UnstageAllCommand}"
                                        Content="Unstage All"
                                        IsVisible="{Binding !IsUnstaged}"
                                        ToolTip.Tip="Unstage all files — the working tree keeps every change" />
                                </StackPanel>
                            </Grid>
                        </DataTemplate>
                        <!--  File row: status chip + path + numstat + the
                              side's action button. The numstat column is
                              FIXED 104px (48 + 8 + 48) so the action
                              button holds its x on rows without counts
                              (binary/untracked) too.  -->
                        <DataTemplate x:DataType="entities:GitChangedFile">
                            <Grid ColumnDefinitions="Auto,*,104,Auto" ColumnSpacing="8">
                                <Border
                                    Grid.Column="0"
                                    Width="30"
                                    Padding="0,2"
                                    VerticalAlignment="Center"
                                    Background="{DynamicResource CardSubtleBackgroundBrush}"
                                    BorderBrush="{DynamicResource HairlineBrush}"
                                    BorderThickness="1"
                                    CornerRadius="{DynamicResource ChipRadius}">
                                    <TextBlock
                                        HorizontalAlignment="Center"
                                        Classes="mono"
                                        Foreground="{Binding StatusCode, Converter={StaticResource GitStatusBrushConverter}}"
                                        Text="{Binding DisplayStatusCode}" />
                                </Border>
                                <TextBlock
                                    Grid.Column="1"
                                    VerticalAlignment="Center"
                                    Classes="mono"
                                    Foreground="{DynamicResource BodyForegroundBrush}"
                                    Text="{Binding Path}"
                                    TextTrimming="CharacterEllipsis" />
                                <ContentControl
                                    Grid.Column="2"
                                    Content="{Binding}"
                                    ContentTemplate="{StaticResource NumstatPillsTemplate}" />
                                <!--  Row actions: discard (↩) + the side's
                                      stage/unstage button. Discard reverts an
                                      unstaged file to the index (untracked
                                      files are deleted) and throws a staged
                                      file back to HEAD — no undo.  -->
                                <StackPanel
                                    Grid.Column="3"
                                    VerticalAlignment="Center"
                                    Orientation="Horizontal"
                                    Spacing="2">
                                    <Button
                                        Classes="icon row-action"
                                        Command="{Binding $parent[UserControl].((vm:ChangesTabViewModel)DataContext).DiscardFileCommand}"
                                        CommandParameter="{Binding}"
                                        ToolTip.Tip="Discard this change — no undo">
                                        <Path
                                            Width="14"
                                            Height="14"
                                            Data="{tools:SvgPath icon-undo}"
                                            Fill="{DynamicResource MutedForegroundBrush}"
                                            Stretch="Uniform" />
                                    </Button>
                                    <Button
                                        Classes="icon row-action"
                                        Command="{Binding $parent[UserControl].((vm:ChangesTabViewModel)DataContext).StageFileCommand}"
                                        CommandParameter="{Binding}"
                                        IsVisible="{Binding !IsStaged}"
                                        ToolTip.Tip="Stage this file">
                                        <Path
                                            Width="14"
                                            Height="14"
                                            Data="{tools:SvgPath icon-plus}"
                                            Fill="{DynamicResource MutedForegroundBrush}"
                                            Stretch="Uniform" />
                                    </Button>
                                    <Button
                                        Classes="icon row-action"
                                        Command="{Binding $parent[UserControl].((vm:ChangesTabViewModel)DataContext).UnstageFileCommand}"
                                        CommandParameter="{Binding}"
                                        IsVisible="{Binding IsStaged}"
                                        ToolTip.Tip="Unstage this file — the working tree keeps the change">
                                        <Path
                                            Width="14"
                                            Height="14"
                                            Data="{tools:SvgPath icon-minus}"
                                            Fill="{DynamicResource MutedForegroundBrush}"
                                            Stretch="Uniform" />
                                    </Button>
                                </StackPanel>
                            </Grid>
                        </DataTemplate>
                    </ListBox.DataTemplates>
                </ListBox>

            </Grid>
        </Border>

        <!--  RIGHT: the commit workspace — message box with the wand and
              Commit, and the git rail beside the message (branch picker on
              top, last-fetched status + fetch refresh at the bottom edge).  -->
        <Border Grid.Column="1" Classes="ov-card" IsVisible="{Binding !ShowHistoryView}">
            <DockPanel>

                <TextBlock
                    Margin="0,0,0,6"
                    Classes="ov-card-title"
                    DockPanel.Dock="Top"
                    Text="Commit message" />


                <!--  Commit button: an empty message box turns it into "Generate & Commit" —
                      the press then writes the message first (the wand's run) and commits  -->
                <Button
                    Margin="0,8,0,0"
                    HorizontalAlignment="Left"
                    Classes="Outlined"
                    Command="{Binding CommitCommand}"
                    DockPanel.Dock="Bottom"
                    ToolTip.Tip="Commit staged changes; empty message auto-generates (opencode)">
                    <StackPanel Orientation="Horizontal" Spacing="6">
                        <!--  wand while the box is empty, check once a message is typed;
                              both give way to the spinning ring while the commit runs;
                              Fill/Stroke track the button's Foreground so hover turns it white with the text  -->
                        <Path
                            Width="13"
                            Height="13"
                            VerticalAlignment="Center"
                            IsVisible="{Binding CommitShowsWand}"
                            Data="{tools:SvgPath icon-wand}"
                            Fill="{Binding $parent[Button].Foreground}"
                            Stretch="Uniform" />
                        <Path
                            Width="13"
                            Height="13"
                            VerticalAlignment="Center"
                            IsVisible="{Binding CommitShowsCheck}"
                            Data="{tools:SvgPath icon-check}"
                            Fill="{Binding $parent[Button].Foreground}"
                            Stretch="Uniform" />
                        <!--  same ring recipe as the wand button: element-space arc,
                              no Stretch, so the circle's center is exactly the
                              RenderTransformOrigin the rotation pivots on  -->
                        <Path
                            Width="13"
                            Height="13"
                            VerticalAlignment="Center"
                            IsVisible="{Binding IsCommitting}"
                            Classes="spinner"
                            RenderTransformOrigin="50%,50%"
                            Data="{tools:SvgPath icon-spinner, Center=False}"
                            Stroke="{Binding $parent[Button].Foreground}"
                            StrokeThickness="2">
                            <Path.RenderTransform>
                                <RotateTransform />
                            </Path.RenderTransform>
                        </Path>
                        <TextBlock VerticalAlignment="Center" Text="{Binding CommitButtonText}" />
                    </StackPanel>
                </Button>

                <Grid ColumnDefinitions="*,10,212">

                    <!--  Message box; the wand sits over its bottom-right corner.
                          Ctrl+Enter commits (OnCommitBoxKeyDown) — plain Enter keeps
                          its newline.  -->
                    <Grid Grid.Column="0">
                        <TextBox
                            AcceptsReturn="True"
                            KeyDown="OnCommitBoxKeyDown"
                            Padding="0,0,26,0"
                            VerticalContentAlignment="Top"
                            Text="{Binding CommitMessage}"
                            TextWrapping="Wrap"
                            Watermark="Commit message (empty = auto-generate)" />
                        <!--
                            Commit-message wand: a bare icon floating over the message
                            box's corner — a detail-link (transparent, dims on hover)
                            with its own padding, so the TextBox shows through.
                        -->
                        <Button
                            Margin="0,0,4,4"
                            HorizontalAlignment="Right"
                            VerticalAlignment="Bottom"
                            Padding="4"
                            Classes="detail-link"
                            Command="{Binding GenerateCommitMessageCommand}"
                            ToolTip.Tip="Generate a commit message from the staged diff (opencode)">
                            <Grid>
                                <!--  spinning arc while the generation runs; drawn at final size
                                      in element coordinates (no Stretch) so the circle's center
                                      is exactly the RenderTransformOrigin the rotation pivots on;
                                      the ring is the Path.spinner shared style  -->
                                <Path
                                    Width="16"
                                    Height="16"
                                    IsVisible="{Binding IsGeneratingMessage}"
                                    Classes="spinner"
                                    RenderTransformOrigin="50%,50%"
                                    Data="M 8 1 A 7 7 0 1 1 1 8"
                                    Stroke="{DynamicResource AccentPrimaryBrush}"
                                    StrokeThickness="2">
                                    <Path.RenderTransform>
                                        <RotateTransform />
                                    </Path.RenderTransform>
                                </Path>
                                <Path
                                    Width="16"
                                    Height="16"
                                    IsVisible="{Binding !IsGeneratingMessage}"
                                    Data="{tools:SvgPath icon-wand}"
                                    Fill="{DynamicResource MutedForegroundBrush}"
                                    Stretch="Uniform" />
                            </Grid>
                        </Button>
                    </Grid>

                    <!--  Git rail: the branch dropdown on top (picking a branch
                          checks it out) with Pull / Push right under it, and
                          the last-fetched row pinned to the bottom edge — the
                          old toolbar row's leftovers, moved beside the message
                          instead of above the whole tab. LastChildFill=False:
                          every row is docked, the leftover middle stays empty.  -->
                    <DockPanel Grid.Column="2" LastChildFill="False">

                        <!--  Branch dropdown — outlined box with a branch icon +
                              name. The rail's fixed 200px column is the box's
                              width; the dropdown popup still grows with its
                              widest entry under the same cap, so full names
                              show there.  -->

                        <!--  Git menu: one quiet full-width row per action
                              (bar-item = stretch button with the table's hover
                              tint). Fetch/Pull/Push first, then a hairline,
                              Sync + the destructive Discard-all, a hairline,
                              and the History toggle. Each row's icon swaps to
                              the spinning ring while its operation runs.  -->
                        <StackPanel DockPanel.Dock="Top">
                            <Border Classes="rail-group">
                                <StackPanel>
                                <ComboBox
                                    x:Name="BranchPicker"
                                    Height="30"
                                    Background="Transparent"
                                    BorderBrush="{DynamicResource HairlineBrush}"
                                    BorderThickness="1"
                                    CornerRadius="6"
                                    ItemsSource="{Binding Branches}"
                                    PlaceholderText="branch"
                                    SelectedItem="{Binding SelectedBranch, Mode=OneWay}"
                                    SelectionChanged="OnBranchSelectionChanged"
                                    ToolTip.Tip="Current branch — pick another to check it out">
                                    <ComboBox.Styles>
                                        <!--  The popup is at least the box's width and
                                              otherwise follows its widest entry (theme
                                              MinWidth binding); the cap keeps an extreme
                                              name on screen, where the entry's own
                                              ellipsis (ItemTemplate) takes over.  -->
                                        <Style Selector="ComboBoxItem">
                                            <Setter Property="MaxWidth" Value="360" />
                                        </Style>
                                    </ComboBox.Styles>
                                    <ComboBox.ItemTemplate>
                                        <DataTemplate x:DataType="x:String">
                                            <StackPanel Orientation="Horizontal" Spacing="6">
                                                <Path
                                                    Width="12"
                                                    Height="12"
                                                    Data="{tools:SvgPath icon-source-branch}"
                                                    Fill="{DynamicResource MutedForegroundBrush}"
                                                    Stretch="Uniform" />
                                                <!--
                                                    Explicit foreground: SukiUI brightens only TextBlocks that
                                                    are the ComboBoxItem's DIRECT content; inside this
                                                    StackPanel the inherited popup color is too dim. The
                                                    ellipsis bites only under the caps (the closed box's
                                                    width, the item's) — the popup sizes to the widest
                                                    entry otherwise, so entries never trim in it.
                                                -->
                                                <TextBlock
                                                    Foreground="{DynamicResource BodyForegroundBrush}"
                                                    Text="{Binding}"
                                                    TextTrimming="CharacterEllipsis" />
                                            </StackPanel>
                                        </DataTemplate>
                                    </ComboBox.ItemTemplate>
                                </ComboBox>
                                    <Button
                                        Padding="8,9,10,9"
                                        Classes="bar-item"
                                        Command="{Binding FetchCommand}"
                                        ToolTip.Tip="git fetch --prune for the selected repository">
                                        <Grid ColumnDefinitions="Auto,*,Auto" ColumnSpacing="10">
                                            <Panel Width="14" Height="14" VerticalAlignment="Center">
                                                <Path
                                                    Width="14"
                                                    Height="14"
                                                    Classes="icon"
                                                    Data="{tools:SvgPath icon-cloud-download}"
                                                    IsVisible="{Binding !IsFetching}" />
                                                <Path
                                                    Width="13"
                                                    Height="13"
                                                    Classes="spinner"
                                                    Data="{tools:SvgPath icon-spinner, Center=False}"
                                                    IsVisible="{Binding IsFetching}"
                                                    RenderTransformOrigin="50%,50%"
                                                    Stroke="{DynamicResource MutedForegroundBrush}"
                                                    StrokeThickness="2">
                                                    <Path.RenderTransform>
                                                        <RotateTransform />
                                                    </Path.RenderTransform>
                                                </Path>
                                            </Panel>
                                            <TextBlock
                                                Grid.Column="1"
                                                VerticalAlignment="Center"
                                                Foreground="{DynamicResource BodyForegroundBrush}"
                                                Text="Fetch" />
                                        </Grid>
                                    </Button>
                                    <Button
                                        Padding="8,9,10,9"
                                        Classes="bar-item"
                                        Command="{Binding PullCommand}"
                                        ToolTip.Tip="git pull for the selected repository">
                                        <Grid ColumnDefinitions="Auto,*,Auto" ColumnSpacing="10">
                                            <Panel Width="14" Height="14" VerticalAlignment="Center">
                                                <Path
                                                    Width="14"
                                                    Height="14"
                                                    Classes="icon"
                                                    Data="{tools:SvgPath icon-arrow-down}"
                                                    IsVisible="{Binding !IsPulling}" />
                                                <Path
                                                    Width="13"
                                                    Height="13"
                                                    Classes="spinner"
                                                    Data="{tools:SvgPath icon-spinner, Center=False}"
                                                    IsVisible="{Binding IsPulling}"
                                                    RenderTransformOrigin="50%,50%"
                                                    Stroke="{DynamicResource MutedForegroundBrush}"
                                                    StrokeThickness="2">
                                                    <Path.RenderTransform>
                                                        <RotateTransform />
                                                    </Path.RenderTransform>
                                                </Path>
                                            </Panel>
                                            <TextBlock
                                                Grid.Column="1"
                                                VerticalAlignment="Center"
                                                Foreground="{DynamicResource BodyForegroundBrush}"
                                                Text="Pull" />
                                            <Border
                                                Grid.Column="2"
                                                VerticalAlignment="Center"
                                                Background="{DynamicResource CardSubtleBackgroundBrush}"
                                                BorderBrush="{DynamicResource HairlineBrush}"
                                                BorderThickness="1"
                                                CornerRadius="{DynamicResource ChipRadius}"
                                                IsVisible="{Binding GitToPullCount, Converter={StaticResource PositiveCountToVisibilityConverter}}"
                                                Padding="7,1">
                                                <TextBlock
                                                    FontSize="12"
                                                    FontWeight="SemiBold"
                                                    Foreground="{DynamicResource InfoAccentBrush}"
                                                    Text="{Binding GitToPullCount}" />
                                            </Border>
                                        </Grid>
                                    </Button>
                                    <Button
                                        Padding="8,9,10,9"
                                        Classes="bar-item"
                                        Command="{Binding PushCommand}"
                                        ToolTip.Tip="git push for the selected repository">
                                        <Grid ColumnDefinitions="Auto,*,Auto" ColumnSpacing="10">
                                            <Panel Width="14" Height="14" VerticalAlignment="Center">
                                                <Path
                                                    Width="14"
                                                    Height="14"
                                                    Classes="icon"
                                                    Data="{tools:SvgPath icon-arrow-up}"
                                                    IsVisible="{Binding !IsPushing}" />
                                                <Path
                                                    Width="13"
                                                    Height="13"
                                                    Classes="spinner"
                                                    Data="{tools:SvgPath icon-spinner, Center=False}"
                                                    IsVisible="{Binding IsPushing}"
                                                    RenderTransformOrigin="50%,50%"
                                                    Stroke="{DynamicResource MutedForegroundBrush}"
                                                    StrokeThickness="2">
                                                    <Path.RenderTransform>
                                                        <RotateTransform />
                                                    </Path.RenderTransform>
                                                </Path>
                                            </Panel>
                                            <TextBlock
                                                Grid.Column="1"
                                                VerticalAlignment="Center"
                                                Foreground="{DynamicResource BodyForegroundBrush}"
                                                Text="Push" />
                                            <Border
                                                Grid.Column="2"
                                                VerticalAlignment="Center"
                                                Background="{DynamicResource CardSubtleBackgroundBrush}"
                                                BorderBrush="{DynamicResource HairlineBrush}"
                                                BorderThickness="1"
                                                CornerRadius="{DynamicResource ChipRadius}"
                                                IsVisible="{Binding GitToPushCount, Converter={StaticResource PositiveCountToVisibilityConverter}}"
                                                Padding="7,1">
                                                <TextBlock
                                                    FontSize="12"
                                                    FontWeight="SemiBold"
                                                    Foreground="{DynamicResource StatusActiveBrush}"
                                                    Text="{Binding GitToPushCount}" />
                                            </Border>
                                        </Grid>
                                    </Button>
                                    <Border
                                        Height="1"
                                        Margin="10,5"
                                        Background="{DynamicResource HairlineBrush}" />
                                    <Button
                                        Padding="8,9,10,9"
                                        Classes="bar-item"
                                        Command="{Binding SyncCommand}"
                                        ToolTip.Tip="Pull, then push — bring the branch level with its upstream">
                                        <Grid ColumnDefinitions="Auto,*,Auto" ColumnSpacing="10">
                                            <Panel Width="14" Height="14" VerticalAlignment="Center">
                                                <Path
                                                    Width="14"
                                                    Height="14"
                                                    Classes="icon"
                                                    Data="{tools:SvgPath icon-refresh}"
                                                    IsVisible="{Binding !IsSyncing}" />
                                                <Path
                                                    Width="13"
                                                    Height="13"
                                                    Classes="spinner"
                                                    Data="{tools:SvgPath icon-spinner, Center=False}"
                                                    IsVisible="{Binding IsSyncing}"
                                                    RenderTransformOrigin="50%,50%"
                                                    Stroke="{DynamicResource MutedForegroundBrush}"
                                                    StrokeThickness="2">
                                                    <Path.RenderTransform>
                                                        <RotateTransform />
                                                    </Path.RenderTransform>
                                                </Path>
                                            </Panel>
                                            <TextBlock
                                                Grid.Column="1"
                                                VerticalAlignment="Center"
                                                Foreground="{DynamicResource BodyForegroundBrush}"
                                                Text="Sync" />
                                        </Grid>
                                    </Button>
                                    <Button
                                        Padding="8,9,10,9"
                                        Classes="bar-item"
                                        Command="{Binding DiscardAllCommand}"
                                        ToolTip.Tip="Delete every staged, unstaged and untracked change — no undo">
                                        <Grid ColumnDefinitions="Auto,*,Auto" ColumnSpacing="10">
                                            <Panel Width="14" Height="14" VerticalAlignment="Center">
                                                <Path
                                                    Width="14"
                                                    Height="14"
                                                    Classes="icon"
                                                    Data="{tools:SvgPath icon-discard}"
                                                    IsVisible="{Binding !IsDiscarding}" />
                                                <Path
                                                    Width="13"
                                                    Height="13"
                                                    Classes="spinner"
                                                    Data="{tools:SvgPath icon-spinner, Center=False}"
                                                    IsVisible="{Binding IsDiscarding}"
                                                    RenderTransformOrigin="50%,50%"
                                                    Stroke="{DynamicResource MutedForegroundBrush}"
                                                    StrokeThickness="2">
                                                    <Path.RenderTransform>
                                                        <RotateTransform />
                                                    </Path.RenderTransform>
                                                </Path>
                                            </Panel>
                                            <TextBlock
                                                Grid.Column="1"
                                                VerticalAlignment="Center"
                                                Foreground="{DynamicResource BodyForegroundBrush}"
                                                Text="Discard all changes" />
                                        </Grid>
                                    </Button>
                                    <Button
                                        Padding="8,9,10,9"
                                        Classes="bar-item"
                                        Command="{Binding ToggleHistoryCommand}"
                                        ToolTip.Tip="Show this repository's history">
                                        <Grid ColumnDefinitions="Auto,*,Auto" ColumnSpacing="10">
                                            <Path
                                                Width="14"
                                                Height="14"
                                                Classes="icon"
                                                Data="{tools:SvgPath icon-clock}" />
                                            <TextBlock
                                                Grid.Column="1"
                                                VerticalAlignment="Center"
                                                Foreground="{DynamicResource BodyForegroundBrush}"
                                                Text="History" />
                                        </Grid>
                                    </Button>
                                <!--  Last fetched: status dot (green once the repo has
                                      been fetched) + the relative label, then the
                                      refresh button (a git fetch with prune; the icon
                                      swaps to the spinning ring while it runs).  -->
                                <Grid
                                    ColumnDefinitions="Auto,*,Auto"
                                    ColumnSpacing="8"
                                    Margin="5,2,5,2">
                                    <Border
                                        Width="7"
                                        Height="7"
                                        VerticalAlignment="Center"
                                        Background="{Binding HasFetched, Converter={StaticResource BoolToBrushConverter}}"
                                        CornerRadius="4" />
                                    <TextBlock
                                        Grid.Column="1"
                                        VerticalAlignment="Center"
                                        Foreground="{DynamicResource BodyForegroundBrush}"
                                        Text="{Binding LastFetchText, TargetNullValue='Not fetched'}"
                                        TextTrimming="CharacterEllipsis" />
                                    <Button
                                        Grid.Column="2"
                                        VerticalAlignment="Center"
                                        Classes="icon"
                                        Command="{Binding FetchCommand}"
                                        ToolTip.Tip="git fetch --prune for the selected repository">
                                        <Panel>
                                            <Path
                                                Classes="icon"
                                                Data="{tools:SvgPath icon-refresh}"
                                                IsVisible="{Binding !IsFetching}" />
                                            <Path
                                                Width="13"
                                                Height="13"
                                                Classes="spinner"
                                                Data="{tools:SvgPath icon-spinner, Center=False}"
                                                IsVisible="{Binding IsFetching}"
                                                RenderTransformOrigin="50%,50%"
                                                Stroke="{DynamicResource MutedForegroundBrush}"
                                                StrokeThickness="2">
                                                <Path.RenderTransform>
                                                    <RotateTransform />
                                                </Path.RenderTransform>
                                            </Path>
                                        </Panel>
                                    </Button>
                                </Grid>
                                </StackPanel>
                            </Border>
                        </StackPanel>
                    </DockPanel>
                </Grid>
            </DockPanel>
        </Border>

    </Grid>
</UserControl>
