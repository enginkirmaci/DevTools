<?xml version="1.0" encoding="utf-8" ?>
<!--
    Changes tab (commit workspace): LEFT — the staged/unstaged tree as two
    sections, each with its own header (icon + name + count + Stage All /
    Unstage All) and one row per file with a status chip, per-side numstat and
    a + / − button; RIGHT — two side-by-side cards: the commit message box
    with the wand button and Commit, and the git rail in its own card — the
    branch dropdown (pick to check out), a hairline, then the action menu —
    Fetch, Pull, Push, a hairline, Sync (pull then push), Discard all changes
    (a hard reset plus untracked cleanup), the History toggle — and under one
    more hairline the last-fetched dot + label with the fetch refresh button
    pinned to the bottom edge. Toggling History swaps the whole tab body
    (cards AND the tab row) for a full-width History view hosted by the bar
    shell (back link "<- Changes" in its top-left, same pattern as the
    History drawer).
    Handlers (branch pick, history rows, Ctrl+Enter commit) live in this tab's
    code-behind.
-->
<UserControl
    x:Class="Tools.Views.Components.BottomBar.Tabs.ChangesTab"
    xmlns="https://github.com/avaloniaui"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:entities="using:Tools.Library.Entities"
    xmlns:lib="using:Tools.Library.Services"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:tools="using:Tools.Library.MarkupExtensions"
    xmlns:vm="using:Tools.ViewModels.Components.BottomBar"
    d:DesignHeight="600"
    d:DesignWidth="1200"
    x:CompileBindings="True"
    x:DataType="vm:ChangesTabViewModel"
    mc:Ignorable="d">
    <UserControl.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceInclude Source="avares://Tools/Views/Components/BottomBar/BottomBarResources.axaml" />
            </ResourceDictionary.MergedDictionaries>
        </ResourceDictionary>
    </UserControl.Resources>
    <UserControl.Styles>
        <StyleInclude Source="avares://Tools/Views/Components/BottomBar/BottomBarStyles.axaml" />
    </UserControl.Styles>

    <!--  Two views share the tab body: the commit workspace (changes tree +
          commit message + git rail), and — while the rail's History row is
          toggled — the full-width History view with a back link, mirroring the
          History drawer's back pattern.  -->
    <!--  Main row: staged/unstaged tree (left) + commit workspace (right);
          while the rail's History row is toggled, the shell hosts the
          full-width History view over the whole tab body instead.  -->
    <Grid ColumnDefinitions="58*,42*" ColumnSpacing="10">

        <!--  LEFT: the staged/unstaged tree. ONE virtualized list holds
              both sections (each opens with its own header row,
              unstaged first), so the tab keeps its single scrolling
              surface while only viewport rows are realized — the list
              can hold thousands of untracked files, and realizing
              them all was the bar's biggest RAM cost. Header rows
              carry the Stage All / Unstage All buttons; file rows
              branch their +/− action on GitChangedFile.IsStaged.  -->
        <Border Grid.Column="0" Classes="ov-card" IsVisible="{Binding !ShowHistoryView}">
            <Grid Margin="4" RowDefinitions="Auto,*">
                <StackPanel Grid.Row="0" Spacing="2">
                    <TextBlock
                        Margin="0,20"
                        Classes="list-note subtle"
                        IsVisible="{Binding ShowChangesTabEmpty}"
                        Text="No changes — the working tree is clean" />
                    <TextBlock
                        Margin="0,20"
                        Classes="list-note subtle"
                        IsVisible="{Binding IsChangesTabLoading}"
                        Text="Loading changes…" />
                </StackPanel>
                <ListBox
                    Grid.Row="1"
                    Classes="plain-list"
                    ItemsSource="{Binding ChangeRows}">
                    <ListBox.DataTemplates>
                        <!--  Section header: icon + title + count on the
                              left, the side's all-button on the right
                              (icon and command branch on the side).  -->
                        <DataTemplate x:DataType="vm:ChangeSectionRow">
                            <Grid ColumnDefinitions="*,Auto" Margin="2,8,2,2">
                                <StackPanel
                                    Grid.Column="0"
                                    VerticalAlignment="Center"
                                    Orientation="Horizontal"
                                    Spacing="6">
                                    <Panel Width="13" Height="13" VerticalAlignment="Center">
                                        <Path
                                            Width="13"
                                            Height="13"
                                            Data="{tools:SvgPath icon-source-branch}"
                                            Fill="{DynamicResource WarningAccentBrush}"
                                            IsVisible="{Binding IsUnstaged}"
                                            Stretch="Uniform" />
                                        <Path
                                            Width="13"
                                            Height="13"
                                            Data="{tools:SvgPath icon-check}"
                                            Fill="{DynamicResource StatusActiveBrush}"
                                            IsVisible="{Binding !IsUnstaged}"
                                            Stretch="Uniform" />
                                    </Panel>
                                    <TextBlock Classes="ov-card-title" Text="{Binding Title}" />
                                    <TextBlock
                                        VerticalAlignment="Center"
                                        Classes="subtle"
                                        Text="{Binding Count, StringFormat='({0})'}" />
                                </StackPanel>
                                <!--  Header actions: Discard (section-wide, no
                                      undo) beside the side's Stage All /
                                      Unstage All.  -->
                                <StackPanel
                                    Grid.Column="1"
                                    VerticalAlignment="Center"
                                    Orientation="Horizontal"
                                    Spacing="10">
                                    <Button
                                        VerticalAlignment="Center"
                                        Classes="text-subtle"
                                        Command="{Binding $parent[UserControl].((vm:ChangesTabViewModel)DataContext).DiscardSectionCommand}"
                                        CommandParameter="{Binding}"
                                        ToolTip.Tip="Discard every change in this section — no undo"
                                        Content="Discard" />
                                    <Button
                                        VerticalAlignment="Center"
                                        Classes="text-subtle"
                                        Command="{Binding $parent[UserControl].((vm:ChangesTabViewModel)DataContext).StageAllCommand}"
                                        Content="Stage All"
                                        IsVisible="{Binding IsUnstaged}"
                                        ToolTip.Tip="Stage all unstaged files" />
                                    <Button
                                        VerticalAlignment="Center"
                                        Classes="text-subtle"
                                        Command="{Binding $parent[UserControl].((vm:ChangesTabViewModel)DataContext).UnstageAllCommand}"
                                        Content="Unstage All"
                                        IsVisible="{Binding !IsUnstaged}"
                                        ToolTip.Tip="Unstage all files — the working tree keeps every change" />
                                </StackPanel>
                            </Grid>
                        </DataTemplate>
                        <!--  File row: status chip + path, then the action
                              pair (discard + stage/unstage) LEFT of the
                              numstat pills. Both trailing columns are FIXED
                              width so pills align row-to-row and never shift:
                              the pair owns a reserved 50px column (two 24px
                              buttons + 2px gap) and only becomes visible while
                              the row is highlighted.  -->
                        <DataTemplate x:DataType="entities:GitChangedFile">
                            <Grid
                                x:Name="ChangeRow"
                                Classes="change-row"
                                ColumnDefinitions="Auto,*,50,104"
                                ColumnSpacing="8">
                                <Border
                                    Grid.Column="0"
                                    Width="30"
                                    Padding="0,2"
                                    VerticalAlignment="Center"
                                    Background="{DynamicResource CardSubtleBackgroundBrush}"
                                    BorderBrush="{DynamicResource HairlineBrush}"
                                    BorderThickness="1"
                                    CornerRadius="{DynamicResource ChipRadius}">
                                    <TextBlock
                                        HorizontalAlignment="Center"
                                        Classes="mono"
                                        Foreground="{Binding StatusCode, Converter={StaticResource GitStatusBrushConverter}}"
                                        Text="{Binding DisplayStatusCode}" />
                                </Border>
                                <TextBlock
                                    Grid.Column="1"
                                    VerticalAlignment="Center"
                                    Classes="mono"
                                    Foreground="{DynamicResource BodyForegroundBrush}"
                                    Text="{Binding Path}"
                                    TextTrimming="CharacterEllipsis" />
                                <ContentControl
                                    Grid.Column="3"
                                    Content="{Binding}"
                                    ContentTemplate="{StaticResource NumstatPillsTemplate}" />
                                <!--  Row actions: discard (↩) + the side's
                                      stage/unstage button, revealed only while
                                      the row is highlighted. Discard reverts an
                                      unstaged file to the index (untracked
                                      files are deleted) and throws a staged
                                      file back to HEAD — no undo.  -->
                                <StackPanel
                                    Grid.Column="2"
                                    VerticalAlignment="Center"
                                    Orientation="Horizontal"
                                    Spacing="2"
                                    IsVisible="{Binding #ChangeRow.IsPointerOver}">
                                    <Button
                                        Width="20"
                                        Height="20"
                                        Classes="icon row-action"
                                        Command="{Binding $parent[UserControl].((vm:ChangesTabViewModel)DataContext).DiscardFileCommand}"
                                        CommandParameter="{Binding}"
                                        ToolTip.Tip="Discard this change — no undo">
                                        <Path
                                            Width="18"
                                            Height="18"
                                            Data="{tools:SvgPath icon-undo}"
                                            Fill="{DynamicResource MutedForegroundBrush}"
                                            Stretch="Uniform" />
                                    </Button>
                                    <Button
                                        Width="20"
                                        Height="20"
                                        Classes="icon row-action"
                                        Command="{Binding $parent[UserControl].((vm:ChangesTabViewModel)DataContext).StageFileCommand}"
                                        CommandParameter="{Binding}"
                                        IsVisible="{Binding !IsStaged}"
                                        ToolTip.Tip="Stage this file">
                                        <Path
                                            Width="18"
                                            Height="18"
                                            Data="{tools:SvgPath icon-plus}"
                                            Fill="{DynamicResource MutedForegroundBrush}"
                                            Stretch="Uniform" />
                                    </Button>
                                    <Button
                                        Width="20"
                                        Height="20"
                                        Classes="icon row-action"
                                        Command="{Binding $parent[UserControl].((vm:ChangesTabViewModel)DataContext).UnstageFileCommand}"
                                        CommandParameter="{Binding}"
                                        IsVisible="{Binding IsStaged}"
                                        ToolTip.Tip="Unstage this file — the working tree keeps the change">
                                        <Path
                                            Width="18"
                                            Height="18"
                                            Data="{tools:SvgPath icon-minus}"
                                            Fill="{DynamicResource MutedForegroundBrush}"
                                            Stretch="Uniform" />
                                    </Button>
                                </StackPanel>
                            </Grid>
                        </DataTemplate>
                    </ListBox.DataTemplates>
                </ListBox>

            </Grid>
        </Border>

        <!--  RIGHT: two side-by-side cards — the commit message (box with the
              wand and the commit button below it), and the git rail in its
              own card: the branch picker on top, a hairline, the action rows
              (Fetch / Pull / Push, a hairline, Sync / Discard-all / History),
              and the last-fetched status + fetch refresh pinned to the bottom
              edge under one more hairline.  -->
        <Grid Grid.Column="1" ColumnDefinitions="*,14,246" IsVisible="{Binding !ShowHistoryView}">

            <!--  Commit message card: title, the message box (the wand sits
                  over its bottom-right corner) and the commit button at the
                  bottom. Ctrl+Enter commits (OnCommitBoxKeyDown) — plain
                  Enter keeps its newline.  -->
            <Border Grid.Column="0" Classes="ov-card">
                <DockPanel>

                    <TextBlock
                        Margin="0,0,0,6"
                        Classes="ov-card-title"
                        DockPanel.Dock="Top"
                        Text="Commit message" />


                    <!--  Commit button: an empty message box turns it into "Generate & Commit" —
                          the press then writes the message first (the wand's run) and commits  -->
                    <Button
                        Margin="0,8,0,0"
                        HorizontalAlignment="Left"
                        Classes="Outlined"
                        Command="{Binding CommitCommand}"
                        DockPanel.Dock="Bottom"
                        ToolTip.Tip="Commit staged changes; empty message auto-generates (opencode)">
                        <StackPanel Orientation="Horizontal" Spacing="6">
                            <!--  wand while the box is empty, check once a message is typed;
                                  both give way to the spinning ring while the commit runs;
                                  Fill/Stroke track the button's Foreground so hover turns it white with the text  -->
                            <Path
                                Width="13"
                                Height="13"
                                VerticalAlignment="Center"
                                IsVisible="{Binding CommitShowsWand}"
                                Data="{tools:SvgPath icon-wand}"
                                Fill="{Binding $parent[Button].Foreground}"
                                Stretch="Uniform" />
                            <Path
                                Width="13"
                                Height="13"
                                VerticalAlignment="Center"
                                IsVisible="{Binding CommitShowsCheck}"
                                Data="{tools:SvgPath icon-check}"
                                Fill="{Binding $parent[Button].Foreground}"
                                Stretch="Uniform" />
                            <!--  same ring recipe as the wand button: element-space arc,
                                  no Stretch, so the circle's center is exactly the
                                  RenderTransformOrigin the rotation pivots on  -->
                            <Path
                                Width="13"
                                Height="13"
                                VerticalAlignment="Center"
                                IsVisible="{Binding IsCommitting}"
                                Classes="spinner"
                                RenderTransformOrigin="50%,50%"
                                Data="{tools:SvgPath icon-spinner, Center=False}"
                                Stroke="{Binding $parent[Button].Foreground}"
                                StrokeThickness="2">
                                <Path.RenderTransform>
                                    <RotateTransform />
                                </Path.RenderTransform>
                            </Path>
                            <TextBlock VerticalAlignment="Center" Text="{Binding CommitButtonText}" />
                        </StackPanel>
                    </Button>

                    <!--  Message box; the wand sits over its bottom-right corner.  -->
                    <Grid>
                        <TextBox
                            AcceptsReturn="True"
                            KeyDown="OnCommitBoxKeyDown"
                            Padding="0,0,26,0"
                            VerticalContentAlignment="Top"
                            Text="{Binding CommitMessage}"
                            TextWrapping="Wrap"
                            Watermark="Commit message (empty = auto-generate)" />
                        <!--
                            Commit-message wand: a bare icon floating over the message
                            box's corner — a detail-link (transparent, dims on hover)
                            with its own padding, so the TextBox shows through.
                        -->
                        <Button
                            Margin="0,0,4,4"
                            HorizontalAlignment="Right"
                            VerticalAlignment="Bottom"
                            Padding="4"
                            Classes="detail-link"
                            Command="{Binding GenerateCommitMessageCommand}"
                            ToolTip.Tip="Generate a commit message from the staged diff (opencode)">
                            <Grid>
                                <!--  spinning arc while the generation runs; drawn at final size
                                      in element coordinates (no Stretch) so the circle's center
                                      is exactly the RenderTransformOrigin the rotation pivots on;
                                      the ring is the Path.spinner shared style  -->
                                <Path
                                    Width="16"
                                    Height="16"
                                    IsVisible="{Binding IsGeneratingMessage}"
                                    Classes="spinner"
                                    RenderTransformOrigin="50%,50%"
                                    Data="M 8 1 A 7 7 0 1 1 1 8"
                                    Stroke="{DynamicResource AccentPrimaryBrush}"
                                    StrokeThickness="2">
                                    <Path.RenderTransform>
                                        <RotateTransform />
                                    </Path.RenderTransform>
                                </Path>
                                <Path
                                    Width="16"
                                    Height="16"
                                    IsVisible="{Binding !IsGeneratingMessage}"
                                    Data="{tools:SvgPath icon-wand}"
                                    Fill="{DynamicResource MutedForegroundBrush}"
                                    Stretch="Uniform" />
                            </Grid>
                        </Button>
                    </Grid>
                </DockPanel>
            </Border>

            <!--  Git rail card. LastChildFill=False: the action stack docks
                  Top, the fetched row docks Bottom, the middle stays empty.
                  Padding=0 so the bar-item hover tints run card-edge to
                  card-edge; every block sets its own side margins.  -->
            <Border Grid.Column="2" Classes="ov-card" Padding="0">
                <DockPanel LastChildFill="False">

                    <StackPanel DockPanel.Dock="Top">

                        <!--  Branch dropdown — the stock SukiUI ComboBox (same
                              look as the repos page's sort selector): filled
                              box, branch icon + name, chevron square at the
                              right. Its FIRST entry is "New branch…" (an
                              action, not a branch — picking it opens the
                              new-branch drawer); picking a branch checks it
                              out, a remote pick checking out its local
                              tracking equivalent. The popup grows with its
                              widest entry under the cap, so full names show
                              there.  -->
                        <ComboBox
                            x:Name="BranchPicker"
                            Margin="6,12,6,0"
                            Height="38"
                            FontSize="14"
                            ItemsSource="{Binding BranchMenuItems}"
                            PlaceholderText="branch"
                            SelectedItem="{Binding SelectedMenuItem, Mode=OneWay}"
                            SelectionChanged="OnBranchSelectionChanged"
                            ToolTip.Tip="{Binding SelectedBranch}"> 
                            <!--
                                The menu mixes item types (the New branch sentinel and
                                GitBranchRef rows: local branches, the "Remote" group
                                label, remote-tracking branches); one ItemTemplate
                                hosting a ContentControl lets the typed inner
                                templates pick the row shape — keeping a single
                                ItemTemplate means no dependence on how the theme
                                resolves DataTemplates. The Remote label stays
                                selectable-but-inert: picking it snaps the selection
                                back in the view model (a container IsEnabled binding
                                can't type-check across the sentinel and branch rows).
                            -->
                            <ComboBox.ItemTemplate>
                                <DataTemplate x:DataType="x:Object">
                                    <ContentControl Content="{Binding}">
                                        <ContentControl.DataTemplates>
                                            <DataTemplate x:DataType="vm:NewBranchEntry">
                                                <StackPanel Orientation="Horizontal" Spacing="6">
                                                    <Path
                                                        Width="12"
                                                        Height="12"
                                                        Data="{tools:SvgPath icon-plus}"
                                                        Fill="{DynamicResource MutedForegroundBrush}"
                                                        Stretch="Uniform" />
                                                    <TextBlock
                                                        Foreground="{DynamicResource BodyForegroundBrush}"
                                                        Text="New branch…" />
                                                </StackPanel>
                                            </DataTemplate>
                                            <DataTemplate x:DataType="lib:GitBranchRef">
                                                <StackPanel Orientation="Horizontal" Spacing="6">
                                                    <Path
                                                        Width="12"
                                                        Height="12"
                                                        Data="{tools:SvgPath icon-source-branch}"
                                                        Fill="{DynamicResource MutedForegroundBrush}"
                                                        Stretch="Uniform"
                                                        IsVisible="{Binding IsLocal}" />
                                                    <Path
                                                        Width="12"
                                                        Height="12"
                                                        Data="{tools:SvgPath icon-cloud-download}"
                                                        Fill="{DynamicResource MutedForegroundBrush}"
                                                        Stretch="Uniform"
                                                        IsVisible="{Binding IsRemote}" />
                                                    <!--
                                                        Explicit foreground: SukiUI brightens only TextBlocks that
                                                        are the ComboBoxItem's DIRECT content; inside this
                                                        StackPanel the inherited popup color is too dim. The
                                                        ellipsis bites only under the caps (the closed box's
                                                        width, the item's) — the popup sizes to the widest
                                                        entry otherwise, so entries never trim in it. The
                                                        group label renders muted and small, no icon.
                                                    -->
                                                    <TextBlock
                                                        Foreground="{DynamicResource BodyForegroundBrush}"
                                                        Text="{Binding Name}"
                                                        TextTrimming="CharacterEllipsis"
                                                        IsVisible="{Binding !IsHeader}" />
                                                    <TextBlock
                                                        Foreground="{DynamicResource MutedForegroundBrush}"
                                                        FontSize="12"
                                                        Text="{Binding Name}"
                                                        IsVisible="{Binding IsHeader}" />
                                                </StackPanel>
                                            </DataTemplate>
                                        </ContentControl.DataTemplates>
                                    </ContentControl>
                                </DataTemplate>
                            </ComboBox.ItemTemplate>
                        </ComboBox>

                        <Border
                            Height="1"
                            Margin="12,14,12,2"
                            Background="{DynamicResource HairlineBrush}" />

                        <!--  One quiet full-width row per action (bar-item =
                              stretch button with the table's hover tint).
                              Each row's icon swaps to the spinning ring
                              while its operation runs.  -->
                        <Button
                            Padding="12,11"
                            Classes="bar-item"
                            Command="{Binding FetchCommand}"
                            ToolTip.Tip="git fetch --prune for the selected repository">
                            <Grid ColumnDefinitions="Auto,*,Auto" ColumnSpacing="10">
                                <Panel Width="16" Height="16" VerticalAlignment="Center">
                                    <Path
                                        Width="16"
                                        Height="16"
                                        Classes="icon"
                                        Data="{tools:SvgPath icon-cloud-download}"
                                        IsVisible="{Binding !IsFetching}" />
                                    <Path
                                        Width="15"
                                        Height="15"
                                        Classes="spinner"
                                        Data="{tools:SvgPath icon-spinner, Center=False}"
                                        IsVisible="{Binding IsFetching}"
                                        RenderTransformOrigin="50%,50%"
                                        Stroke="{DynamicResource MutedForegroundBrush}"
                                        StrokeThickness="2">
                                        <Path.RenderTransform>
                                            <RotateTransform />
                                        </Path.RenderTransform>
                                    </Path>
                                </Panel>
                                <TextBlock
                                    Grid.Column="1"
                                    VerticalAlignment="Center"
                                    FontSize="14"
                                    Foreground="{DynamicResource BodyForegroundBrush}"
                                    Text="Fetch" />
                            </Grid>
                        </Button>
                        <Button
                            Padding="12,11"
                            Classes="bar-item"
                            Command="{Binding PullCommand}"
                            ToolTip.Tip="git pull for the selected repository">
                            <Grid ColumnDefinitions="Auto,*,Auto" ColumnSpacing="10">
                                <Panel Width="16" Height="16" VerticalAlignment="Center">
                                    <Path
                                        Width="16"
                                        Height="16"
                                        Classes="icon"
                                        Data="{tools:SvgPath icon-arrow-down}"
                                        IsVisible="{Binding !IsPulling}" />
                                    <Path
                                        Width="15"
                                        Height="15"
                                        Classes="spinner"
                                        Data="{tools:SvgPath icon-spinner, Center=False}"
                                        IsVisible="{Binding IsPulling}"
                                        RenderTransformOrigin="50%,50%"
                                        Stroke="{DynamicResource MutedForegroundBrush}"
                                        StrokeThickness="2">
                                        <Path.RenderTransform>
                                            <RotateTransform />
                                        </Path.RenderTransform>
                                    </Path>
                                </Panel>
                                <TextBlock
                                    Grid.Column="1"
                                    VerticalAlignment="Center"
                                    FontSize="14"
                                    Foreground="{DynamicResource BodyForegroundBrush}"
                                    Text="Pull" />
                                <!--  Behind/ahead count: the page header's count-chip
                                      look (Repositories 11) — borderless neutral
                                      pill, semibold body-colored number.  -->
                                <Border
                                    Grid.Column="2"
                                    VerticalAlignment="Center"
                                    Background="{DynamicResource RowHoverBackgroundBrush}"
                                    CornerRadius="{DynamicResource ChipRadius}"
                                    IsVisible="{Binding GitToPullCount, Converter={StaticResource PositiveCountToVisibilityConverter}}"
                                    Padding="8,3">
                                    <TextBlock
                                        VerticalAlignment="Center"
                                        FontSize="13"
                                        FontWeight="SemiBold"
                                        Foreground="{DynamicResource BodyForegroundBrush}"
                                        Text="{Binding GitToPullCount}" />
                                </Border>
                            </Grid>
                        </Button>
                        <Button
                            Padding="12,11"
                            Classes="bar-item"
                            Command="{Binding PushCommand}"
                            ToolTip.Tip="git push for the selected repository">
                            <Grid ColumnDefinitions="Auto,*,Auto" ColumnSpacing="10">
                                <Panel Width="16" Height="16" VerticalAlignment="Center">
                                    <Path
                                        Width="16"
                                        Height="16"
                                        Classes="icon"
                                        Data="{tools:SvgPath icon-arrow-up}"
                                        IsVisible="{Binding !IsPushing}" />
                                    <Path
                                        Width="15"
                                        Height="15"
                                        Classes="spinner"
                                        Data="{tools:SvgPath icon-spinner, Center=False}"
                                        IsVisible="{Binding IsPushing}"
                                        RenderTransformOrigin="50%,50%"
                                        Stroke="{DynamicResource MutedForegroundBrush}"
                                        StrokeThickness="2">
                                        <Path.RenderTransform>
                                            <RotateTransform />
                                        </Path.RenderTransform>
                                    </Path>
                                </Panel>
                                <TextBlock
                                    Grid.Column="1"
                                    VerticalAlignment="Center"
                                    FontSize="14"
                                    Foreground="{DynamicResource BodyForegroundBrush}"
                                    Text="Push" />
                                <Border
                                    Grid.Column="2"
                                    VerticalAlignment="Center"
                                    Background="{DynamicResource RowHoverBackgroundBrush}"
                                    CornerRadius="{DynamicResource ChipRadius}"
                                    IsVisible="{Binding GitToPushCount, Converter={StaticResource PositiveCountToVisibilityConverter}}"
                                    Padding="8,3">
                                    <TextBlock
                                        VerticalAlignment="Center"
                                        FontSize="13"
                                        FontWeight="SemiBold"
                                        Foreground="{DynamicResource BodyForegroundBrush}"
                                        Text="{Binding GitToPushCount}" />
                                </Border>
                            </Grid>
                        </Button>

                        <Border
                            Height="1"
                            Margin="12,8"
                            Background="{DynamicResource HairlineBrush}" />

                        <Button
                            Padding="12,11"
                            Classes="bar-item"
                            Command="{Binding SyncCommand}"
                            ToolTip.Tip="Pull, then push — bring the branch level with its upstream">
                            <Grid ColumnDefinitions="Auto,*,Auto" ColumnSpacing="10">
                                <Panel Width="16" Height="16" VerticalAlignment="Center">
                                    <Path
                                        Width="16"
                                        Height="16"
                                        Classes="icon"
                                        Data="{tools:SvgPath icon-refresh}"
                                        IsVisible="{Binding !IsSyncing}" />
                                    <Path
                                        Width="15"
                                        Height="15"
                                        Classes="spinner"
                                        Data="{tools:SvgPath icon-spinner, Center=False}"
                                        IsVisible="{Binding IsSyncing}"
                                        RenderTransformOrigin="50%,50%"
                                        Stroke="{DynamicResource MutedForegroundBrush}"
                                        StrokeThickness="2">
                                        <Path.RenderTransform>
                                            <RotateTransform />
                                        </Path.RenderTransform>
                                    </Path>
                                </Panel>
                                <TextBlock
                                    Grid.Column="1"
                                    VerticalAlignment="Center"
                                    FontSize="14"
                                    Foreground="{DynamicResource BodyForegroundBrush}"
                                    Text="Sync" />
                            </Grid>
                        </Button>
                        <Button
                            Padding="12,11"
                            Classes="bar-item"
                            Command="{Binding DiscardAllCommand}"
                            ToolTip.Tip="Delete every staged, unstaged and untracked change — no undo">
                            <Grid ColumnDefinitions="Auto,*,Auto" ColumnSpacing="10">
                                <Panel Width="16" Height="16" VerticalAlignment="Center">
                                    <Path
                                        Width="16"
                                        Height="16"
                                        Classes="icon"
                                        Data="{tools:SvgPath icon-discard}"
                                        IsVisible="{Binding !IsDiscarding}" />
                                    <Path
                                        Width="15"
                                        Height="15"
                                        Classes="spinner"
                                        Data="{tools:SvgPath icon-spinner, Center=False}"
                                        IsVisible="{Binding IsDiscarding}"
                                        RenderTransformOrigin="50%,50%"
                                        Stroke="{DynamicResource MutedForegroundBrush}"
                                        StrokeThickness="2">
                                        <Path.RenderTransform>
                                            <RotateTransform />
                                        </Path.RenderTransform>
                                    </Path>
                                </Panel>
                                <TextBlock
                                    Grid.Column="1"
                                    VerticalAlignment="Center"
                                    FontSize="14"
                                    Foreground="{DynamicResource BodyForegroundBrush}"
                                    Text="Discard all changes" />
                            </Grid>
                        </Button>
                        <Button
                            Padding="12,11"
                            Classes="bar-item"
                            Command="{Binding ToggleHistoryCommand}"
                            ToolTip.Tip="Show this repository's history">
                            <Grid ColumnDefinitions="Auto,*,Auto" ColumnSpacing="10">
                                <Path
                                    Width="16"
                                    Height="16"
                                    Classes="icon"
                                    Data="{tools:SvgPath icon-clock}" />
                                <TextBlock
                                    Grid.Column="1"
                                    VerticalAlignment="Center"
                                    FontSize="14"
                                    Foreground="{DynamicResource BodyForegroundBrush}"
                                    Text="History" />
                            </Grid>
                        </Button>
                    </StackPanel>

                    <!--  Last fetched: a hairline, then the status dot (green
                          once the repo has been fetched) + the relative
                          label, and the refresh button (a git fetch with
                          prune; the icon swaps to the spinning ring while it
                          runs) pinned to the card's bottom edge.  -->
                    <StackPanel DockPanel.Dock="Bottom">
                        <Border
                            Height="1"
                            Margin="12,8,12,0"
                            Background="{DynamicResource HairlineBrush}" />
                        <Grid
                            ColumnDefinitions="Auto,*,Auto"
                            ColumnSpacing="8"
                            Margin="12,9,12,10">
                            <Border
                                Width="8"
                                Height="8"
                                VerticalAlignment="Center"
                                Background="{Binding HasFetched, Converter={StaticResource BoolToBrushConverter}}"
                                CornerRadius="4" />
                            <TextBlock
                                Grid.Column="1"
                                VerticalAlignment="Center"
                                FontSize="13"
                                Foreground="{DynamicResource BodyForegroundBrush}"
                                Text="{Binding LastFetchText, TargetNullValue='Not fetched'}"
                                TextTrimming="CharacterEllipsis" />
                            <Button
                                Grid.Column="2"
                                VerticalAlignment="Center"
                                Classes="icon"
                                Command="{Binding FetchCommand}"
                                ToolTip.Tip="git fetch --prune for the selected repository">
                                <Panel>
                                    <Path
                                        Classes="icon"
                                        Data="{tools:SvgPath icon-refresh}"
                                        IsVisible="{Binding !IsFetching}" />
                                    <Path
                                        Width="13"
                                        Height="13"
                                        Classes="spinner"
                                        Data="{tools:SvgPath icon-spinner, Center=False}"
                                        IsVisible="{Binding IsFetching}"
                                        RenderTransformOrigin="50%,50%"
                                        Stroke="{DynamicResource MutedForegroundBrush}"
                                        StrokeThickness="2">
                                        <Path.RenderTransform>
                                            <RotateTransform />
                                        </Path.RenderTransform>
                                    </Path>
                                </Panel>
                            </Button>
                        </Grid>
                    </StackPanel>
                </DockPanel>
            </Border>
        </Grid>

    </Grid>
</UserControl>
