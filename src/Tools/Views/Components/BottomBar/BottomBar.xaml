<?xml version="1.0" encoding="utf-8" ?>
<UserControl
    x:Class="Tools.Views.Components.BottomBar.BottomBar"
    xmlns="https://github.com/avaloniaui"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:controls="using:Tools.Controls"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:repo="using:Tools.Views.Components.Repo"
    xmlns:tabs="using:Tools.Views.Components.BottomBar.Tabs"
    xmlns:vm="using:Tools.ViewModels.Components.BottomBar"
    d:DesignHeight="280"
    d:DesignWidth="1200"
    x:CompileBindings="True"
    x:DataType="vm:BottomBarViewModel"
    x:Name="BarRoot"
    mc:Ignorable="d">

    <UserControl.Styles>
        <!--  Tab row styles (moved with the tab row itself out of RepoHeader):
              quiet label + count chip, accent underline when active.  -->
        <Style Selector="Button.bar-tab">
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="Padding" Value="0,9" />
            <Setter Property="CornerRadius" Value="0" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="VerticalContentAlignment" Value="Center" />
        </Style>
        <Style Selector="Button.bar-tab TextBlock.tab-label">
            <Setter Property="FontSize" Value="13" />
            <Setter Property="FontWeight" Value="Medium" />
            <Setter Property="Foreground" Value="{DynamicResource MutedForegroundBrush}" />
        </Style>
        <Style Selector="Button.bar-tab:pointerover TextBlock.tab-label">
            <Setter Property="Foreground" Value="{DynamicResource BodyForegroundBrush}" />
        </Style>
        <Style Selector="Button.bar-tab.active">
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="BorderBrush" Value="{DynamicResource AccentPrimaryBrush}" />
            <Setter Property="BorderThickness" Value="0,0,0,2" />
            <Setter Property="Padding" Value="0,9" />
        </Style>
        <Style Selector="Button.bar-tab.active TextBlock.tab-label">
            <Setter Property="Foreground" Value="{DynamicResource TitleForegroundBrush}" />
            <Setter Property="FontWeight" Value="SemiBold" />
        </Style>
        <!--  Tab badge: the count carried over from the row chips, in a small rounded chip.  -->
        <Style Selector="Border.tab-badge-chip">
            <Setter Property="Background" Value="{DynamicResource CardSubtleBackgroundBrush}" />
            <Setter Property="CornerRadius" Value="5" />
            <Setter Property="Padding" Value="6,1" />
            <Setter Property="VerticalAlignment" Value="Center" />
        </Style>
        <Style Selector="TextBlock.tab-badge">
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="Foreground" Value="{DynamicResource BodyForegroundBrush}" />
        </Style>
    </UserControl.Styles>

    <!--
        Bottom bar shell: the expandable panel hosting the active tab's content.
        The whole control stays hidden until a repo is selected from the table: a
        row press or a row chip reveals it (IsBarVisible); the header's X hides it
        again. The tab row lives in the RepoHeader inside the panel; each tab's
        content is its own control under Tabs/ (Overview, Changes, Pull Requests,
        Issues, Pipelines — gated by the IsActive* flags here), and the shared
        row/card templates + styles live in BottomBarResources.axaml, merged into
        each tab. The git context (branch dropdown + Fetch + last-fetched) lives
        in the Changes tab's toolbar row. Chrome matches the floating tool drawer:
        one docked card (CardBackgroundBrush surface, HairlineBrush border,
        CardRadius corners) that lives in the page layout — the table shrinks
        around it, nothing floats over the page. The bar lives on the Repositories
        page (it is that page's footer), not on every page.
    -->

    <!--  The bar sits inset from the page edges, aligned with the table card above.  -->
    <Grid IsVisible="{Binding IsBarVisible}" Margin="8,0,8,0" RowDefinitions="Auto,Auto">

        <!--  ============ Panel-top drag divider ====
              Three grip dots between the repo table and the bar; the WHOLE row (not just
              the dots) is the drag surface and resizes the expanded panel (the table
              above shrinks/grows to match). Visible whenever the bar is, so it always
              separates the table from the bar. The band is
              16px and the dots sit dead-center (6.5 above / 6.5 below) — the page's
              table margin no longer adds a top gap. The dots, cursor and hit
              background live in the shared controls:ResizeGrip (same markup as the
              tool drawer's left-edge grip).  -->
        <controls:ResizeGrip
            Grid.Row="0"
            x:Name="PanelResizer"
            Height="8"
            Orientation="Vertical" />

        <!--  ============ Expandable panel (repo header + active tab's content) ====
              The whole docked card (the old strip is gone — its branch/Fetch row
              moved into the Changes tab's toolbar): full rounded corners, hairline
              border on all four sides.  -->
        <Border
            Grid.Row="1"
            Height="{Binding PanelHeight}"
            Background="{DynamicResource CardBackgroundBrush}"
            BorderBrush="{DynamicResource HairlineBrush}"
            BorderThickness="1"
            ClipToBounds="True"
            CornerRadius="{DynamicResource CardRadius}"
            IsVisible="{Binding IsPanelOpen}">
            <Grid Margin="12,8,12,12" RowDefinitions="Auto,Auto,*">

                <!--
                    Repo header (mockup): back link, repo name + star, branch / URL
                    line and the tab row — lives INSIDE the panel, above its content.
                -->
                <repo:RepoHeader Grid.Row="0" />

                <!--  Tab row: drives the panel's content (moved out of RepoHeader
                      so the Changes History view can cover it via a row-spanning
                      overlay without covering the repo name / tag rows).  -->
                <StackPanel
                    Grid.Row="1"
                    Margin="0,0,0,8"
                    Orientation="Horizontal"
                    Spacing="36">
                    <Button Classes="bar-tab" Classes.active="{Binding IsActiveOverview}" Command="{Binding ToggleOverviewTabCommand}" ToolTip.Tip="Open the repository's overview">
                        <TextBlock Classes="tab-label" Text="Overview" />
                    </Button>
                    <Button Classes="bar-tab" Classes.active="{Binding IsActiveChanges}" Command="{Binding ToggleChangesTabCommand}" ToolTip.Tip="Working tree, staging and commit">
                        <StackPanel Orientation="Horizontal" Spacing="8">
                            <TextBlock Classes="tab-label" Text="Changes" />
                            <Border Classes="tab-badge-chip" IsVisible="{Binding ShowChangesBadge}">
                                <TextBlock Classes="tab-badge" Text="{Binding ChangesCount}" />
                            </Border>
                        </StackPanel>
                    </Button>
                    <Button
                        Classes="bar-tab"
                        Classes.active="{Binding IsActivePullRequests}"
                        Command="{Binding TogglePullRequestsTabCommand}"
                        IsVisible="{Binding IsGitHubEnabled}"
                        ToolTip.Tip="Open pull requests">
                        <StackPanel Orientation="Horizontal" Spacing="8">
                            <TextBlock Classes="tab-label" Text="Pull Requests" />
                            <Border Classes="tab-badge-chip" IsVisible="{Binding ShowPullRequestBadge}">
                                <TextBlock Classes="tab-badge" Text="{Binding PullRequestCount}" />
                            </Border>
                        </StackPanel>
                    </Button>
                    <Button
                        Classes="bar-tab"
                        Classes.active="{Binding IsActiveIssues}"
                        Command="{Binding ToggleIssuesTabCommand}"
                        IsVisible="{Binding IsGitHubEnabled}"
                        ToolTip.Tip="Open issues">
                        <StackPanel Orientation="Horizontal" Spacing="8">
                            <TextBlock Classes="tab-label" Text="Issues" />
                            <Border Classes="tab-badge-chip" IsVisible="{Binding ShowIssueBadge}">
                                <TextBlock Classes="tab-badge" Text="{Binding IssueCount}" />
                            </Border>
                        </StackPanel>
                    </Button>
                    <Button
                        Classes="bar-tab"
                        Classes.active="{Binding IsActiveAzure}"
                        Command="{Binding ToggleAzureTabCommand}"
                        IsVisible="{Binding IsAzureDevOpsEnabled}"
                        ToolTip.Tip="Open pull requests, work items and pipeline runs">
                        <TextBlock Classes="tab-label" Text="Pipelines" />
                    </Button>
                </StackPanel>

                <!--  Overview tab: stat cards, three activity lists, repository details  -->
                <tabs:OverviewTab
                    Grid.Row="2"
                    IsVisible="{Binding IsActiveOverview}" />

                <!--  Changes tab: branch toolbar, staged/unstaged tree, commit workspace,
                      collapsed history — bound to the shell's Changes child VM; the
                      shell-scoped visibility reads the root element directly.  -->
                <tabs:ChangesTab
                    Grid.Row="2"
                    DataContext="{Binding Changes}"
                    IsVisible="{Binding #BarRoot.((vm:BottomBarViewModel)DataContext).IsActiveChanges}" />

                <!--  Pull requests tab  -->
                <tabs:PullRequestsTab
                    Grid.Row="2"
                    IsVisible="{Binding IsActivePullRequests}" />

                <!--  Issues tab  -->
                <tabs:IssuesTab
                    Grid.Row="2"
                    IsVisible="{Binding IsActiveIssues}" />

                <!--  Azure DevOps tab: pull requests, work items, pipeline runs —
                      bound to the shell's Azure panel VM  -->
                <tabs:AzureTab
                    Grid.Row="2"
                    DataContext="{Binding Azure}"
                    IsVisible="{Binding #BarRoot.((vm:BottomBarViewModel)DataContext).IsActiveAzure}" />

                <!--  Changes History view: covers the tab row AND the content
                      (rows 1-2) while the Changes tab's git rail has toggled
                      History on — it reads as a page over the tabs, not a
                      section under them. Only on the Changes tab; bound to the
                      Changes child VM like the tab itself.  -->
                <Grid
                    Grid.Row="1"
                    Grid.RowSpan="2"
                    IsVisible="{Binding #BarRoot.((vm:BottomBarViewModel)DataContext).IsActiveChanges}">
                    <tabs:ChangesHistoryView
                        DataContext="{Binding Changes}"
                        IsVisible="{Binding ShowHistoryView}" />
                </Grid>
            </Grid>
        </Border>

    </Grid>
</UserControl>
