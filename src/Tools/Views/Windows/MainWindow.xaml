<?xml version="1.0" encoding="utf-8" ?>
<suki:SukiWindow
	x:Class="Tools.Views.Windows.MainWindow"
	xmlns="https://github.com/avaloniaui"
	xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
	xmlns:controls="using:Tools.Controls"
	xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
	xmlns:helpers="using:Tools.Helpers"
	xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
	xmlns:suki="https://github.com/kikipoulet/SukiUI"
	xmlns:tools="using:Tools.Library.MarkupExtensions"
	Title="DevTools"
	Width="1400"
	Height="900"
	MinWidth="800"
	MinHeight="600"
	BackgroundStyle="Flat"
	Theme="{StaticResource CustomSukiWindowTheme}"
	WindowStartupLocation="CenterScreen">

	<suki:SukiWindow.Styles>
		<!--
			Title-bar status dots: running = green, SnapIt stopped = red,
			NuGet idle = yellow. The running class is bound to each tool's
			running state; define order matters — .running must come last.
		-->
		<Style Selector="Ellipse.status-dot">
			<Setter Property="Fill" Value="{DynamicResource DangerAccentBrush}" />
		</Style>
		<Style Selector="Ellipse.status-dot.status-idle">
			<Setter Property="Fill" Value="{DynamicResource WarningAccentBrush}" />
		</Style>
		<Style Selector="Ellipse.status-dot.running">
			<Setter Property="Fill" Value="{DynamicResource StatusActiveBrush}" />
		</Style>
		<!--  Title-bar status chip: transparent until hovered  -->
		<Style Selector="Button.titlebar-status">
			<Setter Property="Background" Value="Transparent" />
			<Setter Property="BorderThickness" Value="0" />
		</Style>
		<Style Selector="Button.titlebar-status:pointerover">
			<Setter Property="Background" Value="{DynamicResource HoverBackgroundBrush}" />
		</Style>
		<!--
			Header: the window uses the CustomSukiWindowTheme (see Styles/), whose title
			bar replaces the app-title text with the centered global search field. The
			brand cluster (logo, app name) lives in LogoContent at the bar's left; the
			bar keeps its drag role everywhere else.
		-->
		<!--  The search field tints its hairline with the accent while focused  -->
		<Style Selector="Border#HeaderSearchBorder:focus-within">
			<Setter Property="BorderBrush" Value="{DynamicResource AccentSoftBorderBrush}" />
		</Style>
	</suki:SukiWindow.Styles>

	<!--  Logo mark + app name hosted on the left of the title bar  -->
	<suki:SukiWindow.LogoContent>
		<!--  Header brand cluster: logo mark, app title  -->
		<StackPanel
			VerticalAlignment="Center"
			Orientation="Horizontal"
			Spacing="8">
			<!--
				Logo mark: code brackets around a slash. Box is sized to the ink's
				aspect (16.4x13.2 on the 24 grid): Stretch.Uniform then fills the
				box edge-to-edge, so VerticalAlignment=Center centers the drawn
				mark instead of leaving Avalonia's top-left fit riding it high.
			-->
			<Path
				Width="20"
				Height="16"
				VerticalAlignment="Center"
				Data="{tools:SvgPath icon-logo-mark,
				                     Center=False}"
				Stretch="Uniform"
				Stroke="{DynamicResource AccentPrimaryBrush}"
				StrokeJoin="Round"
				StrokeThickness="2.2" />
			<TextBlock
				VerticalAlignment="Center"
				FontSize="15"
				FontWeight="SemiBold"
				Foreground="{DynamicResource TitleForegroundBrush}"
				Text="DevTools" />
		</StackPanel>
	</suki:SukiWindow.LogoContent>

	<!--
		Title-bar tray on the right of the search field: live status chips, a hairline
		divider, the tools dropdown and settings grouped, then a final divider between
		them and the caption buttons. SukiWindow lays RightWindowTitleBarControls out
		right-to-left, so items are declared in REVERSE of their visual order: the
		divider + settings + tools cluster ends up nearest the caption buttons, the
		status chips nearest the search field. Each child gets ElementRole=User from
		the window template, so they stay clickable while the bar around them keeps
		its drag role.
	-->
	<suki:SukiWindow.RightWindowTitleBarControls>
		<!--  Hairline divider between the icon cluster and the caption buttons  -->
		<Border
			Width="1"
			Height="14"
			Margin="2,0"
			VerticalAlignment="Center"
			Background="{DynamicResource HairlineBrush}" />
		<!--  Open the settings folder  -->
		<Button
			Width="26"
			Height="26"
			Margin="4,0"
			Padding="0"
			Classes="icon"
			Command="{Binding OpenSettingsFolderCommand}"
			ToolTip.Tip="Open settings folder">
			<Path
				Width="15"
				Height="15"
				VerticalAlignment="Center"
				Data="{tools:SvgPath icon-cog}"
				Fill="{DynamicResource BodyForegroundBrush}"
				Stretch="Uniform" />
		</Button>
		<!--
			Tools dropdown: opens the tool components in the floating right drawer.
			Hover-open/close are wired in the code-behind: a short hover delay opens
			it, and it stays up while the pointer is over the button or the menu.
		-->
		<Button
			x:Name="ToolsButton"
			Width="38"
			Height="26"
			Margin="4,0"
			Padding="0"
			Classes="icon"
			ToolTip.Tip="Tools">
			<StackPanel
				VerticalAlignment="Center"
				Orientation="Horizontal"
				Spacing="3">
				<Path
					Width="14"
					Height="14"
					VerticalAlignment="Center"
					Data="{tools:SvgPath icon-tools}"
					Fill="{DynamicResource BodyForegroundBrush}"
					Stretch="Uniform" />
				<!--
					Center=False: the flat chevron's ink would be shrunk onto the square
					design grid; raw bounds let it fill the box at its real aspect.
				-->
				<Path
					Width="8"
					Height="6"
					VerticalAlignment="Center"
					Data="{tools:SvgPath icon-chevron-down,
					                     Center=False}"
					Fill="{DynamicResource MutedForegroundBrush}"
					Stretch="Uniform" />
			</StackPanel>
			<Button.Flyout>
				<!--
					Right-aligned: the button sits at the window's right edge, so a
					left-aligned flyout would overflow off the window. CommandParameters
					are x:Static references to ToolComponentMapper key constants, so the
					menu keys are compile-checked against the mapper.
				-->
				<MenuFlyout Placement="BottomEdgeAlignedRight">
					<!--
						Icon rows ride in an explicit Header element: the XAML compiler
						crashes resolving MenuFlyoutItem's implicit content property.
					-->
					<!--  Hidden along with the tool itself when the tool is disabled  -->
					<MenuItem
						Command="{Binding OpenToolCommand}"
						CommandParameter="{x:Static helpers:ToolComponentMapper.NugetLocalKey}"
						IsVisible="{Binding ShowNuget}">
						<MenuItem.Header>
							<StackPanel Orientation="Horizontal" Spacing="10">
								<Path
									Width="16"
									Height="16"
									Data="{tools:SvgPath icon-package}"
									Fill="{DynamicResource MutedForegroundBrush}"
									Stretch="Uniform" />
								<TextBlock Foreground="{DynamicResource BodyForegroundBrush}" Text="NuGet Package Manager" />
							</StackPanel>
						</MenuItem.Header>
					</MenuItem>
					<MenuItem Command="{Binding OpenToolCommand}" CommandParameter="{x:Static helpers:ToolComponentMapper.FormattersKey}">
						<MenuItem.Header>
							<StackPanel Orientation="Horizontal" Spacing="10">
								<Path
									Width="16"
									Height="16"
									Data="{tools:SvgPath icon-text-format}"
									Fill="{DynamicResource MutedForegroundBrush}"
									Stretch="Uniform" />
								<TextBlock Foreground="{DynamicResource BodyForegroundBrush}" Text="Formatters" />
							</StackPanel>
						</MenuItem.Header>
					</MenuItem>
					<!--  Hidden along with the tool itself when the tool is disabled  -->
					<MenuItem
						Command="{Binding OpenToolCommand}"
						CommandParameter="{x:Static helpers:ToolComponentMapper.ClipboardPasswordKey}"
						IsVisible="{Binding ShowClipboardPassword}">
						<MenuItem.Header>
							<StackPanel Orientation="Horizontal" Spacing="10">
								<Path
									Width="16"
									Height="16"
									Data="{tools:SvgPath icon-lock}"
									Fill="{DynamicResource MutedForegroundBrush}"
									Stretch="Uniform" />
								<TextBlock Foreground="{DynamicResource BodyForegroundBrush}" Text="Clipboard Password" />
							</StackPanel>
						</MenuItem.Header>
					</MenuItem>
					<MenuItem Command="{Binding OpenToolCommand}" CommandParameter="{x:Static helpers:ToolComponentMapper.CodeExecuteKey}">
						<MenuItem.Header>
							<StackPanel Orientation="Horizontal" Spacing="10">
								<Path
									Width="16"
									Height="16"
									Data="{tools:SvgPath icon-terminal-alt}"
									Fill="{DynamicResource MutedForegroundBrush}"
									Stretch="Uniform" />
								<TextBlock Foreground="{DynamicResource BodyForegroundBrush}" Text="Code Execute" />
							</StackPanel>
						</MenuItem.Header>
					</MenuItem>
					<!--  SnapIt is Windows-only: the entry hides on other platforms  -->
					<MenuItem
						Command="{Binding OpenToolCommand}"
						CommandParameter="{x:Static helpers:ToolComponentMapper.SnapItSettingsKey}"
						IsVisible="{Binding ShowSnapIt}">
						<MenuItem.Header>
							<StackPanel Orientation="Horizontal" Spacing="10">
								<Path
									Width="16"
									Height="16"
									Data="{tools:SvgPath icon-grid}"
									Fill="{DynamicResource MutedForegroundBrush}"
									Stretch="Uniform" />
								<TextBlock Foreground="{DynamicResource BodyForegroundBrush}" Text="SnapIt" />
							</StackPanel>
						</MenuItem.Header>
					</MenuItem>
				</MenuFlyout>
			</Button.Flyout>
		</Button>
		<!--  Hairline divider between the NuGet chip and the tools icon  -->
		<Border
			Width="1"
			Height="14"
			Margin="2,0"
			VerticalAlignment="Center"
			Background="{DynamicResource HairlineBrush}" />
		<!--  NuGet watch status chip: dot yellow while idle, green while watching; click toggles  -->
		<Button
			Height="26"
			Margin="4,0"
			Padding="10,0"
			Classes="titlebar-status"
			Command="{Binding ToggleNugetWatchCommand}"
			CornerRadius="{DynamicResource ChipRadius}"
			Cursor="Hand"
			IsVisible="{Binding ShowNuget}"
			ToolTip.Tip="{Binding NugetWatchStatusText, StringFormat='NuGet watch: {0}'}">
			<StackPanel Orientation="Horizontal" Spacing="7">
				<Ellipse
					Width="8"
					Height="8"
					VerticalAlignment="Center"
					Classes="status-dot status-idle"
					Classes.running="{Binding NugetWatchRunning}" />
				<TextBlock
					VerticalAlignment="Center"
					Foreground="{DynamicResource BodyForegroundBrush}"
					Text="NuGet" />
			</StackPanel>
		</Button>
		<!--
			SnapIt status chip: dot red while stopped, green while running; click toggles.
			Windows-only functionality — hidden entirely on other platforms.
		-->
		<Button
			Height="26"
			Margin="4,0"
			Padding="10,0"
			Classes="titlebar-status"
			Command="{Binding ToggleSnapItCommand}"
			CornerRadius="{DynamicResource ChipRadius}"
			Cursor="Hand"
			IsVisible="{Binding ShowSnapIt}"
			ToolTip.Tip="{Binding SnapItStatusText, StringFormat='SnapIt: {0}'}">
			<StackPanel Orientation="Horizontal" Spacing="7">
				<Ellipse
					Width="8"
					Height="8"
					VerticalAlignment="Center"
					Classes="status-dot"
					Classes.running="{Binding SnapItRunning}" />
				<TextBlock
					VerticalAlignment="Center"
					Foreground="{DynamicResource BodyForegroundBrush}"
					Text="SnapIt" />
			</StackPanel>
		</Button>
	</suki:SukiWindow.RightWindowTitleBarControls>

	<!--  The bottom bar lives on the Repositories page (its footer), not on every page.  -->
	<Grid ColumnDefinitions="*">
		<!--  Content Area  -->
		<Grid Background="{DynamicResource ContentBackgroundBrush}">
			<ContentControl x:Name="ContentArea" Padding="0" />
		</Grid>

		<!--
			Floating tool drawer: a card anchored over the right edge of the open page,
			opened from the title-bar tools dropdown or the dashboard tool cards. The
			transparent backdrop eats clicks anywhere outside the card (closing it) while
			leaving the page visually untouched.
		-->
		<Panel IsVisible="{Binding IsToolDrawerOpen}">
			<Border
				x:Name="ToolDrawerBackdrop"
				Background="Transparent"
				PointerPressed="OnToolDrawerBackdropPointerPressed" />
			<Border
				Width="{Binding ToolDrawerWidth}"
				Margin="0,12,12,12"
				HorizontalAlignment="Right"
				VerticalAlignment="Stretch"
				Background="{DynamicResource CardBackgroundBrush}"
				BorderBrush="{DynamicResource HairlineBrush}"
				BorderThickness="1"
				BoxShadow="{DynamicResource FlyoutShadow}"
				CornerRadius="{DynamicResource CardRadius}">
				<Grid>
					<Grid RowDefinitions="Auto,*">
						<!--  Drawer header: current tool icon + title, close on the right  -->
						<Grid
							Grid.Row="0"
							Margin="16,12,8,4"
							ColumnDefinitions="Auto,*,Auto">
						<Path
							Grid.Column="0"
							Width="18"
							Height="18"
							VerticalAlignment="Center"
							Data="{Binding ToolDrawerIconPath, Converter={StaticResource StringToGeometryConverter}}"
							Fill="{DynamicResource AccentPrimaryBrush}"
							Stretch="Uniform" />
						<TextBlock
							Grid.Column="1"
							Margin="10,0,0,0"
							VerticalAlignment="Center"
							FontSize="16"
							FontWeight="SemiBold"
							Foreground="{DynamicResource TitleForegroundBrush}"
							Text="{Binding ToolDrawerTitle}" />
						<Button
							Grid.Column="2"
							Width="26"
							Height="26"
							Padding="0"
							Classes="icon"
							Command="{Binding CloseToolDrawerCommand}"
							ToolTip.Tip="Close">
							<Path
								Width="13"
								Height="13"
								Data="{tools:SvgPath icon-close}"
								Fill="{DynamicResource MutedForegroundBrush}"
								Stretch="Uniform" />
						</Button>
					</Grid>
					<!--  The open tool's component view; the window swaps it per selection  -->
					<ContentControl x:Name="ToolDrawerHost" Grid.Row="1" />
					</Grid>
					<!--
						Left-edge resize grip: the bottom panels' three-dots divider rotated
						vertical (shared controls:ResizeGrip). The whole 16px band is the
						drag surface (wired in code-behind via PanelResizeController,
						horizontal axis); it overlays only the card's gutter — every drawer
						component keeps a 16px content margin, so nothing interactive sits
						underneath.
					-->
					<controls:ResizeGrip
						x:Name="ToolDrawerResizer"
						Width="16"
						HorizontalAlignment="Left"
						VerticalAlignment="Stretch"
						Orientation="Horizontal" />
				</Grid>
			</Border>
		</Panel>

		<!--  Toast overlay (floats above all pages, the drawer and the bottom bar, top-center)  -->
		<ItemsControl
			x:Name="ToastHost"
			Margin="0,12,0,0"
			HorizontalAlignment="Center"
			VerticalAlignment="Top"
			IsHitTestVisible="True">
			<ItemsControl.ItemsPanel>
				<ItemsPanelTemplate>
					<StackPanel
						HorizontalAlignment="Center"
						Orientation="Vertical"
						Spacing="8" />
				</ItemsPanelTemplate>
			</ItemsControl.ItemsPanel>
			<ItemsControl.ItemTemplate>
				<DataTemplate>
					<Border
						Width="320"
						Padding="12,10"
						Background="{DynamicResource CardBackgroundBrush}"
						BorderBrush="{DynamicResource HairlineBrush}"
						BorderThickness="1"
						BoxShadow="{DynamicResource FlyoutShadow}"
						CornerRadius="{DynamicResource CardRadius}">
						<Grid ColumnDefinitions="4,*,Auto">
							<!--  Accent stripe colored by kind  -->
							<Border
								Grid.Column="0"
								Margin="0,0,10,0"
								VerticalAlignment="Stretch"
								Background="{Binding Kind, Converter={StaticResource NotificationKindToBrushConverter}}"
								CornerRadius="2" />
							<!--  Title + message  -->
							<StackPanel
								Grid.Column="1"
								Margin="0,0,8,0"
								VerticalAlignment="Center"
								Spacing="2">
								<TextBlock
									FontWeight="SemiBold"
									Foreground="{DynamicResource TitleForegroundBrush}"
									IsVisible="{Binding Title, Converter={StaticResource StringNotNullToBoolConverter}}"
									Text="{Binding Title}"
									TextTrimming="CharacterEllipsis" />
								<TextBlock
									FontSize="12"
									Foreground="{DynamicResource BodyForegroundBrush}"
									Text="{Binding Message}"
									TextWrapping="Wrap" />
							</StackPanel>
							<!--  Dismiss  -->
							<Button
								Grid.Column="2"
								VerticalAlignment="Top"
								Classes="icon"
								Command="{Binding #ToastHost.DataContext.DismissCommand}"
								CommandParameter="{Binding}"
								ToolTip.Tip="Dismiss">
								<Path
									Width="14"
									Height="14"
									Data="{tools:SvgPath icon-close}"
									Fill="{DynamicResource MutedForegroundBrush}"
									Stretch="Uniform" />
							</Button>
						</Grid>
					</Border>
				</DataTemplate>
			</ItemsControl.ItemTemplate>
		</ItemsControl>
	</Grid>
</suki:SukiWindow>
