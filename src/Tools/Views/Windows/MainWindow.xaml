<?xml version="1.0" encoding="utf-8" ?>
<suki:SukiWindow
	x:Class="Tools.Views.Windows.MainWindow"
	xmlns="https://github.com/avaloniaui"
	xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
	xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
	xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
	xmlns:suki="https://github.com/kikipoulet/SukiUI"
	xmlns:tools="using:Tools.Library.MarkupExtensions"
	Title="DevTools"
	Width="1400"
	Height="900"
	MinWidth="800"
	MinHeight="600"
	WindowStartupLocation="CenterScreen"
	BackgroundStyle="Flat">

	<!--  Sidebar collapse: shrink the rail to icon-only width and hide labels/headers  -->
	<suki:SukiWindow.Styles>
		<!--  Expanded sidebar width  -->
		<Style Selector="Border#SidebarBorder">
			<Setter Property="Width" Value="240" />
		</Style>
		<!--  Collapsed rail: icon-only width with a smooth transition  -->
		<Style Selector="Border#SidebarBorder.collapsed">
			<Setter Property="Width" Value="70" />
			<Setter Property="Transitions">
				<Setter.Value>
					<Transitions>
						<DoubleTransition Property="Width" Duration="0:0:0.15" />
					</Transitions>
				</Setter.Value>
			</Setter>
		</Style>
		<!--  Hide the nav labels when collapsed to an icon-only rail  -->
		<Style Selector="Border#SidebarBorder.collapsed TextBlock.nav-label">
			<Setter Property="IsVisible" Value="False" />
		</Style>
	</suki:SukiWindow.Styles>

	<!--  Logo plus sidebar/back buttons hosted on the left of the title bar  -->
	<suki:SukiWindow.LogoContent>
		<StackPanel
			VerticalAlignment="Center"
			Orientation="Horizontal"
			Spacing="4">
			<!-- <Image
				Width="20"
				Height="20"
				Source="avares://Tools/Assets/logo.png"
				Stretch="Uniform" />-->
			<Button
				Margin="8,0,0,0"
				Height="24"
				Padding="0"
				Classes="icon"
				Command="{Binding ToggleSidebarCommand}"
				ToolTip.Tip="Toggle sidebar">
				<Path
					Width="14"
					Height="14"
					Data="{tools:SvgPath icon-menu}"
					Fill="{DynamicResource BodyForegroundBrush}"
					Stretch="Uniform" />
			</Button>
			<Button
				x:Name="BackButton"
				Height="24"
				Padding="0"
				Classes="icon"
				Click="BackButton_Click"
				IsVisible="False"
				ToolTip.Tip="Back">
				<Path
					Width="14"
					Height="14"
					Data="{tools:SvgPath icon-arrow-left}"
					Fill="{DynamicResource BodyForegroundBrush}"
					Stretch="Uniform" />
			</Button>
		</StackPanel>
	</suki:SukiWindow.LogoContent>

	<Grid ColumnDefinitions="Auto,*" RowDefinitions="*,28">
		<!--  Sidebar Navigation  -->
		<Border
			x:Name="SidebarBorder"
			Grid.Row="0"
			Grid.Column="0"
			Padding="0,8,0,0"
			Background="{DynamicResource SidebarBackgroundBrush}"
			BorderBrush="{DynamicResource DividerBrush}"
			BorderThickness="0,0,1,0"
			Classes.collapsed="{Binding IsSidebarCollapsed}">
			<DockPanel Margin="0,0,0,8">
				<!--  Open settings folder (pinned to the sidebar bottom)  -->
				<Button
					Margin="8,4"
					Padding="0"
					HorizontalAlignment="Stretch"
					HorizontalContentAlignment="Stretch"
					Background="Transparent"
					BorderThickness="0"
					Command="{Binding OpenSettingsFolderCommand}"
					Cursor="Hand"
					DockPanel.Dock="Bottom"
					ToolTip.Tip="Open settings folder">
					<Button.Styles>
						<!--  Neutralize button chrome so only the surface pill reacts to hover  -->
						<Style Selector="Button:pointerover">
							<Setter Property="Background" Value="Transparent" />
						</Style>
						<Style Selector="Button:pointerover Border.nav-surface">
							<Setter Property="Background" Value="{DynamicResource HoverBackgroundBrush}" />
						</Style>
					</Button.Styles>
					<Grid ColumnDefinitions="3,*">
						<Border
							Grid.Column="1"
							Margin="0"
							Padding="12,8"
							Classes="nav-surface"
							CornerRadius="{DynamicResource ControlRadius}">
							<StackPanel Orientation="Horizontal" Spacing="12">
								<Path
									Width="18"
									Height="18"
									VerticalAlignment="Center"
									Data="{tools:SvgPath icon-cog}"
									Fill="{DynamicResource MutedForegroundBrush}"
									Stretch="Uniform" />
								<TextBlock
									VerticalAlignment="Center"
									Classes="nav-label"
									FontSize="13"
									Foreground="{DynamicResource BodyForegroundBrush}"
									Text="Settings" />
							</StackPanel>
						</Border>
					</Grid>
				</Button>
				<ListBox
					x:Name="NavigationListBox"
					Padding="8,0"
					Background="Transparent"
					BorderThickness="0"
					Classes="Void"
					ItemsSource="{Binding MenuItems}"
					SelectedIndex="0"
					SelectionChanged="NavigationListBox_SelectionChanged">
					<ListBox.Styles>
						<Style Selector="ListBoxItem">
							<Setter Property="Padding" Value="0" />
							<Setter Property="Background" Value="Transparent" />
						</Style>
						<!--  Nav surface: transparent by default, indigo-tinted when selected  -->
						<Style Selector="Border.nav-item-surface">
							<Setter Property="Background" Value="Transparent" />
							<Setter Property="Transitions">
								<Setter.Value>
									<Transitions>
										<BrushTransition Property="Background" Duration="0:0:0.12" />
									</Transitions>
								</Setter.Value>
							</Setter>
						</Style>
						<!--  Selected item: accent-filled pill  -->
						<Style Selector="ListBoxItem:selected Border.nav-item-surface">
							<Setter Property="Background" Value="{DynamicResource AccentPrimaryBrush}" />
						</Style>
						<!--  Nav icon: muted by default, bright when selected  -->
						<Style Selector="Path.nav-icon">
							<Setter Property="Fill" Value="{DynamicResource MutedForegroundBrush}" />
							<Setter Property="Transitions">
								<Setter.Value>
									<Transitions>
										<BrushTransition Property="Fill" Duration="0:0:0.12" />
									</Transitions>
								</Setter.Value>
							</Setter>
						</Style>
						<Style Selector="ListBoxItem:selected Path.nav-icon">
							<Setter Property="Fill" Value="{DynamicResource AccentForegroundBrush}" />
						</Style>
						<!--  Nav label: body by default, title when selected  -->
						<Style Selector="TextBlock.nav-label">
							<Setter Property="Foreground" Value="{DynamicResource BodyForegroundBrush}" />
							<Setter Property="Transitions">
								<Setter.Value>
									<Transitions>
										<BrushTransition Property="Foreground" Duration="0:0:0.12" />
									</Transitions>
								</Setter.Value>
							</Setter>
						</Style>
						<Style Selector="ListBoxItem:selected TextBlock.nav-label">
							<Setter Property="Foreground" Value="{DynamicResource AccentForegroundBrush}" />
							<Setter Property="FontWeight" Value="SemiBold" />
						</Style>
					</ListBox.Styles>
					<ListBox.ItemTemplate>
						<DataTemplate>
							<Panel>
								<!--  Separator line (only when expanded)  -->
								<Border
									Height="1"
									Margin="16,8"
									Background="{DynamicResource DividerBrush}"
									ToolTip.Tip="{Binding Title}">
									<Border.IsVisible>
										<MultiBinding Converter="{StaticResource BoolAllConverter}">
											<Binding
												Converter="{StaticResource EqualVisibilityConverter}"
												ConverterParameter="__separator__"
												Path="PageKey" />
											<Binding
												Converter="{StaticResource InverseBoolConverter}"
												Path="DataContext.IsSidebarCollapsed"
												RelativeSource="{RelativeSource AncestorType=ListBox}" />
										</MultiBinding>
									</Border.IsVisible>
								</Border>
								<!--  Section header (only when expanded)  -->
								<TextBlock
									Margin="16,12,0,4"
									FontSize="11"
									FontWeight="SemiBold"
									Foreground="{DynamicResource FaintForegroundBrush}"
									Text="{Binding Title}">
									<TextBlock.IsVisible>
										<MultiBinding Converter="{StaticResource BoolAllConverter}">
											<Binding
												Converter="{StaticResource EqualVisibilityConverter}"
												ConverterParameter="__header__"
												Path="PageKey" />
											<Binding
												Converter="{StaticResource InverseBoolConverter}"
												Path="DataContext.IsSidebarCollapsed"
												RelativeSource="{RelativeSource AncestorType=ListBox}" />
										</MultiBinding>
									</TextBlock.IsVisible>
								</TextBlock>
								<!--  Normal navigation item  -->
								<Border
									Margin="0,1"
									Padding="0"
									CornerRadius="{DynamicResource ControlRadius}"
									IsVisible="{Binding PageKey, Converter={StaticResource EqualNotVisibilityConverter}, ConverterParameter=__separator__}">
									<Grid ColumnDefinitions="3,*">
										<!--  Nav surface + content  -->
										<Border
											Grid.Column="1"
											Margin="0"
											Padding="12,8"
											Classes="nav-item-surface"
											CornerRadius="{DynamicResource ControlRadius}"
											ToolTip.Tip="{Binding Title}">
											<StackPanel Orientation="Horizontal" Spacing="12">
												<Path
													Width="18"
													Height="18"
													VerticalAlignment="Center"
													Classes="nav-icon"
													Data="{Binding IconPath, Converter={StaticResource StringToGeometryConverter}}"
													Stretch="Uniform" />
												<TextBlock
													VerticalAlignment="Center"
													Classes="nav-label"
													FontSize="13"
													Text="{Binding Title}" />
											</StackPanel>
										</Border>
									</Grid>
								</Border>
							</Panel>
						</DataTemplate>
					</ListBox.ItemTemplate>
				</ListBox>
			</DockPanel>
		</Border>

		<!--  Content Area  -->
		<Grid
			Grid.Row="0"
			Grid.Column="1"
			Background="{DynamicResource ContentBackgroundBrush}">
			<Grid.RowDefinitions>
				<RowDefinition Height="*" />
				<RowDefinition Height="Auto" />
			</Grid.RowDefinitions>

			<ContentControl
				x:Name="ContentArea"
				Grid.Row="0"
				Padding="0" />
		</Grid>

		<!--  Status Bar  -->
		<Border
			Grid.Row="1"
			Grid.ColumnSpan="2"
			Background="{DynamicResource SidebarTranslucentBrush}"
			BorderBrush="{DynamicResource DividerBrush}"
			BorderThickness="0,1,0,0">
			<DockPanel Margin="14,0" LastChildFill="False" VerticalAlignment="Center">
				<!--  SnapIt indicator (moved from dashboard)  -->
				<Button
					Padding="8,2"
					Background="Transparent"
					BorderThickness="0"
					Command="{Binding ToggleSnapItCommand}"
					CornerRadius="{DynamicResource ChipRadius}"
					Cursor="Hand"
					DockPanel.Dock="Left">
					<StackPanel Orientation="Horizontal" Spacing="6">
						<Border
							Width="8"
							Height="8"
							VerticalAlignment="Center"
							Background="{Binding SnapItRunning, Converter={StaticResource BoolToBrushConverter}}"
							CornerRadius="4" />
						<TextBlock
							VerticalAlignment="Center"
							FontSize="11"
							FontWeight="Medium"
							Foreground="{DynamicResource BodyForegroundBrush}"
							Text="SnapIt" />
						<TextBlock
							VerticalAlignment="Center"
							FontSize="11"
							Foreground="{DynamicResource MutedForegroundBrush}"
							Text="{Binding SnapItStatusText, Mode=OneWay}" />
					</StackPanel>
					<Button.Styles>
						<Style Selector="Button:pointerover">
							<Setter Property="Background" Value="{DynamicResource HoverBackgroundBrush}" />
						</Style>
					</Button.Styles>
				</Button>

				<!--  NuGet Local watch indicator  -->
				<Button
					Margin="6,0,0,0"
					Padding="8,2"
					Background="Transparent"
					BorderThickness="0"
					Command="{Binding ToggleNugetWatchCommand}"
					CornerRadius="{DynamicResource ChipRadius}"
					Cursor="Hand"
					DockPanel.Dock="Left">
					<StackPanel Orientation="Horizontal" Spacing="6">
						<Border
							Width="8"
							Height="8"
							VerticalAlignment="Center"
							Background="{Binding NugetWatchRunning, Converter={StaticResource BoolToBrushConverter}}"
							CornerRadius="4" />
						<TextBlock
							VerticalAlignment="Center"
							FontSize="11"
							FontWeight="Medium"
							Foreground="{DynamicResource BodyForegroundBrush}"
							Text="NuGet watch" />
						<TextBlock
							VerticalAlignment="Center"
							FontSize="11"
							Foreground="{DynamicResource MutedForegroundBrush}"
							Text="{Binding NugetWatchStatusText, Mode=OneWay}" />
					</StackPanel>
					<Button.Styles>
						<Style Selector="Button:pointerover">
							<Setter Property="Background" Value="{DynamicResource HoverBackgroundBrush}" />
						</Style>
					</Button.Styles>
				</Button>
			</DockPanel>
		</Border>

		<!--  Toast overlay (floats above all pages, top-center)  -->
		<ItemsControl
			x:Name="ToastHost"
			Grid.RowSpan="2"
			Grid.ColumnSpan="2"
			Margin="0,12,0,0"
			HorizontalAlignment="Center"
			VerticalAlignment="Top"
			IsHitTestVisible="True">
			<ItemsControl.ItemsPanel>
				<ItemsPanelTemplate>
					<StackPanel
						HorizontalAlignment="Center"
						Orientation="Vertical"
						Spacing="8" />
				</ItemsPanelTemplate>
			</ItemsControl.ItemsPanel>
			<ItemsControl.ItemTemplate>
				<DataTemplate>
					<Border
						Width="320"
						Padding="12,10"
						Background="{DynamicResource CardBackgroundBrush}"
						BorderBrush="{DynamicResource HairlineBrush}"
						BorderThickness="1"
						BoxShadow="{DynamicResource FlyoutShadow}"
						CornerRadius="{DynamicResource CardRadius}">
						<Grid ColumnDefinitions="4,*,Auto">
							<!--  Accent stripe colored by kind  -->
							<Border
								Grid.Column="0"
								Margin="0,0,10,0"
								VerticalAlignment="Stretch"
								Background="{Binding Kind, Converter={StaticResource NotificationKindToBrushConverter}}"
								CornerRadius="2" />
							<!--  Title + message  -->
							<StackPanel
								Grid.Column="1"
								Margin="0,0,8,0"
								VerticalAlignment="Center"
								Spacing="2">
								<TextBlock
									FontWeight="SemiBold"
									Foreground="{DynamicResource TitleForegroundBrush}"
									IsVisible="{Binding Title, Converter={StaticResource StringNotNullToBoolConverter}}"
									Text="{Binding Title}"
									TextTrimming="CharacterEllipsis" />
								<TextBlock
									FontSize="12"
									Foreground="{DynamicResource BodyForegroundBrush}"
									Text="{Binding Message}"
									TextWrapping="Wrap" />
							</StackPanel>
							<!--  Dismiss  -->
							<Button
								Grid.Column="2"
								VerticalAlignment="Top"
								Classes="icon"
								Command="{Binding #ToastHost.DataContext.DismissCommand}"
								CommandParameter="{Binding}"
								ToolTip.Tip="Dismiss">
								<Path
									Width="14"
									Height="14"
									Data="{tools:SvgPath icon-close}"
									Fill="{DynamicResource MutedForegroundBrush}"
									Stretch="Uniform" />
							</Button>
						</Grid>
					</Border>
				</DataTemplate>
			</ItemsControl.ItemTemplate>
		</ItemsControl>
	</Grid>
</suki:SukiWindow>
