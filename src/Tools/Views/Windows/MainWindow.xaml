<?xml version="1.0" encoding="utf-8" ?>
<suki:SukiWindow
	x:Class="Tools.Views.Windows.MainWindow"
	xmlns="https://github.com/avaloniaui"
	xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
	xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
	xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
	xmlns:suki="https://github.com/kikipoulet/SukiUI"
	xmlns:tools="using:Tools.Library.MarkupExtensions"
	Title="DevTools"
	Width="1400"
	Height="900"
	MinWidth="800"
	MinHeight="600"
	WindowStartupLocation="CenterScreen"
	BackgroundStyle="Flat"
	Theme="{StaticResource CustomSukiWindowTheme}">

	<!--  Sidebar collapse: shrink the rail to icon-only width and hide labels/headers  -->
	<suki:SukiWindow.Styles>
		<!--  Expanded sidebar width  -->
		<Style Selector="Border#SidebarBorder">
			<Setter Property="Width" Value="240" />
		</Style>
		<!--  Collapsed rail: icon-only width with a smooth transition  -->
		<Style Selector="Border#SidebarBorder.collapsed">
			<Setter Property="Width" Value="70" />
			<Setter Property="Transitions">
				<Setter.Value>
					<Transitions>
						<DoubleTransition Property="Width" Duration="0:0:0.15" />
					</Transitions>
				</Setter.Value>
			</Setter>
		</Style>
		<!--  Hide the nav labels when collapsed to an icon-only rail  -->
		<Style Selector="Border#SidebarBorder.collapsed TextBlock.nav-label">
			<Setter Property="IsVisible" Value="False" />
		</Style>
		<!--  Collapsed rail: center the footer icons (settings gear, status icons);
				with the labels hidden the panels shrink to the icon and center.
				Status buttons must get their Left alignment from a style, not a local
				value — a local HorizontalContentAlignment would beat the collapsed
				setter and keep the dots left-aligned.  -->
		<Style Selector="Border#SidebarBorder.collapsed StackPanel.nav-footer">
			<Setter Property="HorizontalAlignment" Value="Center" />
		</Style>
		<Style Selector="Button.nav-status">
			<Setter Property="HorizontalContentAlignment" Value="Left" />
		</Style>
		<Style Selector="Border#SidebarBorder.collapsed Button.nav-status">
			<Setter Property="HorizontalContentAlignment" Value="Center" />
		</Style>
		<!--  Status icon traffic lights: running = green, SnapIt stopped = red,
				NuGet idle = yellow. The running class is bound to each tool's
				running state; define order matters — .running must come last.  -->
		<Style Selector="Path.status-icon">
			<Setter Property="Fill" Value="{DynamicResource DangerAccentBrush}" />
		</Style>
		<Style Selector="Path.status-icon.status-idle">
			<Setter Property="Fill" Value="{DynamicResource WarningAccentBrush}" />
		</Style>
		<Style Selector="Path.status-icon.running">
			<Setter Property="Fill" Value="{DynamicResource StatusActiveBrush}" />
		</Style>
		<!--
			Header: the window uses the CustomSukiWindowTheme (see Styles/), whose title
			bar replaces the app-title text with the centered global search field. The
			brand cluster (sidebar toggle, back, logo, app name) lives in LogoContent at
			the bar's left; the bar keeps its drag role everywhere else.
		-->
		<!--  The search field tints its hairline with the accent while focused  -->
		<Style Selector="Border#HeaderSearchBorder:focus-within">
			<Setter Property="BorderBrush" Value="{DynamicResource AccentSoftBorderBrush}" />
		</Style>
	</suki:SukiWindow.Styles>

	<!--  Back button hosted on the left of the title bar  -->
	<suki:SukiWindow.LogoContent>
		<!--  Header brand cluster: sidebar toggle, back, logo mark, app title  -->
		<StackPanel
			VerticalAlignment="Center"
			Orientation="Horizontal"
			Spacing="8">
			<Button
				Width="26"
				Height="26"
				Margin="8,0,0,0"
				Padding="0"
				VerticalAlignment="Center"
				Classes="icon"
				Command="{Binding ToggleSidebarCommand}"
				ToolTip.Tip="Toggle sidebar">
				<Path
					Width="14"
					Height="14"
					Data="{tools:SvgPath icon-menu}"
					Fill="{DynamicResource BodyForegroundBrush}"
					Stretch="Uniform" />
			</Button>
			<Button
				x:Name="BackButton"
				Height="24"
				Padding="0"
				VerticalAlignment="Center"
				Classes="icon"
				Click="BackButton_Click"
				IsVisible="False"
				ToolTip.Tip="Back">
				<Path
					Width="14"
					Height="14"
					Data="{tools:SvgPath icon-arrow-left}"
					Fill="{DynamicResource BodyForegroundBrush}"
					Stretch="Uniform" />
			</Button>
			<!--  Logo mark: code brackets around a slash  -->
			<Path
				Width="20"
				Height="20"
				VerticalAlignment="Center"
				Data="M8.6,7.2 L3.8,12 L8.6,16.8 M15.4,7.2 L20.2,12 L15.4,16.8 M13.9,5.4 L10.1,18.6"
				Stretch="Uniform"
				Stroke="{DynamicResource AccentPrimaryBrush}"
				StrokeJoin="Round"
				StrokeThickness="2.2" />
			<TextBlock
				VerticalAlignment="Center"
				FontSize="15"
				FontWeight="SemiBold"
				Foreground="{DynamicResource TitleForegroundBrush}"
				Text="DevTools" />
		</StackPanel>
	</suki:SukiWindow.LogoContent>

	<Grid ColumnDefinitions="Auto,*">
		<!--  Sidebar Navigation  -->
		<Border
			x:Name="SidebarBorder"
			Grid.Row="0"
			Grid.Column="0"
			Padding="0,6,0,0"
			Background="{DynamicResource SidebarBackgroundBrush}"
			BorderBrush="{DynamicResource DividerBrush}"
			BorderThickness="0,0,1,0"
			Classes.collapsed="{Binding IsSidebarCollapsed}">
			<DockPanel Margin="0,0,0,8">
				<!--  Pinned footer: settings, divider, then the live status toggles  -->
				<StackPanel DockPanel.Dock="Bottom" Margin="0,0,0,2">
					<!--  Open settings folder  -->
					<Button
						Margin="8,4"
						Padding="0"
						HorizontalAlignment="Stretch"
						HorizontalContentAlignment="Stretch"
						Background="Transparent"
						BorderThickness="0"
						Command="{Binding OpenSettingsFolderCommand}"
						Cursor="Hand"
						ToolTip.Tip="Open settings folder">
						<Button.Styles>
							<!--  Neutralize button chrome so only the surface pill reacts to hover  -->
							<Style Selector="Button:pointerover">
								<Setter Property="Background" Value="Transparent" />
							</Style>
							<Style Selector="Button:pointerover Border.nav-surface">
								<Setter Property="Background" Value="{DynamicResource HoverBackgroundBrush}" />
							</Style>
						</Button.Styles>
						<Grid ColumnDefinitions="3,*">
							<Border
								Grid.Column="1"
								Margin="0"
								Padding="12,8"
								Classes="nav-surface"
								CornerRadius="{DynamicResource ControlRadius}">
								<StackPanel Classes="nav-footer" Orientation="Horizontal" Spacing="12">
									<Path
										Width="18"
										Height="18"
										VerticalAlignment="Center"
										Data="{tools:SvgPath icon-cog}"
										Fill="{DynamicResource MutedForegroundBrush}"
										Stretch="Uniform" />
									<TextBlock
										VerticalAlignment="Center"
										Classes="nav-label"
										FontSize="13"
										Foreground="{DynamicResource BodyForegroundBrush}"
										Text="Settings" />
								</StackPanel>
							</Border>
						</Grid>
					</Button>
					<!--  Divider between settings and the status toggles  -->
					<Border
						Height="1"
						Margin="14,2,14,2"
						Background="{DynamicResource DividerBrush}"
						IsVisible="{Binding IsSidebarCollapsed, Converter={StaticResource InverseBoolConverter}}" />
					<!--  SnapIt status toggle (moved from the removed window status bar)  -->
					<Button
						Margin="8,0"
						Padding="12,6"
						Classes="nav-status"
						Background="Transparent"
						BorderThickness="0"
						Command="{Binding ToggleSnapItCommand}"
						CornerRadius="{DynamicResource ChipRadius}"
						Cursor="Hand"
						ToolTip.Tip="{Binding SnapItStatusText, StringFormat='SnapIt: {0}'}">
						<StackPanel Classes="nav-footer" Orientation="Horizontal" Spacing="6">
							<Path
								Width="18"
								Height="18"
								Classes="status-icon"
								Classes.running="{Binding SnapItRunning}"
								VerticalAlignment="Center"
								Data="{tools:SvgPath icon-grid}"
								Stretch="Uniform" />
							<TextBlock
								VerticalAlignment="Center"
								Classes="nav-label"
								FontSize="11"
								FontWeight="Medium"
								Foreground="{DynamicResource BodyForegroundBrush}"
								Text="SnapIt" />
							<TextBlock
								VerticalAlignment="Center"
								Classes="nav-label"
								FontSize="11"
								Foreground="{DynamicResource MutedForegroundBrush}"
								Text="{Binding SnapItStatusText, Mode=OneWay}" />
						</StackPanel>
						<Button.Styles>
							<Style Selector="Button:pointerover">
								<Setter Property="Background" Value="{DynamicResource HoverBackgroundBrush}" />
							</Style>
						</Button.Styles>
					</Button>
					<!--  NuGet Local watch status toggle  -->
					<Button
						Margin="8,0"
						Padding="12,6"
						Classes="nav-status"
						Background="Transparent"
						BorderThickness="0"
						Command="{Binding ToggleNugetWatchCommand}"
						CornerRadius="{DynamicResource ChipRadius}"
						Cursor="Hand"
						ToolTip.Tip="{Binding NugetWatchStatusText, StringFormat='NuGet watch: {0}'}">
						<StackPanel Classes="nav-footer" Orientation="Horizontal" Spacing="6">
							<Path
								Width="18"
								Height="18"
								Classes="status-icon status-idle"
								Classes.running="{Binding NugetWatchRunning}"
								VerticalAlignment="Center"
								Data="{tools:SvgPath icon-package}"
								Stretch="Uniform" />
							<TextBlock
								VerticalAlignment="Center"
								Classes="nav-label"
								FontSize="11"
								FontWeight="Medium"
								Foreground="{DynamicResource BodyForegroundBrush}"
								Text="NuGet watch" />
							<TextBlock
								VerticalAlignment="Center"
								Classes="nav-label"
								FontSize="11"
								Foreground="{DynamicResource MutedForegroundBrush}"
								Text="{Binding NugetWatchStatusText, Mode=OneWay}" />
						</StackPanel>
						<Button.Styles>
							<Style Selector="Button:pointerover">
								<Setter Property="Background" Value="{DynamicResource HoverBackgroundBrush}" />
							</Style>
						</Button.Styles>
					</Button>
				</StackPanel>
				<ListBox
					x:Name="NavigationListBox"
					Padding="8,0"
					Background="Transparent"
					BorderThickness="0"
					Classes="Void"
					ItemsSource="{Binding MenuItems}"
					SelectedIndex="0"
					SelectionChanged="NavigationListBox_SelectionChanged">
					<ListBox.Styles>
						<Style Selector="ListBoxItem">
							<Setter Property="Padding" Value="0" />
							<Setter Property="Background" Value="Transparent" />
						</Style>
						<!--  Nav surface: transparent by default, indigo-tinted when selected  -->
						<Style Selector="Border.nav-item-surface">
							<Setter Property="Background" Value="Transparent" />
							<Setter Property="Transitions">
								<Setter.Value>
									<Transitions>
										<BrushTransition Property="Background" Duration="0:0:0.12" />
									</Transitions>
								</Setter.Value>
							</Setter>
						</Style>
						<!--  Selected item: accent-filled pill  -->
						<Style Selector="ListBoxItem:selected Border.nav-item-surface">
							<Setter Property="Background" Value="{DynamicResource AccentPrimaryBrush}" />
						</Style>
						<!--  Nav icon: muted by default, bright when selected  -->
						<Style Selector="Path.nav-icon">
							<Setter Property="Fill" Value="{DynamicResource MutedForegroundBrush}" />
							<Setter Property="Transitions">
								<Setter.Value>
									<Transitions>
										<BrushTransition Property="Fill" Duration="0:0:0.12" />
									</Transitions>
								</Setter.Value>
							</Setter>
						</Style>
						<Style Selector="ListBoxItem:selected Path.nav-icon">
							<Setter Property="Fill" Value="{DynamicResource AccentForegroundBrush}" />
						</Style>
						<!--  Nav label: body by default, title when selected  -->
						<Style Selector="TextBlock.nav-label">
							<Setter Property="Foreground" Value="{DynamicResource BodyForegroundBrush}" />
							<Setter Property="Transitions">
								<Setter.Value>
									<Transitions>
										<BrushTransition Property="Foreground" Duration="0:0:0.12" />
									</Transitions>
								</Setter.Value>
							</Setter>
						</Style>
						<Style Selector="ListBoxItem:selected TextBlock.nav-label">
							<Setter Property="Foreground" Value="{DynamicResource AccentForegroundBrush}" />
							<Setter Property="FontWeight" Value="SemiBold" />
						</Style>
					</ListBox.Styles>
					<ListBox.ItemTemplate>
						<DataTemplate>
							<!--  Normal navigation item  -->
							<Border
								Margin="0,1"
								Padding="0"
								CornerRadius="{DynamicResource ControlRadius}">
								<Grid ColumnDefinitions="3,*">
									<!--  Nav surface + content  -->
									<Border
										Grid.Column="1"
										Margin="0"
										Padding="12,8"
										Classes="nav-item-surface"
										CornerRadius="{DynamicResource ControlRadius}"
										ToolTip.Tip="{Binding Title}">
										<StackPanel Orientation="Horizontal" Spacing="12">
											<Path
												Width="18"
												Height="18"
												VerticalAlignment="Center"
												Classes="nav-icon"
												Data="{Binding IconPath, Converter={StaticResource StringToGeometryConverter}}"
												Stretch="Uniform" />
											<TextBlock
												VerticalAlignment="Center"
												Classes="nav-label"
												FontSize="13"
												Text="{Binding Title}" />
										</StackPanel>
									</Border>
								</Grid>
							</Border>
						</DataTemplate>
					</ListBox.ItemTemplate>
				</ListBox>
			</DockPanel>
		</Border>

		<!--  Content Area  -->
		<Grid
			Grid.Row="0"
			Grid.Column="1"
			Background="{DynamicResource ContentBackgroundBrush}">
			<ContentControl
				x:Name="ContentArea"
				Padding="0" />
		</Grid>

		<!--  Toast overlay (floats above all pages, top-center)  -->
		<ItemsControl
			x:Name="ToastHost"
			Grid.ColumnSpan="2"
			Margin="0,12,0,0"
			HorizontalAlignment="Center"
			VerticalAlignment="Top"
			IsHitTestVisible="True">
			<ItemsControl.ItemsPanel>
				<ItemsPanelTemplate>
					<StackPanel
						HorizontalAlignment="Center"
						Orientation="Vertical"
						Spacing="8" />
				</ItemsPanelTemplate>
			</ItemsControl.ItemsPanel>
			<ItemsControl.ItemTemplate>
				<DataTemplate>
					<Border
						Width="320"
						Padding="12,10"
						Background="{DynamicResource CardBackgroundBrush}"
						BorderBrush="{DynamicResource HairlineBrush}"
						BorderThickness="1"
						BoxShadow="{DynamicResource FlyoutShadow}"
						CornerRadius="{DynamicResource CardRadius}">
						<Grid ColumnDefinitions="4,*,Auto">
							<!--  Accent stripe colored by kind  -->
							<Border
								Grid.Column="0"
								Margin="0,0,10,0"
								VerticalAlignment="Stretch"
								Background="{Binding Kind, Converter={StaticResource NotificationKindToBrushConverter}}"
								CornerRadius="2" />
							<!--  Title + message  -->
							<StackPanel
								Grid.Column="1"
								Margin="0,0,8,0"
								VerticalAlignment="Center"
								Spacing="2">
								<TextBlock
									FontWeight="SemiBold"
									Foreground="{DynamicResource TitleForegroundBrush}"
									IsVisible="{Binding Title, Converter={StaticResource StringNotNullToBoolConverter}}"
									Text="{Binding Title}"
									TextTrimming="CharacterEllipsis" />
								<TextBlock
									FontSize="12"
									Foreground="{DynamicResource BodyForegroundBrush}"
									Text="{Binding Message}"
									TextWrapping="Wrap" />
							</StackPanel>
							<!--  Dismiss  -->
							<Button
								Grid.Column="2"
								VerticalAlignment="Top"
								Classes="icon"
								Command="{Binding #ToastHost.DataContext.DismissCommand}"
								CommandParameter="{Binding}"
								ToolTip.Tip="Dismiss">
								<Path
									Width="14"
									Height="14"
									Data="{tools:SvgPath icon-close}"
									Fill="{DynamicResource MutedForegroundBrush}"
									Stretch="Uniform" />
							</Button>
						</Grid>
					</Border>
				</DataTemplate>
			</ItemsControl.ItemTemplate>
		</ItemsControl>
	</Grid>
</suki:SukiWindow>
