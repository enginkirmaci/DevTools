<?xml version="1.0" encoding="utf-8" ?>
<Application
	x:Class="Tools.App"
	xmlns="https://github.com/avaloniaui"
	xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
	xmlns:conv="using:Tools.Library.Converters"
	xmlns:suki="https://github.com/kikipoulet/SukiUI"
	RequestedThemeVariant="Dark">
	<!--  Resources must come before Styles: SukiTheme writes its runtime  -->
	<!--  color resources (SukiPrimaryColor*) into Application.Resources  -->
	<!--  during style initialization, and a later Resources assignment    -->
	<!--  would replace that dictionary and wipe them.                     -->
	<Application.Resources>
		<ResourceDictionary>
		<ResourceDictionary.MergedDictionaries>
			<ResourceInclude Source="/Styles/ThemeResources.axaml" />
			<!--  Custom SukiWindow title bar (search field in the bar), applied explicitly on MainWindow  -->
			<ResourceInclude Source="/Styles/CustomSukiWindowTheme.axaml" />
		</ResourceDictionary.MergedDictionaries>

			<!--  Accent: SukiTheme ThemeColor="Blue", with its SukiPrimaryColor* palette  -->
			<!--  overridden to the periwinkle app accent in App.ApplyAccentColorOverride  -->

			<!--  Converters  -->
			<conv:StringNullOrEmptyToVisibilityConverter x:Key="StringNullOrEmptyToVisibilityConverter" />
			<conv:InverseBoolConverter x:Key="InverseBoolConverter" />
			<conv:BoolToBrushConverter x:Key="BoolToBrushConverter" />
			<conv:StringToGeometryConverter x:Key="StringToGeometryConverter" />
			<conv:StringNotNullToBoolConverter x:Key="StringNotNullToBoolConverter" />
			<conv:NotNullToBoolConverter x:Key="NotNullToBoolConverter" />
<!--
                The favorite star's bool-to-brush pair, via the shared parameterized
                BoolToBrushConverter (the dedicated converter class is gone): a
                favorited repo paints the star gold, everything else (unchecked, or
                no repo selected) the muted gray.
            -->
			<conv:BoolToBrushConverter x:Key="FavoriteStarBrushConverter" TrueBrush="#F5B400" FalseBrush="#8B90A0" NullBrush="#8B90A0" />
			<conv:BranchChipBrushConverter x:Key="BranchChipBrushConverter" />
			<conv:GitStatusBrushConverter x:Key="GitStatusBrushConverter" />
			<conv:GitHubStateChipBrushConverter x:Key="GitHubStateChipBrushConverter" />
			<conv:GitHubLabelBrushConverter x:Key="GitHubLabelBrushConverter" />
			<conv:NotificationKindToBrushConverter x:Key="NotificationKindToBrushConverter" />
			<conv:PositiveCountToVisibilityConverter x:Key="PositiveCountToVisibilityConverter" />
		</ResourceDictionary>
	</Application.Resources>
	<Application.Styles>
		<suki:SukiTheme Locale="en-US" ThemeColor="Blue" />
		<StyleInclude Source="/Styles/AppStyles.axaml" />
		<StyleInclude Source="avares://Tools.SnapIt/Controls/Styles/SnapIt.Controls.UI.xaml" />
	</Application.Styles>
</Application>
