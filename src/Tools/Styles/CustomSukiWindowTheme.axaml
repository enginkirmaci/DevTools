<ResourceDictionary
    xmlns="https://github.com/avaloniaui"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:chrome="clr-namespace:Avalonia.Controls.Chrome;assembly=Avalonia.Controls"
    xmlns:suki="clr-namespace:SukiUI.Controls;assembly=SukiUI"
    xmlns:tools="using:Tools.Library.MarkupExtensions">
    <!--
        DevTools custom SukiWindow title bar, based on SukiUI 7.0.1's SukiWindowTheme
        (Controls/SukiWindow.axaml). Applied EXPLICITLY via Theme="{StaticResource CustomSukiWindowTheme}"
        on MainWindow, so it overrides SukiUI's implicit window theme on every platform:
        Windows and Linux share this exact template, and SukiUI's own platform handling
        (WindowDecorations per OS, window buttons, drag area, Linux resize grips, Windows
        snap layout) is preserved because the template and all its PARTs are kept.
        
        The one change vs upstream: the in-titlebar title TextBlock (PART_TitleTextBlock,
        referenced by no code-behind lookup) is REPLACED by the global repository search
        field, centered in the bar. The field carries ElementRole="User" so it stays
        interactive while the bar around it remains a drag area. MainWindow code-behind
        attaches the field's event handlers in OnApplyTemplate (a ControlTheme has no
        code-behind to wire them).
    -->
    <ControlTheme x:Key="CustomSukiWindowTheme" TargetType="suki:SukiWindow">
        <Setter Property="Margin" Value="0" />
        <Setter Property="TransparencyLevelHint" Value="Transparent" />
        <Setter Property="WindowDecorations" Value="{OnPlatform BorderOnly, Windows=Full, Linux=None, x:TypeArguments=WindowDecorations}" />
        <Setter Property="ExtendClientAreaToDecorationsHint" Value="True" />
        <Setter Property="ExtendClientAreaTitleBarHeightHint" Value="-1" />
        <Setter Property="Foreground" Value="{DynamicResource SukiText}" />
        <Setter Property="FlowDirection" Value="{DynamicResource FlowDirectionPrimary}" />
        <Setter Property="Template">
            <ControlTemplate>
                <Panel Name="PART_Root" Margin="{TemplateBinding Margin}">
                    <Panel
                        Margin="{TemplateBinding WindowDecorationMargin}"
                        Background="Transparent"
                        IsHitTestVisible="False" />
                    <suki:SukiMainHost
                        BackgroundAnimationEnabled="{TemplateBinding BackgroundAnimationEnabled}"
                        BackgroundForceSoftwareRendering="{TemplateBinding BackgroundForceSoftwareRendering}"
                        BackgroundShaderCode="{TemplateBinding BackgroundShaderCode}"
                        BackgroundShaderFile="{TemplateBinding BackgroundShaderFile}"
                        BackgroundStyle="{TemplateBinding BackgroundStyle}"
                        BackgroundTransitionTime="{TemplateBinding BackgroundTransitionTime}"
                        BackgroundTransitionsEnabled="{TemplateBinding BackgroundTransitionsEnabled}"
                        CornerRadius="{TemplateBinding RootCornerRadius}"
                        Foreground="{TemplateBinding Foreground}"
                        Hosts="{Binding Hosts, RelativeSource={RelativeSource AncestorType={x:Type suki:SukiWindow}}}">
                        <DockPanel LastChildFill="True">
                            <Panel DockPanel.Dock="Top">
                                <StackPanel>
                                    <LayoutTransformControl Name="PART_TitleBar" RenderTransformOrigin="0%,0%">
                                        <Panel chrome:WindowDecorationProperties.ElementRole="TitleBar" Background="Transparent">
                                            <Border
                                                Name="DragArea"
                                                chrome:WindowDecorationProperties.ElementRole="TitleBar"
                                                Background="Transparent"
                                                BorderThickness="0"
                                                CornerRadius="0" />

                                            <suki:GlassCard
                                                Name="PART_TitleBarBackground"
                                                chrome:WindowDecorationProperties.ElementRole="TitleBar"
                                                BorderThickness="0"
                                                CornerRadius="0"
                                                IsAnimated="False"
                                                IsVisible="{TemplateBinding ShowTitlebarBackground}" />

                                            <DockPanel
                                                Margin="16,12,12,8"
                                                chrome:WindowDecorationProperties.ElementRole="TitleBar"
                                                Background="Transparent"
                                                LastChildFill="True">
                                                <StackPanel
                                                    VerticalAlignment="Center"
                                                    DockPanel.Dock="Right"
                                                    Orientation="Horizontal"
                                                    Spacing="8">
                                                    <StackPanel.Styles>
                                                        <Style Selector="PathIcon">
                                                            <Setter Property="Height" Value="{TemplateBinding TitleBarControlSize}" />
                                                            <Setter Property="Width" Value="{TemplateBinding TitleBarControlSize}" />
                                                            <Setter Property="VerticalAlignment" Value="Center" />
                                                        </Style>
                                                    </StackPanel.Styles>
                                                    <ItemsControl chrome:WindowDecorationProperties.ElementRole="User" ItemsSource="{TemplateBinding RightWindowTitleBarControls}">
                                                        <ItemsControl.Styles>
                                                            <Style Selector="Control">
                                                                <Setter Property="chrome:WindowDecorationProperties.ElementRole" Value="User" />
                                                            </Style>
                                                        </ItemsControl.Styles>
                                                        <ItemsControl.ItemsPanel>
                                                            <ItemsPanelTemplate>
                                                                <StackPanel FlowDirection="{DynamicResource FlowDirectionOpposite}" Orientation="Horizontal" />
                                                            </ItemsPanelTemplate>
                                                        </ItemsControl.ItemsPanel>
                                                    </ItemsControl>
                                                    <Button
                                                        Name="PART_FullScreenButton"
                                                        chrome:WindowDecorationProperties.ElementRole="User"
                                                        Classes="WindowControlsButton"
                                                        IsEnabled="{TemplateBinding CanFullScreen}"
                                                        IsVisible="{TemplateBinding CanFullScreen}">
                                                        <PathIcon x:Name="FullScreenIcon" Data="{tools:SvgPath icon-window-full-screen, Center=False}" />
                                                    </Button>
                                                    <Button
                                                        Name="PART_PinButton"
                                                        chrome:WindowDecorationProperties.ElementRole="User"
                                                        Classes="WindowControlsButton"
                                                        IsEnabled="{TemplateBinding CanPin}"
                                                        IsVisible="{TemplateBinding CanPin}">
                                                        <PathIcon x:Name="PinIcon" Data="{tools:SvgPath icon-window-pin, Center=False}" />
                                                    </Button>
                                                    <Button
                                                        Name="PART_MinimizeButton"
                                                        chrome:WindowDecorationProperties.ElementRole="User"
                                                        Classes="WindowControlsButton"
                                                        IsVisible="{TemplateBinding CanMinimize}">
                                                        <PathIcon Data="{tools:SvgPath icon-window-minimize, Center=False}" />
                                                    </Button>
                                                    <Button
                                                        Name="PART_MaximizeButton"
                                                        chrome:WindowDecorationProperties.ElementRole="User"
                                                        Classes="WindowControlsButton"
                                                        IsVisible="{TemplateBinding CanMaximize}">
                                                        <PathIcon x:Name="MaximizeIcon" Data="{tools:SvgPath icon-window-maximize, Center=False}" />
                                                    </Button>
                                                    <Button
                                                        Name="PART_CloseButton"
                                                        chrome:WindowDecorationProperties.ElementRole="User"
                                                        Classes="WindowControlsButton Close">
                                                        <PathIcon Data="{tools:SvgPath icon-window-close, Center=False}" />
                                                    </Button>
                                                </StackPanel>

                                                <Grid
                                                    VerticalAlignment="Center"
                                                    chrome:WindowDecorationProperties.ElementRole="TitleBar"
                                                    Background="Transparent"
                                                    ColumnDefinitions="Auto">
                                                    <ContentPresenter
                                                        Name="PART_Logo"
                                                        Grid.Column="0"
                                                        Margin="2,0,0,0"
                                                        HorizontalAlignment="Left"
                                                        chrome:WindowDecorationProperties.ElementRole="User"
                                                        Background="Transparent"
                                                        Content="{TemplateBinding LogoContent}" />
                                                </Grid>
                                            </DockPanel>
                                            <!--
                                                Custom title bar content: the global search field
                                                overlays the WHOLE title bar (sibling of the DockPanel,
                                                not inside its fill column) so it centers on the bar.
                                                ElementRole="User" keeps it interactive (and
                                                non-dragging); the bar around it keeps dragging.
                                                Handlers are attached by MainWindow.OnApplyTemplate.
                                            -->
                                            <Border
                                                Name="HeaderSearchBorder"
                                                Width="520"
                                                Height="38"
                                                Margin="170,2,170,0"
                                                HorizontalAlignment="Center"
                                                VerticalAlignment="Center"
                                                chrome:WindowDecorationProperties.ElementRole="User"
                                                Background="{DynamicResource HeaderSearchBackgroundBrush}"
                                                BorderBrush="{DynamicResource HairlineBrush}"
                                                BorderThickness="1"
                                                ClipToBounds="True"
                                                CornerRadius="{DynamicResource ControlRadius}">
                                                <TextBox
                                                    Name="HeaderSearchBox"
                                                    MinHeight="0"
                                                    Padding="0,0,4,0"
                                                    VerticalContentAlignment="Center"
                                                    Background="Transparent"
                                                    BorderThickness="0"
                                                    FontSize="14"
                                                    PlaceholderText="Search repositories...">
                                                    <TextBox.InnerLeftContent>
                                                        <Path
                                                            Width="15"
                                                            Height="15"
                                                            Margin="10,0,0,0"
                                                            Data="{tools:SvgPath icon-search}"
                                                            Fill="{DynamicResource MutedForegroundBrush}"
                                                            Stretch="Uniform" />
                                                    </TextBox.InnerLeftContent>
                                                    <TextBox.InnerRightContent>
                                                        <Panel Margin="0,0,6,0">
                                                            <!--  Shortcut hint: shown while the field is empty  -->
                                                            <Border
                                                                Name="SearchKbdHint"
                                                                Padding="6,3"
                                                                VerticalAlignment="Center"
                                                                Background="{DynamicResource HoverBackgroundBrush}"
                                                                CornerRadius="4">
                                                                <TextBlock
                                                                    FontSize="11"
                                                                    Foreground="{DynamicResource MutedForegroundBrush}"
                                                                    Text="Ctrl + F" />
                                                            </Border>
                                                            <!--  Clear button: shown once the field has text  -->
                                                            <Button
                                                                Name="SearchClearButton"
                                                                Width="20"
                                                                Height="20"
                                                                Padding="2"
                                                                HorizontalAlignment="Right"
                                                                VerticalAlignment="Center"
                                                                Classes="icon"
                                                                IsVisible="False"
                                                                ToolTip.Tip="Clear">
                                                                <Path
                                                                    Width="12"
                                                                    Height="12"
                                                                    Data="{tools:SvgPath icon-close}"
                                                                    Fill="{DynamicResource MutedForegroundBrush}"
                                                                    Stretch="Uniform" />
                                                            </Button>
                                                        </Panel>
                                                    </TextBox.InnerRightContent>
                                                </TextBox>
                                            </Border>
                                        </Panel>
                                    </LayoutTransformControl>
                                    <Panel IsVisible="{TemplateBinding IsMenuVisible}">
                                        <suki:GlassCard
                                            Margin="0,0,0,0"
                                            BorderThickness="0"
                                            CornerRadius="0"
                                            IsAnimated="False"
                                            IsVisible="{TemplateBinding ShowTitlebarBackground}" />
                                        <suki:GlassCard
                                            Name="AlternativeGlassMenuBackground"
                                            Margin="10,2,10,10"
                                            CornerRadius="13" />
                                        <Menu
                                            Name="PART_Menu"
                                            IsEnabled="{TemplateBinding IsMenuVisible}"
                                            ItemsSource="{TemplateBinding MenuItems}" />
                                    </Panel>
                                    <Border Name="PART_BottomBorder" BorderBrush="{DynamicResource SukiBorderBrush}" />
                                </StackPanel>
                            </Panel>
                            <ContentPresenter
                                x:Name="PART_ContentPresenter"
                                Padding="{TemplateBinding Padding}"
                                HorizontalContentAlignment="{TemplateBinding HorizontalContentAlignment}"
                                VerticalContentAlignment="{TemplateBinding VerticalContentAlignment}"
                                Content="{TemplateBinding Content}"
                                ContentTemplate="{TemplateBinding ContentTemplate}"
                                CornerRadius="10"
                                IsHitTestVisible="True" />
                        </DockPanel>
                    </suki:SukiMainHost>
                </Panel>
            </ControlTemplate>
        </Setter>

        <Style Selector="^[ShowTitlebarBackground=False] /template/ Menu#PART_Menu">
            <Setter Property="Margin" Value="10,0,0,7" />
        </Style>
        <Style Selector="^[ShowTitlebarBackground=True] /template/ suki|GlassCard#AlternativeGlassMenuBackground">
            <Setter Property="IsVisible" Value="False" />
        </Style>

        <Style Selector="^[Topmost=False] /template/ PathIcon#PinIcon">
            <Setter Property="Data" Value="{tools:SvgPath icon-window-pin, Center=False}" />
        </Style>
        <Style Selector="^[Topmost=True] /template/ PathIcon#PinIcon">
            <Setter Property="Data" Value="{tools:SvgPath icon-window-pin-off, Center=False}" />
        </Style>

        <Style Selector="^[WindowState=Maximized] /template/ PathIcon#MaximizeIcon">
            <Setter Property="Data" Value="{tools:SvgPath icon-window-restore, Center=False}" />
        </Style>
        <Style Selector="^[WindowState=Normal] /template/ PathIcon#MaximizeIcon">
            <Setter Property="Data" Value="{tools:SvgPath icon-window-maximize, Center=False}" />
        </Style>

        <Style Selector="^[WindowState=FullScreen] /template/ Button#PART_MaximizeButton">
            <Setter Property="IsVisible" Value="False" />
        </Style>
        <Style Selector="^[WindowState=FullScreen] /template/ PathIcon#FullScreenIcon">
            <Setter Property="Data" Value="{tools:SvgPath icon-window-full-screen-off, Center=False}" />
        </Style>

        <Style Selector="^[ShowBottomBorder=True] /template/ Border#PART_BottomBorder">
            <Setter Property="BorderThickness" Value="0,0,0,1" />
        </Style>
        <Style Selector="^[ShowBottomBorder=False] /template/ Border#PART_BottomBorder">
            <Setter Property="BorderThickness" Value="0,0,0,0" />
        </Style>

    </ControlTheme>
</ResourceDictionary>
