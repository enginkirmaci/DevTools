<Styles
    xmlns="https://github.com/avaloniaui"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <!--
        ================================================================
        POPUPS / LIGHT-IN-POPUP WORKAROUND
        Popup roots (tooltips, flyouts, menus, ComboBox dropdowns) do not
        inherit the application's RequestedThemeVariant — they follow the
        OS theme, so SukiUI theme dictionaries would resolve Light inside
        popups. Fixed globally in ThemeResources.axaml: the Suki* theme
        keys are overridden there with their Dark values as plain
        Application.Resources entries, which win over SukiTheme's
        style-level theme dictionaries in every lookup context.
        ================================================================
    -->
    <Style Selector="PopupRoot">
        <Setter Property="RequestedThemeVariant" Value="Dark" />
    </Style>

    <!--
        SukiUI's FlyoutPresenter theme paints with ThemeBackgroundBrush /
        ThemeBorderMidBrush — static light-baked colors from SukiUI's
        Colors.xaml — and its template hardcodes Background="Transparent",
        so flyouts render as the white popup window regardless of theme.
        Style selectors do not reliably reach popup content, so the whole
        ControlTheme is overridden here — type-keyed theme resolution is
        the mechanism SukiUI itself uses inside popups.
    -->
    <Styles.Resources>
        <ControlTheme x:Key="{x:Type FlyoutPresenter}" TargetType="FlyoutPresenter">
            <Setter Property="Background" Value="{DynamicResource CardBackgroundBrush}" />
            <Setter Property="BorderBrush" Value="{DynamicResource HairlineBrush}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="CornerRadius" Value="{DynamicResource CardRadius}" />
            <Setter Property="Padding" Value="10" />
            <Setter Property="Template">
                <ControlTemplate>
                    <Border
                        Background="{TemplateBinding Background}"
                        BorderBrush="{TemplateBinding BorderBrush}"
                        BorderThickness="{TemplateBinding BorderThickness}"
                        BoxShadow="{DynamicResource FlyoutShadow}"
                        CornerRadius="{TemplateBinding CornerRadius}">
                        <ContentPresenter
                            Margin="{TemplateBinding Padding}"
                            HorizontalContentAlignment="{TemplateBinding HorizontalContentAlignment}"
                            VerticalContentAlignment="{TemplateBinding VerticalContentAlignment}"
                            Content="{TemplateBinding Content}"
                            ContentTemplate="{TemplateBinding ContentTemplate}" />
                    </Border>
                </ControlTemplate>
            </Setter>
        </ControlTheme>
    </Styles.Resources>

    <!--
        ================================================================
        TYPOGRAPHY
        Reusable TextBlock styles. Apply via Classes="...".
        ================================================================
    -->

    <!-- Page-level hero title (used in Dashboard header). -->
    <Style Selector="TextBlock.page-title">
        <Setter Property="FontSize" Value="28" />
        <Setter Property="FontWeight" Value="Bold" />
        <Setter Property="Foreground" Value="{DynamicResource TitleForegroundBrush}" />
        <Setter Property="TextTrimming" Value="CharacterEllipsis" />
    </Style>

    <Style Selector="TextBlock.page-subtitle">
        <Setter Property="FontSize" Value="13" />
        <Setter Property="Foreground" Value="{DynamicResource MutedForegroundBrush}" />
    </Style>

    <!-- H1 used at the top of a content page (above all cards). -->
    <Style Selector="TextBlock.section-title">
        <Setter Property="FontSize" Value="20" />
        <Setter Property="FontWeight" Value="Bold" />
        <Setter Property="Foreground" Value="{DynamicResource TitleForegroundBrush}" />
        <Setter Property="Margin" Value="0,0,0,12" />
    </Style>

    <!-- H2 used inside cards to label a section. -->
    <Style Selector="TextBlock.card-title">
        <Setter Property="FontSize" Value="14" />
        <Setter Property="FontWeight" Value="SemiBold" />
        <Setter Property="Foreground" Value="{DynamicResource TitleForegroundBrush}" />
    </Style>

    <!-- H3 used as a small field label. -->
    <Style Selector="TextBlock.field-label">
        <Setter Property="FontSize" Value="12" />
        <Setter Property="FontWeight" Value="SemiBold" />
        <Setter Property="Foreground" Value="{DynamicResource MutedForegroundBrush}" />
    </Style>

    <!-- Body copy text used inside cards. -->
    <Style Selector="TextBlock.body-text">
        <Setter Property="FontSize" Value="13" />
        <Setter Property="Foreground" Value="{DynamicResource BodyForegroundBrush}" />
        <Setter Property="TextWrapping" Value="Wrap" />
    </Style>

    <!-- Subtle secondary text (paths, captions, helper text). -->
    <Style Selector="TextBlock.subtle">
        <Setter Property="FontSize" Value="12" />
        <Setter Property="Foreground" Value="{DynamicResource MutedForegroundBrush}" />
    </Style>

    <!-- Inline monospace text used for code/console output. -->
    <Style Selector="TextBlock.mono">
        <Setter Property="FontFamily" Value="Consolas,Menlo,monospace" />
        <Setter Property="FontSize" Value="13" />
    </Style>

    <Style Selector="TextBox.mono">
        <Setter Property="FontFamily" Value="Consolas,Menlo,monospace" />
        <Setter Property="FontSize" Value="13" />
    </Style>

    <!--
        ================================================================
        LAYOUT PRIMITIVES
        ================================================================
    -->

    <!-- Standard card surface — elevated, hairline border, soft shadow. -->
    <Style Selector="Border.card">
        <Setter Property="Background" Value="{DynamicResource CardBackgroundBrush}" />
        <Setter Property="BorderBrush" Value="{DynamicResource HairlineBrush}" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="CornerRadius" Value="{DynamicResource CardRadius}" />
        <Setter Property="Padding" Value="16" />
        <Setter Property="BoxShadow" Value="{DynamicResource CardShadow}" />
    </Style>

    <!-- Subtle chip surface used for status pills, badges, etc. -->
    <Style Selector="Border.chip">
        <Setter Property="Background" Value="{DynamicResource CardSubtleBackgroundBrush}" />
        <Setter Property="BorderBrush" Value="{DynamicResource HairlineBrush}" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="CornerRadius" Value="{DynamicResource ChipRadius}" />
        <Setter Property="Padding" Value="10,6" />
    </Style>

    <!-- Standard root padding for a page (matches 16px gutters). -->
    <Style Selector="Grid.page-root, StackPanel.page-root">
        <Setter Property="Margin" Value="16" />
    </Style>

    <!-- Vertical stack used inside cards with consistent spacing. -->
    <Style Selector="StackPanel.field-stack">
        <Setter Property="Spacing" Value="12" />
    </Style>

    <!-- Horizontal action row at the bottom of a card/dialog. -->
    <Style Selector="StackPanel.actions">
        <Setter Property="Orientation" Value="Horizontal" />
        <Setter Property="Spacing" Value="8" />
    </Style>

    <!-- Divider line used inside action bars. -->
    <Style Selector="Border.vertical-divider">
        <Setter Property="Width" Value="1" />
        <Setter Property="Margin" Value="0,2" />
        <Setter Property="Background" Value="{DynamicResource DividerBrush}" />
    </Style>

    <Style Selector="Border.horizontal-divider">
        <Setter Property="Height" Value="1" />
        <Setter Property="Background" Value="{DynamicResource DividerBrush}" />
    </Style>

    <!--
        ================================================================
        CONTROL OVERRIDES
        ================================================================
    -->

    <!-- Icon-only square button (32x32) with hover background. -->
    <Style Selector="Button.icon">
        <Setter Property="Width" Value="32" />
        <Setter Property="Height" Value="32" />
        <Setter Property="Padding" Value="0" />
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="BorderThickness" Value="0" />
        <Setter Property="CornerRadius" Value="{DynamicResource ControlRadius}" />
    </Style>
    <Style Selector="Button.icon:pointerover">
        <Setter Property="Background" Value="{DynamicResource HoverBackgroundBrush}" />
    </Style>

    <!-- Standard icon path (18px, subtle gray). -->
    <Style Selector="Path.icon">
        <Setter Property="Width" Value="18" />
        <Setter Property="Height" Value="18" />
        <Setter Property="Stretch" Value="Uniform" />
        <Setter Property="Fill" Value="{DynamicResource MutedForegroundBrush}" />
    </Style>

    <!--
        Tool button — a larger launch button with an icon stacked over a caption
        (repo card Workspace zone). Subtle fill, hairline border, lifts on hover.
    -->
    <Style Selector="Button.tool-button">
        <Setter Property="MinWidth" Value="68" />
        <Setter Property="Padding" Value="10,8" />
        <Setter Property="Background" Value="{DynamicResource CardSubtleBackgroundBrush}" />
        <Setter Property="BorderBrush" Value="{DynamicResource HairlineBrush}" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="CornerRadius" Value="{DynamicResource ControlRadius}" />
        <Setter Property="Cursor" Value="Hand" />
        <Setter Property="Transitions">
            <Setter.Value>
                <Transitions>
                    <BrushTransition Property="Background" Duration="0:0:0.15" />
                    <BrushTransition Property="BorderBrush" Duration="0:0:0.15" />
                </Transitions>
            </Setter.Value>
        </Setter>
    </Style>
    <Style Selector="Button.tool-button:pointerover">
        <Setter Property="Background" Value="{DynamicResource HoverBackgroundBrush}" />
        <Setter Property="BorderBrush" Value="{DynamicResource AccentSoftBorderBrush}" />
    </Style>

    <!--
        Accent button — primary action. Indigo fill, white text, rounded,
        smooth hover/press transitions.
    -->
    <Style Selector="Button.accent">
        <Setter Property="Background" Value="{DynamicResource AccentPrimaryBrush}" />
        <Setter Property="Foreground" Value="{DynamicResource AccentForegroundBrush}" />
        <Setter Property="BorderThickness" Value="0" />
        <Setter Property="CornerRadius" Value="{DynamicResource ControlRadius}" />
        <Setter Property="FontWeight" Value="SemiBold" />
        <Setter Property="Transitions">
            <Setter.Value>
                <Transitions>
                    <BrushTransition Property="Background" Duration="0:0:0.15" />
                </Transitions>
            </Setter.Value>
        </Setter>
    </Style>
    <Style Selector="Button.accent:pointerover">
        <Setter Property="Background" Value="{DynamicResource AccentPrimaryHoverBrush}" />
    </Style>
    <Style Selector="Button.accent:pressed">
        <Setter Property="Background" Value="{DynamicResource AccentPrimaryPressedBrush}" />
    </Style>

    <!--
        Card button — used for dashboard / interactive cards. Subtle
        elevation that lifts on hover with a smooth shadow transition.
        The template is overridden because SukiUI's Button theme wraps the
        content in a horizontal StackPanel, which measures content with
        infinite width — so wrapping TextBlocks inside the card (e.g. the
        dashboard subtitles) never wrap. Here the ContentPresenter is placed
        directly in the border so content is measured with the real width.
    -->
    <Style Selector="Button.card-button">
        <Setter Property="Background" Value="{DynamicResource CardBackgroundBrush}" />
        <Setter Property="BorderBrush" Value="{DynamicResource HairlineBrush}" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="CornerRadius" Value="{DynamicResource CardRadius}" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate>
                    <Border
                            Name="RootBorder"
                            Padding="{TemplateBinding Padding}"
                            Background="{TemplateBinding Background}"
                            BorderBrush="{TemplateBinding BorderBrush}"
                            BorderThickness="{TemplateBinding BorderThickness}"
                            CornerRadius="{TemplateBinding CornerRadius}"
                            TextElement.Foreground="{TemplateBinding Foreground}">
                            <ContentPresenter
                                    Name="PART_ContentPresenter"
                                    HorizontalContentAlignment="{TemplateBinding HorizontalContentAlignment}"
                                    VerticalContentAlignment="{TemplateBinding VerticalContentAlignment}"
                                    Content="{TemplateBinding Content}"
                                    ContentTemplate="{TemplateBinding ContentTemplate}" />
                    </Border>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
        <Setter Property="Transitions">
            <Setter.Value>
                <Transitions>
                    <BrushTransition Property="Background" Duration="0:0:0.15" />
                    <BrushTransition Property="BorderBrush" Duration="0:0:0.15" />
                </Transitions>
            </Setter.Value>
        </Setter>
    </Style>
    <Style Selector="Button.card-button /template/ Border#RootBorder">
        <Setter Property="BoxShadow" Value="{DynamicResource CardShadow}" />
    </Style>
    <Style Selector="Button.card-button:pointerover">
        <Setter Property="Background" Value="{DynamicResource CardSubtleBackgroundBrush}" />
        <Setter Property="BorderBrush" Value="{DynamicResource AccentSoftBorderBrush}" />
    </Style>
    <Style Selector="Button.card-button:pointerover /template/ Border#RootBorder">
        <Setter Property="BoxShadow" Value="{DynamicResource CardHoverShadow}" />
    </Style>

</Styles>
