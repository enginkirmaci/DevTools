<Styles xmlns="https://github.com/avaloniaui" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <!--
        ================================================================
        POPUPS
        Popup roots (tooltips, flyouts, menus, ComboBox dropdowns) do not
        inherit the application's RequestedThemeVariant — they follow the
        OS theme, so SukiUI theme dictionaries would resolve Light inside
        popups. ThemeResources.axaml overrides the Suki* theme keys with
        their Dark values as plain Application.Resources entries; for
        flyout surfaces that still resolved Light, the whole ControlTheme
        is overridden below — type-keyed theme resolution is the mechanism
        SukiUI itself uses inside popups.
        
        Avalonia 12 defaults PopupRoot.Background to White and popup
        surfaces are not transparency-capable here, so every see-through
        area of a popup (tooltip shadow margin, rounded corners) painted
        as a white frame. Fixed by making the popup root transparent;
        TransparencyBackgroundFallback is what the renderer actually
        composites with when the surface itself can't be transparent.
        ================================================================
    -->
    <Style Selector="PopupRoot">
        <Setter Property="RequestedThemeVariant" Value="Dark" />
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="TransparencyBackgroundFallback" Value="Transparent" />
    </Style>

    <!--
        SukiUI's FlyoutPresenter theme paints with ThemeBackgroundBrush /
        ThemeBorderMidBrush — static light-baked colors from SukiUI's
        Colors.xaml — and its template hardcodes Background="Transparent",
        so flyouts render as the white popup window regardless of theme.
        Style selectors do not reliably reach popup content, so the whole
        ControlTheme is overridden here — type-keyed theme resolution is
        the mechanism SukiUI itself uses inside popups.
    -->
    <Styles.Resources>
        <ControlTheme x:Key="{x:Type FlyoutPresenter}" TargetType="FlyoutPresenter">
            <Setter Property="Background" Value="{DynamicResource CardBackgroundBrush}" />
            <Setter Property="BorderBrush" Value="{DynamicResource HairlineBrush}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="CornerRadius" Value="{DynamicResource CardRadius}" />
            <Setter Property="Padding" Value="10" />
            <Setter Property="Template">
                <ControlTemplate>
                    <Border
                        Background="{TemplateBinding Background}"
                        BorderBrush="{TemplateBinding BorderBrush}"
                        BorderThickness="{TemplateBinding BorderThickness}"
                        BoxShadow="{DynamicResource FlyoutShadow}"
                        CornerRadius="{TemplateBinding CornerRadius}">
                        <ContentPresenter
                            Margin="{TemplateBinding Padding}"
                            HorizontalContentAlignment="{TemplateBinding HorizontalContentAlignment}"
                            VerticalContentAlignment="{TemplateBinding VerticalContentAlignment}"
                            Content="{TemplateBinding Content}"
                            ContentTemplate="{TemplateBinding ContentTemplate}" />
                    </Border>
                </ControlTemplate>
            </Setter>
        </ControlTheme>
    </Styles.Resources>

    <!--
        ================================================================
        TYPOGRAPHY
        Reusable TextBlock styles. Apply via Classes="...".
        ================================================================
    -->

    <!--  H1 used at the top of a content page (above all cards).  -->
    <Style Selector="TextBlock.section-title">
        <Setter Property="FontSize" Value="20" />
        <Setter Property="FontWeight" Value="Bold" />
        <Setter Property="Foreground" Value="{DynamicResource TitleForegroundBrush}" />
        <Setter Property="Margin" Value="0,0,0,12" />
    </Style>

    <!--  H2 used inside cards to label a section.  -->
    <Style Selector="TextBlock.card-title">
        <Setter Property="FontSize" Value="16" />
        <Setter Property="FontWeight" Value="SemiBold" />
        <Setter Property="Foreground" Value="{DynamicResource TitleForegroundBrush}" />
    </Style>

    <!--  H3 used as a small field label.  -->
    <Style Selector="TextBlock.field-label">
        <Setter Property="FontSize" Value="12" />
        <Setter Property="FontWeight" Value="SemiBold" />
        <Setter Property="Foreground" Value="{DynamicResource MutedForegroundBrush}" />
    </Style>

    <!--  Body copy text used inside cards.  -->
    <Style Selector="TextBlock.body-text">
        <Setter Property="FontSize" Value="13" />
        <Setter Property="Foreground" Value="{DynamicResource BodyForegroundBrush}" />
        <Setter Property="TextWrapping" Value="Wrap" />
    </Style>

    <!--  Subtle secondary text (paths, captions, helper text).  -->
    <Style Selector="TextBlock.subtle">
        <Setter Property="FontSize" Value="12" />
        <Setter Property="Foreground" Value="{DynamicResource MutedForegroundBrush}" />
    </Style>

    <!--  Inline monospace text used for code/console output.  -->
    <Style Selector="TextBlock.mono">
        <Setter Property="FontFamily" Value="Consolas,Menlo,monospace" />
        <Setter Property="FontSize" Value="13" />
    </Style>

    <Style Selector="TextBox.mono">
        <Setter Property="FontFamily" Value="Consolas,Menlo,monospace" />
        <Setter Property="FontSize" Value="13" />
    </Style>

    <!--
        ================================================================
        LAYOUT PRIMITIVES
        ================================================================
    -->

    <!--  Standard card surface — elevated, hairline border, soft shadow.  -->
    <Style Selector="Border.card">
        <Setter Property="Background" Value="{DynamicResource CardBackgroundBrush}" />
        <Setter Property="BorderBrush" Value="{DynamicResource HairlineBrush}" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="CornerRadius" Value="{DynamicResource CardRadius}" />
        <Setter Property="Padding" Value="16" />
        <Setter Property="BoxShadow" Value="{DynamicResource CardShadow}" />
    </Style>

    <!--  Subtle chip surface used for status pills, badges, etc.  -->
    <Style Selector="Border.chip">
        <Setter Property="Background" Value="{DynamicResource CardSubtleBackgroundBrush}" />
        <Setter Property="BorderBrush" Value="{DynamicResource HairlineBrush}" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="CornerRadius" Value="{DynamicResource ChipRadius}" />
        <Setter Property="Padding" Value="10,6" />
    </Style>

    <!--  Standard root padding for a page (matches 16px gutters).  -->
    <Style Selector="Grid.page-root, StackPanel.page-root">
        <Setter Property="Margin" Value="16" />
    </Style>

    <!--  Vertical stack used inside cards with consistent spacing.  -->
    <Style Selector="StackPanel.field-stack">
        <Setter Property="Spacing" Value="12" />
    </Style>

    <!--  Horizontal action row at the bottom of a card/dialog.  -->
    <Style Selector="StackPanel.actions">
        <Setter Property="Orientation" Value="Horizontal" />
        <Setter Property="Spacing" Value="8" />
    </Style>

    <!--  Divider line used inside action bars.  -->
    <Style Selector="Border.vertical-divider">
        <Setter Property="Width" Value="1" />
        <Setter Property="Margin" Value="0,2" />
        <Setter Property="Background" Value="{DynamicResource DividerBrush}" />
    </Style>

    <!--
        ================================================================
        CONTROL OVERRIDES
        ================================================================
    -->

    <!--  Icon-only square button (32x32) with hover background.  -->
    <Style Selector="Button.icon">
        <Setter Property="Width" Value="32" />
        <Setter Property="Height" Value="32" />
        <Setter Property="Padding" Value="0" />
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="BorderThickness" Value="0" />
        <Setter Property="CornerRadius" Value="{DynamicResource ControlRadius}" />
    </Style>
    <Style Selector="Button.icon:pointerover">
        <Setter Property="Background" Value="{DynamicResource HoverBackgroundBrush}" />
    </Style>

    <!--  Quiet text button: transparent with a hover tint, 12px muted label —
          for text actions that would read as mystery icons (Stage/Unstage All
          in the bottom bar, the repos table's "Clear").  -->
    <Style Selector="Button.text-subtle">
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="BorderThickness" Value="0" />
        <Setter Property="Padding" Value="8,2" />
        <Setter Property="CornerRadius" Value="{DynamicResource ControlRadius}" />
        <Setter Property="FontSize" Value="12" />
        <Setter Property="Foreground" Value="{DynamicResource MutedForegroundBrush}" />
    </Style>
    <Style Selector="Button.text-subtle:pointerover">
        <Setter Property="Background" Value="{DynamicResource HoverBackgroundBrush}" />
    </Style>

    <!--  Standard icon path (18px, subtle gray).  -->
    <Style Selector="Path.icon">
        <Setter Property="Width" Value="18" />
        <Setter Property="Height" Value="18" />
        <Setter Property="Stretch" Value="Uniform" />
        <Setter Property="Fill" Value="{DynamicResource MutedForegroundBrush}" />
    </Style>

    <!--
        Stepped spinner ring (commit button + commit-message wand in the bottom bar,
        the Repos page's refresh button): the arc is drawn at final size in element
        coordinates — NO Stretch, no StrokeLineCap setters — so the circle's center is
        exactly the RenderTransformOrigin (50%,50%) the rotation pivots on; keep those
        on each Path instance. Stroke stays per-instance too: the commit ring tracks
        the button Foreground, the wand ring is accent-colored. [IsVisible=True] stops
        the animation (and its clock work) once the ring hides. The spin is stepped on
        purpose: during each hold nothing invalidates and the compositor idles — a
        smooth per-frame sweep measured ~20% of a core on this 165Hz display, the
        stepped form ~2% (synthetic A/B).
    -->
    <Style Selector="Path.spinner[IsVisible=True]">
        <Style.Animations>
            <Animation Duration="0:0:0.9" IterationCount="Infinite">
                <KeyFrame Cue="0%">
                    <Setter Property="RotateTransform.Angle" Value="0" />
                </KeyFrame>
                <KeyFrame Cue="8.3%">
                    <Setter Property="RotateTransform.Angle" Value="0" />
                </KeyFrame>
                <KeyFrame Cue="10%">
                    <Setter Property="RotateTransform.Angle" Value="36" />
                </KeyFrame>
                <KeyFrame Cue="18.3%">
                    <Setter Property="RotateTransform.Angle" Value="36" />
                </KeyFrame>
                <KeyFrame Cue="20%">
                    <Setter Property="RotateTransform.Angle" Value="72" />
                </KeyFrame>
                <KeyFrame Cue="28.3%">
                    <Setter Property="RotateTransform.Angle" Value="72" />
                </KeyFrame>
                <KeyFrame Cue="30%">
                    <Setter Property="RotateTransform.Angle" Value="108" />
                </KeyFrame>
                <KeyFrame Cue="38.3%">
                    <Setter Property="RotateTransform.Angle" Value="108" />
                </KeyFrame>
                <KeyFrame Cue="40%">
                    <Setter Property="RotateTransform.Angle" Value="144" />
                </KeyFrame>
                <KeyFrame Cue="48.3%">
                    <Setter Property="RotateTransform.Angle" Value="144" />
                </KeyFrame>
                <KeyFrame Cue="50%">
                    <Setter Property="RotateTransform.Angle" Value="180" />
                </KeyFrame>
                <KeyFrame Cue="58.3%">
                    <Setter Property="RotateTransform.Angle" Value="180" />
                </KeyFrame>
                <KeyFrame Cue="60%">
                    <Setter Property="RotateTransform.Angle" Value="216" />
                </KeyFrame>
                <KeyFrame Cue="68.3%">
                    <Setter Property="RotateTransform.Angle" Value="216" />
                </KeyFrame>
                <KeyFrame Cue="70%">
                    <Setter Property="RotateTransform.Angle" Value="252" />
                </KeyFrame>
                <KeyFrame Cue="78.3%">
                    <Setter Property="RotateTransform.Angle" Value="252" />
                </KeyFrame>
                <KeyFrame Cue="80%">
                    <Setter Property="RotateTransform.Angle" Value="288" />
                </KeyFrame>
                <KeyFrame Cue="88.3%">
                    <Setter Property="RotateTransform.Angle" Value="288" />
                </KeyFrame>
                <KeyFrame Cue="90%">
                    <Setter Property="RotateTransform.Angle" Value="324" />
                </KeyFrame>
                <KeyFrame Cue="98.3%">
                    <Setter Property="RotateTransform.Angle" Value="324" />
                </KeyFrame>
                <KeyFrame Cue="100%">
                    <Setter Property="RotateTransform.Angle" Value="360" />
                </KeyFrame>
            </Animation>
        </Style.Animations>
    </Style>

    <!--
        Stat-card icon badge — the overview card's tinted rounded square: give the
        Border the stat's accent color as its Background and draw the full-strength
        icon on top of it (sibling inside a 36px Grid).
    -->
    <Style Selector="Border.stat-badge">
        <Setter Property="CornerRadius" Value="8" />
        <Setter Property="Opacity" Value="0.16" />
    </Style>

    <!--
        List row — the repositories table's row language for static lists (history,
        activity logs): transparent surface, bottom hairline as the row separator and
        the table's hover tint. Rows sit contiguously inside a card.
    -->
    <Style Selector="Border.list-row">
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="BorderBrush" Value="{DynamicResource DividerBrush}" />
        <Setter Property="BorderThickness" Value="0,0,0,1" />
        <Setter Property="Padding" Value="10,7" />
    </Style>
    <Style Selector="Border.list-row:pointerover">
        <Setter Property="Background" Value="{DynamicResource RowHoverBackgroundBrush}" />
    </Style>

    <!--
        Tool button — an icon-only launch button (repo card Workspace zone).
        Subtle fill, hairline border, lifts on hover; the tooltip names the action.
    -->
    <Style Selector="Button.tool-button">
        <Setter Property="Width" Value="40" />
        <Setter Property="Height" Value="40" />
        <Setter Property="Padding" Value="0" />
        <Setter Property="Background" Value="{DynamicResource CardSubtleBackgroundBrush}" />
        <Setter Property="BorderBrush" Value="{DynamicResource HairlineBrush}" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="CornerRadius" Value="{DynamicResource ControlRadius}" />
        <Setter Property="Cursor" Value="Hand" />
        <Setter Property="Transitions">
            <Setter.Value>
                <Transitions>
                    <BrushTransition Property="Background" Duration="0:0:0.15" />
                    <BrushTransition Property="BorderBrush" Duration="0:0:0.15" />
                </Transitions>
            </Setter.Value>
        </Setter>
    </Style>
    <Style Selector="Button.tool-button:pointerover">
        <Setter Property="Background" Value="{DynamicResource HoverBackgroundBrush}" />
        <Setter Property="BorderBrush" Value="{DynamicResource AccentSoftBorderBrush}" />
    </Style>

</Styles>
