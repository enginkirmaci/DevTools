<ResourceDictionary
    xmlns="https://github.com/avaloniaui"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <!--
        ================================================================
        SUKIUI DARK OVERRIDES (static, variant-proof)
        Plain Application.Resources entries win over SukiTheme's
        style-level Light/Dark theme dictionaries in every lookup
        context — including popup roots (tooltips, flyouts, menus,
        ComboBox dropdowns), which follow the OS theme instead of the
        app's pinned Dark variant. Values copied from SukiUI Dark.axaml.
        Remove this section if runtime light/dark switching is ever added.
        ================================================================
    -->
    <Color x:Key="SukiBackground">Transparent</Color>
    <Color x:Key="SukiStrongBackground">#353535</Color>
    <Color x:Key="SukiLightBackground">Transparent</Color>
    <Color x:Key="SukiCardBackground">#323232</Color>
    <Color x:Key="SukiPopupBackground">#252525</Color>
    <Color x:Key="SukiGlassCardBackground">#49AAAAAA</Color>
    <Color x:Key="SukiGlassCardOpaqueBackground">#333333</Color>
    <Color x:Key="SukiControlTouchBackground">#505050</Color>
    <Color x:Key="SukiDialogBackground">#000000</Color>

    <Color x:Key="SukiBorderBrush">#353535</Color>
    <Color x:Key="SukiControlBorderBrush">#606060</Color>
    <Color x:Key="SukiMediumBorderBrush">#555555</Color>
    <Color x:Key="SukiLightBorderBrush">#454545</Color>
    <Color x:Key="SukiMenuBorderBrush">#454545</Color>
    <Color x:Key="GlassBorderBrush">#252729</Color>

    <Color x:Key="SukiText">#EDFFFFFF</Color>
    <Color x:Key="SukiLowText">#CAFFFFFF</Color>
    <Color x:Key="SukiMuteText">#B4B4B4</Color>
    <Color x:Key="SukiDisabledText">#CA727272</Color>

    <Color x:Key="SukiLiquid1">#FFFFFF</Color>
    <Color x:Key="SukiLiquid2">#AAFFFFFF</Color>

    <Color x:Key="SukiSuccessColor">#CC228B22</Color>
    <Color x:Key="SukiSuccessMediumColor">#CC1D771D</Color>
    <Color x:Key="SukiSuccessDarkColor">#CC1D771D</Color>
    <Color x:Key="SukiSuccessForeground">White</Color>

    <Color x:Key="SukiInformationColor">#CC2F54EB</Color>
    <Color x:Key="SukiInformationMediumColor">#CC1D39C4</Color>
    <Color x:Key="SukiInformationDarkColor">#CC1D39C4</Color>
    <Color x:Key="SukiInformationForeground">White</Color>

    <Color x:Key="SukiWarningColor">#CCFA8C16</Color>
    <Color x:Key="SukiWarningMediumColor">#CCAD4E00</Color>
    <Color x:Key="SukiWarningDarkColor">#CCAD4E00</Color>
    <Color x:Key="SukiWarningForeground">White</Color>

    <Color x:Key="SukiDangerColor">#BBF5222D</Color>
    <Color x:Key="SukiDangerMediumColor">#BBA8071A</Color>
    <Color x:Key="SukiDangerDarkColor">#BBA8071A</Color>
    <Color x:Key="SukiDangerForeground">White</Color>

    <Color x:Key="ControlSukiGlassCardBackground">#49AAAAAA</Color>
    <Color x:Key="SukiNeedleBrush">#FFFFFF</Color>

    <x:Boolean x:Key="IsDark">True</x:Boolean>
    <x:Boolean x:Key="IsLight">False</x:Boolean>
    <x:Double x:Key="GlassOpacity">0.18</x:Double>
    <x:Double x:Key="ControlGlassOpacity">0.3</x:Double>
    <x:Double x:Key="DiscreteControlGlassOpacity">0.17</x:Double>

    <!--
        ================================================================
        THEME RESOURCES — SukiUI alias layer
        The app's semantic keys are thin aliases over SukiUI theme
        tokens (Suki*), so the whole palette, light/dark switching and
        accent color are owned by SukiTheme. Views and styles keep
        referencing the stable app keys unchanged.
        ================================================================
    -->

    <!-- Surfaces -->
    <SolidColorBrush x:Key="AppBackgroundBrush" Color="{DynamicResource SukiBackground}" />
    <SolidColorBrush x:Key="SidebarBackgroundBrush" Color="{DynamicResource SukiStrongBackground}" />
    <SolidColorBrush x:Key="SidebarTranslucentBrush" Color="{DynamicResource SukiCardBackground}" />
    <SolidColorBrush x:Key="ContentBackgroundBrush" Color="{DynamicResource SukiBackground}" />
    <SolidColorBrush x:Key="CardBackgroundBrush" Color="{DynamicResource SukiCardBackground}" />
    <SolidColorBrush x:Key="CardSubtleBackgroundBrush" Color="{DynamicResource SukiStrongBackground}" />
    <SolidColorBrush x:Key="DividerBrush" Color="{DynamicResource SukiLightBorderBrush}" />
    <SolidColorBrush x:Key="HairlineBrush" Color="{DynamicResource SukiBorderBrush}" />
    <SolidColorBrush x:Key="SelectionBackgroundBrush" Color="{DynamicResource SukiPrimaryColor25}" />
    <SolidColorBrush x:Key="HoverBackgroundBrush" Color="{DynamicResource SukiControlTouchBackground}" />

    <!-- Text -->
    <SolidColorBrush x:Key="TitleForegroundBrush" Color="{DynamicResource SukiText}" />
    <SolidColorBrush x:Key="SubtitleForegroundBrush" Color="{DynamicResource SukiLowText}" />
    <SolidColorBrush x:Key="BodyForegroundBrush" Color="{DynamicResource SukiLowText}" />
    <SolidColorBrush x:Key="MutedForegroundBrush" Color="{DynamicResource SukiMuteText}" />
    <SolidColorBrush x:Key="FaintForegroundBrush" Color="{DynamicResource SukiDisabledText}" />

    <!-- Accent (SukiPrimaryColor follows SukiTheme.ThemeColor) -->
    <SolidColorBrush x:Key="AccentPrimaryBrush" Color="{DynamicResource SukiPrimaryColor}" />
    <SolidColorBrush x:Key="AccentPrimaryHoverBrush" Color="{DynamicResource SukiPrimaryColor120}" />
    <SolidColorBrush x:Key="AccentPrimaryPressedBrush" Color="{DynamicResource SukiPrimaryColor75}" />
    <SolidColorBrush x:Key="AccentSoftBrush" Color="{DynamicResource SukiPrimaryColor15}" />
    <SolidColorBrush x:Key="AccentSoftBorderBrush" Color="{DynamicResource SukiPrimaryColor50}" />
    <SolidColorBrush x:Key="AccentForegroundBrush" Color="#FFFFFF" />

    <!-- Status indicators -->
    <SolidColorBrush x:Key="StatusActiveBrush" Color="{DynamicResource SukiSuccessColor}" />
    <SolidColorBrush x:Key="StatusInactiveBrush" Color="{DynamicResource SukiDisabledText}" />
    <SolidColorBrush x:Key="InfoAccentBrush" Color="{DynamicResource SukiInformationColor}" />
    <SolidColorBrush x:Key="WarningAccentBrush" Color="{DynamicResource SukiWarningColor}" />
    <SolidColorBrush x:Key="DangerAccentBrush" Color="{DynamicResource SukiDangerColor}" />
    <!-- No SukiUI equivalent — kept as a custom brand color -->
    <SolidColorBrush x:Key="PurpleAccentBrush" Color="#8B5CF6" />

    <!--
        ================================================================
        DESIGN TOKENS
        Centralized numeric tokens for sizing and radius.
        ================================================================
    -->
    <CornerRadius x:Key="CardRadius">10</CornerRadius>
    <CornerRadius x:Key="ControlRadius">8</CornerRadius>
    <CornerRadius x:Key="ChipRadius">6</CornerRadius>

    <!--
        ================================================================
        ELEVATION SHADOWS — same values as SukiUI's theme shadows
        (SukiLowShadow / SukiSmallPopupShadow / SukiPopupShadow)
        ================================================================
    -->
    <ResourceDictionary.ThemeDictionaries>
        <ResourceDictionary x:Key="Dark">
            <BoxShadows x:Key="CardShadow">0 0 3 0 #353535</BoxShadows>
            <BoxShadows x:Key="CardHoverShadow">0 2 5 0 #101010</BoxShadows>
            <BoxShadows x:Key="FlyoutShadow">1 1 14 1 #101010</BoxShadows>
        </ResourceDictionary>
        <ResourceDictionary x:Key="Light">
            <BoxShadows x:Key="CardShadow">0 0 3 0 #eaeaea</BoxShadows>
            <BoxShadows x:Key="CardHoverShadow">0 2 5 0 LightGray</BoxShadows>
            <BoxShadows x:Key="FlyoutShadow">1 1 8 0 LightGray</BoxShadows>
        </ResourceDictionary>
    </ResourceDictionary.ThemeDictionaries>

</ResourceDictionary>
