<ResourceDictionary
    xmlns="https://github.com/avaloniaui"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <!--
        ================================================================
        SUKIUI DARK OVERRIDES (static, variant-proof)
        Plain Application.Resources entries win over SukiTheme's
        style-level Light/Dark theme dictionaries in every lookup
        context — including popup roots (tooltips, flyouts, menus,
        ComboBox dropdowns), which follow the OS theme instead of the
        app's pinned Dark variant. Surface values follow the SukiUI dark
        reference look (Images/winuidark.png: #252525 window background,
        #222222 cards, #292929 sidebar) instead of the current SukiUI
        Dark.axaml defaults. SukiBorderBrush is bumped to #3F3F3F so 1px
        card hairlines stay visible after fractional-pixel antialiasing.
        Remove this section if runtime light/dark switching is ever added.
        ================================================================
    -->
    <Color x:Key="SukiBackground">#252525</Color>
    <Color x:Key="SukiStrongBackground">#292929</Color>
    <Color x:Key="SukiLightBackground">#252525</Color>
    <Color x:Key="SukiCardBackground">#222222</Color>
    <Color x:Key="SukiPopupBackground">#2B2B2B</Color>
    <Color x:Key="SukiGlassCardBackground">#49AAAAAA</Color>
    <Color x:Key="SukiGlassCardOpaqueBackground">#333333</Color>
    <Color x:Key="SukiControlTouchBackground">#505050</Color>
    <Color x:Key="SukiDialogBackground">#000000</Color>

    <Color x:Key="SukiBorderBrush">#3F3F3F</Color>
    <Color x:Key="SukiControlBorderBrush">#505050</Color>
    <Color x:Key="SukiMediumBorderBrush">#494949</Color>
    <Color x:Key="SukiLightBorderBrush">#333333</Color>
    <Color x:Key="SukiMenuBorderBrush">#333333</Color>
    <Color x:Key="GlassBorderBrush">#252729</Color>

    <Color x:Key="SukiText">#EDFFFFFF</Color>
    <Color x:Key="SukiLowText">#CAFFFFFF</Color>
    <Color x:Key="SukiMuteText">#B4B4B4</Color>
    <Color x:Key="SukiDisabledText">#CA727272</Color>

    <Color x:Key="SukiLiquid1">#FFFFFF</Color>
    <Color x:Key="SukiLiquid2">#AAFFFFFF</Color>

    <Color x:Key="SukiSuccessColor">#CC228B22</Color>
    <Color x:Key="SukiSuccessMediumColor">#CC1D771D</Color>
    <Color x:Key="SukiSuccessDarkColor">#CC1D771D</Color>
    <Color x:Key="SukiSuccessForeground">White</Color>

    <Color x:Key="SukiInformationColor">#CC2F54EB</Color>
    <Color x:Key="SukiInformationMediumColor">#CC1D39C4</Color>
    <Color x:Key="SukiInformationDarkColor">#CC1D39C4</Color>
    <Color x:Key="SukiInformationForeground">White</Color>

    <Color x:Key="SukiWarningColor">#CCFA8C16</Color>
    <Color x:Key="SukiWarningMediumColor">#CCAD4E00</Color>
    <Color x:Key="SukiWarningDarkColor">#CCAD4E00</Color>
    <Color x:Key="SukiWarningForeground">White</Color>

    <Color x:Key="SukiDangerColor">#BBF5222D</Color>
    <Color x:Key="SukiDangerMediumColor">#BBA8071A</Color>
    <Color x:Key="SukiDangerDarkColor">#BBA8071A</Color>
    <Color x:Key="SukiDangerForeground">White</Color>

    <Color x:Key="ControlSukiGlassCardBackground">#49AAAAAA</Color>
    <Color x:Key="SukiNeedleBrush">#FFFFFF</Color>

    <x:Boolean x:Key="IsDark">True</x:Boolean>
    <x:Boolean x:Key="IsLight">False</x:Boolean>
    <x:Double x:Key="GlassOpacity">0.18</x:Double>
    <x:Double x:Key="ControlGlassOpacity">0.3</x:Double>
    <x:Double x:Key="DiscreteControlGlassOpacity">0.17</x:Double>

    <!--
        ================================================================
        THEME RESOURCES — SukiUI alias layer
        The app's semantic keys are thin aliases over SukiUI theme
        tokens (Suki*), so the whole palette, light/dark switching and
        accent color are owned by SukiTheme. Views and styles keep
        referencing the stable app keys unchanged.
        ================================================================
    -->

    <!-- Surfaces -->
    <SolidColorBrush x:Key="ContentBackgroundBrush" Color="{DynamicResource SukiBackground}" />
    <SolidColorBrush x:Key="CardBackgroundBrush" Color="{DynamicResource SukiCardBackground}" />
    <SolidColorBrush x:Key="CardSubtleBackgroundBrush" Color="{DynamicResource SukiStrongBackground}" />
    <!-- Header (title bar) search field surface: a step lighter than the app background
         so the floating field reads as its own control, with the hairline border. -->
    <SolidColorBrush x:Key="HeaderSearchBackgroundBrush" Color="{DynamicResource SukiPopupBackground}" />
    <SolidColorBrush x:Key="DividerBrush" Color="{DynamicResource SukiLightBorderBrush}" />
    <SolidColorBrush x:Key="HairlineBrush" Color="{DynamicResource SukiBorderBrush}" />
    <SolidColorBrush x:Key="HoverBackgroundBrush" Color="{DynamicResource SukiControlTouchBackground}" />
    <!-- Repos table row hover — the touch color at low opacity so a full-width row
         highlight stays subtle against the card surface underneath it. -->
    <SolidColorBrush
        x:Key="RowHoverBackgroundBrush"
        Color="{DynamicResource SukiControlTouchBackground}"
        Opacity="0.18" />

    <!-- Text -->
    <SolidColorBrush x:Key="TitleForegroundBrush" Color="{DynamicResource SukiText}" />
    <SolidColorBrush x:Key="BodyForegroundBrush" Color="{DynamicResource SukiLowText}" />
    <SolidColorBrush x:Key="MutedForegroundBrush" Color="{DynamicResource SukiMuteText}" />
    <SolidColorBrush x:Key="FaintForegroundBrush" Color="{DynamicResource SukiDisabledText}" />

    <!-- Accent (SukiTheme writes the SukiPrimaryColor* palette, then
         App.ApplyAccentColorOverride overrides it to the periwinkle accent) -->
    <SolidColorBrush x:Key="AccentPrimaryBrush" Color="{DynamicResource SukiPrimaryColor}" />
    <SolidColorBrush x:Key="AccentSoftBorderBrush" Color="{DynamicResource SukiPrimaryColor50}" />

    <!-- Status indicators -->
    <SolidColorBrush x:Key="StatusActiveBrush" Color="{DynamicResource SukiSuccessColor}" />
    <SolidColorBrush x:Key="InfoAccentBrush" Color="{DynamicResource SukiInformationColor}" />
    <SolidColorBrush x:Key="WarningAccentBrush" Color="{DynamicResource SukiWarningColor}" />
    <SolidColorBrush x:Key="DangerAccentBrush" Color="{DynamicResource SukiDangerColor}" />
    <!-- No SukiUI equivalent — kept as a custom brand color. The pull-request accent:
         every PR pill/chip is purple, every issue one green (the Overview cards' coding). -->
    <Color x:Key="PurpleBrandColor">#8B5CF6</Color>
    <SolidColorBrush x:Key="PurpleAccentBrush" Color="{DynamicResource PurpleBrandColor}" />
    <!-- Translucent tints behind the GitHub column's PR / issue count chips
         (PR purple, issue green) — bright bases at 0.2 so the pill reads on the
         dark theme -->
    <SolidColorBrush x:Key="GitHubPrChipBrush" Color="#33A78BFA" />
    <SolidColorBrush x:Key="GitHubIssueChipBrush" Color="#334EC94E" />
    <!-- Translucent tint behind the changes column's count pill (matches the orange modified count) -->
    <SolidColorBrush x:Key="ChangesChipBrush" Color="#33FFAB40" />
    <!-- The changes tab's per-file delta pills: additions green, deletions light red
         (a softer red than the danger accent, so the pair reads +/- rather than error) -->
    <Color x:Key="LightRedColor">#F87171</Color>
    <SolidColorBrush x:Key="AddedCountBrush" Color="#4EC94E" />
    <SolidColorBrush x:Key="RemovedCountBrush" Color="{DynamicResource LightRedColor}" />
    <SolidColorBrush x:Key="AddedCountChipBrush" Color="#334EC94E" />
    <SolidColorBrush x:Key="RemovedCountChipBrush" Color="#33F87171" />
    <!-- Bright pill text/glyph brushes (ChipPalette.Bright*) — higher-luminance
         versions of the accent hues so pill text reads on the dark theme -->
    <SolidColorBrush x:Key="GreenBrightBrush" Color="#4EC94E" />
    <SolidColorBrush x:Key="RedBrightBrush" Color="#F87171" />
    <SolidColorBrush x:Key="AmberBrightBrush" Color="#FFAB40" />
    <SolidColorBrush x:Key="PurpleBrightBrush" Color="#A78BFA" />
    <SolidColorBrush x:Key="BlueBrightBrush" Color="#6E9BF7" />
    <!-- Translucent tints behind the Azure DevOps column's chips — PR / work item follow
         the GitHub coding (purple / green); pipeline states keep their own semantics -->
    <SolidColorBrush x:Key="AzureDevOpsPrChipBrush" Color="#33A78BFA" />
    <SolidColorBrush x:Key="AzureDevOpsWorkItemChipBrush" Color="#334EC94E" />
    <SolidColorBrush x:Key="AzureDevOpsPipelineOkChipBrush" Color="#334EC94E" />
    <SolidColorBrush x:Key="AzureDevOpsPipelineFailedChipBrush" Color="#33F87171" />
    <SolidColorBrush x:Key="AzureDevOpsPipelineRunningChipBrush" Color="#336E9BF7" />

    <!--
        ================================================================
        DESIGN TOKENS
        Centralized numeric tokens for sizing and radius.
        ================================================================
    -->
    <CornerRadius x:Key="CardRadius">10</CornerRadius>
    <!--  Half-card radii: the repos bottom bar's panel (top half) and strip (bottom
          half) form ONE docked card, so each carries only its own rounded corners.  -->
    <CornerRadius x:Key="CardRadiusTop">10,10,0,0</CornerRadius>
    <CornerRadius x:Key="CardRadiusBottom">0,0,10,10</CornerRadius>
    <CornerRadius x:Key="ControlRadius">8</CornerRadius>
    <CornerRadius x:Key="ChipRadius">6</CornerRadius>
    <!--  Fully-rounded pill chrome (state chips, small badges) on tiny surfaces —
          a small surface at CardRadius reads as a pill.  -->
    <CornerRadius x:Key="PillRadius">10</CornerRadius>

    <!--
        ================================================================
        ELEVATION SHADOWS — same values as SukiUI's theme shadows
        (SukiLowShadow / SukiSmallPopupShadow / SukiPopupShadow)
        ================================================================
    -->
    <ResourceDictionary.ThemeDictionaries>
        <ResourceDictionary x:Key="Dark">
            <BoxShadows x:Key="CardShadow">0 0 3 0 #353535</BoxShadows>
            <BoxShadows x:Key="FlyoutShadow">1 1 14 1 #101010</BoxShadows>
        </ResourceDictionary>
        <ResourceDictionary x:Key="Light">
            <BoxShadows x:Key="CardShadow">0 0 3 0 #eaeaea</BoxShadows>
            <BoxShadows x:Key="FlyoutShadow">1 1 8 0 LightGray</BoxShadows>
        </ResourceDictionary>
    </ResourceDictionary.ThemeDictionaries>

</ResourceDictionary>
