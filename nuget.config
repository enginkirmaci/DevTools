<?xml version="1.0" encoding="utf-8"?>
<configuration>
  <packageSources>
    <!-- Local feed first: MarkdownViewerKit.Avalonia lives here until it is
         published to nuget.org (add the NUGET_API_KEY secret and push the
         markdownviewerkit-v0.1.0 tag; packaging/nuget/build-nupkg.sh packs it). -->
    <add key="local-feed" value="packaging/nuget/feed" />
  </packageSources>
</configuration>
