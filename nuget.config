<?xml version="1.0" encoding="utf-8"?>
<configuration>
  <packageSources>
    <!-- Local feed first: MarkdownViewerKit.Avalonia's sources moved to
         github.com/enginkirmaci/MarkdownViewerKit (publishes to nuget.org on
         markdownviewerkit-v* tags once the NUGET_API_KEY secret is set there);
         until then this committed feed carries the package. -->
    <add key="local-feed" value="packaging/nuget/feed" />
  </packageSources>
</configuration>
